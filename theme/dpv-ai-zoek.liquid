.dpvai-bood .lbl{display:flex;align-items:center;gap:6px;font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#94a3b8;margin-bottom:9px}
.dpvai-bg{margin:0 0 13px}
.dpvai-bg:last-of-type{margin-bottom:4px}
