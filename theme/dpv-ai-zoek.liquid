@media(max-width:700px){
  .dpvai{padding:0 16px}
  .dpvai-veld{padding:11px 13px;gap:9px}
  .dpvai-veld input{font-size:15px}
  .dpvai-go{padding:9px 14px;font-size:13px}
}
</style>

