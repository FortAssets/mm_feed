.dpvai-bood{margin-top:11px;background:#fff;border:1px solid #e8edf5;border-radius:15px;padding:14px 15px;display:none;max-height:52vh;overflow:auto}
.dpvai-bood.aan{display:block}
.dpvai-sr{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:10px 4px;border-top:1px solid #E3E8F0;text-decoration:none;color:#0D1B2A}
.dpvai-sr:first-of-type{border-top:none}
