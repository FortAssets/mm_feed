  var GIDSEN = {
    'Turkije':'turkije','Verenigde Staten':'amerika','Thailand':'thailand','Egypte':'egypte',
    'Marokko':'marokko','Verenigde Arabische Emiraten':'dubai','Spanje':'spanje',
