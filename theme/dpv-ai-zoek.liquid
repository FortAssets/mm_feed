{%- comment -%}
  DPV AI-zoekbalk.

  Plaatst zichzelf boven de vergelijker (.pvx-outer) op elke pagina waar die
  staat. De AI schrijft geen antwoord: hij levert filterwaarden, en dit script
  zet ze in de bestaande vergelijker.

  Hoe de filters landen:
    data / bellen / maxMaand   -> window.pvxSetFilters()  (bestaat al)
    looptijd                   -> chip in #pvx-ctrbk aanklikken
    netwerk                    -> chip in #pvx-netbk aanklikken
    maxEenmalig                -> schuif #s-bij
    zoekterm                   -> tekstveld #pvx-q
    zakelijk                   -> knop .pvx-seg-btn[data-seg=zakelijk]
    categorie                  -> naar de bijbehorende pagina navigeren

  De chips worden op volgorde aangeklikt, niet op tekst: de vergelijker is
  vijftalig, dus op label matchen breekt zodra iemand naar Engels schakelt.
{%- endcomment -%}

<style>
.dpvai{max-width:1100px;margin:0 auto 18px;padding:0 24px;font-family:'Inter',system-ui,sans-serif}
.dpvai-veld{display:flex;align-items:center;gap:11px;background:#fff;border:2px solid #e8edf5;border-radius:15px;padding:13px 15px;transition:border-color .15s,box-shadow .15s}
.dpvai-veld:focus-within{border-color:#059669;box-shadow:0 0 0 4px rgba(5,150,105,.09)}

/* --- donker blok bovenaan --- */
.dpvai-blok{background:linear-gradient(160deg,#0f2f47,#0D1B2A);border-radius:19px;padding:17px 16px 18px}
.dpvai-blok .kp{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.dpvai-blok .kp b{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:16px;color:#fff}
.dpvai-blok .pil{font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;background:#059669;color:#fff;border-radius:20px;padding:3px 8px}
.dpvai-blok .sub{margin:0 0 12px;font-size:12px;color:#b6c6d6;line-height:1.5}
.dpvai-blok .dpvai-veld{border-color:#059669}
.dpvai-blok .dpvai-hint button{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.17);color:#dbe4ff}
.dpvai-blok .dpvai-hint button:hover{background:rgba(255,255,255,.18)}

/* --- zwevende knop (alleen mobiel) --- */
/* Op alle schermbreedtes. Eerder stond hij op desktop uit, omdat een
   zwevende knop naast een vergelijker als chatbot kan lezen. Maar dan zie je
   hem op je eigen scherm nooit, en site-breed betekent site-breed. */
.dpvai-fab{position:fixed;right:14px;bottom:16px;z-index:99991;display:flex;align-items:center;gap:8px;
  background:#059669;color:#fff;border:none;border-radius:999px;padding:13px 18px;
  font:800 13.5px 'Inter',system-ui,sans-serif;cursor:pointer;
  box-shadow:0 14px 30px -10px rgba(5,150,105,.7);
  opacity:0;transform:translateY(14px) scale(.94);pointer-events:none;
  transition:opacity .22s ease,transform .22s cubic-bezier(.2,.9,.3,1.2)}
.dpvai-fab.aan{opacity:1;transform:none;pointer-events:auto}
/* Zichtbaarheid loopt via de klasse 'aan', niet via display: zo houden we de
   in- en uitfade. Op desktop iets ruimer van de rand af. */
@media(min-width:901px){ .dpvai-fab{right:22px;bottom:22px;padding:14px 20px;font-size:14px} }
/* taalkiezer wijkt uit zodra de knop er staat */
body.dpvai-fab-open .pvlang{bottom:74px !important;transition:bottom .22s ease}
@media(min-width:901px){ body.dpvai-fab-open .pvlang{bottom:86px !important} }

/* --- paneel onderin --- */
.dpvai-ovl{position:fixed;inset:0;background:rgba(13,27,42,.45);z-index:99992;opacity:0;pointer-events:none;transition:opacity .2s}
.dpvai-ovl.aan{opacity:1;pointer-events:auto}
.dpvai-paneel{position:fixed;left:12px;right:12px;bottom:14px;z-index:99993;background:#fff;border:1px solid #e8edf5;
  border-radius:19px;padding:15px;box-shadow:0 -12px 44px -12px rgba(13,27,42,.5);
  transform:translateY(130%);transition:transform .26s cubic-bezier(.2,.9,.3,1)}
.dpvai-paneel.aan{transform:none}
.dpvai-paneel .kp{display:flex;align-items:center;justify-content:space-between;margin-bottom:11px}
.dpvai-paneel .kp b{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:15px}
.dpvai-paneel .kp button{background:none;border:none;color:#94a3b8;font-size:22px;line-height:1;cursor:pointer;padding:0 4px}

/* --- boodschappen: winkels onder elkaar, goedkoopste eerst --- */
