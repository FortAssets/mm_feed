{% schema %}
{
  "name": "Aanbod bij artikel",
  "settings": [
    { "type": "paragraph", "content": "Kiest zelf het aanbod op basis van het onderwerp van het artikel (tags, handle en titel)." }
  ],
  "presets": [ { "name": "Aanbod bij artikel" } ]
}
{% endschema %}
