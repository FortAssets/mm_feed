<script>
(function () {
  function sleutel(href) {
    var m = /[?&]i=([^&#]+)/.exec(href || '');
    return m ? decodeURIComponent(m[1]) : (href || '');
  }
  function start() {
    var rijen = document.querySelectorAll('.ak-t tbody tr');
    if (!rijen.length) return;
    var foto = {};
    Array.prototype.forEach.call(document.querySelectorAll('.ak a[href] img, a[style*="flex:1 1 2"] img'), function (img) {
      var a = img.closest('a'); if (a && img.getAttribute('src')) foto[sleutel(a.getAttribute('href'))] = img.getAttribute('src');
    });
    // Kaarten zonder link om de foto (abonnementen): dan op naam.
    var opNaam = [];
    Array.prototype.forEach.call(document.querySelectorAll('.ak'), function (k) {
      var img = k.querySelector('img'), n = k.querySelector('.ak-n');
      if (img && n && img.getAttribute('src')) opNaam.push([n.textContent.toLowerCase().replace(/\s+/g, ' ').trim(), img.getAttribute('src')]);
    });
    function norm(t) { return String(t || '').toLowerCase().replace(/\s+/g, ' ').trim(); }
    function viaNaam(cel) {
      var st = cel.querySelector('strong'), eigen = norm(st ? st.textContent : cel.textContent), t = norm(cel.textContent), beste = '', src = '';
      for (var i = 0; i < opNaam.length; i++) {
        var n = opNaam[i][0];
        if (n === eigen) return opNaam[i][1];
        if (n.length > 5 && n.length > beste.length && (t.indexOf(n) > -1 || (eigen.length > 5 && n.indexOf(eigen) > -1))) { beste = n; src = opNaam[i][1]; }
      }
      return src;
    }
    Array.prototype.forEach.call(rijen, function (tr) {
      var cel = tr.cells[0]; if (!cel || cel.querySelector('img')) return;
      function zet(src) {
        if (!src || cel.querySelector('.ak-th')) return;
        var wrap = document.createElement('div'); wrap.className = 'ak-tc';
        var img = document.createElement('img'); img.className = 'ak-th'; img.loading = 'lazy'; img.alt = ''; img.src = src;
        img.onerror = function () { img.remove(); };
        var tekst = document.createElement('span');
        while (cel.firstChild) tekst.appendChild(cel.firstChild);
        wrap.appendChild(img); wrap.appendChild(tekst); cel.appendChild(wrap);
      }
      var a = tr.querySelector('a[href*="/api/shop/go"]');
      var href = a ? a.getAttribute('href') : '', k = a ? sleutel(href) : '';
      if (k && foto[k]) return zet(foto[k]);
      var vn = viaNaam(cel); if (vn) return zet(vn);
      if (!a) return;
      var c = /[?&]cat=([^&#]+)/.exec(href);
      if (href.indexOf('/api/shop/go') < 0 || !c) return;
      fetch('https://shop.deprijsvergelijker.com/api/shop/product?i=' + encodeURIComponent(k) + '&cat=' + c[1])
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { if (d && d.product && d.product.im) zet(d.product.im); })
        .catch(function () {});
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>
{%- if onderwerp == 'winkel' -%}<style>[id$="__dpv-nieuws"]{display:none !important}</style>{%- endif -%}
