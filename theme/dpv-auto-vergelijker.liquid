<script>
(function(){
  var el=document.getElementById('av');if(!el)return;
  var D=JSON.parse(document.getElementById('av-data').textContent);
  var K={l:'35-59',r:'middel',d:'bc'};
  var LN={'18-23':'18 tot 23 jaar','24-34':'24 tot 34 jaar','35-59':'35 tot 59 jaar','60+':'60 jaar en ouder'};
  var RN={stad:'grote stad',middel:'middelgrote stad',dorp:'dorp of platteland'};
  var DN={wa:'WA',bc:'WA+',vc:'Allrisk'};
  var PR={'18-23':['21 jaar',1],'24-34':['28 jaar',5],'35-59':['45 jaar',12],'60+':['67 jaar',20]};
  var PL={stad:'Rotterdam',middel:'Amersfoort',dorp:'Beetsterzwaag (Friesland)'};
  function eur(p){return '\u20AC'+p.toFixed(2).replace('.',',');}
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  try{var q=new URLSearchParams(location.search);if(LN[q.get('leeftijd')])K.l=q.get('leeftijd');if(RN[q.get('regio')])K.r=q.get('regio');if(DN[q.get('dekking')])K.d=q.get('dekking');}catch(e){}
  function teken(){
    var rows=D.p[K.l+'|'+K.r+'|'+K.d]||[];
    el.querySelectorAll('[data-f]').forEach(function(g){var f=g.getAttribute('data-f');g.querySelectorAll('button').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-w')===K[f]?'true':'false');});});
    document.getElementById('av-keuze').textContent=DN[K.d]+' \u00B7 '+LN[K.l]+' \u00B7 '+RN[K.r];
    var pr=PR[K.l];
    document.getElementById('av-profiel').textContent='Rekenvoorbeeld: Volkswagen Polo uit 2018, '+pr[1]+(pr[1]===1?' schadevrij jaar':' schadevrije jaren')+', 10.000 km per jaar. Peildatum 6 oktober 2026.';
    document.getElementById('av-voet').textContent='Rekenvoorbeeld: Volkswagen Polo 1.0 uit 2018, 10.000 km per jaar, '+pr[0]+', '+pr[1]+(pr[1]===1?' schadevrij jaar':' schadevrije jaren')+', '+PL[K.r]+'. Premies per maand volgens de vergelijker van Poliswijzer op 6 oktober 2026, goedkoopste polis per verzekeraar. Jouw premie hangt af van je kenteken, postcode en schadevrije jaren en kan hoger of lager zijn. Wij ontvangen een vergoeding als je via ons afsluit; jij betaalt hetzelfde.';
    if(!rows.length){document.getElementById('av-band').textContent='Geen rekenvoorbeeld';document.getElementById('av-lijst').innerHTML='<div class="av-leeg">Voor deze keuze hebben wij geen rekenvoorbeeld.</div>';document.getElementById('av-aantal').textContent='';return;}
    document.getElementById('av-band').innerHTML=eur(rows[0][1])+' <u>tot</u> '+eur(rows[rows.length-1][1])+' <u>per maand</u>';
    document.getElementById('av-aantal').innerHTML='<b>'+rows.length+' verzekeraars</b> voor '+DN[K.d];
    document.getElementById('av-lijst').innerHTML=rows.map(function(r,x){var v=D.v[r[0]];
      var ch=['Eigen risico \u20AC'+r[2]].concat(v.c);if(r[3])ch.push('Dekkingsscore '+r[3]);
      return '<div data-dpv-mail class="av-rij'+(x===0?' av-top':'')+'">'+(x===0?'<span class="av-lint">Laagste in dit rekenvoorbeeld</span>':'')+
       '<div class="av-wie"><span class="av-ini" style="background:'+v.k+'">'+esc(v.i)+'</span><div><b>'+esc(v.n)+'</b><span class="av-hoe'+(v.direct?' av-direct':'')+'">'+(v.direct?'rechtstreeks bij '+esc(v.n):'via Poliswijzer')+'</span></div></div>'+
       '<div class="av-pr"><b>'+eur(r[1])+'</b><span>per maand \u00B7 rekenvoorbeeld</span></div>'+
       '<ul class="av-ch">'+ch.map(function(c){return '<li>'+esc(c)+'</li>';}).join('')+'</ul>'+
       '<a class="av-knop" href="'+esc(v.u)+'" target="_blank" rel="nofollow sponsored noopener">Bekijk '+esc(v.n)+' \u2192</a></div>';}).join('');
  }
  el.addEventListener('click',function(e){var b=e.target.closest('button.av-chip');if(!b)return;var f=b.parentNode.getAttribute('data-f');K[f]=b.getAttribute('data-w');teken();});
  teken();
})();
</script>
