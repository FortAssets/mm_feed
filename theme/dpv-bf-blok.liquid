</div>
<style>
.bfb{max-width:760px;margin:30px auto 10px;padding:0 20px;font-family:'Instrument Sans',system-ui,sans-serif;color:#0D1B2A}
.bfb *{box-sizing:border-box}
.bfb-in{border-top:1.5px solid #E3E8F0;padding-top:22px}
.bfb-eb{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border:1.5px solid #0D1B2A;border-radius:999px;padding:4px 11px;margin:0 0 12px}
.bfb-eb i{width:8px;height:8px;border-radius:50%;background:#F9C31F;display:block}
.bfb-kop{font-family:'Bricolage Grotesque','Instrument Sans',sans-serif;font-size:23px;letter-spacing:-.03em;line-height:1.15;margin:4px 0 12px;color:#0D1B2A}
.bfb-sub{font-size:15px;line-height:1.5;color:#4A5A70;margin:-4px 0 6px}
.bfb-tegels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 26px}
.bfb-t:last-child:nth-child(odd){grid-column:1/-1}
@media(min-width:700px){.bfb-tegels{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}.bfb-t:last-child:nth-child(odd){grid-column:auto}}
.bfb-t{display:block;background:#fff;border:1.5px solid #0D1B2A;border-radius:14px;padding:11px 12px;text-decoration:none !important;color:#0D1B2A !important;box-shadow:4px 4px 0 #3FAE7A}
.bfb-t small{display:block;font-size:11.5px;font-weight:700;color:#4A5A70;text-transform:uppercase;letter-spacing:.04em}
.bfb-t b{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:19px;letter-spacing:-.03em;margin:3px 0 2px}
.bfb-t span{display:block;font-size:12.5px;color:#4A5A70;font-weight:600;line-height:1.35}
.bfb-rij{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 2px 14px;margin:6px -2px 2px;scrollbar-width:none}
.bfb-rij::-webkit-scrollbar{display:none}
.bfb-k{flex:0 0 72%;max-width:250px;scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;border:1.5px solid #0D1B2A;border-radius:14px;padding:12px}
@media(min-width:700px){.bfb-k{flex:0 0 calc(25% - 9px);max-width:none}}
.bfb-afb{height:130px;background:#F1F3F8;border-radius:10px;position:relative;overflow:hidden;margin:0 0 10px;display:block}
.bfb-afb img{position:absolute;inset:12px;width:calc(100% - 24px);height:calc(100% - 24px);object-fit:contain;mix-blend-mode:multiply;margin:0 !important}
.bfb-n{font-size:15px;line-height:1.25;font-weight:700;margin:0}
.bfb-s{font-size:13px;color:#4A5A70;font-weight:500;margin:3px 0 0}
.bfb-p{font-family:'Bricolage Grotesque',sans-serif;font-size:25px;font-weight:800;letter-spacing:-.04em;line-height:1;margin:10px 0 2px}
.bfb-w{font-size:12.5px;color:#4A5A70;font-weight:600;margin:0 0 11px}
.bfb-knop,.bfb-knop:visited{margin-top:auto;display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 10px;background:#F9C31F;color:#0D1B2A !important;border:1.5px solid #0D1B2A;border-radius:10px;box-shadow:3px 3px 0 #0D1B2A;font-size:14px;font-weight:700;text-decoration:none !important;text-align:center}
.bfb-fijn{font-size:12.5px;color:#4A5A70;line-height:1.5;margin:4px 0 0}
</style>
<script>
(function(){
  var blok=document.getElementById('bfb'); if(!blok||!window.fetch) return;
  var API='https://shop.deprijsvergelijker.com/api/shop/product';
  function eur(n){n=Math.round(n*100)/100;var s=(n%1===0?String(n):n.toFixed(2).replace('.',','));var d=s.split(',');d[0]=d[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.');return '\u20ac'+d.join(',');}
  function wn(w){return w==='bol.com partner'?'via een partner op bol.com':'bij '+w;}
  function kn(w){return /^bol\.com/.test(w)?'Bekijk bij bol.com':'Bekijk bij '+w;}
  function laad(){
    var ks=blok.querySelectorAll('.bfb-k'), klaar=0;
    Array.prototype.forEach.call(ks,function(k){
      fetch(API+'?i='+encodeURIComponent(k.dataset.i)+'&cat='+encodeURIComponent(k.dataset.c)).then(function(r){return r.ok?r.json():null;}).then(function(d){
        var o=d&&d.product&&d.product.o; if(!o||!o.length) return;
        o=o.filter(function(x){return x.p>0;}).sort(function(a,b){return a.p-b.p;}); if(!o.length) return;
        k.querySelector('.bfb-p').textContent=eur(o[0].p);
        k.querySelector('.bfb-w').textContent=wn(o[0].w);
        var url='https://shop.deprijsvergelijker.com/api/shop/go?cat='+encodeURIComponent(k.dataset.c)+'&i='+encodeURIComponent(k.dataset.i)+'&w='+encodeURIComponent(o[0].w);
        k.querySelectorAll('a').forEach(function(a){a.href=url;});
        k.querySelector('.bfb-knop').textContent=kn(o[0].w);
        klaar++;
      }).catch(function(){}).then(function(){
        if(klaar){document.getElementById('bfb-datum').textContent='Prijzen van vandaag, automatisch bijgewerkt.';}
      });
    });
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){io.disconnect();laad();}},{rootMargin:'400px'});io.observe(blok);
  } else laad();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Black Friday-blok",
  "settings": [
    { "type": "checkbox", "id": "aan", "label": "Blok tonen onder Black Friday-artikelen en op de Black Friday-pagina", "default": true }
  ]
}
{% endschema %}
