<style>
.bfr{--ink:#0D1B2A;--soft:#5B6B80;--line:#E6EBF2;--vlak:#F6F8FB;--groen:#10b981;--groen-d:#0b7d5c;--diep:#0B0F17;
 font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);max-width:880px;margin:0 auto;padding:10px 16px 50px}
.bfr *{box-sizing:border-box}
.bfr :focus-visible{outline:3px solid var(--groen);outline-offset:2px}
.bfr-pil{display:inline-flex;align-items:center;gap:9px;background:#111827;color:#fff;border-radius:99px;padding:7px 16px;font-size:13.5px;font-weight:800}
.bfr-pil i{width:8px;height:8px;border-radius:50%;background:#FBBF24;display:block}
.bfr h1{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:32px;line-height:1.05;letter-spacing:-.03em;font-weight:800;margin:14px 0 8px}
.bfr-sub{font-size:16px;line-height:1.6;color:var(--soft);margin:0 0 22px;max-width:62ch}
.bfr h2{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:21px;letter-spacing:-.02em;font-weight:800;margin:0 0 10px}
.bfr-blok{padding:24px 0;border-top:1px solid var(--line)}
.bfr-tekst{font-size:15.5px;line-height:1.65}
.bfr-tekst p{margin:0 0 12px}
.bfr-tekst p:last-child{margin:0}

.bfr-aanmeld{background:var(--diep);color:#fff;border-radius:18px;padding:22px;
 background-image:radial-gradient(520px 300px at 88% 0%, rgba(251,191,36,.18), transparent 70%)}
.bfr-eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#FBBF24;font-weight:800;margin:0 0 8px}
.bfr-akop{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:25px;line-height:1.15;letter-spacing:-.025em;font-weight:800;margin:0 0 8px}
.bfr-asub{font-size:15px;line-height:1.6;color:#B9C6D6;margin:0 0 16px;max-width:52ch}
.bfr-rij{display:flex;gap:9px;flex-wrap:wrap}
.bfr-rij input{flex:1 1 230px;min-height:50px;padding:0 15px;border:1px solid rgba(255,255,255,.22);border-radius:12px;background:rgba(255,255,255,.07);color:#fff;font:inherit;font-size:16px}
.bfr-rij input::placeholder{color:#8FA0B4}
.bfr-rij button{min-height:50px;padding:0 22px;border:0;border-radius:12px;background:var(--groen);color:#fff;font:inherit;font-size:15px;font-weight:800;cursor:pointer}
.bfr-rij button:hover{background:#0fa876}
.bfr-rij button:disabled{opacity:.6;cursor:default}
.bfr-uit{display:none;font-size:14px;font-weight:700;margin:11px 0 0}
.bfr-aanmeld .bfr-fijn{color:#8FA0B4;margin:12px 0 0}
.bfr-fijn{font-size:12.5px;color:var(--soft);line-height:1.55;margin:14px 0 0}

.bfr-kopje{font-size:13px;font-weight:800;color:var(--soft);margin:18px 0 9px}
.bfr-kaarten{display:grid;gap:10px}
@media(min-width:680px){.bfr-kaarten{grid-template-columns:1fr 1fr}}
.bfr a.bfr-kaart,.bfr a.bfr-kaart:visited{display:block;background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px 16px;text-decoration:none;color:var(--ink)}
.bfr a.bfr-kaart:hover{border-color:var(--groen)}
.bfr-naam{display:block;font-size:16px;font-weight:800}
.bfr-detail{display:block;font-size:13px;color:var(--soft);margin-top:2px;line-height:1.4}
.bfr-cta{display:flex;align-items:center;justify-content:center;min-height:46px;margin-top:12px;background:var(--groen);color:#fff;border-radius:11px;font-size:14.5px;font-weight:800}

.bfr-vragen details{border:1px solid var(--line);border-radius:12px;padding:13px 15px;margin:0 0 9px;background:#fff}
.bfr-vragen summary{cursor:pointer;font-size:15.5px;font-weight:700;list-style:none}
.bfr-vragen summary::-webkit-details-marker{display:none}
.bfr-vragen summary::after{content:'+';float:right;color:var(--soft);font-weight:800}
.bfr-vragen details[open] summary::after{content:'\2212'}
.bfr-vragen details[open] summary{margin-bottom:9px}
</style>

<script>
(function () {
  var wortel = document.getElementById('bfr');
  if (!wortel) return;

  var startTijd = Date.parse(wortel.getAttribute('data-start') || '');
  if (!isNaN(startTijd) && Date.now() >= startTijd) {
    var st = document.getElementById('bfr-status');
    if (st) st.textContent = {{ section.settings.status_na | json }};
    var blok = document.getElementById('bfr-aanmeld');
    if (blok) blok.hidden = true;
  }

  var knop = document.getElementById('bfr-knop');
  var veld = document.getElementById('bfr-mail');
  var uit = document.getElementById('bfr-uit');
  /* 3 okt: dit veld ging naar de mc-lijst en was enkele opt-in: het postte een
     adres en zei "Gelukt", zonder bevestigingsmail. Dat is wat artikel 11.7
     Telecomwet van je vraagt, en het betekende ook dat iemand dit formulier kon
     gebruiken om andermans adres op de lijst te zetten.

     Nu naar dezelfde lijst als de rest van de site, met dubbele opt-in: er gaat
     eerst een mail met één link naartoe en pas na die klik staat iemand erop.
     De oude mc-adressen zijn met /sm/api/import-mc naar dezelfde lijst gehaald,
     dus het blijft één lijst. */
  var API = (wortel.getAttribute('data-api') || 'https://dpv-boodschappen.business-347.workers.dev')
    .replace(/\/+$/, '') + '/sm/api/aanmelden';
  var BRON = wortel.getAttribute('data-bron') || 'blackfriday-pagina';
  var ONDERWERPEN = (wortel.getAttribute('data-onderwerpen') || '')
    .split(',').map(function (x) { return x.trim(); }).filter(Boolean);

  function zeg(tekst, goed) {
    uit.textContent = tekst;
    uit.style.color = goed ? '#7FE3BC' : '#FFB4A8';
    uit.style.display = 'block';
  }

  function stuur() {
    var adres = (veld.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(adres)) { zeg('Vul een geldig e-mailadres in.', false); veld.focus(); return; }
    knop.disabled = true;
    var oud = knop.textContent;
    knop.textContent = 'Bezig\u2026';
    fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: adres, bron: BRON, onderwerpen: ONDERWERPEN })
    }).then(function (r) { return r.json(); }).then(function (res) {
      if (res && res.ok && res.status === 'al-actief') {
        zeg('Je stond al op de lijst. Je hoort van ons op 27 november.', true);
        veld.value = '';
        knop.textContent = 'Je staat op de lijst';
      } else if (res && res.ok) {
        zeg('Bijna klaar: kijk in je mail en klik op de link erin. Zonder die klik sturen wij je niets.', true);
        veld.value = '';
        knop.textContent = 'Kijk in je mail';
      } else {
        zeg('Dat lukte niet. Probeer het over een minuut opnieuw.', false);
        knop.disabled = false; knop.textContent = oud;
      }
    }).catch(function () {
      zeg('Dat lukte niet. Probeer het over een minuut opnieuw.', false);
      knop.disabled = false; knop.textContent = oud;
    });
  }

  knop.addEventListener('click', stuur);
  veld.addEventListener('keydown', function (e) { if (e.key === 'Enter') stuur(); });
})();
</script>

