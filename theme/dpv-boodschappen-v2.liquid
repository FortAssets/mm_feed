{%- comment -%}
  BOODSCHAPPEN, VISUELE OPZET (concept A)
  Eén raster met gelijke productkaarten, zoals een supermarktwebsite. Per kaart
  de goedkoopste aanbieding groot, en daaronder uitklapbaar alle andere winkels
  die hetzelfde merk deze week in de aanbieding hebben. Filteren gebeurt in één
  balk bovenaan die meescrollt. Data komt uit dezelfde worker als de huidige
  pagina (/sm/api/deals), er is dus geen aanpassing aan de worker nodig.
{%- endcomment -%}
<div class="bv" id="bv" data-api="{{ section.settings.api }}">

  <div class="bv-top">
    <div class="bv-tl">
      <p class="bv-e">Boodschappen</p>
      <h1>{{ section.settings.titel }}</h1>
      {%- if section.settings.intro != blank -%}<p class="bv-sub">{{ section.settings.intro }}</p>{%- endif -%}
      <p class="bv-wk" id="bv-wk">De aanbiedingen van deze week worden geladen…</p>
    </div>
    <div class="bv-tr" id="bv-cijfers"></div>
  </div>

  <div class="bv-barhouder" id="bv-barhouder">
    <div class="bv-bar" id="bv-bar">
      <div class="bv-weken" id="bv-weken" hidden>
        <button type="button" class="bv-wkt aan" data-w="deze">Deze week<small id="bv-wk1"></small></button>
        <button type="button" class="bv-wkt" data-w="volgende">Volgende week<small id="bv-wk2"></small></button>
      </div>
      <form class="bv-zoek" id="bv-zoekform" role="search">
        <label for="bv-q" class="bv-weg">Zoek een product</label>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M9 2a7 7 0 1 0 4.2 12.6l3.1 3.1 1.4-1.4-3.1-3.1A7 7 0 0 0 9 2Zm0 2a5 5 0 1 1 0 10A5 5 0 0 1 9 4Z"/></svg>
        <input id="bv-q" type="search" placeholder="Zoek op merk of product, bijvoorbeeld kwark of luiers" autocomplete="off">
        <button type="button" id="bv-wis" hidden aria-label="Zoekopdracht wissen">&times;</button>
      </form>
      <div class="bv-rijen">
        <div class="bv-rij"><span class="bv-rl">Winkel</span><div class="bv-chipswrap"><div class="bv-chips" id="bv-cw"></div></div></div>
        <div class="bv-rij"><span class="bv-rl">Actie</span><div class="bv-chipswrap"><div class="bv-chips" id="bv-ca"></div></div></div>
        <div class="bv-rij bv-soortrij"><span class="bv-rl">Soort</span><div class="bv-chipswrap"><div class="bv-chips" id="bv-cs"></div></div></div>
        <div class="bv-rij bv-folderrij"><span class="bv-rl">Folder</span><div class="bv-chipswrap"><div class="bv-chips" id="bv-cf"></div></div></div>
      </div>
      <div class="bv-onder">
        <p class="bv-telling" id="bv-telling" aria-live="polite"></p>
        <label class="bv-kies"><span>Schap</span><select id="bv-cc"></select></label>
        <span class="bv-nuschap" id="bv-nuschap" aria-live="polite" hidden></span>
        <label class="bv-kies"><span>Sorteer</span>
          <select id="bv-sort">
            <option value="schap">Per schap</option>
            <option value="korting">Hoogste korting</option>
            <option value="winkels">Meeste winkels</option>
            <option value="eenheid">Laagste prijs per liter of kilo</option>
            <option value="prijs">Laagste prijs</option>
            <option value="naam">Naam A tot Z</option>
          </select>
        </label>
        <button type="button" class="bv-reset" id="bv-reset" hidden>Filters wissen</button>
        <button type="button" class="bv-naarfilters" id="bv-naarfilters">Filters en folders</button>
      </div>
    </div>
  </div>

  <p class="bv-vooruit" id="bv-vooruit" hidden></p>

  <section class="bv-sec" id="bv-zoekextra" hidden>
    <h2 class="bv-h2">Ook gevonden in de folders</h2>
    <p class="bv-uit">Aanbiedingen die bij dit zoekwoord passen maar niet bij een merk horen dat wij per winkel volgen.</p>
    <div class="bv-wgrid" id="bv-zl"></div>
  </section>

  <section class="bv-sec" id="bv-dag" hidden>
    <h2 class="bv-h2">Dagdeals</h2>
    <p class="bv-uit">Acties die maar één dag of alleen in het weekend gelden.</p>
    <div class="bv-chipswrap"><div class="bv-chips" id="bv-dt" role="tablist"></div></div>
    <div class="bv-dgrid" id="bv-dl"></div>
  </section>

  <div class="bv-grid" id="bv-grid"><p class="bv-leeg">Laden…</p></div>
  <p class="bv-meerp"><button type="button" id="bv-meer" hidden></button></p>

  <section class="bv-sec" id="bv-alles" hidden>
    <h2 class="bv-h2">Alles uit de folder</h2>
    <p class="bv-uit">Alle aanbiedingen die wij deze week van die winkel binnenkregen, goedkoopste eerst. Staat een merk ook bij andere winkels in de aanbieding, dan kun je doorklikken naar de vergelijking.</p>
    <div class="bv-chipswrap"><div class="bv-chips" id="bv-at" role="tablist"></div></div>
    <p class="bv-folder" id="bv-af"></p>
    <div class="bv-agrid" id="bv-al"></div>
    <p class="bv-meerp"><button type="button" id="bv-ameer" hidden></button></p>
  </section>

  <section class="bv-sec" id="bv-folders">
    <h2 class="bv-h2">Weekfolders</h2>
    <p class="bv-uit">De volledige folder van deze week, bij de winkel zelf.</p>
    <div class="bv-fchips" id="bv-fl"></div>
    <div id="bv-fvolgende" hidden>
      <h3 class="bv-h3">Volgende week</h3>
      <p class="bv-uit">Deze winkels hebben hun volgende folder al online gezet. De rest volgt later deze week.</p>
      <div class="bv-fchips" id="bv-fv"></div>
    </div>
  </section>

  <section class="bv-sec" id="bv-cb-blok" hidden>
    <h2 class="bv-h2">Ook bij Coolblue</h2>
    <p class="bv-uit">Apparaten die een supermarkt deze week in de aanbieding heeft, naast precies hetzelfde product bij Coolblue.</p>
    <div class="bv-cb" id="bv-cb"></div>
  </section>

  <p class="bv-fijn">Bij elke aanbieding staat wat voor soort het is. <b>Weekfolder</b> betekent dat de actie in de folder van deze week staat, en de knop brengt je naar de pagina waar hij staat. <b>Alleen zaterdag</b> of <b>Weekendactie</b> betekent dat de actie maar één dag of alleen in het weekend geldt. <b>Van de website</b> is een actie die we op de aanbiedingenpagina van de winkel vonden, <b>Webshop</b> komt uit hun webwinkel.</p>
  <p class="bv-fijn">Actieprijzen gelden zolang de actie loopt en kunnen per filiaal verschillen. Controleer de voorwaarden bij de winkel zelf. Omgerekend naar prijs per liter, kilo, wasbeurt of stuk, zodat 1+1 gratis en 25 procent korting eerlijk naast elkaar staan. Productfoto's: Open Food Facts (CC BY-SA). Via sommige links ontvangen wij een vergoeding, jij betaalt hetzelfde.</p>
</div>

<style>
#bv .dpvmb{display:none !important}
.bv{max-width:1180px;margin:0 auto;padding:18px 16px 48px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#0D1B2A}
.bv *{box-sizing:border-box}
.bv-weg{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* Kop */
.bv-top{display:flex;gap:20px;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;margin:0 0 14px}
.bv-e{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#0b7d5c;font-weight:800;margin:0 0 6px}
.bv h1{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:clamp(24px,3.4vw,34px);line-height:1.06;letter-spacing:-.03em;margin:0 0 6px;color:#0D1B2A}
.bv-sub{font-size:15px;line-height:1.55;color:#475569;margin:0 0 8px;max-width:760px}
.bv-wk{font-size:14px;color:#5B6B80;margin:0;font-weight:600}
.bv-tr{display:flex;gap:8px;flex-wrap:wrap}
.bv-c{background:#F5F8FB;border:1px solid #E6EBF2;border-radius:12px;padding:8px 14px;min-width:92px}
.bv-c b{display:block;font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:21px;line-height:1.1}
.bv-c span{font-size:11.5px;color:#5B6B80;font-weight:600}

/* Filterbalk */
.bv-barhouder{margin:0 0 16px}
.bv-bar{background:#fff;border:1px solid #E6EBF2;border-radius:16px;padding:12px 14px;box-shadow:0 1px 2px rgba(13,27,42,.04)}
.bv-bar.bv-vast{position:fixed;z-index:40;border-radius:0 0 16px 16px;box-shadow:0 10px 22px -16px rgba(13,27,42,.45)}
/* Schakelaar tussen deze en volgende week. Staat alleen in beeld als er van
   volgende week al iets bekend is. */
.bv-weken{display:flex;gap:6px;margin:0 0 10px}
.bv-wkt{flex:1;font:inherit;font-size:13px;font-weight:800;border:1.5px solid #E6EBF2;background:#fff;color:#475569;border-radius:11px;padding:7px 8px;cursor:pointer;line-height:1.2}
.bv-wkt small{display:block;font-weight:700;font-size:11px;opacity:.75;margin-top:1px}
.bv-wkt.aan{background:#0D1B2A;border-color:#0D1B2A;color:#fff}
.bv-vooruit{background:#FDF0DC;border:1px solid #f6d9ae;color:#8a5a12;border-radius:12px;padding:10px 13px;font-size:13px;line-height:1.5;font-weight:600;margin:0 0 14px}
.bv-vooruit b{font-weight:800}
.bv-zoek{position:relative;margin:0 0 10px}
.bv-zoek svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:18px;height:18px;fill:#94A3B8;pointer-events:none}
.bv-zoek input{width:100%;height:46px !important;min-height:46px !important;-webkit-appearance:none;appearance:none;border:1.5px solid #E6EBF2 !important;border-radius:12px !important;padding:0 40px 0 40px !important;font-size:16px !important;background:#F8FAFC !important;color:#0D1B2A !important;margin:0 !important;box-sizing:border-box !important}
.bv-zoek input:focus{outline:none;border-color:#10b981 !important;background:#fff !important}
.bv-zoek button{position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:#E6EBF2;color:#475569;width:26px;height:26px;border-radius:99px;font-size:17px;line-height:1;cursor:pointer}
.bv-rij{display:flex;gap:10px;align-items:center;margin:0 0 6px;min-width:0}
.bv-rl{flex:0 0 52px;font-size:10.5px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#94A3B8}
.bv-chipswrap{position:relative;flex:1;min-width:0}
.bv-chipswrap::after{content:'';position:absolute;right:0;top:0;bottom:0;width:26px;pointer-events:none;background:linear-gradient(90deg,rgba(255,255,255,0),#fff)}
.bv-chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:2px 0;-webkit-overflow-scrolling:touch}
.bv-chips::-webkit-scrollbar{display:none}
.bv-chips button{flex:0 0 auto;font:inherit;font-size:13px;font-weight:700;border:1.5px solid #E6EBF2;background:#fff;color:#475569;border-radius:99px;padding:6px 13px;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.bv-chips button:hover{border-color:#CBD5E1}
.bv-chips button small{font-weight:700;font-size:11px;color:#94A3B8}
.bv-chips button.aan{background:#0D1B2A;border-color:#0D1B2A;color:#fff}
.bv-chips button.aan small{color:#9FB3C8}
.bv-chips button i{width:9px;height:9px;border-radius:3px;flex:0 0 9px;font-style:normal}
.bv-onder{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:8px;padding-top:9px;border-top:1px solid #F1F5F9}
.bv-telling{margin:0;font-size:13px;font-weight:700;color:#0D1B2A;flex:1;min-width:120px}
.bv-telling span{color:#94A3B8;font-weight:600}
.bv-kies{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#94A3B8}
.bv-kies select{font:inherit;font-size:13px;font-weight:700;text-transform:none;letter-spacing:0;color:#0D1B2A;border:1.5px solid #E6EBF2;border-radius:10px;background:#fff;padding:6px 10px;max-width:200px}
.bv-kies select:focus{outline:none;border-color:#10b981}
.bv-reset{font:inherit;font-size:13px;font-weight:800;color:#2563EB;background:none;border:0;cursor:pointer;padding:6px 2px}
/* Vastgezet neemt de balk minder ruimte in: de telling en het sorteren staan
   al bovenaan, tijdens het scrollen heb je vooral de filters nodig. */
.bv-bar.bv-vast .bv-telling{display:none}
/* 6 okt: tijdens het scrollen loopt alleen de regel met het schap mee (waar je bent, schap kiezen, sorteren).
   De week, het zoekveld en de filterrijen blijven bovenaan staan; de knop "Filters en folders" brengt je terug. */
.bv-bar.bv-vast .bv-weken,.bv-bar.bv-vast .bv-zoek,.bv-bar.bv-vast .bv-rijen{display:none}
.bv-bar.bv-vast{padding:8px 14px}
.bv-bar.bv-vast .bv-onder{padding-top:0;margin-top:0;border-top:0;justify-content:flex-start;gap:8px 12px}
.bv-naarfilters{display:none;font:inherit;font-size:13px;font-weight:700;color:#0D1B2A;background:#F1F3F8;border:0;border-radius:99px;padding:7px 13px;cursor:pointer;margin-left:auto}
.bv-bar.bv-vast .bv-naarfilters{display:inline-block}
/* Weekfolder in een venster op de eigen pagina */
.bv-fo{position:fixed;inset:0;z-index:2147483000;background:rgba(13,27,42,.55);display:flex;align-items:center;justify-content:center;padding:18px}
.bv-fo-vak{background:#fff;border-radius:14px;width:min(1100px,100%);height:min(92vh,100%);display:flex;flex-direction:column;overflow:hidden;box-shadow:6px 6px 0 #3FAE7A}
.bv-fo-kop{display:flex;align-items:center;gap:12px;padding:10px 12px 10px 16px;border-bottom:1px solid #E3E8F0;flex:0 0 auto}
.bv-fo-kop b{font-family:'Bricolage Grotesque','Instrument Sans',sans-serif;font-weight:800;font-size:18px;letter-spacing:-.03em;color:#0D1B2A;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bv-fo-kop a{font-size:13px;font-weight:700;color:#0D1B2A;text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
.bv-fo-kop button{width:40px;height:40px;border:0;border-radius:50%;background:#F1F3F8;color:#0D1B2A;font-size:22px;line-height:1;cursor:pointer;flex:0 0 40px}
.bv-fo iframe{flex:1;width:100%;border:0;background:#F1F3F8}
@media(max-width:700px){.bv-fo{padding:0}.bv-fo-vak{border-radius:0;height:100%;box-shadow:none}.bv-fo-kop a span{display:none}}

/* Raster */
/* Kaarten krijgen de hoogte van hun eigen inhoud. Rekten ze mee met de hoogste
   kaart in de rij, dan ontstond er een gat zodra je er één uitklapte. */
.bv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(214px,1fr));gap:12px;align-items:start}
.bv-k{background:#fff;border:1px solid #E6EBF2;border-radius:16px;padding:12px;display:flex;flex-direction:column;position:relative}
.bv-k:hover{border-color:#CBD5E1}
.bv-badge{position:absolute;left:10px;top:10px;z-index:2;font-size:12px;font-weight:800;background:#E11D48;color:#fff;border-radius:8px;padding:3px 7px;line-height:1.1}
.bv-badge b{font-weight:700;opacity:.85;font-size:.86em}
/* Schapkoppen in het raster. Ze lopen over de volle breedte, ook in een
   raster van drie kolommen, zodat ze echt als scheiding werken. */
.bv-schapkop{grid-column:1/-1;margin:22px 0 2px;font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;
  font-size:17px;font-weight:800;letter-spacing:-.02em;color:#0D1B2A;
  display:flex;align-items:center;gap:10px}
.bv-schapkop:first-child{margin-top:4px}
.bv-schapkop:after{content:'';flex:1;height:1px;background:#E6EBF2}
.bv-nuschap{display:inline-flex;align-items:center;gap:6px;background:#0D1B2A;color:#fff;border-radius:99px;
  padding:5px 12px;font-size:12.5px;font-weight:800;white-space:nowrap;max-width:46vw;overflow:hidden;
  text-overflow:ellipsis}
.bv-nuschap:before{content:'';width:6px;height:6px;border-radius:50%;background:#10b981;flex:0 0 6px}
@media(max-width:700px){.bv-schapkop{font-size:15.5px;margin:16px 0 2px}}
.bv-badge.gratis{background:#0b7d5c}
.bv-beeld{height:104px;display:flex;align-items:center;justify-content:center;margin:0 0 8px}
.bv-beeld img{max-height:104px;max-width:100%;object-fit:contain}
/* Niet elk product heeft een foto. In plaats van een leeg vlak tonen we de
   merknaam in een getinte tegel, dan blijft de kaart herkenbaar. */
.bv-geenbeeld{width:100%;height:96px;border-radius:12px;background:linear-gradient(160deg,#F5F8FB,#EDF2F7);display:flex;align-items:center;justify-content:center;padding:8px 10px;text-align:center;font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:16px;line-height:1.15;font-weight:800;color:#A8B6C6;letter-spacing:-.01em;overflow:hidden}
.bv-cat{font-size:11px;color:#94A3B8;font-weight:700;margin:0 0 2px;letter-spacing:.02em}
.bv-k h3{font-size:14.5px;line-height:1.25;margin:0 0 8px;font-weight:800}
.bv-hm{font-size:10px;font-weight:800;background:#EEF2F7;color:#64748B;border-radius:99px;padding:1px 6px;margin-left:4px;vertical-align:1px}
.bv-prijs{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;margin:0 0 2px}
.bv-prijs strong{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:25px;font-weight:800;line-height:1;letter-spacing:-.02em}
.bv-prijs s{font-size:13px;color:#94A3B8;font-weight:700}
.bv-prijs em{font-style:normal;font-size:11.5px;color:#5B6B80;font-weight:700}
.bv-actiep{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:19px;font-weight:800;color:#E11D48;line-height:1.1;margin:0 0 2px}
.bv-vw{font-size:12.5px;font-weight:800;color:#B45309;background:#FEF3C7;border-radius:6px;padding:3px 8px;display:inline-block;margin:3px 0 0}
.bv-pe{font-size:12px;font-weight:800;color:#0b7d5c;margin:0 0 9px}
.bv-pe.leeg{color:#B45309;font-weight:700}
.bv-eerder{font-size:11.5px;font-weight:700;color:#64748B;margin:-6px 0 9px}
.bv-eerder.laag{color:#0b7d5c}
.bv-lm em{font-style:normal;color:#94A3B8;font-weight:700}
/* De prijs staat direct onder de naam, de winkel en de knop worden naar de
   onderkant geduwd. Zo staan de prijzen in een rij netjes op één lijn. */
.bv-bij{display:block;color:#0D1B2A;margin:auto 0 2px}
.bv-oms{margin-top:5px;font-size:11.5px;line-height:1.35;color:#5B6B80;font-weight:700;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.bv-wl{display:inline-block;font-size:11.5px;font-weight:800;line-height:1;padding:4px 8px;border-radius:7px;white-space:nowrap}
/* Wat voor aanbieding het is, staat als label op de kaart. Een dag- of
   weekendactie krijgt een opvallender kleur, want die loopt het snelst af. */
.bv-tot{margin:5px 0 0;display:flex;flex-wrap:wrap;gap:5px;align-items:center}
.bv-soort{font-size:10.5px;font-weight:800;letter-spacing:.02em;border-radius:6px;padding:3px 7px;line-height:1.2;white-space:nowrap}
.bv-soort.folder{background:#E8EEF9;color:#1B3FA0}
.bv-soort.dag{background:#FDF0DC;color:#B45309}
.bv-soort.web{background:#EEF2F7;color:#5B6B80}
.bv-tdatum{font-size:11px;color:#B45309;font-weight:700}
.bv-knop{display:block;text-align:center;margin:9px 0 0;font-size:13px;font-weight:800;color:#fff;background:#0D1B2A;border-radius:10px;padding:9px 10px;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bv-knop:hover{background:#16305C}
.bv-knop.check{background:#fff;color:#0D1B2A;border:1.5px solid #E6EBF2}
.bv-knop.bestel{background:#059669;margin-top:6px}
.bv-knop.bestel:hover{background:#047857}
.bv-online{margin:10px 0 0;padding:9px 10px 10px;background:#F4FAF7;border:1px solid #D7EDE3;border-radius:11px}
.bv-okop{margin:0;font-size:10.5px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;color:#047857;line-height:1.25}
.bv-owin{display:inline-block;background:#059669;color:#fff;border-radius:5px;padding:1px 5px;font-size:9.5px;font-weight:900;white-space:nowrap;vertical-align:1px;text-transform:uppercase;letter-spacing:.03em}
.bv-oreg{margin:4px 0 0;font-size:13px;font-weight:700;color:#0D1B2A;line-height:1.3}
.bv-oreg b{font-size:17px;font-weight:900;letter-spacing:-.02em}
.bv-ototaal{margin:2px 0 0;font-size:12px;font-weight:700;color:#3C4B5F}
.bv-ototaal s{color:#8A98AA;font-weight:600}
.bv-otitel{margin:3px 0 0;font-size:11.5px;color:#5B6B80;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.bv-ofolder{margin:7px 0 0;font-size:11px;color:#5B6B80;line-height:1.35}
/* Vaste opbouw per kaart. Elk blok heeft dezelfde kop op dezelfde plek, zodat
   je langs de kaarten kunt scrollen en steeds op dezelfde hoogte de prijs
   vindt. Dat scheelt zoeken en maakt vergelijken een kwestie van kijken. */
.bv-folder{display:flex;flex-direction:column}
