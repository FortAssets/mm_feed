<script>
(function(){
  var root=document.getElementById('bv'); if(!root) return;
  var API=root.getAttribute('data-api')||'';
  var D=null, alles=[], winkel='', actie='', dsoort='', categorie='', vraag='', sort='schap', getoond=24, STAP=24;
  var welkeWeek='deze', cache={}, weekKeys={};

  function e(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
  function eu(n){return n==null?'':'€'+Number(n).toLocaleString('nl-NL',{minimumFractionDigits:2,maximumFractionDigits:2})}
  var DGN=['zo','ma','di','wo','do','vr','za'], MND=['jan','feb','mrt','apr','mei','jun','jul','aug','sep','okt','nov','dec'];
  var MNDLANG=['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
  function maandag(wk){var j=+String(wk).slice(0,4),w=+String(wk).split('-W')[1],d=new Date(Date.UTC(j,0,4)),dag=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()-dag+1+(w-1)*7);return d}
  function plusD(d,n){var x=new Date(d);x.setUTCDate(x.getUTCDate()+n);return x}
  function tot(s){if(!s)return '';var d=new Date(s+'T12:00:00');if(isNaN(d))return '';return 't/m '+DGN[d.getDay()]+' '+d.getDate()+' '+MND[d.getMonth()]}
  var KLEUR={ah:['#00A0E2','#fff'],jumbo:['#FFC800','#1A1A1A'],plus:['#6AA521','#fff'],dirk:['#E30613','#fff'],lidl:['#0050AA','#FFF000'],aldi:['#00005F','#fff'],
    hoogvliet:['#009A44','#fff'],vomar:['#D1001C','#fff'],kruidvat:['#E3000F','#fff'],action:['#0B64B4','#fff'],etos:['#1A1A1A','#fff'],da:['#E6007E','#fff'],trekpleister:['#F18A00','#fff']};
  function wl(w,naam){var k=KLEUR[w]||['#334155','#fff'];return '<span class="bv-wl" style="background:'+k[0]+';color:'+k[1]+'">'+e(naam||w)+'</span>'}
  window.bvGeenFoto=function(img){var m=img.getAttribute('data-merk')||'';
    var v=document.createElement('div');v.className='bv-geenbeeld';v.textContent=m;
    if(img.parentNode)img.parentNode.replaceChild(v,img)};
  function stip(w){var k=KLEUR[w]||['#334155','#fff'];return '<i style="background:'+k[0]+'"></i>'}

  /* Elke deal krijgt een actietype, zodat je daarop kunt filteren. Let op: dit
     is iets anders dan d.soort van de worker, dat zegt of het een weekfolder,
     dagaanbieding of webshopactie is. */
  function actieSoortVan(a){a=String(a||'').toLowerCase();
    if(/\d+\s*\+\s*\d+\s*gratis/.test(a))return 'gratis';
    if(/halve prijs|50\s*%/.test(a))return 'halve';
    if(/\d+\s*%\s*korting/.test(a))return 'korting';
    if(/\d+\s*voor\b|\bvoor\s*€?\s*\d/.test(a))return 'meer';
    return 'prijs'}
  var SOORTNAAM={gratis:'Gratis erbij',halve:'2e halve prijs',korting:'Procent korting',meer:'Meerstuks',prijs:'Actieprijs'};

  /* Hoeveel procent lever je in ten opzichte van de normale prijs? */
  function kortingVan(d){
    if(d.korting)return d.korting;
    var m=/(\d+)\s*\+\s*(\d+)\s*gratis/i.exec(d.actie||'');
    if(m)return Math.round(+m[2]/(+m[1]+ +m[2])*100);
    m=/(\d+)\s*%\s*korting/i.exec(d.actie||'');
    if(m)return +m[1];
    if(/halve prijs/i.test(d.actie||''))return 25;
    if(d.normaalprijs&&d.prijsPerStuk&&d.normaalprijs>d.prijsPerStuk)return Math.round((1-d.prijsPerStuk/d.normaalprijs)*100);
    return 0}

  /* Eén regel per product, klaar om te filteren en te sorteren. */
  function bouw(d){
    return (d.producten||[]).filter(function(p){return p.deals&&p.deals.length}).map(function(p){
      var ds=p.deals.map(function(x){var q=Object.assign({},x);q.k=kortingVan(x);q.asoort=actieSoortVan(x.actie);
        /* Wat voor aanbieding: komt van de worker, maar we vullen hem zelf aan
           zolang die nog de oude gegevens stuurt. */
        q.dsoort=x.soort||(x.dag?(x.dag==='weekend'?'weekend':'dag'):(x.bron==='folder'?'weekfolder':(x.bron==='action'?'webshop':'website')));
        return q});
      /* Beste aanbieding: eerst op prijs per eenheid, anders op korting. */
      var metEenheid=ds.filter(function(x){return x.perEenheid});
      var best=metEenheid.length?metEenheid.slice().sort(function(a,b){return a.perEenheid-b.perEenheid})[0]
        :ds.slice().sort(function(a,b){return (b.k-a.k)||((a.prijsPerStuk||9e9)-(b.prijsPerStuk||9e9))})[0];
      var rest=ds.filter(function(x){return x!==best}).sort(function(a,b){
        var pa=a.perEenheid||(a.prijsPerStuk?1e3+a.prijsPerStuk:1e6), pb=b.perEenheid||(b.prijsPerStuk?1e3+b.prijsPerStuk:1e6);return pa-pb});
      /* Sorteren op de korting van de aanbieding die we ook tonen, anders staat
         een kaart met -11% ineens tussen de kaarten met -60% omdat een andere
         winkel daar wel veel korting geeft maar per liter duurder is. */
      return {p:p,ds:ds,best:best,rest:rest,elders:p.elders||[],
        k:best.k||0,
        pe:best.perEenheid||null, pr:best.prijsPerStuk||null,
        zoek:(p.naam+' '+p.merk+' '+p.categorie+' '+ds.map(function(x){return x.omschrijving||''}).join(' ')).toLowerCase()}})}

  /* De volgorde waarin je door een winkel loopt, niet alfabetisch. Schappen
     die hier niet in staan komen erachter, op naam. */
  var SCHAPVOLGORDE = ['Groente en fruit','Vlees en vis','Zuivel en kaas','Broodbeleg en sauzen',
    'Ontbijt','Houdbaar','Diepvries','Chips en snoep','Frisdrank','Sappen','Water','Bier',
    'Koffie en thee','Huishouden','Wasmiddel','Verzorging','Baby','Huisdier'];

  function gefilterd(){
    return alles.filter(function(x){
      if(categorie&&x.p.categorie!==categorie)return false;
      if(winkel&&!x.ds.some(function(d){return d.winkel===winkel}))return false;
      if(actie&&!x.ds.some(function(d){return d.asoort===actie}))return false;
      if(dsoort&&!x.ds.some(function(d){return d.dsoort===dsoort}))return false;
      if(vraag&&x.zoek.indexOf(vraag)<0)return false;
      return true}).sort(function(a,b){
        /* Per schap is de standaard. Daarvoor stond alles op korting door
           elkaar: zuivel, chips en wasmiddel afgewisseld, en dan is de lijst
           niet te lopen zoals je door een winkel loopt. Binnen een schap nog
           steeds de hoogste korting bovenaan, want daar kom je voor. */
        if(sort==='schap'){
          var ca=SCHAPVOLGORDE.indexOf(a.p.categorie), cb=SCHAPVOLGORDE.indexOf(b.p.categorie);
          if(ca<0)ca=99; if(cb<0)cb=99;
          if(ca!==cb)return ca-cb;
          var na=String(a.p.categorie||''), nb=String(b.p.categorie||'');
          if(na!==nb)return na.localeCompare(nb);
          return (b.k-a.k)||a.p.naam.localeCompare(b.p.naam);
        }
        if(sort==='naam')return a.p.naam.localeCompare(b.p.naam);
        if(sort==='winkels')return (b.ds.length-a.ds.length)||(b.k-a.k);
        if(sort==='eenheid')return (a.pe||9e9)-(b.pe||9e9)||(b.k-a.k);
        if(sort==='prijs')return (a.pr||9e9)-(b.pr||9e9)||(b.k-a.k);
        return (b.k-a.k)||(b.ds.length-a.ds.length)})}

  /* Een actie als "4 voor 17,94" geldt pas als je er ook echt vier koopt. De
     prijs per stuk zegt dat niet, en wie er een pakt betaalt de volle prijs.
     Die voorwaarde zetten we er daarom apart onder. */
  function voorwaarde(d){
    var a=String(d.actie||'');
    if(/^\s*\d+\s*voor\b/i.test(a))return '<p class="bv-vw">Alleen bij '+e(a)+'</p>';
    if(/^\s*\d\s*\+\s*\d\s*gratis/i.test(a))return '<p class="bv-vw">Prijs per stuk bij '+e(a)+'</p>';
    return ''}
  function prijsBlok(d,eh){
    if(d.prijsPerStuk)return '<p class="bv-prijs"><strong>'+(d.groep?'vanaf ':'')+eu(d.prijsPerStuk)+'</strong>'+
      (d.normaalprijs&&!d.groep&&d.normaalprijs>d.prijsPerStuk?'<s>'+eu(d.normaalprijs)+'</s>':'')+
      (/voor|gratis|halve/i.test(d.actie||'')?'<em>per stuk</em>':'')+'</p>'+voorwaarde(d);
    return '<p class="bv-actiep">'+e(d.actie||'aanbieding')+'</p>'}

  /* Wat kostte dit eerder? Zodra wij een week of langer meekijken staat hier de
     laagste actieprijs die we eerder zagen, met winkel en datum. Is het nu even
     goedkoop of goedkoper, dan zeggen we dat, want dat is het echte signaal. */
  function korteDatum(s){if(!s)return '';var d=new Date(String(s).slice(0,10)+'T12:00:00');
    if(isNaN(d))return '';return d.getDate()+' '+MND[d.getMonth()]}
  function eerderRegel(x,d,eh){
    var v=x.p.eerder; if(!v)return '';
    var nuPE=d.perEenheid, nuP=d.prijsPerStuk;
    if(v.perEenheid!=null&&nuPE!=null){
      if(nuPE<=v.perEenheid)return '<p class="bv-eerder laag">Nog niet eerder zo goedkoop gezien</p>';
      return '<p class="bv-eerder">Eerder '+eu(v.perEenheid)+' per '+e(eh)+' bij '+e(v.winkelNaam)+(v.datum?' ('+korteDatum(v.datum)+')':'')+'</p>'}
    if(v.prijs!=null&&nuP!=null){
      if(nuP<=v.prijs)return '<p class="bv-eerder laag">Nog niet eerder zo goedkoop gezien</p>';
      return '<p class="bv-eerder">Eerder '+eu(v.prijs)+' bij '+e(v.winkelNaam)+(v.datum?' ('+korteDatum(v.datum)+')':'')+'</p>'}
    return ''}

  /* Waar komt deze aanbieding vandaan en hoe lang loopt hij? Dat zegt meteen
     waar de knop je heen brengt: de folderpagina of het product zelf. */
  var DAGNM={ma:'maandag',di:'dinsdag',wo:'woensdag',do:'donderdag',vr:'vrijdag',za:'zaterdag',zo:'zondag'};
  var SOORT={
    weekfolder:['Weekfolder','folder'],
    dag:['Dagaanbieding','dag'],
    weekend:['Weekendactie','dag'],
    webshop:['Webshop','web'],
    website:['Van de website','web']};
  function soortDeal(d){
    var s=d.dsoort||d.soort;
    var v=SOORT[s]; if(!v)return null;
    var tekst=v[0];
    if(s==='dag'&&d.dag&&DAGNM[d.dag])tekst='Alleen '+DAGNM[d.dag];
    return {tekst:tekst,kleur:v[1]}}
  function herkomst(d){
    var s=soortDeal(d), r='';
    if(s)r+='<span class="bv-soort '+s.kleur+'">'+e(s.tekst)+'</span>';
    if(d.geldigTot)r+='<span class="bv-tdatum">'+tot(d.geldigTot)+'</span>';
    return r?'<p class="bv-tot">'+r+'</p>':''}

  /* Grootverpakkingen die je online kunt bestellen. Die staan niet in een
     folder, dus ze horen niet tussen de aanbiedingen maar als eigen regel
     eronder. We tonen altijd de totaalprijs en het aantal erbij: per wasbeurt
     is zo'n pak goedkoper, maar je legt wel een groter bedrag neer, en dat
     hoort de bezoeker te zien voordat hij klikt.
     Staat het product deze week ook in een folder, dan zetten we dat er klein
     bij, zodat hij kan kiezen tussen meenemen of laten bezorgen. */
  function onlineBlok(x,eh,best){
    var o=(x.p.online||[])[0];
    if(!o||!o.url)return '';
    var goedkoper=best&&best.perEenheid&&o.perEenheid<best.perEenheid;
    var mv=eh==='wasbeurt'?'wasbeurten':(eh==='stuk'?'stuks':eh);
    return '<div class="bv-online">'+
      '<p class="bv-okop">Online bij '+e(o.winkelNaam)+'</p>'+
      /* Bij een product waarvan "per stuk" niets betekent, omdat er doekjes
         en flacons onder dezelfde naam vallen, laat de worker de omrekening
         weg. Dan tonen we de pakprijs groot: dat getal klopt altijd. */
      (o.perEenheid
        ? '<p class="bv-oreg"><b>'+eu(o.perEenheid)+'</b> per '+e(eh)+
            (goedkoper?' <span class="bv-owin">voordeligst</span>':'')+'</p>'
        : '<p class="bv-oreg"><b>'+eu(o.prijs)+'</b> voor de hele verpakking</p>')+
      '<p class="bv-ototaal">'+(o.perEenheid
          ? 'Grootverpakking: '+eu(o.prijs)+' voor '+e(String(Math.round(o.aantal*100)/100))+' '+e(mv)
          : e(String(Math.round(o.aantal*100)/100))+' '+e(mv)+' in de verpakking')+
        (o.vanprijs&&o.vanprijs>o.prijs?' <s>'+eu(o.vanprijs)+'</s>':'')+'</p>'+
      (o.titel?'<p class="bv-otitel">'+e(o.titel)+'</p>':'')+
      '<a class="bv-knop bestel" href="'+e(o.url)+'" target="_blank" rel="sponsored nofollow noopener">Bestel nu online →</a>'+
      (o.folderOok?'<p class="bv-ofolder">Staat deze week ook in de folder bij '+e(o.folderOok.winkelNaam)+
        (o.folderOok.perEenheid?' voor '+eu(o.folderOok.perEenheid)+' per '+e(eh):'')+
        (o.folderOok.geldigTot?', '+tot(o.folderOok.geldigTot):'')+'</p>':'')+
      '</div>'}

  /* In welke categorieen slaat de bezoeker in? Wasmiddel, huishoudelijke
     middelen en babyspullen koop je per grootverpakking en niet per week. Daar
     is de online bestelling de hoofdzaak en de folderaanbieding de bijzaak, dus
     daar draaien we de volgorde om. In de rest blijft de folder leidend: boter,
     kaas en frisdrank haal je bij de winkel om de hoek.
     De opbouw van de kaart blijft wel overal gelijk, met boven elk blok dezelfde
     kop, zodat je kunt scrollen en vergelijken zonder te zoeken waar de prijs
     staat. */
  var ONLINE_EERST = { 'Wasmiddel':1, 'Huishouden':1, 'Baby':1 };

  /* De folderaanbieding als een los blok, zodat die boven of onder het
     onlineblok kan staan zonder dat de inhoud verandert. */
  function folderBlok(x,d,eh,klein){
    return '<div class="bv-folder'+(klein?' bv-bijzaak':'')+'">'+
      '<p class="bv-okop">Deze week in de folder</p>'+
      prijsBlok(d,eh)+
      '<p class="bv-pe'+(d.perEenheid?'':' leeg')+'">'+(d.perEenheid?eu(d.perEenheid)+' per '+e(eh):(d.prijsPerStuk?'inhoud niet vermeld':'prijs checken in de winkel'))+'</p>'+
      eerderRegel(x,d,eh)+
      '<span class="bv-bij">'+wl(d.winkel,d.winkelNaam)+'<span class="bv-oms">'+e(d.omschrijving||d.actie||'')+'</span></span>'+
      herkomst(d)+
      /* Bij een lange winkelnaam past "Bekijk bij Albert Heijn" niet op een
         smal scherm. De winkel staat er vlak boven al, dus dan volstaat dit. */
      '<a class="bv-knop'+(d.prijsPerStuk?'':' check')+'" href="'+e(d.url)+'" target="_blank" rel="sponsored nofollow noopener">'+
        (d.dsoort==='weekfolder'?'Bekijk in de folder'
          :(d.prijsPerStuk?(String(d.winkelNaam||'').length>9?'Bekijk deal':'Bekijk bij '+e(d.winkelNaam)):'Prijs checken'))+'</a>'+
      /* Bij een winkel waar wij partner zijn kan de bezoeker meteen bestellen.
         De folderknop blijft staan, want daar ziet hij de actie zelf. Bij een
         lange winkelnaam laten we die naam uit de knop, anders wordt hij op een
         smal scherm afgekapt. */
      (d.bestelUrl&&d.bestelUrl!==d.url?'<a class="bv-knop bestel" href="'+e(d.bestelUrl)+'" target="_blank" rel="sponsored nofollow noopener">Bestel nu online'+
        (String(d.winkelNaam||'').length>6?'':' bij '+e(d.winkelNaam))+' →</a>':'')+
      '</div>'}

  /* 3 okt: de badge zei niet bij welk aanbod hij hoorde, en dat ging mis.
     Bij "Dettol (merkbrede actie)" stond -54% bovenaan de kaart. Dat was de
     allesreiniger van Dirk, maar omdat Huishouden in ONLINE_EERST staat, kwam
     daar direct het bol.com-blok onder: doekjes van €16,99, af van €17,97, en
     dat is 5 procent. Twee verschillende producten onder één percentage.

     Twee dingen veranderd. De badge noemt nu de winkel waar hij bij hoort, en
     staat het onlineblok bovenaan, dan hoort de badge bij dát aanbod en wordt
     hij uit de van-prijs van die winkel gerekend. Is er geen van-prijs, dan
     staat er geen percentage: liever niets dan een getal van elders. */
  function onlineKorting(o){
    if(!o||!(o.vanprijs>o.prijs))return 0;
    return Math.round((1-o.prijs/o.vanprijs)*100)}

  function kaart(x,i){
    var p=x.p, d=x.best, eh=p.eenheid||'stuk';
    var o0=(x.p.online||[])[0];
    var onlineBoven=!!(o0&&o0.url&&ONLINE_EERST[p.categorie]);
    var badge='';
    if(onlineBoven){
      var ok=onlineKorting(o0);
      if(ok>=3)badge='<span class="bv-badge">-'+ok+'% <b>'+e(o0.winkelNaam)+'</b></span>';
    } else if(d.k){
      badge='<span class="bv-badge'+(d.asoort==='gratis'?' gratis':'')+'">'+
        (d.asoort==='gratis'?e(d.actie):'-'+d.k+'%')+' <b>'+e(d.winkelNaam)+'</b></span>';
    }
    var anders=x.rest.length+x.elders.length;
    /* Alleen omdraaien als er ook echt iets online te bestellen is. Een lege
       kop boven een folderaanbieding maakt de kaart alleen verwarrender. */
    var online=onlineBlok(x,eh,d);
    var omgedraaid=!!online&&!!ONLINE_EERST[p.categorie];
    return '<article class="bv-k'+(omgedraaid?' bv-omgedraaid':'')+'" id="bvk-'+e(p.id)+'">'+badge+
      '<div class="bv-beeld">'+(p.afbeelding
        ?'<img src="'+e(p.afbeelding)+'" alt="'+e(p.naam)+'" loading="lazy" data-merk="'+e(p.merk||p.naam)+'" onerror="bvGeenFoto(this)">'
        :'<div class="bv-geenbeeld">'+e(p.merk||p.naam)+'</div>')+'</div>'+
      '<p class="bv-cat">'+e(p.categorie)+'</p>'+
      '<h3>'+e(p.naam)+(p.huismerk?'<span class="bv-hm">huismerk</span>':'')+'</h3>'+
      (omgedraaid ? online+folderBlok(x,d,eh,true) : folderBlok(x,d,eh,false)+online)+
      (anders?'<button type="button" class="bv-verg" aria-expanded="false" aria-controls="bvl-'+e(p.id)+'"><span>Ook bij '+anders+(anders===1?' andere winkel':' andere winkels')+'</span><i>▾</i></button>'+
        '<div class="bv-lijst" id="bvl-'+e(p.id)+'" hidden>'+lijst(x)+'</div>':'')+
      '</article>'}

  function lijst(x){
    var eh=x.p.eenheid||'stuk', h='';
    h+=x.rest.map(function(d){
      return '<a class="bv-lr" href="'+e(d.url)+'" target="_blank" rel="sponsored nofollow noopener">'+
        wl(d.winkel,d.winkelNaam)+
        '<span class="bv-lp">'+(d.prijsPerStuk?(d.groep?'vanaf ':'')+eu(d.prijsPerStuk)+(d.normaalprijs&&!d.groep&&d.normaalprijs>d.prijsPerStuk?'<s>'+eu(d.normaalprijs)+'</s>':''):'→')+'</span>'+
        '<span class="bv-lm">'+e(d.actie||'')+(d.perEenheid?' · <b>'+eu(d.perEenheid)+' per '+e(eh)+'</b>':'')+
        (soortDeal(d)?' · '+e(soortDeal(d).tekst).toLowerCase():'')+(d.geldigTot?' · '+tot(d.geldigTot):'')+
        (d.eerderPrijs!=null?' · <em>eerder '+eu(d.eerderPrijs)+'</em>':'')+'</span></a>'}).join('');
    if(x.elders.length){
      h+='<p class="bv-lkop">Normale prijs elders</p>'+x.elders.slice(0,6).map(function(y){
        var dt=y.datum?new Date(y.datum+'T12:00:00'):null;
        return '<a class="bv-lr normaal"'+(y.url?' href="'+e(y.url)+'" target="_blank" rel="sponsored nofollow noopener"':'')+'>'+
          wl(y.winkel,y.winkelNaam)+
          '<span class="bv-lp">'+eu(y.normaalprijs)+'</span>'+
          '<span class="bv-lm">'+(y.titel?e(y.titel):'geen actie')+(y.perEenheid?' · '+eu(y.perEenheid)+' per '+e(eh):'')+(dt?' · '+(y.nu?'gecheckt ':'gezien ')+dt.getDate()+' '+MND[dt.getMonth()]:'')+'</span></a>'}).join('')}
    return h}

  function teken(){
    var r=gefilterd(), g=document.getElementById('bv-grid');
    if(!r.length){
      g.innerHTML='<div class="bv-niets"><b>Niets gevonden</b><span>Geen aanbieding die aan deze filters voldoet. Wis een filter of zoek op een ander merk.</span></div>';
      document.getElementById('bv-meer').hidden=true;
      document.getElementById('bv-telling').innerHTML='0 producten';
    }else{
      /* Bij sorteren per schap een kop boven elke groep. Die kop is ook het
         ankerpunt waar de balk bovenin op meeleest tijdens het scrollen. */
      var zicht=r.slice(0,getoond);
      if(sort==='schap'){
        var vorige=null, h='';
        zicht.forEach(function(x,n){
          var c=x.p.categorie||'Overig';
          if(c!==vorige){
            h+='<h3 class="bv-schapkop" data-schap="'+e(c)+'">'+e(c)+'</h3>';
            vorige=c;
          }
          h+=kaart(x,n);
        });
        g.innerHTML=h;
      } else {
        g.innerHTML=zicht.map(kaart).join('');
      }
      var m=document.getElementById('bv-meer');
      m.hidden=r.length<=getoond;
      m.textContent='Toon '+Math.min(STAP*2,r.length-getoond)+' van de '+(r.length-getoond)+' overige producten';
      var w=0;r.forEach(function(x){w+=x.ds.length});
      document.getElementById('bv-telling').innerHTML=r.length+(r.length===1?' product':' producten')+' <span>· '+w+(w===1?' aanbieding':' aanbiedingen')+'</span>';
    }
    document.getElementById('bv-reset').hidden=!(winkel||actie||dsoort||categorie||vraag);
    plak();
    schapVolgen();
  }

  /* Uitklappen van de vergelijking gebeurt via het raster, dan blijft het werken
     na opnieuw tekenen. */
  document.getElementById('bv-grid').addEventListener('click',function(ev){
    var b=ev.target.closest('.bv-verg'); if(!b)return;
    var l=document.getElementById(b.getAttribute('aria-controls')); if(!l)return;
    var open=l.hidden; l.hidden=!open; b.setAttribute('aria-expanded',open?'true':'false');
    b.querySelector('span').textContent=open?'Verberg de andere winkels':b.querySelector('span').textContent;
    if(!open){var n=l.querySelectorAll('.bv-lr').length;b.querySelector('span').textContent='Ook bij '+n+(n===1?' andere winkel':' andere winkels')}
  });

  /* Welk schap staat er nu in beeld? De balk bovenaan plakt al vast tijdens
     het scrollen; dit zet de naam van het schap erin dat je op dat moment
     bekijkt. Zo weet je waar je bent zonder terug te scrollen.

     IntersectionObserver met een rootMargin die alles onder de balk wegsnijdt,
     dus de bovenste kop die nog zichtbaar is wint. Scroll-events zouden
     hetzelfde doen maar dan dertig keer per seconde. */
  var schapWijzer=null, schapKijker=null;
  function schapVolgen(){
    if(schapKijker){schapKijker.disconnect();schapKijker=null}
    var wijzer=document.getElementById('bv-nuschap');
    if(!wijzer)return;
    if(sort!=='schap'){wijzer.hidden=true;return}
    var koppen=[].slice.call(document.querySelectorAll('.bv-schapkop'));
    if(!koppen.length){wijzer.hidden=true;return}
    wijzer.hidden=false;
    wijzer.textContent=koppen[0].getAttribute('data-schap')||'';
    if(!('IntersectionObserver' in window))return;
    var bar=document.getElementById('bv-bar');
    /* 6 okt: de vaste balk is nu alleen de schapregel; reken met die hoogte, niet met het hele filterblok */
    var hoog=((typeof vaste!=='undefined'&&vaste&&vaste.length)?bovenrand():70)+72;
    var inBeeld={};
    schapKijker=new IntersectionObserver(function(rijen){
      rijen.forEach(function(r){inBeeld[r.target.getAttribute('data-schap')]=r.isIntersecting});
      /* de eerste kop die nog niet voorbij is, van boven naar beneden */
      for(var i=0;i<koppen.length;i++){
        var k=koppen[i];
        if(k.getBoundingClientRect().top<=hoog+1){
          wijzer.textContent=k.getAttribute('data-schap')||'';
        }
      }
    },{rootMargin:(-hoog)+'px 0px 0px 0px',threshold:[0,1]});
    koppen.forEach(function(k){schapKijker.observe(k)});
  }

  function chips(el,items,huidig,kies){
    el.innerHTML=items.map(function(it){
      return '<button type="button" data-v="'+e(it.v)+'"'+(it.v===huidig?' class="aan"':'')+'>'+(it.kleur?stip(it.kleur):'')+e(it.n)+(it.a?'<small>'+it.a+'</small>':'')+'</button>'}).join('');
    if(el.dataset.aan)return;
    el.dataset.aan='1';
    el.addEventListener('click',function(ev){var b=ev.target.closest('button');if(!b)return;
      kies(b.getAttribute('data-v')===huidigVan(el)?'':b.getAttribute('data-v'));});
  }
  function huidigVan(el){var a=el.querySelector('button.aan');return a?a.getAttribute('data-v'):''}

  function tekenChips(){
    var wc={},ac={},cc={};
    alles.forEach(function(x){
      var w={},s={};
      x.ds.forEach(function(d){w[d.winkel]=d.winkelNaam;s[d.asoort]=1});
      Object.keys(w).forEach(function(k){wc[k]=wc[k]||{n:w[k],a:0};wc[k].a++});
      Object.keys(s).forEach(function(k){ac[k]=(ac[k]||0)+1});
      cc[x.p.categorie]=(cc[x.p.categorie]||0)+1});
    var wl2=[{v:'',n:'Alle winkels',a:0}].concat(Object.keys(wc).sort(function(a,b){return wc[b].a-wc[a].a})
      .map(function(k){return {v:k,n:wc[k].n,a:wc[k].a,kleur:k}}));
    chips(document.getElementById('bv-cw'),wl2,winkel,function(v){winkel=v;getoond=STAP;tekenChips();teken()});
    var VOLG=['gratis','korting','halve','meer','prijs'];
    var al2=[{v:'',n:'Alle acties',a:0}].concat(VOLG.filter(function(k){return ac[k]}).map(function(k){return {v:k,n:SOORTNAAM[k],a:ac[k]}}));
    chips(document.getElementById('bv-ca'),al2,actie,function(v){actie=v;getoond=STAP;tekenChips();teken()});
    /* Zeventien schappen passen niet als knoppen: dan moet je zijwaarts scrollen
       en zie je maar een paar. Als keuzelijst staan ze er allemaal in. */
    var SOORTVOLG=['weekfolder','dag','weekend','website','webshop'];
    var SOORTKNOP={weekfolder:'Weekfolder',dag:'Dagaanbiedingen',weekend:'Weekend',website:'Van de website',webshop:'Webshop'};
    var sc={};
    alles.forEach(function(x){var g={};x.ds.forEach(function(d){g[d.dsoort]=1});Object.keys(g).forEach(function(k){sc[k]=(sc[k]||0)+1})});
    var sl=[{v:'',n:'Alle soorten',a:0}].concat(SOORTVOLG.filter(function(k){return sc[k]}).map(function(k){return {v:k,n:SOORTKNOP[k],a:sc[k]}}));
    chips(document.getElementById('bv-cs'),sl,dsoort,function(v){dsoort=v;getoond=STAP;tekenChips();teken()});
    var SCHAP=['Frisdrank','Water','Sappen','Bier','Koffie en thee','Zuivel en kaas','Ontbijt','Broodbeleg en sauzen','Houdbaar','Chips en snoep','Diepvries','Groente en fruit','Vlees en vis','Huishouden','Verzorging','Baby','Huisdier'];
    var ks=Object.keys(cc).sort(function(a,b){var i=SCHAP.indexOf(a),j=SCHAP.indexOf(b);return (i<0?99:i)-(j<0?99:j)});
    var sel=document.getElementById('bv-cc'), totaal=0;
    ks.forEach(function(k){totaal+=cc[k]});
    sel.innerHTML='<option value="">Alle schappen</option>'+
      ks.map(function(k){return '<option value="'+e(k)+'"'+(k===categorie?' selected':'')+'>'+e(k)+' ('+cc[k]+')</option>'}).join('');
    if(!sel.dataset.aan){sel.dataset.aan='1';
      sel.addEventListener('change',function(){categorie=sel.value;getoond=STAP;tekenChips();teken()})}
  }

  /* Weekfolder per winkel als knop in de filterbalk. Folders die op Publitas staan (en die van Dirk) mogen in een
     venster op onze pagina; de andere winkels staan dat niet toe en openen in een nieuw tabblad. */
  (function(){
    var FOLDERS=[
      ['ah','Albert Heijn','https://view.publitas.com/ah/',1],
      ['jumbo','Jumbo','https://www.jumbo.com/aanbiedingen',0],
      ['plus','PLUS','https://view.publitas.com/plus-folder-nl/',1],
      ['lidl','Lidl','https://www.lidl.nl/c/service-contact-folders/s10008124',0],
      ['aldi','Aldi','https://www.aldi.nl/aanbiedingen.html',0],
      ['dirk','Dirk','https://www.dirk.nl/folder',1],
      ['hoogvliet','Hoogvliet','https://folder.hoogvliet.com/',1],
      ['vomar','Vomar','https://view.publitas.com/folder-deze-week/',1],
      ['kruidvat','Kruidvat','https://view.publitas.com/kruidvat-nederland/',1],
      ['etos','Etos','https://view.publitas.com/etos/',1],
      ['trekpleister','Trekpleister','https://view.publitas.com/trekpleister/',1],
      ['da','DA','https://view.publitas.com/da-drogisterij/',1],
      ['action','Action','https://www.action.com/nl-nl/weekactie/',0]];
    var cf=document.getElementById('bv-cf'); if(!cf)return;
    cf.innerHTML=FOLDERS.map(function(f,i){
      return '<button type="button" class="bv-fk" data-i="'+i+'" aria-haspopup="'+(f[3]?'dialog':'false')+'">'+stip(f[0])+e(f[1])+(f[3]?'':' <small>\u2197</small>')+'</button>'}).join('');
    var venster=null, vorige=null;
    function dicht(){if(!venster)return;venster.remove();venster=null;document.documentElement.style.overflow='';if(vorige)try{vorige.focus()}catch(err){}}
    function open(f,knop){
      vorige=knop;
      venster=document.createElement('div');venster.className='bv-fo';venster.setAttribute('role','dialog');venster.setAttribute('aria-modal','true');venster.setAttribute('aria-label','Weekfolder '+f[1]);
      venster.innerHTML='<div class="bv-fo-vak"><div class="bv-fo-kop"><b>Weekfolder '+e(f[1])+'</b><a href="'+e(f[2])+'" target="_blank" rel="nofollow noopener">Nieuw tabblad<span> openen</span> \u2197</a><button type="button" aria-label="Sluiten">&times;</button></div><iframe title="Weekfolder '+e(f[1])+'" src="'+e(f[2])+'" referrerpolicy="no-referrer"></iframe></div>';
      document.body.appendChild(venster);document.documentElement.style.overflow='hidden';
      venster.addEventListener('click',function(ev){if(ev.target===venster||ev.target.closest('.bv-fo-kop button'))dicht()});
      venster.querySelector('button').focus();
    }
    document.addEventListener('keydown',function(ev){if(ev.key==='Escape')dicht()});
    cf.addEventListener('click',function(ev){var b=ev.target.closest('button');if(!b)return;
      var f=FOLDERS[+b.getAttribute('data-i')];
      try{if(window.gtag)gtag('event','bv_folder',{winkel:f[0]})}catch(err){}
      if(f[3])open(f,b);else window.open(f[2],'_blank','noopener')});
    var nf=document.getElementById('bv-naarfilters');
    if(nf)nf.addEventListener('click',function(){var h=document.getElementById('bv-barhouder');if(!h)return;
      var y=h.getBoundingClientRect().top+window.pageYOffset-140;window.scrollTo({top:Math.max(0,y),behavior:'smooth'})});
  })();

  /* De filterbalk zet zich vast zodra hij de bovenkant raakt. Het thema laat
     position:sticky niet toe, daarom meten we de vaste balken van het thema één
     keer en schuiven we er zelf onderlangs. */
  var raf=0, vaste=[], houder=document.getElementById('bv-barhouder'), bar=document.getElementById('bv-bar');
  function meet(){vaste=[];Array.prototype.forEach.call(document.querySelectorAll('body *'),function(el){
      if(el.closest&&el.closest('#bv'))return;var s=getComputedStyle(el);
      if(s.position!=='fixed'&&s.position!=='sticky')return;
      var r=el.getBoundingClientRect();
      if(r.top<300&&r.height<260&&r.width>window.innerWidth*0.5)vaste.push(el)})}
  function bovenrand(){var m=0;vaste.map(function(el){return el.getBoundingClientRect()})
      .filter(function(r){return r.bottom>0&&r.height>0}).sort(function(a,b){return a.top-b.top})
      .forEach(function(r){if(r.top<=m+5)m=Math.max(m,r.bottom)});return Math.round(m)}
  function plak(){raf=0;if(!houder||!bar)return;
    var hr=houder.getBoundingClientRect(), boven=bovenrand();
    var grid=document.getElementById('bv-grid'), gr=grid.getBoundingClientRect();
    var vast=hr.top<boven&&gr.bottom>boven+120;
    if(vast){if(!bar.classList.contains('bv-vast'))houder.style.height=bar.offsetHeight+'px';bar.classList.add('bv-vast');
      bar.style.top=boven+'px';bar.style.left=hr.left+'px';bar.style.width=hr.width+'px'}
    else{houder.style.height='';bar.classList.remove('bv-vast');bar.style.top=bar.style.left=bar.style.width=''}}
  window.addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(plak)},{passive:true});
  window.addEventListener('resize',function(){meet();plak()});
  setTimeout(function(){meet();plak()},1200);

  /* Zoeken doorzoekt ook de folders zelf, zodat je ook iets vindt dat niet bij
     een merk hoort dat wij per winkel volgen. Die treffers staan apart. */
  function brederZoeken(w){
    var blok=document.getElementById('bv-zoekextra'), lijst=document.getElementById('bv-zl');
    if(!w||w.length<2){blok.hidden=true;lijst.innerHTML='';return}
    fetch(API+'/sm/api/zoek?q='+encodeURIComponent(w)).then(function(r){return r.json()}).then(function(d){
      if(q.value.trim().toLowerCase()!==w)return;
      var los=(d.resultaten||[]).filter(function(x){return !x.product_id});
      blok.hidden=!los.length;
      lijst.innerHTML=los.slice(0,36).map(function(x){
        return '<a class="bv-wi"'+(x.url?' href="'+e(x.url)+'" target="_blank" rel="sponsored nofollow noopener"':'')+'>'+
          '<span class="bv-wn">'+e(x.titel)+'</span>'+
          '<span class="bv-wp">'+(x.prijs?eu(x.prijs):'')+'</span>'+
          '<span class="bv-wa">'+wl(x.winkel,x.winkelNaam)+e(nette(x.actie,x.prijs))+'</span></a>'}).join('');
    }).catch(function(){blok.hidden=true})}

  /* "voor 1.49" naast €1,49 herhaalt alleen de prijs; toon alleen een echte
     actie zoals 1+1 gratis, 2e halve prijs of een kortingspercentage. */
  function nette(a,p){a=String(a||'').trim();
    if(!a)return '';
    if(/^(voor|prijs|actieprijs|van)\b/i.test(a))return '';
    if(p&&a.replace(',','.').indexOf(String(p))>-1)return '';
    return a.charAt(0).toUpperCase()+a.slice(1)}

  var q=document.getElementById('bv-q'), wis=document.getElementById('bv-wis'), t;
  q.addEventListener('input',function(){clearTimeout(t);t=setTimeout(function(){
    vraag=q.value.trim().toLowerCase();wis.hidden=!vraag;getoond=STAP;teken();brederZoeken(vraag)},220)});
  wis.addEventListener('click',function(){q.value='';vraag='';wis.hidden=true;getoond=STAP;teken();brederZoeken('');q.focus()});
  document.getElementById('bv-zoekform').addEventListener('submit',function(ev){ev.preventDefault()});
  document.getElementById('bv-sort').addEventListener('change',function(){sort=this.value;getoond=STAP;teken()});
  document.getElementById('bv-meer').addEventListener('click',function(){getoond+=STAP*2;teken()});
  document.getElementById('bv-reset').addEventListener('click',function(){
    winkel=actie=dsoort=categorie=vraag='';q.value='';wis.hidden=true;getoond=STAP;tekenChips();teken();brederZoeken('');
    window.scrollTo({top:houder.offsetTop-90,behavior:'smooth'})});

  /* Dagdeals: acties die maar op één dag of alleen in het weekend gelden. */
  var DAGNAAM={ma:'maandag',di:'dinsdag',wo:'woensdag',do:'donderdag',vr:'vrijdag',za:'zaterdag',zo:'zondag',weekend:'weekend'};
  fetch(API+'/sm/api/dagdeals').then(function(r){return r.json()}).then(function(d){
    /* Bij Dirk en Hoogvliet staat de verpakking in een eigen regel ("Kuip 100
       tot 200 gram.", "VR, ZA & ZO actie"). Dat is geen aanbieding. */
    function rommel(t){t=String(t||'').trim();
      if(!t)return true;
      if(/^(kuip|bus|pak|fles|zak|doos|krat|blik|bakje|rol|set|emmer|beker|tray|stuk)\b[^a-z]*\d/i.test(t))return true;
      if(/^\d+([.,]\d+)?\s*(gram|gr|ml|liter|l|kg|stuks?)\b/i.test(t))return true;
      if(/^(ma|di|wo|do|vr|za|zo)[,\s&].*actie$/i.test(t))return true;
      return false}
    var lijst=(d.dagdeals||[]).filter(function(x){
      return !/verzending|bezorging/i.test(x.actie||'')&&!/acties$|^dag- en weekend/i.test(x.titel||'')&&!rommel(x.titel)});
    if(!lijst.length)return;
    var volg=['ma','di','wo','do','vr','za','zo','weekend'], vandaag=['zo','ma','di','wo','do','vr','za'][new Date().getDay()];
    var dagen=volg.filter(function(k){return lijst.some(function(x){return x.dag===k})});
    var open=dagen.indexOf(vandaag)>-1?vandaag:((['za','zo','vr'].indexOf(vandaag)>-1&&dagen.indexOf('weekend')>-1)?'weekend':dagen[0]);
    var dt=document.getElementById('bv-dt'), dl=document.getElementById('bv-dl'), ma=maandag(d.week||'');
    var idx={ma:0,di:1,wo:2,do:3,vr:4,za:5,zo:6};
    function toon(){
      dt.innerHTML=dagen.map(function(k){var n=lijst.filter(function(x){return x.dag===k}).length, lab;
        if(k==='weekend')lab='Weekend';
        else lab=(k===vandaag?'Vandaag':DAGNAAM[k].charAt(0).toUpperCase()+DAGNAAM[k].slice(1)+' '+plusD(ma,idx[k]).getUTCDate()+' '+MND[plusD(ma,idx[k]).getUTCMonth()]);
        return '<button type="button" role="tab" data-d="'+k+'"'+(k===open?' class="aan"':'')+'>'+e(lab)+'<small>'+n+'</small></button>'}).join('');
      dl.innerHTML=lijst.filter(function(x){return x.dag===open})
        .sort(function(a,b){return (a.prijs||9e9)-(b.prijs||9e9)}).slice(0,12).map(function(x){
        var act=nette(x.actie,x.prijs);
        return '<a class="bv-dr"'+(x.url?' href="'+e(x.url)+'" target="_blank" rel="sponsored nofollow noopener"':'')+'>'+
          wl(x.winkel,x.winkelNaam)+
          '<span class="bv-dn">'+e(x.titel)+(act?'<i>'+e(act)+'</i>':'')+'</span>'+
          '<span class="bv-dp">'+(x.prijs?eu(x.prijs):'→')+'</span></a>'}).join('')}
    dt.addEventListener('click',function(ev){var b=ev.target.closest('button');if(!b)return;open=b.getAttribute('data-d');toon()});
    toon(); document.getElementById('bv-dag').hidden=false;
  }).catch(function(){});

  /* Alles uit de folder: per winkel alles wat we binnenkregen. Dit blok stond
     er eerder ook, maar toen zonder prijs per eenheid en zonder de stap naar de
     vergelijking, en dan zegt een rij prijzen inderdaad weinig. */
  (function(){
    var at=document.getElementById('bv-at'), al=document.getElementById('bv-al'),
        af=document.getElementById('bv-af'), am=document.getElementById('bv-ameer');
    var huidig='', aantal=30, opslag={};
    function nette(a,p){a=String(a||'').trim();
      if(!a)return '';
      if(/^(voor|prijs|actieprijs|van)\b/i.test(a))return '';
      if(p&&a.replace(',','.').indexOf(String(p))>-1)return '';
      return a.charAt(0).toUpperCase()+a.slice(1)}
    function toon(d){
      var r=d.aanbiedingen||[];
      af.innerHTML=d.folder?'<a href="'+e(d.folder)+'" target="_blank" rel="nofollow noopener">Bekijk de hele folder bij '+e(d.naam)+' \u2192</a>':'';
      al.innerHTML=r.slice(0,aantal).map(function(x){
        var act=nette(x.actie,x.prijs);
        return '<a class="bv-ai"'+(x.url?' href="'+e(x.url)+'" target="_blank" rel="sponsored nofollow noopener"':'')+'>'+
          '<span class="bv-an">'+e(x.titel)+'</span>'+
          '<span class="bv-ap">'+(x.prijs?eu(x.prijs):'')+
            (x.normaalprijs&&x.normaalprijs>x.prijs?' <s class="bv-aw">'+eu(x.normaalprijs)+'</s>':'')+'</span>'+
          (act?'<span class="bv-aa">'+e(act)+'</span>':'')+
          (x.perEenheid?'<span class="bv-ae">'+eu(x.perEenheid)+' per '+e(x.eenheid||'stuk')+'</span>':'')+
          (x.product_id?'<span class="bv-avgl" data-p="'+e(x.product_id)+'">Vergelijk '+e(x.productNaam||'')+' bij alle winkels \u2193</span>':'')+
          '</a>'}).join('');
      am.hidden=r.length<=aantal; am.textContent='Toon de overige '+(r.length-aantal)+' aanbiedingen'}
    function kies(w){
      huidig=w; aantal=30;
      Array.prototype.forEach.call(at.children,function(b){b.classList.toggle('aan',b.getAttribute('data-w')===w)});
      if(opslag[w])return toon(opslag[w]);
      al.innerHTML='<p class="bv-leeg">Laden\u2026</p>';
      fetch(API+'/sm/api/winkel?w='+encodeURIComponent(w)).then(function(r){return r.json()}).then(function(j){
        if(j&&j.ok){opslag[w]=j;if(huidig===w)toon(j)}})}
    al.addEventListener('click',function(ev){
      var k=ev.target.closest('.bv-avgl'); if(!k)return;
      ev.preventDefault(); ev.stopPropagation();
      var kaart=document.getElementById('bvk-'+k.getAttribute('data-p'));
      if(kaart){try{kaart.scrollIntoView({behavior:'smooth',block:'center'})}catch(err){}
        kaart.style.outline='2px solid #10b981'; kaart.style.outlineOffset='3px';
        setTimeout(function(){kaart.style.outline=''},2200)}});
    fetch(API+'/sm/api/winkels').then(function(r){return r.json()}).then(function(j){
      if(!j||!j.ok||!j.winkels.length)return;
      at.innerHTML=j.winkels.map(function(w){
        return '<button type="button" role="tab" data-w="'+e(w.winkel)+'">'+stip(w.winkel)+e(w.naam)+'<small>'+w.aantal+'</small></button>'}).join('');
      at.addEventListener('click',function(ev){var b=ev.target.closest('button');if(b)kies(b.getAttribute('data-w'))});
      am.addEventListener('click',function(){aantal=9999;toon(opslag[huidig])});
      document.getElementById('bv-alles').hidden=false;
      kies(j.winkels[0].winkel);
    }).catch(function(){});
  })();

  /* Weekfolders: alleen een knop per winkel naar hun eigen folder. Alles per
     winkel uitschrijven zei weinig, want zonder vergelijking weet je niet of
     zo'n prijs goed is. Filteren op winkel kan hierboven al. */
  (function(){
    /* De folders komen uit de worker, die weet ook of de folder van volgende
       week er al staat. Lukt dat niet, dan vallen we terug op de vaste lijst,
       zodat de knoppen er altijd staan. */
    fetch(API+'/sm/api/folders').then(function(r){return r.json()}).then(function(j){
      if(!j||!j.ok||!j.winkels)return;
      var deze=j.winkels.filter(function(w){return w.deze});
      if(deze.length)document.getElementById('bv-fl').innerHTML=deze.map(function(w){
        return '<a href="'+e(w.deze)+'" target="_blank" rel="nofollow noopener">'+stip(w.winkel)+e(w.naam)+'</a>'}).join('');
      var later=j.winkels.filter(function(w){return w.volgende});
      document.getElementById('bv-fvolgende').hidden=!later.length;
      document.getElementById('bv-fv').innerHTML=later.map(function(w){
        return '<a href="'+e(w.volgende)+'" target="_blank" rel="nofollow noopener">'+stip(w.winkel)+e(w.naam)+'</a>'}).join('');
    }).catch(function(){});

    var FOLDER=[
      ['ah','Albert Heijn','https://www.ah.nl/bonus'],
      ['jumbo','Jumbo','https://www.jumbo.com/aanbiedingen'],
      ['plus','PLUS','https://www.plus.nl/aanbiedingen'],
      ['dirk','Dirk','https://www.dirk.nl/folder'],
      ['lidl','Lidl','https://www.lidl.nl/c/folder/s10007813'],
      ['aldi','Aldi','https://www.aldi.nl/aanbiedingen.html'],
      ['hoogvliet','Hoogvliet','https://folder.hoogvliet.com/'],
      ['vomar','Vomar','https://www.vomar.nl/folder'],
      ['kruidvat','Kruidvat','https://www.kruidvat.nl/acties'],
      ['etos','Etos','https://www.etos.nl/aanbiedingen/'],
      ['da','DA','https://www.da.nl/aanbiedingen'],
      ['trekpleister','Trekpleister','https://www.trekpleister.nl/acties'],
      ['action','Action','https://www.action.com/nl-nl/weekactie/']];
    document.getElementById('bv-fl').innerHTML=FOLDER.map(function(f){
      return '<a href="'+e(f[2])+'" target="_blank" rel="nofollow noopener">'+stip(f[0])+e(f[1])+'</a>'}).join('');
  })();

  /* Kom je vanuit de zoekhulp binnen met ?zoek=sanex, dan staat die term hier
     meteen ingevuld en is het raster er al op gefilterd. */
  try{
    var vanUrl=new URLSearchParams(location.search).get('zoek');
    if(vanUrl){q.value=vanUrl;vraag=vanUrl.trim().toLowerCase();wis.hidden=!vraag}
  }catch(err){}

  function weekErna(w){var m=/^(\d{4})-W(\d{1,2})$/.exec(String(w||''));if(!m)return null;
    var n=+m[2]+1;return m[1]+'-W'+(n<10?'0'+n:''+n)}
  function toonWeek(d){
    D=d; alles=bouw(d);
    var ma=maandag(d.week), zo=plusD(ma,6);
    document.getElementById('bv-wk').textContent='Aanbiedingen van maandag '+ma.getUTCDate()+
      (ma.getUTCMonth()!==zo.getUTCMonth()?' '+MNDLANG[ma.getUTCMonth()]:'')+' tot en met zondag '+zo.getUTCDate()+' '+MNDLANG[zo.getUTCMonth()];
    var deals=0, wk={};
    alles.forEach(function(x){deals+=x.ds.length;x.ds.forEach(function(dd){wk[dd.winkel]=1})});
    document.getElementById('bv-cijfers').innerHTML=
      '<div class="bv-c"><b>'+alles.length+'</b><span>producten</span></div>'+
      '<div class="bv-c"><b>'+deals+'</b><span>aanbiedingen</span></div>'+
      '<div class="bv-c"><b>'+Object.keys(wk).length+'</b><span>winkels</span></div>';
    /* Coolblue: alleen exact hetzelfde apparaat. */
    if(d.coolblue&&d.coolblue.length){
      document.getElementById('bv-cb-blok').hidden=false;
      document.getElementById('bv-cb').innerHTML=d.coolblue.map(function(c){
        var cbGoedkoper=c.prijs&&c.cbPrijs<c.prijs;
        return '<div class="bv-cbk"><h3>'+e(c.titel)+'</h3>'+
          '<div class="bv-cbr"><span>'+wl(c.winkel,c.winkelNaam)+'<small>'+e(c.actie||'aanbieding')+'</small></span>'+
          '<span><b>'+(c.prijs?eu(c.prijs):'prijs checken')+'</b>'+(c.prijs&&!cbGoedkoper?'<span class="g">goedkoopst</span>':'')+'</span></div>'+
          '<a class="bv-cbr" href="'+e(c.cbUrl)+'" target="_blank" rel="sponsored nofollow noopener">'+
          '<span><span class="bv-wl" style="background:#0090E3;color:#fff">Coolblue</span><small>'+e(c.cbNaam)+'</small></span>'+
          '<span><b>'+eu(c.cbPrijs)+'</b>'+(cbGoedkoper?'<span class="g">goedkoopst</span>':'')+'</span></a></div>'}).join('')}
    tekenChips(); teken();
  }

  /* Schakelen tussen deze en volgende week. De data per week bewaren we, zodat
     heen en weer klikken niets opnieuw ophaalt. */
  function laadWeek(welke){
    var sleutel=weekKeys[welke];
    if(cache[welke]){welkeWeek=welke;toonWeek(cache[welke]);vooruitMelding();return}
    document.getElementById('bv-grid').innerHTML='<p class="bv-leeg">Laden\u2026</p>';
    fetch(API+'/sm/api/deals'+(sleutel?'?week='+encodeURIComponent(sleutel):'')).then(function(r){return r.json()}).then(function(d){
      cache[welke]=d;welkeWeek=welke;toonWeek(d);vooruitMelding()}).catch(function(){
      document.getElementById('bv-grid').innerHTML='<p class="bv-leeg">Kon de aanbiedingen niet laden. Probeer het zo nog eens.</p>'});
  }
  function telVan(d){return d&&d.producten?d.producten.filter(function(p){return p.deals&&p.deals.length}).length:0}
  function vooruitMelding(){
    var p=document.getElementById('bv-vooruit');
    if(welkeWeek!=='volgende'){p.hidden=true;return}
    var d=cache.volgende;
    var ws={};(d&&d.producten||[]).forEach(function(x){(x.deals||[]).forEach(function(y){ws[y.winkelNaam]=1})});
    var namen=Object.keys(ws);
    p.hidden=false;
    p.innerHTML=namen.length
      ? '<b>Nog niet compleet.</b> Van '+e(namen.join(', '))+' weten we het al. De andere winkels publiceren hun folder later deze week, dan vullen we aan.'
      : '<b>Nog niets bekend.</b> Geen enkele winkel heeft de folder van volgende week al online gezet. Meestal gebeurt dat vanaf donderdag.';
  }
  document.getElementById('bv-weken').addEventListener('click',function(ev){
    var b=ev.target.closest('button'); if(!b)return;
    var welke=b.getAttribute('data-w'); if(welke===welkeWeek)return;
    Array.prototype.forEach.call(this.children,function(x){x.classList.toggle('aan',x===b)});
    winkel=actie=dsoort=categorie=''; getoond=STAP;
    laadWeek(welke);
  });

  fetch(API+'/sm/api/deals').then(function(r){return r.json()}).then(function(d){
    cache.deze=d; weekKeys.deze=d.week; weekKeys.volgende=weekErna(d.week);
    toonWeek(d);
    if(vraag){brederZoeken(vraag);
      try{document.getElementById('bv-grid').scrollIntoView({behavior:'smooth',block:'start'})}catch(err){}}
    /* Alleen een schakelaar tonen als er van volgende week echt iets is. */
    if(weekKeys.volgende)fetch(API+'/sm/api/deals?week='+encodeURIComponent(weekKeys.volgende))
      .then(function(r){return r.json()}).then(function(v){
        var n=telVan(v); if(!n)return;
        cache.volgende=v;
        document.getElementById('bv-wk1').textContent=telVan(d)+' producten';
        document.getElementById('bv-wk2').textContent=n+' producten';
        document.getElementById('bv-weken').hidden=false;
      }).catch(function(){});
  }).catch(function(){
    document.getElementById('bv-grid').innerHTML='<p class="bv-leeg">Kon de aanbiedingen niet laden. Probeer het zo nog eens.</p>'});
})();
</script>

