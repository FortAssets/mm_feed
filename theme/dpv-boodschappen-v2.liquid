  "name": "Boodschappen raster",
  "settings": [
    { "type": "text", "id": "api", "label": "Adres van de boodschappenworker", "default": "https://dpv-boodschappen.business-347.workers.dev" },
    { "type": "text", "id": "titel", "label": "Titel", "default": "Welk merk is deze week waar in de aanbieding?" },
    { "type": "textarea", "id": "intro", "label": "Intro onder de titel", "default": "A-merken en huismerken naast elkaar bij Albert Heijn, Jumbo, PLUS, Dirk, Lidl, Aldi, Vomar, Hoogvliet, Kruidvat, Etos, DA, Trekpleister en Action. Omgerekend naar de prijs per liter, kilo of stuk, zodat 1+1 gratis en 25 procent korting eerlijk te vergelijken zijn." }
  ]
}
