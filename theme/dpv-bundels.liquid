{%- comment -%}
  21 okt 2026: sim only en internet thuis in dezelfde stijl als de telefoonvergelijker.

  Bovenaan tabs per datategoed (sim only) of per snelheid (internet). Daaronder per aanbieding een rij:
  de maandprijs groot, een tijdelijke actieprijs apart met de prijs daarna, en het totaal
  (sim only: over 24 maanden; internet: het eerste jaar, inclusief eenmalige kosten).

  Wat we met de feeds doen:
  - Sim only: aanbiedingen via Mobiel.nl tonen we onder het merk (Simpel, Lebara), niet onder Mobiel.nl.
    Bij een actie is `price` in de feed het gemiddelde; wij tonen de actieprijs en de prijs daarna.
    Regels met een toestel erbij of zonder bekende data laten we weg. Gelijke bundels van hetzelfde merk
    (zelfde data, minuten en looptijd) tonen we een keer, met het laagste totaal.
  - Internet: Odido staat twee keer in de feed (Odido Thuis via Awin met honderden varianten en
    verkeerde snelheden, en Odido uit onze eigen lijst). Is de eigen lijst er, dan laten we Odido Thuis weg.
    Snelheden als 1, 2 of 8 bij een Gbit-pakket rekenen we om naar Mbit/s. Pakketten met en zonder
    "Bellen basis" voor dezelfde prijs tonen we een keer. Een actie die alleen in de omschrijving staat
    ("6 maanden 34,95 p.m.") tonen we als actie; de prijs daarna staat dan niet in de feed.
  Alle bedragen inclusief btw. Wij vergelijken op feitelijke kenmerken en geven geen advies.
{%- endcomment -%}
<div class="bvg" id="vergelijker" data-id="{{ section.id }}" data-soort="{{ section.settings.soort }}" data-worker="{{ section.settings.worker_url }}">
  <div class="bvg-kop">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="bvg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="bvg-h">{{ section.settings.kop }}</h2>
      {%- if section.settings.sub != blank -%}<p class="bvg-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    {%- if section.settings.zakelijk_url != blank -%}<a class="bvg-zak" href="{{ section.settings.zakelijk_url }}">{{ section.settings.zakelijk_label }}</a>{%- endif -%}
  </div>
  <div class="bvg-tabs" role="group" aria-label="{% if section.settings.soort == 'internet' %}Snelheid{% else %}Datategoed{% endif %}"></div>
  <div class="bvg-fil"></div>
  <div class="bvg-mbar"></div>
  <div class="bvg-pills"></div>
  <p class="bvg-tel" aria-live="polite">Prijzen laden…</p>
  <ul class="bvg-lijst"></ul>
  <div class="bvg-meer"></div>
  {%- if section.settings.uitleg != blank -%}
  <div class="bvg-uitleg">
    {%- if section.settings.uitleg_kop != blank -%}<h3>{{ section.settings.uitleg_kop }}</h3>{%- endif -%}
    {{ section.settings.uitleg }}
  </div>
  {%- endif -%}
  {%- if section.settings.fijn != blank -%}<p class="bvg-fijn">{{ section.settings.fijn }}</p>{%- endif -%}
  <div class="bvg-sheet" hidden></div>
</div>

<style>
.bvg{--ink:#0D1B2A;--soft:#5B6B80;--line:#E6EBF2;--vlak:#F6F8FB;--groen:#10b981;--groenD:#0b7d5c;--groenL:#E3F3EA;--blauw:#1B3FA0;--blauwL:#EEF2FB;--geel:#F9C31F;--oranje:#B45309;--oranjeL:#FFF8DD;
 font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);max-width:1080px;margin:0 auto;padding:10px 16px 46px}
.bvg *{box-sizing:border-box}
.bvg :focus-visible{outline:3px solid var(--groen);outline-offset:2px}
.bvg-kop{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 18px}
.bvg-eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--blauw);font-weight:800;margin:0 0 6px}
.bvg .bvg-h{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:29px;line-height:1.08;letter-spacing:-.03em;font-weight:800;margin:0 0 8px}
.bvg-sub{font-size:15.5px;line-height:1.6;color:var(--soft);margin:0;max-width:64ch}
.bvg a.bvg-zak,.bvg a.bvg-zak:visited{font-size:14px;font-weight:700;color:var(--blauw) !important;text-decoration:underline}
.bvg-tabs{display:grid;grid-template-columns:repeat(var(--n,5),minmax(0,1fr));gap:8px;margin:0 0 12px}
.bvg-tabs button{min-height:58px;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:12px;padding:8px 10px;font:inherit;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;text-align:center}
.bvg-tabs button b{font-size:15px;font-weight:700;line-height:1.2}
.bvg-tabs button small{font-size:12px;color:var(--soft)}
.bvg-tabs button[aria-pressed="true"]{border:2px solid var(--blauw);background:var(--blauw);color:#fff}
.bvg-tabs button[aria-pressed="true"] small{color:#fff;opacity:.85}
.bvg-tabs button:disabled{opacity:.45;cursor:default}
.bvg-fil{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 14px}
.bvg-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:#fff;border-radius:99px;padding:7px 13px;font:inherit;font-size:13px;font-weight:700;color:var(--ink);cursor:pointer;min-height:36px;white-space:nowrap}
.bvg-chip[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:#fff}
.bvg-sp{flex-grow:1}
.bvg-fl{font-size:13px;color:var(--soft);display:flex;align-items:center;gap:8px}
.bvg-sel{min-height:36px;border:1px solid var(--line);border-radius:10px;padding:0 10px;font:inherit;font-size:13px;font-weight:600;color:var(--ink);background:#fff;max-width:100%}
.bvg-tel{font-size:14px;color:var(--soft);margin:0 0 12px}.bvg-tel b{color:var(--ink)}
.bvg-lijst{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
.bvg-r{display:grid;grid-template-columns:44px minmax(0,1fr) 200px 130px 104px;grid-template-areas:"l n p t k";gap:16px;align-items:center;padding:14px 18px;border:1px solid var(--line);border-radius:14px;background:#fff}
.bvg-r.top{border:2px solid var(--groen);padding:13px 17px}
.bvg-logo{grid-area:l;width:44px;height:44px;object-fit:contain;border-radius:11px;background:#fff;border:1px solid var(--line);padding:5px}
.bvg-logo-tekst{display:inline-flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:var(--blauw);background:var(--blauwL);border:0}
.bvg-n{grid-area:n;min-width:0;display:flex;flex-direction:column;gap:6px}
.bvg-nt{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.bvg-gb{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;line-height:1.1}
.bvg-pv{font-size:15px;font-weight:600}
.bvg-c{display:flex;gap:6px;flex-wrap:wrap}
.bvg-c span{font-size:12px;font-weight:600;padding:3px 8px;border-radius:6px;background:var(--vlak);color:var(--soft)}
.bvg-c span.tv{background:var(--blauwL);color:var(--blauw);font-weight:700}
.bvg-p{grid-area:p;display:flex;flex-direction:column;gap:3px;align-items:flex-end;text-align:right}
.bvg-pm{display:flex;align-items:baseline;gap:4px}
.bvg-pm b{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:28px;font-weight:800;line-height:1}
.bvg-pm i{font-style:normal;font-size:13px;color:var(--soft)}
.bvg-act{font-size:11px;font-weight:800;padding:2px 7px;border-radius:99px;background:var(--oranjeL);color:var(--oranje);align-self:center}
.bvg-p small{font-size:12px;color:var(--soft);line-height:1.35}
.bvg-p small.al{color:var(--oranje);font-weight:700}
.bvg-p small.g0{color:var(--groenD);font-weight:700}
.bvg-t{grid-area:t;display:flex;flex-direction:column;gap:3px;align-items:flex-end;text-align:right}
.bvg-t small{font-size:12px;color:var(--soft)}
.bvg-t b{font-size:16px;font-weight:700}
.bvg-lab{font-size:11px;font-weight:800;padding:2px 7px;border-radius:99px;background:var(--groenL);color:var(--groenD)}
.bvg a.bvg-go,.bvg a.bvg-go:visited{grid-area:k;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;background:var(--geel);color:var(--ink) !important;border:1.5px solid var(--ink);border-radius:10px;font-size:14px;font-weight:800;text-decoration:none !important;white-space:nowrap}
.bvg a.bvg-go:hover{background:#EDB50C}
.bvg-meer{display:flex;justify-content:center;margin:14px 0 0}
.bvg-meer button{min-height:44px;padding:0 20px;border-radius:10px;border:1.5px solid var(--blauw);background:#fff;color:var(--blauw);font:inherit;font-size:14px;font-weight:800;cursor:pointer}
.bvg-leeg{border:1px dashed var(--line);border-radius:14px;padding:34px;text-align:center;color:var(--soft);font-size:14px}
.bvg-leeg button{margin-top:10px}
.bvg-uitleg{margin:26px 0 0;background:var(--vlak);border-radius:14px;padding:18px 20px;font-size:14.5px;line-height:1.6}
.bvg-uitleg h3{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:18px;margin:0 0 6px}
.bvg-uitleg p{margin:0 0 8px}.bvg-uitleg p:last-child{margin:0}
.bvg-fijn{font-size:12px;color:var(--soft);margin:14px 0 0;line-height:1.5}
.bvg .dpvmb{display:none !important}
/* 21 okt: op mobiel een knop Filters met een paneel van onderaf (desktop houdt de rij filters) */
.bvg-mbar,.bvg-pills{display:none}
.bvg-fk,.bvg-ms{flex:1 1 0;min-width:0;min-height:44px;border-radius:10px;font:inherit;font-size:14px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:8px}
.bvg-fk{border:1.5px solid var(--ink);background:var(--ink);color:#fff;cursor:pointer}
.bvg-ms{position:relative;border:1px solid var(--line);background:#fff;color:var(--ink)}
.bvg-ms select{position:absolute;inset:0;opacity:0;width:100%;font-size:16px;cursor:pointer}
.bvg-ms span:after{content:'';display:inline-block;width:7px;height:7px;border:solid var(--ink);border-width:0 2px 2px 0;transform:rotate(45deg);margin:0 0 3px 8px}
.bvg-pill{display:inline-flex;align-items:center;gap:6px;min-height:32px;border:0;border-radius:99px;padding:0 11px;background:var(--blauwL);color:var(--blauw);font:inherit;font-size:12.5px;font-weight:700;cursor:pointer}
.bvg-pill i{font-style:normal;font-size:15px;line-height:1}
.bvg-sheet{--ink:#0D1B2A;--soft:#5B6B80;--line:#E6EBF2;--blauw:#1B3FA0;position:fixed;inset:0;z-index:2147483000}
.bvg-sheet *{box-sizing:border-box}
.bvg-sheet :focus-visible{outline:3px solid #10b981;outline-offset:2px}
.bvg-sheet[hidden]{display:none}
.bvg-bd{position:absolute;inset:0;background:rgba(13,27,42,.45)}
/* het thema verbergt lege div's (div:empty), dus expliciet tonen */
.bvg-sheet .bvg-bd,.bvg-sheet .bvg-grip{display:block}
.bvg-pan{position:absolute;left:0;right:0;bottom:0;max-height:86vh;display:flex;flex-direction:column;background:#fff;border-radius:20px 20px 0 0;box-shadow:0 -8px 30px rgba(13,27,42,.18);font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink)}
.bvg-grip{width:40px;height:4px;border-radius:4px;background:var(--line);margin:10px auto 0}
.bvg-pk{display:flex;align-items:center;justify-content:space-between;padding:6px 16px 4px}
.bvg-pk h3{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;margin:0}
.bvg-pk button{min-height:44px;border:0;background:none;font:inherit;font-size:14px;font-weight:700;color:var(--blauw);cursor:pointer;padding:0 4px}
.bvg-pb{overflow-y:auto;-webkit-overflow-scrolling:touch;padding:4px 16px 8px;display:flex;flex-direction:column;gap:16px}
.bvg-gr{display:flex;flex-direction:column;gap:8px}
.bvg-gr>b{font-size:13.5px;font-weight:800}
.bvg-gr div{display:flex;gap:6px;flex-wrap:wrap}
.bvg-gr button{min-height:40px;padding:0 14px;border-radius:99px;border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;font-size:13.5px;font-weight:700;cursor:pointer}
.bvg-gr button[aria-pressed="true"]{border-color:var(--ink);background:var(--ink);color:#fff}
.bvg-pv{padding:12px 16px calc(12px + env(safe-area-inset-bottom));border-top:1px solid var(--line)}
.bvg-pv button{width:100%;min-height:50px;border:0;border-radius:12px;background:var(--blauw);color:#fff;font:inherit;font-size:15px;font-weight:800;cursor:pointer}
@media(max-width:900px){
 .bvg-tabs{grid-template-columns:repeat(var(--nm,3),minmax(0,1fr));gap:6px}
 .bvg-tabs button{min-height:50px;padding:6px 4px}
 .bvg-tabs button b{font-size:13.5px}
 .bvg-tabs button small{font-size:11px}
 .bvg-fil{display:none}
 .bvg-mbar{display:flex;gap:8px;margin:0 0 10px}
 .bvg-pills{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px}
 .bvg-pills:empty{display:none}
 .bvg-r{grid-template-columns:40px minmax(0,1fr) auto;grid-template-areas:"l n k" "p p t";column-gap:12px;row-gap:10px;padding:14px}
 .bvg-c{gap:4px}.bvg-c span{font-size:11px;padding:2px 6px}
 .bvg-nt{gap:6px}
 .bvg-r.top{padding:13px}
 .bvg-logo{width:40px;height:40px}
 .bvg-p{align-items:flex-start;text-align:left;border-top:1px solid var(--line);padding-top:10px}
 .bvg-t{border-top:1px solid var(--line);padding-top:10px;align-self:stretch;justify-content:flex-start}
 .bvg-pm b{font-size:26px}
 .bvg-gb{font-size:18px}
 .bvg a.bvg-go{min-width:84px}
}
</style>

<script>
(function () {
  var w = document.querySelector('.bvg[data-id="{{ section.id }}"]');
  if (!w) return;
  var SOORT = w.getAttribute('data-soort') === 'internet' ? 'internet' : 'simonly';
  var SIM = SOORT === 'simonly';
  var WORKER = w.getAttribute('data-worker') || 'https://awin.business-347.workers.dev';
  var TIERS = SIM
    ? [['t7', 'Tot 7 GB'], ['t8', '8 tot 19 GB'], ['t20', '20 tot 49 GB'], ['t50', '50 GB of meer'], ['tob', 'Onbeperkt']]
    : [['s0', 'Tot 100 Mbit/s'], ['s1', '100 tot 500 Mbit/s'], ['s5', '500 tot 1000 Mbit/s'], ['g1', '1 Gbit/s of meer']];
  var STAP = 10;
  var ALLES = [], TIER = '', SORT = 'totaal', TOON = STAP;
  var F = { bellen: false, net: '', mnd: 0, vast: false, actie: false, tv: 'zonder', type: '', max: 0 };
  var OPEN = false, FOCUS = '';
  try {
    var q = new URLSearchParams(location.search), qt = q.get(SIM ? 'bundel' : 'snelheid');
    if (qt && TIERS.some(function (t) { return t[0] === qt; })) TIER = qt;
  } catch (e) {}

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function euro(v) {
    if (!v && v !== 0) return '';
    var r = Math.round(v * 100) / 100;
    return '€' + (r % 1 === 0 ? r.toFixed(0) : r.toFixed(2).replace('.', ','));
  }
  function num(v) { var n = parseFloat(v); return isFinite(n) ? n : 0; }

  var DOM = [['kpn', 'kpn.com'], ['odido', 'odido.nl'], ['vodafone', 'vodafone.nl'], ['ziggo', 'ziggo.nl'], ['simyo', 'simyo.nl'],
    ['hollandsnieuwe', 'hollandsnieuwe.nl'], ['youfone', 'youfone.nl'], ['simpel', 'simpel.nl'], ['50+', '50plusmobiel.nl'], ['50plus', '50plusmobiel.nl'],
    ['lebara', 'lebara.nl'], ['lyca', 'lycamobile.nl'], ['budget', 'budgetthuis.nl'], ['online.nl', 'online.nl'], ['delta', 'delta.nl'], ['tele2', 'tele2.nl'],
    ['robin', 'robinmobile.nl'], ['scarlet', 'scarlet.nl'], ['caiway', 'caiway.nl'], ['ben', 'ben.nl']];
  function logo(prov) {
    var p = String(prov || '').toLowerCase(), dom = '';
    for (var i = 0; i < DOM.length; i++) if (DOM[i][0] === 'ben' ? /^ben\b/.test(p) : p.indexOf(DOM[i][0]) > -1) { dom = DOM[i][1]; break; }
    if (!dom) return '<span class="bvg-logo bvg-logo-tekst" aria-hidden="true">' + esc(String(prov || '?').charAt(0).toUpperCase()) + '</span>';
    var g = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&size=64&url=https://' + dom;
    var d = 'https://icons.duckduckgo.com/ip3/' + dom + '.ico';
    return '<img class="bvg-logo" src="' + g + '" alt="" loading="lazy" width="44" height="44" onerror="if(this.dataset.fb){this.style.visibility=\'hidden\'}else{this.dataset.fb=1;this.src=\'' + d + '\'}">';
  }
  function looptijd(m) { return m === 1 ? 'Maandelijks opzegbaar' : m === 12 ? '1 jaar' : m === 24 ? '2 jaar' : m === 36 ? '3 jaar' : ''; }
  function isZakelijk(d) {
    if (d.isZakelijk === true) return true;
    var h = ((d.merchantName || '') + ' ' + (d.name || '')).toLowerCase();
    return h.indexOf('zakelijk') > -1 || h.indexOf('business') > -1 || h.indexOf('b2b') > -1;
  }
  function actieUit(x) {
    var ap = num(x.actiePrijs), am = parseInt(x.actieMaanden, 10) || 0, na = num(x.prijsNaActie);
    if (ap > 0 && am > 0 && na > ap) return { p: ap, m: am, na: na };
    return null;
  }
  // Naam van de aanbieder: bij Mobiel.nl het merk zelf.
  function provVan(x) {
    var m = String(x.merchantName || '').replace(/\s+NL$/, '').trim(), b = String(x.brand || '').trim();
    if (/mobiel\.nl/i.test(m) && b) m = b;
    if (/^hollandsnieuwe$/i.test(m)) m = 'hollandsnieuwe';
    return m;
  }

  // ---------------------------------------------------------------- sim only
  var GEEN = /tablet|\btab\b|\bpad\b|ipad|watch|hotspot|mifi|router|modem|data ?sim|laptop|dongle/i;
  var NETTEN = ['KPN', 'Odido', 'Vodafone'];
  function simRij(x) {
    var naam = String(x.name || '');
    if (isZakelijk(x) || GEEN.test(naam) || num(x.deviceTotalPrice) > 0 || num(x.deviceMonthlyCost) > 0) return null;
    var gb = num(x.dataGB); if (!(gb > 0)) return null;
    var a = actieUit(x), p = a ? a.na : num(x.price); if (!(p > 0)) return null;
    var prov = provVan(x), m = parseInt(x.contractMonths, 10) || 0, een = num(x.initialCost);
    if (!looptijd(m)) m = 0;
    var net = ''; NETTEN.forEach(function (n) { if (String(x.network || '').toLowerCase() === n.toLowerCase() && prov.toLowerCase().indexOf(n.toLowerCase()) < 0) net = n; });
    var min = String(x.minutesLabel || '').trim(), mn = parseInt(min, 10);
    var onb = /onbeperkt/i.test(min) || mn >= 1000;
    var tot = (a ? a.p * Math.min(a.m, 24) + a.na * Math.max(0, 24 - a.m) : p * 24) + een;
    return {
      prov: prov, gb: gb >= 999 ? 999 : gb, min: onb ? 'Onbeperkt bellen' : min, onb: onb, net: net, m: m, p: p, a: a, een: een,
      tot: tot, nu: a ? a.p : p, url: x.affiliateUrl, tier: gb >= 999 ? 'tob' : gb >= 50 ? 't50' : gb >= 20 ? 't20' : gb >= 8 ? 't8' : 't7'
    };
  }

  // ---------------------------------------------------------------- internet
  function snelheid(x) {
    var n = String(x.name || ''), sp = num(x.speedMbit);
    var g = /(\d+(?:[.,]\d+)?)\s*Gbit/i.exec(n), mb = /(\d+)\s*Mb(?:it)?\/?s?/i.exec(n);
    if (sp > 0 && sp < 20 && g) sp = sp * 1000;
    if (!sp && g) sp = parseFloat(g[1].replace(',', '.')) * 1000;
    if (!sp && mb) sp = parseInt(mb[1], 10);
    if (sp >= 990 && sp < 1000) sp = 1000;
    return sp;
  }
  function spTekst(sp) { return sp >= 1000 ? String(Math.round(sp / 100) / 10).replace('.', ',') + ' Gbit/s' : sp + ' Mbit/s'; }
  function netRij(x) {
    var naam = String(x.name || '').replace(/&amp;/g, '&');
    if (isZakelijk(x)) return null;
    var p = num(x.price); if (!(p > 0)) return null;
    var sp = snelheid(x); if (!(sp > 0)) return null;
    var prov = provVan(x), m = parseInt(x.contractMonths, 10) || 0, een = num(x.initialCost);
    if (!looptijd(m)) m = 0;
    // Resellers (online.nl) verkopen pakketten op verschillende netwerken: dat zetten we erbij.
    var net = /delta/i.test(naam) ? 'DELTA Fiber' : /\bkpn\b/i.test(naam) && !/kpn/i.test(prov) ? 'KPN-netwerk' : '';
    if (/delta/i.test(naam)) naam = naam.replace(/DELTA Fiber\s*/i, '');
    var tv = !!x.hasTV || /\btv\b/i.test(naam), bellen = /bellen/i.test(naam);
    var type = /glasvezel|fiber/i.test(naam) ? 'Glasvezel' : /\b5g\b/i.test(naam) ? '5G' : /dsl|standaard internet|maximaal internet|snel \d/i.test(naam) ? 'DSL' : /ziggo/i.test(prov) ? 'Kabel' : '';
    var a = actieUit(x);
    if (!a) {
