/* Een algemeen script zet op elke kaart een knop "Mail deze deal". Hier niet:
   onder de uitkomst staat al het seintje, en de knop leidt af van de klik. */
.dhk .dpvmb{display:none !important}
.dhk a.dhk-w,.dhk a.dhk-w:visited{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;padding:0 11px;margin-top:6px;border-radius:11px;
  border:1.5px solid #D8E0EA;color:#0B1B33 !important;text-decoration:none !important;font-size:14px;font-weight:700}
.dhk a.dhk-w b{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:16px;font-weight:800;white-space:nowrap}
.dhk a.dhk-w b::after{content:' ›';font-weight:700}
.dhk a.dhk-w.eerste,.dhk a.dhk-w.eerste:visited{background:#059669;border-color:#059669;color:#fff !important;min-height:48px;font-weight:800}
.dhk a.dhk-w.eerste:hover{background:#047857}
.dhk a.dhk-w:not(.eerste):hover{border-color:#10b981;background:#ECFDF5}
.dhk-w span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:flex;align-items:center}
.dhk-w i{flex:0 0 auto}
.dhk-w i{font-style:normal;font-size:10px;letter-spacing:.06em;text-transform:uppercase;font-weight:800;background:rgba(255,255,255,.22);border-radius:5px;padding:3px 6px;margin-left:7px}
.dhk a.dhk-meer{display:inline-block;margin-top:7px;font-size:13px;font-weight:800;color:#047857 !important;text-decoration:none !important;padding:6px 0}

/* laden */
.dhk-laad i{display:block;height:58px;border-radius:13px;margin-bottom:8px;background:linear-gradient(90deg,#EEF2F6 0%,#F7F9FB 50%,#EEF2F6 100%);background-size:200% 100%;animation:dhk-l 1.2s linear infinite}
.dhk-laad i:first-child{height:150px}
@keyframes dhk-l{to{background-position:-200% 0}}
@media(prefers-reduced-motion:reduce){.dhk-laad i{animation:none}}

.dhk :focus-visible{outline:3px solid #7FE3BC;outline-offset:2px}
.dhk-paneel :focus-visible{outline-color:#059669}
</style>

<script>
(function () {
  var wortel = document.getElementById('dhk');
  if (!wortel) return;
  var WORKER = wortel.getAttribute('data-worker') || '';
  var SHOP = wortel.getAttribute('data-shop') || '';

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function euro(v) {
    var r = Math.round(v * 100) / 100;
    var s = r % 1 === 0 ? String(r) : r.toFixed(2).replace('.', ',');
    return '€' + s.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }
  function meet(naam, extra) {
    try {
      var d = extra || {};
      if (typeof window.gtag === 'function') window.gtag('event', naam, d);
      else if (window.dataLayer && window.dataLayer.push) { d.event = naam; window.dataLayer.push(d); }
    } catch (e) {}
  }

  /* ---------- tabbladen ---------- */
  var tabs = [].slice.call(wortel.querySelectorAll('button.dhk-tab'));
  var prodGeladen = false;
  function kiesTab(naam, focus) {
    tabs.forEach(function (t) {
      var aan = t.getAttribute('data-tab') === naam;
      t.classList.toggle('aan', aan);
      t.setAttribute('aria-selected', aan ? 'true' : 'false');
      t.tabIndex = aan ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !aan;
      if (aan && focus) t.focus();
    });
    if (naam === 'prod' && !prodGeladen) { prodGeladen = true; laadProd(); }
    try { sessionStorage.setItem('dhk-tab', naam); } catch (e) {}
  }
  tabs.forEach(function (t, n) {
    t.addEventListener('click', function () { kiesTab(t.getAttribute('data-tab')); meet('dhk_tab', { tab: t.getAttribute('data-tab') }); });
    t.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      var v = tabs[(n + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      kiesTab(v.getAttribute('data-tab'), true);
    });
  });

  /* ---------- sim only ---------- */
  var DOMEIN = { lebara: 'lebara.nl', youfone: 'youfone.nl', hollandsnieuwe: 'hollandsnieuwe.nl', simyo: 'simyo.nl', ben: 'ben.nl',
    kpn: 'kpn.com', odido: 'odido.nl', vodafone: 'vodafone.nl', budget: 'budgetmobiel.nl', '50plus': '50plusmobiel.nl' };
  function logo(provider, klein) {
    var k = String(provider || '').toLowerCase().replace(/[^a-z0-9]/g, '');
    var d = DOMEIN[k] || DOMEIN[k.replace('mobiel', '')];
    if (!d) return '';
    return '<img class="dhk-logo" alt="" loading="lazy" width="36" height="36" onerror="this.style.display=\'none\'" ' +
      'src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=64&amp;url=https://' + d + '">';
  }
  var FILTER = {
    alles:  { test: function () { return true; }, wat: 'laagste maandprijs' },
    data:   { test: function (k) { return !!k.unlimited; }, wat: 'laagste maandprijs met onbeperkt data' },
    bellen: { test: function (k) { return /onbeperkt/i.test(k.minutes || ''); }, wat: 'laagste maandprijs met onbeperkt bellen' },
    jaar:   { test: function (k) { return mnd(k) === 12; }, wat: 'laagste maandprijs met een contract van 1 jaar' }
  };
  function mnd(k) { return parseInt(String(k.contract || '').replace(/\D/g, ''), 10) || 24; }
  function bundel(k) {
    var d = k.unlimited ? 'Onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
    var b = /onbeperkt/i.test(k.minutes || '') ? 'onbeperkt bellen' : (k.minutes || '');
    var j = mnd(k) === 12 ? '1 jaar' : mnd(k) === 24 ? '2 jaar' : mnd(k) + ' maanden';
    return [d, b, j].filter(Boolean).join(' · ');
  }
  function ga(k) { return WORKER + '/api/go?u=' + encodeURIComponent(k.url) + '&cat=simonly&p=' + encodeURIComponent(k.provider || ''); }

  var kaarten = [], simKeuze = 'alles';
  var simUit = document.getElementById('dhk-sim-uit');
  var simChips = [].slice.call(document.querySelectorAll('#dhk-sim-chips .dhk-chip'));

  function tekenSim() {
    var f = FILTER[simKeuze];
    var lijst = kaarten.filter(f.test).sort(function (a, b) {
      return (a.price - b.price) || ((b.unlimited ? 9999 : b.dataGB || 0) - (a.unlimited ? 9999 : a.dataGB || 0));
    });
    if (!lijst.length) { simUit.innerHTML = '<p class="dhk-leeg">Hiervoor hebben wij nu geen aanbod. Kies een andere optie.</p>'; return; }
    var b = lijst[0];
    var net = b.network && String(b.network).toLowerCase() !== String(b.provider).toLowerCase() ? ' · netwerk van ' + esc(b.network) : '';
    var h = '<div class="dhk-best">' +
      '<span class="dhk-lab">Beste keuze · ' + esc(f.wat) + '</span>' +
      '<div class="dhk-best-rij">' + logo(b.provider) +
        '<div class="dhk-best-naam"><b>' + esc(b.provider) + '</b><span>' + esc(bundel(b)) + net + '</span></div>' +
        '<div class="dhk-prijs">' + euro(b.price) + '<small>per maand</small></div>' +
      '</div>' +
      '<p class="dhk-totaal">' + euro(b.price * mnd(b)) + ' over ' + mnd(b) + ' maanden</p>' +
      '<a class="dhk-knop" rel="nofollow sponsored noopener" target="_blank" href="' + esc(ga(b)) + '" data-pos="1" data-naam="' + esc(b.provider) + '">Bekijk bij ' + esc(b.provider) + ' ›</a>' +
      '</div>';
    var rest = lijst.slice(1, 3);
    if (rest.length) {
      h += '<div class="dhk-alt">' + rest.map(function (k, n) {
        return '<a class="dhk-alt-rij" rel="nofollow sponsored noopener" target="_blank" href="' + esc(ga(k)) + '" data-pos="' + (n + 2) + '" data-naam="' + esc(k.provider) + '">' +
          logo(k.provider) +
          '<span class="dhk-alt-naam"><b>' + esc(k.provider) + '</b><span>' + esc(bundel(k)) + '</span></span>' +
          '<span class="dhk-prijs">' + euro(k.price) + '<small>per maand</small></span>' +
          '<span class="dhk-ga">Bekijk ›</span></a>';
      }).join('') + '</div>';
    }
    simUit.innerHTML = h;
  }

  simChips.forEach(function (c) {
    c.addEventListener('click', function () {
      if (c.disabled) return;
      simKeuze = c.getAttribute('data-f');
      simChips.forEach(function (x) { var a = x === c; x.classList.toggle('aan', a); x.setAttribute('aria-pressed', a ? 'true' : 'false'); });
      tekenSim();
      meet('dhk_keuze', { tab: 'sim', keuze: simKeuze });
    });
  });

  function simFout() {
    simUit.innerHTML = '<p class="dhk-leeg">De prijzen laden nu niet. De volledige vergelijker werkt wel.</p>';
  }
  if (WORKER) {
    fetch(WORKER + '/api/cards/simonly?limit=60')
      .then(function (r) { return r.json(); })
      .then(function (j) {
        kaarten = ((j && j.cards) || []).map(function (k) { k.price = parseFloat(k.price || 0); return k; })
          .filter(function (k) { return k.price > 0 && k.url && k.provider; });
        if (!kaarten.length) return simFout();
        simChips.forEach(function (c) {
          if (!kaarten.some(FILTER[c.getAttribute('data-f')].test)) c.hidden = true;
        });
        tekenSim();
      })
      .catch(simFout);
  } else simFout();

  /* ---------- producten ---------- */
  var prodUit = document.getElementById('dhk-prod-uit');
  var prodChips = [].slice.call(document.querySelectorAll('#dhk-prod-chips .dhk-chip'));
  var prodAlle = document.getElementById('dhk-prod-alle');
  var prodBasis = prodAlle ? prodAlle.getAttribute('href') : '/pages/vergelijken';
  var cache = {};

  function haal(id, cat) {
    var s = id + '|' + cat;
    if (!cache[s]) {
      cache[s] = fetch(SHOP + '/api/shop/product?i=' + encodeURIComponent(id) + '&cat=' + encodeURIComponent(cat))
        .then(function (r) { return r.json(); })
        .then(function (j) { return (j && j.product) || null; })
        .catch(function () { return null; });
    }
    return cache[s];
  }
  function winkel(o) { return o.w === 'bol.com partner' ? 'bol.com (partner)' : o.w; }
  function goed(x) {
    // Zelfde rem als in de productrijen: een winkel die meer dan 40% onder de
    // volgende zit, heeft bijna altijd een fout in de feed.
    if (!x || !x.o || !x.o.length || !(x.p > 0)) return false;
    if (x.o.length > 1 && x.o[0].p < x.o[1].p * 0.6) return false;
    return true;
  }
  function tekenProd(items, chip) {
    items = items.filter(goed);
    if (!items.length) { prodUit.innerHTML = '<p class="dhk-leeg">De prijzen laden nu niet. De productvergelijker werkt wel.</p>'; return; }
    prodUit.innerHTML = items.map(function (x, pn) {
      var link = SHOP + '/api/shop/go?i=' + encodeURIComponent(x.i) + '&cat=' + encodeURIComponent(x.c);
      var o = x.o.slice().sort(function (a, b) { return a.p - b.p; });
      var rijen = o.slice(0, 3).map(function (w, n) {
        return '<a class="dhk-w' + (n === 0 ? ' eerste' : '') + '" rel="nofollow sponsored noopener" target="_blank" href="' + esc(link + '&w=' + encodeURIComponent(w.w)) + '"' +
          ' data-pos="' + (pn + 1) + '.' + (n + 1) + '" data-naam="' + esc(w.w) + '">' +
          '<span>' + (n === 0 ? 'Bekijk bij ' : '') + esc(winkel(w)) + (n === 0 && o.length > 1 ? '<i>laagste</i>' : '') + '</span><b>' + euro(w.p) + '</b></a>';
      }).join('');
      var meer = o.length > 3
        ? '<a class="dhk-meer" href="' + esc(prodBasis + '?cat=' + encodeURIComponent(x.c) + '&q=' + encodeURIComponent(x.n)) + '">+ ' + (o.length - 3) + (o.length - 3 === 1 ? ' winkel' : ' winkels') + ' ›</a>' : '';
      return '<div class="dhk-prod">' +
        '<div class="dhk-prod-im">' + (x.im ? '<img src="' + esc(x.im) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">' : '') + '</div>' +
        '<p class="dhk-prod-n">' + esc(x.n) + '</p>' +
        '<div class="dhk-prod-w">' + rijen + meer + '</div></div>';
    }).join('');
  }
  var prodVraag = 0;
  function laadProd(chip) {
    chip = chip || prodChips[0];
    if (!chip || !SHOP) return;
    var mijn = ++prodVraag;
    var ids = (chip.getAttribute('data-ids') || '').split(',').map(function (s) { return s.trim().split(':'); })
      .filter(function (d) { return d.length === 2 && d[0]; });
    var meer = chip.getAttribute('data-meer') || '';
    if (prodAlle) {
      prodAlle.href = meer ? prodBasis + '?cat=' + encodeURIComponent(meer) : prodBasis;
      prodAlle.textContent = (meer ? 'Alle ' + chip.textContent.trim().toLowerCase() : 'Alle producten') + ' vergelijken ›';
    }
    Promise.all(ids.map(function (d) { return haal(d[0], d[1]); })).then(function (r) {
      if (mijn !== prodVraag) return;
      tekenProd(r.filter(Boolean), chip);
    });
  }
  prodChips.forEach(function (c) {
    c.addEventListener('click', function () {
      prodChips.forEach(function (x) { var a = x === c; x.classList.toggle('aan', a); x.setAttribute('aria-pressed', a ? 'true' : 'false'); });
      prodUit.innerHTML = '<div class="dhk-laad" aria-hidden="true"><i></i><i></i><i></i></div>';
      laadProd(c);
      meet('dhk_keuze', { tab: 'prod', keuze: c.textContent.trim() });
    });
  });

  /* ---------- meten ---------- */
  wortel.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a[data-pos]') : null;
    if (!a) return;
    var tab = a.closest('#dhk-p-prod') ? 'prod' : 'sim';
    meet('dhk_klik', { tab: tab, keuze: tab === 'sim' ? simKeuze : '', positie: a.getAttribute('data-pos'), aanbieder: a.getAttribute('data-naam') });
  });

  try { if (sessionStorage.getItem('dhk-tab') === 'prod') kiesTab('prod'); } catch (e) {}
})();
</script>

