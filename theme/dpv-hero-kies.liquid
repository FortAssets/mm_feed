.dhk a.dhk-knop,.dhk a.dhk-knop:visited{display:flex;align-items:center;justify-content:center;min-height:52px;padding:0 16px;border-radius:13px;
  background:#059669;color:#fff !important;font:800 16px/1.15 'Plus Jakarta Sans',system-ui,sans-serif;text-decoration:none !important;text-align:center}
