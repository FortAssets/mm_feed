.dhk a.dhk-sein,.dhk a.dhk-sein:visited{display:flex;align-items:center;gap:11px;margin-top:6px;padding:12px;border-radius:13px;background:#0B1B33;
  color:#C9D4E2 !important;text-decoration:none !important;font-size:12.5px;line-height:1.4}
.dhk-sein b{color:#fff;font-size:14px}
.dhk-sein-ic{flex:0 0 auto;width:34px;height:34px;border-radius:10px;background:rgba(127,227,188,.14);color:#7FE3BC;display:flex;align-items:center;justify-content:center}
.dhk-sein-ic svg{width:19px;height:19px}
