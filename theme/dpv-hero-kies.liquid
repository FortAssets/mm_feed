.dhk-leeg{font-size:14px;color:#5B6B80;padding:14px 2px}
.dhk-regel{font-size:11.5px;line-height:1.5;color:#5B6B80;margin:10px 0 0;padding-top:10px;border-top:1px solid #E7ECF2}
.dhk a.dhk-alle,.dhk a.dhk-alle:visited{display:flex;align-items:center;justify-content:center;min-height:46px;margin-top:6px;
