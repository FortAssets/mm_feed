.dhk-zoek input{flex:1;min-width:0;height:44px;border:0;background:transparent;padding:0 10px;font:600 16px 'Plus Jakarta Sans',system-ui,sans-serif;color:#0B1B33;outline:none}
.dhk-zoek input::-webkit-search-cancel-button{display:none}
.dhk-zoek button{flex:0 0 auto;height:44px;border:0;border-radius:10px;padding:0 18px;background:#059669;color:#fff;font:800 15px 'Plus Jakarta Sans',system-ui,sans-serif;cursor:pointer}
.dhk-verborgen{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.dhk-prod{display:grid;grid-template-columns:60px 1fr;gap:6px 12px;align-items:center;padding:13px 0;border-bottom:1px solid #E7ECF2}
.dhk-prod:first-child{padding-top:2px}
.dhk-prod:last-child{border-bottom:0}
.dhk-prod-im{width:60px;height:60px;border-radius:12px;background:#F4F7FA;display:flex;align-items:center;justify-content:center;overflow:hidden}
.dhk-prod-im img{max-width:52px;max-height:52px;object-fit:contain;mix-blend-mode:multiply}
