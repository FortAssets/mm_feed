.dhk h1{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:29px;line-height:1.06;letter-spacing:-.035em;font-weight:800;margin:0;color:#fff;text-wrap:balance}
.dhk h1 em{font-style:normal;color:#7FE3BC}
.dhk-sub{display:none;font-size:15.5px;line-height:1.55;color:#9FB0C4;margin:14px 0 0;max-width:42ch}
