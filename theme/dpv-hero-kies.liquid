/* alternatieven: hele regel is de knop */
.dhk-alt{margin-top:4px}
.dhk a.dhk-alt-rij,.dhk a.dhk-alt-rij:visited{display:flex;align-items:center;gap:10px;min-height:62px;padding:10px 2px;border-bottom:1px solid #E7ECF2;
  color:#0B1B33 !important;text-decoration:none !important}
.dhk a.dhk-alt-rij:last-child{border-bottom:0}
