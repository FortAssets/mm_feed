{%- comment -%}
  Hero: tik en zie de uitkomst.

  5 okt. Gebouwd na het deskonderzoek naar conversie (onderzoek-conversie.md):
  - geen verplicht veld voor de uitkomst: het aanbod staat er direct;
  - tikknoppen in plaats van keuzelijsten;
  - een "beste keuze" bovenaan, de alternatieven blijven gewoon zichtbaar en
    klikbaar;
  - onder de uitkomst staat hoe wij kiezen en dat wij een vergoeding krijgen
    (ACM Leidraad 2024, hoofdstuk 8);
  - geen vaste knop onderaan: die wint op homepages in tests niet.

  Eerste stap: alleen Sim only en Producten werken als tabblad. De andere
  categorieen zijn gewone links naar hun eigen pagina.

  Sim only komt uit de telecom-worker (een bundel per aanbieder), producten uit
  de shop-worker. Valt een van beide uit, dan blijft de link naar de volledige
  vergelijker staan.

  Elke klik naar een aanbieder gaat als gebeurtenis "dhk_klik" naar gtag of
  dataLayer als die er zijn, met tabblad, keuze en positie. Daarmee is later te
  meten of de beste keuze of een alternatief wordt gekozen.
{%- endcomment -%}

<section class="dhk" id="dhk"
  data-worker="{{ section.settings.worker_url }}"
  data-shop="{{ section.settings.shop_url }}">
  <div class="dhk-in">

    <div class="dhk-kop">
      <p class="dhk-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.kop }} <em>{{ section.settings.kop_accent }}</em></h1>
      <p class="dhk-sub">{{ section.settings.sub }}</p>
    </div>

    <div class="dhk-app">
      <div class="dhk-tabs" role="tablist" aria-label="Wat wil je vergelijken?">
        <button type="button" class="dhk-tab aan" role="tab" aria-selected="true" aria-controls="dhk-p-sim" id="dhk-t-sim" data-tab="sim">Sim only</button>
        <button type="button" class="dhk-tab" role="tab" aria-selected="false" aria-controls="dhk-p-prod" id="dhk-t-prod" data-tab="prod" tabindex="-1">Producten</button>
        {%- assign links = section.settings.links | newline_to_br | split: '<br />' -%}
        {%- for l in links -%}
          {%- assign d = l | strip | split: '|' -%}
          {%- if d.size == 2 -%}
            <a class="dhk-tab dhk-link" href="{{ d[1] | strip }}">{{ d[0] | strip }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Sim only {%- endcomment -%}
      <div class="dhk-paneel" id="dhk-p-sim" role="tabpanel" aria-labelledby="dhk-t-sim">
        <p class="dhk-vraag">Wat is voor jou belangrijk?</p>
        <div class="dhk-chips" id="dhk-sim-chips">
          <button type="button" class="dhk-chip aan" data-f="alles" aria-pressed="true">Laagste prijs</button>
          <button type="button" class="dhk-chip" data-f="data" aria-pressed="false">Onbeperkt data</button>
          <button type="button" class="dhk-chip" data-f="bellen" aria-pressed="false">Onbeperkt bellen</button>
          <button type="button" class="dhk-chip" data-f="jaar" aria-pressed="false">1 jaar contract</button>
        </div>
        <div class="dhk-uit" id="dhk-sim-uit" aria-live="polite">
          <div class="dhk-laad" aria-hidden="true"><i></i><i></i><i></i></div>
          <noscript><a class="dhk-knop" href="{{ section.settings.sim_url }}">Bekijk alle sim only</a></noscript>
        </div>
        <p class="dhk-regel" id="dhk-sim-regel">{{ section.settings.sim_regel }}</p>
        <a class="dhk-alle" href="{{ section.settings.sim_url }}">Alle sim only vergelijken ›</a>
        {%- if section.settings.seintje_url != blank -%}
        <a class="dhk-sein" href="{{ section.settings.seintje_url }}">
          <span class="dhk-sein-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7 2.5 7h-17S6 15 6 9Z"/><path d="M10 20a2.2 2.2 0 0 0 4 0"/></svg></span>
          <span><b>{{ section.settings.seintje_kop }}</b><br>{{ section.settings.seintje_tekst }}</span>
          <span class="dhk-pijl" aria-hidden="true">›</span>
        </a>
        {%- endif -%}
      </div>

      {%- comment -%} Producten {%- endcomment -%}
      <div class="dhk-paneel" id="dhk-p-prod" role="tabpanel" aria-labelledby="dhk-t-prod" hidden>
        <form class="dhk-zoek" action="{{ section.settings.prod_url }}" method="get" role="search">
          <label for="dhk-q" class="dhk-verborgen">Zoek een product</label>
          <input id="dhk-q" name="q" type="search" autocomplete="off" placeholder="Zoek op merk of model" enterkeyhint="search">
          <button type="submit">Zoek</button>
        </form>
        <div class="dhk-chips" id="dhk-prod-chips">
          {%- assign groepen = section.settings.groepen | newline_to_br | split: '<br />' -%}
          {%- for g in groepen -%}
            {%- assign d = g | strip | split: '|' -%}
            {%- if d.size >= 3 -%}
              <button type="button" class="dhk-chip{% if forloop.first %} aan{% endif %}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                data-ids="{{ d[2] | strip }}" data-meer="{{ d[1] | strip }}">{{ d[0] | strip }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="dhk-uit" id="dhk-prod-uit" aria-live="polite">
          <div class="dhk-laad" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
        <p class="dhk-regel">{{ section.settings.prod_regel }}</p>
        <a class="dhk-alle" id="dhk-prod-alle" href="{{ section.settings.prod_url }}">Alle producten vergelijken ›</a>
      </div>
    </div>

  </div>
</section>

<style>
.dhk{background:#0B1B33;background-image:radial-gradient(900px 560px at 18% 12%,#16305C 0%,transparent 72%);
  color:#fff;font-family:'Plus Jakarta Sans',system-ui,sans-serif}
.dhk *{box-sizing:border-box}
.dhk [hidden]{display:none !important}
