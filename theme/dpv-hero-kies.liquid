{%- comment -%}
  Hero: tik en zie de uitkomst.

  5 okt. Gebouwd na het deskonderzoek naar conversie (onderzoek-conversie.md):
  - geen verplicht veld voor de uitkomst: het aanbod staat er direct;
  - tikknoppen in plaats van keuzelijsten;
  - een "beste keuze" bovenaan, de alternatieven blijven gewoon zichtbaar en
    klikbaar;
  - onder de uitkomst staat hoe wij kiezen en dat wij een vergoeding krijgen
    (ACM Leidraad 2024, hoofdstuk 8);
  - geen vaste knop onderaan: die wint op homepages in tests niet.

  Tweede stap, zelfde dag: alle acht categorieen zijn een tabblad. Een tabblad
  haalt zijn gegevens pas op als je het opent.

  Waar de gegevens vandaan komen:
  - sim only, telefoon, internet: telecom-worker (/api/cards/...);
  - producten, gaming: shop-worker;
  - boodschappen: boodschappen-worker (/sm/api/deals);
  - zorg: de polissen staan als instelling in de zorgvergelijker. Wij lezen ze
    uit die pagina, zodat er een plek blijft om ze bij te houden;
  - energie: data/energie-top.json in de repo. De energie-worker geeft alleen
    een pagina terug en mag niet door een andere site gelezen worden;
    energie.mjs leest de pagina twee keer per dag uit.
  Valt een bron uit, dan blijft de link naar de volledige vergelijker staan.

  Elke klik naar een aanbieder gaat als gebeurtenis "dhk_klik" naar gtag of
  dataLayer als die er zijn, met tabblad, keuze en positie.

  5 okt, huisstijl "2-rond" (STIJLGIDS.md): licht bovenste vlak, Montserrat,
  blauw als accent en geel alleen op de knop naar de aanbieder. Erbij: drie
  vertrouwenspunten (breed scherm: onder de ondertitel; telefoon: als blok
  onder het vlak, zodat de eerste prijs in beeld blijft) en een strook met
  logo's onderaan het vlak. Looptijd en totaalbedrag staan als kleine pillen
  onder de beste keuze. De logica en de klikmeting zijn niet aangeraakt.
{%- endcomment -%}

{%- comment -%} De vertrouwenspunten staan twee keer in de pagina (breed en smal); een van
   de twee is altijd verborgen. Een regel per punt: vet|toelichting. {%- endcomment -%}
{%- capture dhk_punten -%}
  {%- assign punten = section.settings.punten | newline_to_br | split: '<br />' -%}
  <ul class="dhk-punten">
  {%- for r in punten -%}
    {%- assign d = r | strip | split: '|' -%}
    {%- if d[0] != blank -%}
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span><b>{{ d[0] | strip | escape }}</b> {{ d[1] | strip | escape }}</span></li>
    {%- endif -%}
  {%- endfor -%}
  </ul>
{%- endcapture -%}

{%- comment -%} Montserrat staat nog niet in het thema. Een keer per pagina laden, ook als
   er meer secties in de nieuwe stijl op staan. {%- endcomment -%}
<script>if(!document.getElementById('dpv-mont')){var l=document.createElement('link');l.id='dpv-mont';l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap';document.head.appendChild(l);}</script>

<section class="dhk" id="dhk"
  data-worker="{{ section.settings.worker_url }}"
  data-shop="{{ section.settings.shop_url }}"
  data-boodschappen="{{ section.settings.boodschappen_url }}"
  data-energie="{{ section.settings.energie_data }}"
  data-zorg="{{ section.settings.zorg_url }}"
  data-prod="{{ section.settings.groepen | escape }}"
  data-gaming="{{ section.settings.gaming_groepen | escape }}"
  data-seintje="{{ section.settings.seintje_url }}">
  <div class="dhk-top">
  <div class="dhk-in">

    <div class="dhk-kop">
      {%- if section.settings.eyebrow != blank -%}<p class="dhk-eyebrow"><i aria-hidden="true"></i>{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.kop }} <em>{{ section.settings.kop_accent }}</em></h1>
      <p class="dhk-sub">{{ section.settings.sub }}</p>
      {{ dhk_punten }}
    </div>

    <div class="dhk-app">
      <div class="dhk-tabs" role="tablist" aria-label="Wat wil je vergelijken?">
        {%- assign tabs = "sim:Sim only,telefoon:Telefoon,internet:Internet,energie:Energie,zorg:Zorg,prod:Producten,gaming:Gaming,boodschappen:Boodschappen" | split: ',' -%}
        {%- for t in tabs -%}
          {%- assign d = t | split: ':' -%}
          <button type="button" class="dhk-tab{% if forloop.first %} aan{% endif %}" role="tab" id="dhk-t-{{ d[0] }}" data-tab="{{ d[0] }}"
            aria-controls="dhk-paneel" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>{{ d[1] }}</button>
        {%- endfor -%}
      </div>

      <div class="dhk-paneel" id="dhk-paneel" role="tabpanel" aria-labelledby="dhk-t-sim">
        <div class="dhk-laad" aria-hidden="true"><i></i><i></i><i></i></div>
        <noscript>
          <div class="dhk-links">
            <a href="/pages/sim-only">Sim only</a><a href="/pages/telefoonabonnement">Telefoon</a><a href="/pages/internet-tv">Internet</a>
            <a href="/pages/energie">Energie</a><a href="/pages/zorgverzekering">Zorg</a><a href="/pages/vergelijken">Producten</a>
            <a href="/pages/gaming">Gaming</a><a href="/pages/boodschappen">Boodschappen</a>
          </div>
        </noscript>
      </div>
    </div>

    {%- assign logos = section.settings.logos | split: ',' -%}
    {%- if logos.size > 0 -%}
    <div class="dhk-strook">
      <p class="dhk-strook-kop">{{ section.settings.logos_kop }}</p>
      <div class="dhk-logos">
        {%- for m in logos -%}
          {%- assign d = m | strip -%}
          {%- if d != blank -%}
            <img src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=128&amp;url=https://{{ d | escape }}"
                 alt="{{ d | split: '.' | first | capitalize | escape }}" loading="lazy" width="38" height="38" onerror="this.style.display='none'">
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

  </div>
  </div>

  <div class="dhk-onder">{{ dhk_punten }}</div>
</section>

<style>
/* 5 okt, huisstijl "2-rond": licht bovenste vlak in plaats van donkerblauw,
   Montserrat, blauw als accent en geel alleen op de knop naar de aanbieder.
   De opbouw (kop links, kiezer rechts) is gelijk gebleven; erbij gekomen zijn
   de drie vertrouwenspunten en de strook met logo's. */
.dhk{background:#fff;color:#0D1B2A;font-family:'Montserrat',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.dhk *{box-sizing:border-box}
.dhk [hidden]{display:none !important}
.dhk-top{background:linear-gradient(180deg,#E3ECFF 0%,#F4F7FF 100%)}
.dhk-in{max-width:1180px;margin:0 auto;padding:14px 16px 16px;display:grid;gap:12px;grid-template-columns:minmax(0,1fr)}
@media(min-width:900px){.dhk-in{grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:28px 48px;padding:44px 20px 30px;align-items:start}}

.dhk-eyebrow{display:inline-flex;align-items:center;gap:8px;background:#fff;border-radius:999px;padding:6px 12px;font-size:11.5px;line-height:1.2;
  font-weight:800;color:#2456D6;margin:0 0 9px;letter-spacing:0;text-transform:none}
.dhk-eyebrow i{flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:#3FAE7A}
.dhk h1{font-family:'Montserrat',system-ui,sans-serif;font-size:28px;line-height:1.05;letter-spacing:-.03em;font-weight:800;margin:0;color:#0D1B2A;text-wrap:balance}
.dhk h1 em{font-style:normal;color:#2456D6}
.dhk-sub{display:none;font-size:17px;line-height:1.55;color:#4A5A70;font-weight:500;margin:16px 0 24px;max-width:400px}
@media(min-width:900px){.dhk-eyebrow{font-size:12.5px;padding:7px 13px;margin-bottom:14px}.dhk h1{font-size:48px}.dhk-sub{display:block}.dhk-kop{padding-top:44px}}

/* vertrouwenspunten: op een breed scherm onder de ondertitel, op een telefoon
   als blok onder het bovenste vlak. Zo blijft de eerste prijs daar in beeld. */
.dhk-punten{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.dhk-punten li{display:flex;align-items:center;gap:10px;margin:0;padding:0;font-size:13px;line-height:1.3;color:#4A5A70;font-weight:600}
.dhk-punten svg{flex:0 0 22px;width:22px;height:22px;padding:4px;border-radius:50%;background:#3FAE7A;color:#0D1B2A}
.dhk-punten b{display:block;font-size:14px;color:#0D1B2A;font-weight:800}
.dhk-kop .dhk-punten{display:none}
.dhk-onder{max-width:1180px;margin:0 auto;padding:14px 16px 0}
.dhk-onder .dhk-punten{gap:9px;background:#F4F7FF;border-radius:14px;padding:13px}
.dhk-onder .dhk-punten li{font-size:12.5px}
.dhk-onder .dhk-punten b{display:inline;font-size:13px;margin-right:5px}
@media(min-width:900px){.dhk-kop .dhk-punten{display:grid}.dhk-onder{display:none}}

.dhk-app{min-width:0}

/* tabbladen: schuiven opzij op een telefoon */
.dhk-tabs{display:flex;gap:7px;overflow-x:auto;margin:0 -16px 10px;padding:2px 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.dhk-tabs::-webkit-scrollbar{display:none}
@media(min-width:900px){.dhk-tabs{margin:0 0 12px;padding:2px 0;flex-wrap:wrap;overflow:visible}}
.dhk .dhk-tab,.dhk a.dhk-tab:visited{flex:0 0 auto;display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border-radius:999px;
  border:1px solid #D9E1EC;background:#fff;color:#0D1B2A !important;
  font:800 14px/1 'Montserrat',system-ui,sans-serif;text-decoration:none !important;cursor:pointer;white-space:nowrap}
.dhk .dhk-tab.aan{background:#2456D6;color:#fff !important;border-color:#2456D6}
.dhk .dhk-tab:not(.aan):hover{border-color:#2456D6}
.dhk a.dhk-link::after{content:'›';margin-left:6px;opacity:.6}

/* De kaart van de kiezer is de belangrijkste kaart van de pagina en krijgt
   daarom het verschoven groene vlak. De marge rechts en onder houdt dat vlak
   binnen het scherm. */
.dhk-paneel{background:#fff;color:#0D1B2A;border:1px solid #E6EBF2;border-radius:18px;padding:12px 12px 11px;
  box-shadow:8px 8px 0 #3FAE7A;margin:0 8px 8px 0}
@media(min-width:900px){.dhk-paneel{padding:18px 18px 14px;box-shadow:10px 10px 0 #3FAE7A;margin:0 10px 10px 0}}
.dhk-vraag{font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:800;color:#5B6B80;margin:0 0 7px}

.dhk-chips{display:flex;gap:7px;overflow-x:auto;margin:0 -12px 10px;padding:1px 12px;scrollbar-width:none}
.dhk-chips::-webkit-scrollbar{display:none}
@media(min-width:900px){.dhk-chips{margin:0 0 12px;padding:1px 0;flex-wrap:wrap;overflow:visible}}
.dhk-chip{flex:0 0 auto;min-height:40px;padding:0 13px;border-radius:999px;border:1.5px solid #D9E1EC;background:#fff;color:#0D1B2A;
  font:700 13px/1 'Montserrat',system-ui,sans-serif;cursor:pointer;white-space:nowrap}
.dhk-chip:hover{border-color:#2456D6}
.dhk-chip.aan{border-color:#2456D6;background:#EAF1FF;color:#2456D6}
.dhk-chip[disabled]{opacity:.4;cursor:default}

/* beste keuze */
.dhk-best{border:2px solid #2456D6;background:#F3F7FF;border-radius:14px;padding:12px}
@media(min-width:900px){.dhk-best{padding:14px}}
.dhk-lab{display:inline-flex;align-items:center;gap:5px;font-size:11px;line-height:1.25;font-weight:800;color:#fff;background:#2456D6;
  border-radius:999px;padding:5px 10px 5px 7px;margin:0 0 10px;letter-spacing:0;text-transform:none}
.dhk-lab svg{flex:0 0 14px;width:14px;height:14px}
.dhk-best-rij{display:flex;align-items:center;gap:11px}
.dhk-logo{flex:0 0 auto;width:44px;height:44px;border-radius:11px;background:#fff;border:1px solid #E6EBF2;object-fit:contain;padding:6px}
.dhk-best-naam{flex:1;min-width:0}
.dhk-best-naam b{display:block;font-family:'Montserrat',system-ui,sans-serif;font-size:19px;line-height:1.12;font-weight:800;letter-spacing:-.01em}
.dhk-best-naam span{display:block;font-size:13.5px;line-height:1.35;color:#4A5A70;font-weight:600;margin-top:2px}
.dhk-prijs{flex:0 0 auto;text-align:right;font-family:'Montserrat',system-ui,sans-serif;font-weight:800;color:#0D1B2A;white-space:nowrap;line-height:1;
  letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.dhk-best .dhk-prijs{font-size:28px}
@media(min-width:900px){.dhk-best-naam b{font-size:21px}.dhk-best .dhk-prijs{font-size:30px}}
.dhk-prijs small{display:block;font:700 11px/1.2 'Montserrat',system-ui,sans-serif;color:#5B6B80;margin-top:4px;letter-spacing:0}
/* looptijd en totaalbedrag als kleine pillen onder de regel */
.dhk-tags{display:flex;flex-wrap:wrap;gap:6px;margin:11px 0 12px;padding:0;min-height:1px}
.dhk-tags span{background:#fff;border:1px solid #D9E1EC;border-radius:13px;padding:4px 10px;font-size:12px;line-height:1.3;font-weight:700;color:#4A5A70}
.dhk a.dhk-knop,.dhk a.dhk-knop:visited{display:flex;align-items:center;justify-content:center;min-height:50px;padding:0 16px;border-radius:12px;
  background:#F9C31F;color:#0D1B2A !important;font:800 16px/1.15 'Montserrat',system-ui,sans-serif;text-decoration:none !important;text-align:center}
.dhk a.dhk-knop:hover{background:#EDB50C}

/* alternatieven: hele regel is de knop */
.dhk-alt{margin-top:2px}
.dhk a.dhk-alt-rij,.dhk a.dhk-alt-rij:visited{display:flex;align-items:center;gap:10px;min-height:60px;padding:10px 2px;border-bottom:1px solid #E6EBF2;
  color:#0D1B2A !important;text-decoration:none !important}
.dhk a.dhk-alt-rij:last-of-type{border-bottom:0}
.dhk-alt-rij .dhk-logo{width:34px;height:34px;padding:4px;border-radius:9px}
.dhk-alt-naam{flex:1;min-width:0}
.dhk-alt-naam b{display:block;font-size:15px;font-weight:800;line-height:1.2}
.dhk-alt-naam span{display:block;font-size:12px;color:#5B6B80;font-weight:600;line-height:1.35;margin-top:2px}
.dhk-alt-rij .dhk-prijs{font-size:20px}
.dhk-ga{flex:0 0 auto;font-size:12.5px;font-weight:800;color:#0D1B2A;background:#F9C31F;border-radius:10px;padding:9px 11px;white-space:nowrap}
.dhk a.dhk-alt-rij:hover .dhk-ga{background:#EDB50C}

.dhk-leeg{font-size:14px;color:#4A5A70;font-weight:600;padding:14px 2px}
.dhk-regel{font-size:11.5px;line-height:1.5;color:#5B6B80;font-weight:600;margin:8px 0 0;padding-top:10px;border-top:1px solid #E6EBF2}
.dhk-hoe{color:#2456D6;font-weight:800;border-bottom:1.5px solid #C9D6EA}
.dhk a.dhk-alle,.dhk a.dhk-alle:visited{display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:4px;
  font-size:14px;font-weight:800;color:#2456D6 !important;text-decoration:none !important}
.dhk a.dhk-alle:hover{color:#1B45B4 !important;text-decoration:underline !important}

.dhk a.dhk-sein,.dhk a.dhk-sein:visited{display:flex;align-items:center;gap:11px;margin-top:4px;padding:12px;border-radius:12px;background:#EAF1FF;
  color:#4A5A70 !important;text-decoration:none !important;font-size:12.5px;font-weight:600;line-height:1.4}
.dhk a.dhk-sein:hover{background:#DDE8FF}
.dhk-sein b{color:#0D1B2A;font-size:14px;font-weight:800}
.dhk-sein-ic{flex:0 0 auto;width:36px;height:36px;border-radius:10px;background:#fff;color:#2456D6;display:flex;align-items:center;justify-content:center}
.dhk-sein-ic svg{width:19px;height:19px}
.dhk-pijl{margin-left:auto;font-size:20px;font-weight:800;color:#2456D6}

/* producten */
.dhk-zoek{display:flex;gap:0;margin:0 0 10px;border:1.5px solid #D9E1EC;border-radius:12px;padding:4px;background:#fff}
.dhk-zoek:focus-within{border-color:#2456D6}
.dhk-zoek input{flex:1;min-width:0;height:44px;border:0;background:transparent;padding:0 10px;font:600 16px 'Montserrat',system-ui,sans-serif;color:#0D1B2A;outline:none;box-shadow:none}
.dhk-zoek input::placeholder{color:#5B6B80}
.dhk-zoek input::-webkit-search-cancel-button{display:none}
/* zoeken is een interne knop en dus blauw; geel is er alleen voor de doorklik */
.dhk-zoek button{flex:0 0 auto;height:44px;border:0;border-radius:10px;padding:0 18px;background:#2456D6;color:#fff;font:800 15px 'Montserrat',system-ui,sans-serif;cursor:pointer}
.dhk-zoek button:hover{background:#1B45B4}
.dhk-verborgen{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.dhk-prod{display:grid;grid-template-columns:60px minmax(0,1fr);gap:6px 12px;align-items:center;padding:13px 0;border-bottom:1px solid #E6EBF2}
.dhk-prod:first-child{padding-top:2px}
.dhk-prod:last-child{border-bottom:0}
.dhk-prod-im{width:60px;height:60px;border-radius:12px;background:#F4F7FF;display:flex;align-items:center;justify-content:center;overflow:hidden}
.dhk-prod-im img{max-width:50px;max-height:50px;object-fit:contain;mix-blend-mode:multiply}
.dhk-prod-n{font-size:15px;font-weight:800;line-height:1.25;margin:0;color:#0D1B2A;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.dhk-prod-w{min-width:0;grid-column:1 / -1}
@media(min-width:900px){.dhk-prod{grid-template-columns:84px minmax(0,1fr);align-items:start}.dhk-prod-im{grid-row:1 / span 2;width:84px;height:84px}.dhk-prod-im img{max-width:70px;max-height:70px}.dhk-prod-w{grid-column:2}}
/* Een algemeen script zet op elke kaart een knop "Mail deze deal". Hier niet:
   onder de uitkomst staat al het seintje, en de knop leidt af van de klik. */
.dhk .dpvmb{display:none !important}
.dhk a.dhk-w,.dhk a.dhk-w:visited{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;padding:0 12px;margin-top:6px;border-radius:12px;
  border:1.5px solid #D9E1EC;background:#fff;color:#0D1B2A !important;text-decoration:none !important;font-size:14px;font-weight:700}
.dhk a.dhk-w b{font-family:'Montserrat',system-ui,sans-serif;font-size:15.5px;font-weight:800;white-space:nowrap;font-variant-numeric:tabular-nums}
.dhk a.dhk-w b::after{content:' ›';font-weight:800}
/* de goedkoopste winkel is de doorklik: geel met donkere tekst */
.dhk a.dhk-w.eerste,.dhk a.dhk-w.eerste:visited{background:#F9C31F;border-color:#F9C31F;color:#0D1B2A !important;min-height:48px;font-weight:800}
.dhk a.dhk-w.eerste:hover{background:#EDB50C;border-color:#EDB50C}
.dhk a.dhk-w:not(.eerste):hover{border-color:#2456D6;background:#F3F7FF}
.dhk-w span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:flex;align-items:center}
.dhk-w i{flex:0 0 auto}
.dhk-w i{font-style:normal;font-size:10px;letter-spacing:.04em;text-transform:uppercase;font-weight:800;background:rgba(13,27,42,.12);color:#0D1B2A;border-radius:999px;padding:3px 7px;margin-left:7px}
/* Op een telefoon past het label "laagste" niet naast een lange winkelnaam en
   werd het afgesneden. De gele knop staat bovenaan en zegt het al. */
@media(max-width:480px){.dhk-w i{display:none}}
.dhk a.dhk-meer{display:inline-block;margin-top:7px;font-size:13px;font-weight:800;color:#2456D6 !important;text-decoration:none !important;padding:6px 0}

/* laden */
.dhk-laad i{display:block;height:58px;border-radius:12px;margin-bottom:8px;background:linear-gradient(90deg,#EAF1FF 0%,#F4F7FF 50%,#EAF1FF 100%);background-size:200% 100%;animation:dhk-l 1.2s linear infinite}
.dhk-laad i:first-child{height:150px}
@keyframes dhk-l{to{background-position:-200% 0}}
@media(prefers-reduced-motion:reduce){.dhk-laad i{animation:none}}

.dhk :focus-visible{outline:3px solid #2456D6;outline-offset:2px}

/* 5 okt, tweede stap: alle categorieen als tabblad */
.dhk-foto{flex:0 0 auto;width:54px;height:64px;border-radius:11px;background:#fff;border:1px solid #E6EBF2;display:flex;align-items:center;justify-content:center;overflow:hidden}
.dhk-foto img{max-width:46px;max-height:56px;object-fit:contain}
.dhk-alt-rij .dhk-foto{width:40px;height:48px;border-radius:9px}.dhk-alt-rij .dhk-foto img{max-width:34px;max-height:42px}
/* de waarschuwing blijft een eigen melding en wordt geen pil: die moet opvallen */
.dhk-let{font-size:12.5px;line-height:1.45;font-weight:600;color:#6B4A00;background:#FFF3CC;border-radius:10px;padding:8px 10px;margin:0 0 11px}
.dhk-prod-s{display:block;font-size:12px;font-weight:600;color:#5B6B80;margin-top:2px}
.dhk-w small{font:600 11.5px 'Montserrat',system-ui,sans-serif;opacity:.85;margin-left:3px}
.dhk-links{display:flex;flex-wrap:wrap;gap:8px}
.dhk-links a{color:#2456D6;font-weight:800;font-size:14px}

/* strook met logo's, onderaan in het bovenste vlak (variant H2) */
.dhk-strook{min-width:0;border-top:1px solid #CFDAF0;padding-top:12px;margin-top:2px}
.dhk-strook-kop{font-size:11.5px;line-height:1.2;font-weight:800;color:#5B6B80;text-transform:uppercase;letter-spacing:.08em;margin:0 0 8px;white-space:nowrap}
.dhk-logos{display:flex;gap:7px;flex-wrap:nowrap;overflow:hidden;min-width:0}
.dhk-logos img{flex:0 0 34px;width:34px;height:34px;border-radius:10px;border:1px solid #D9E1EC;background:#fff;padding:5px;object-fit:contain}
@media(min-width:900px){.dhk-strook{grid-column:1 / -1;display:flex;align-items:center;gap:18px;padding-top:18px;margin-top:0}
  .dhk-strook-kop{margin:0}.dhk-logos{gap:9px}.dhk-logos img{flex-basis:38px;width:38px;height:38px;border-radius:11px;padding:6px}}
</style>
<script>
(function () {
  var wortel = document.getElementById('dhk');
  if (!wortel) return;
  var A = function (n) { return wortel.getAttribute('data-' + n) || ''; };
  var WORKER = A('worker'), SHOP = A('shop'), BOOD = A('boodschappen'), ENERGIE = A('energie'), ZORG = A('zorg'), SEIN = A('seintje');
  var paneel = document.getElementById('dhk-paneel');

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function euro(v) {
    var r = Math.round(v * 100) / 100;
    var s = r % 1 === 0 ? String(r) : r.toFixed(2).replace('.', ',');
    return '€' + s.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }
  function meet(naam, extra) {
    try {
      var d = extra || {};
      if (typeof window.gtag === 'function') window.gtag('event', naam, d);
      else if (window.dataLayer && window.dataLayer.push) { d.event = naam; window.dataLayer.push(d); }
    } catch (e) {}
  }
  function json(url) { return fetch(url).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); }
  var LAAD = '<div class="dhk-laad" aria-hidden="true"><i></i><i></i><i></i></div>';

  var DOMEIN = { lebara: 'lebara.nl', youfone: 'youfone.nl', hollandsnieuwe: 'hollandsnieuwe.nl', simyo: 'simyo.nl', ben: 'ben.nl',
    kpn: 'kpn.com', odido: 'odido.nl', vodafone: 'vodafone.nl', ziggo: 'ziggo.nl', simpel: 'simpel.nl', onlinenl: 'online.nl',
    budgetmobiel: 'budgetmobiel.nl', delta: 'delta.nl' };
  function logo(dom) {
    if (!dom) return '';
    return '<img class="dhk-logo" alt="" loading="lazy" width="44" height="44" onerror="this.style.display=\'none\'" ' +
      'src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=128&amp;url=https://' + esc(dom) + '">';
  }
  function merkLogo(provider) { return logo(DOMEIN[String(provider || '').toLowerCase().replace(/[^a-z0-9]/g, '')]); }
  function foto(src) {
    return src ? '<span class="dhk-foto"><img src="' + esc(src) + '" alt="" loading="lazy" onerror="this.parentNode.style.display=\'none\'"></span>' : '';
  }
  function mnd(k) { return parseInt(String(k.contract || '').replace(/\D/g, ''), 10) || 0; }
  function duur(k) { var m = mnd(k); return m === 12 ? '1 jaar' : m === 24 ? '2 jaar' : m ? m + ' maanden' : 'maandelijks opzegbaar'; }
  function ga(k, cat) { return WORKER + '/api/go?u=' + encodeURIComponent(k.url) + '&cat=' + cat + '&p=' + encodeURIComponent(k.provider || ''); }
  function datum(iso) {
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || '');
    if (!m) return iso || '';
    return parseInt(m[3], 10) + ' ' + ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'][parseInt(m[2], 10) - 1] + ' ' + m[1];
  }

  var VERGOEDING = ' Aanbieders betalen niet voor een plek. Wij krijgen een vergoeding als je via ons afsluit; jij betaalt daardoor niets extra.';

  /* =====================================================================
     Tabbladen met een aanbod: een beste keuze en twee alternatieven.
     Elk item: naam, sub, prijs, per, onder, let, url, knop, beeld, aff.
     5 okt, nieuwe stijl: tags (kleine pillen onder de beste keuze, meestal
     looptijd en totaalbedrag) en kort (de kenmerken zonder de looptijd, want
     die staat dan al in een pil). Ontbreken ze, dan valt de kaart terug op
     onder en sub.
     ===================================================================== */
  var VINK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  var AANBOD = {
    sim: {
      vraag: 'Wat is voor jou belangrijk?',
      chips: [
        { id: 'alles', label: 'Laagste prijs', wat: 'laagste maandprijs', test: function () { return true; } },
        { id: 'data', label: 'Onbeperkt data', wat: 'laagste maandprijs met onbeperkt data', test: function (x) { return x.k.unlimited; } },
        { id: 'bellen', label: 'Onbeperkt bellen', wat: 'laagste maandprijs met onbeperkt bellen', test: function (x) { return /onbeperkt/i.test(x.k.minutes || ''); } },
        { id: 'jaar', label: '1 jaar contract', wat: 'laagste maandprijs met een contract van 1 jaar', test: function (x) { return mnd(x.k) === 12; } }
      ],
      laad: function () {
        return json(WORKER + '/api/cards/simonly?limit=60').then(function (j) {
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k) || 24;
            var d = k.unlimited ? 'Onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
            var b = /onbeperkt/i.test(k.minutes || '') ? 'onbeperkt bellen' : (k.minutes || '');
            var net = k.network && String(k.network).toLowerCase() !== String(k.provider).toLowerCase() ? 'netwerk van ' + k.network : '';
            return { k: k, naam: k.provider, sub: [d, b, duur(k), net].filter(Boolean).join(' · '), prijs: p, per: 'per maand',
              kort: [d, b, net].filter(Boolean).join(' · '), tags: [duur(k), euro(p * m) + ' over ' + m + ' maanden'],
              rang2: -(k.unlimited ? 9999 : k.dataGB || 0),
              onder: euro(p * m) + ' over ' + m + ' maanden', url: ga(k, 'simonly'), knop: k.provider, beeld: merkLogo(k.provider), aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste maandprijs binnen jouw keuze, bij een gelijke prijs de grootste bundel.' + VERGOEDING,
      alle: ['Alle sim only vergelijken', '/pages/sim-only'], sein: true
    },

    telefoon: {
      vraag: 'Welk toestel zoek je?',
      chips: [
        { id: 'alles', label: 'Laagste kosten', wat: 'laagste kosten per maand', test: function () { return true; } },
        { id: 'apple', label: 'iPhone', wat: 'voordeligste iPhone', test: function (x) { return /iphone/i.test(x.k.device); } },
        { id: 'samsung', label: 'Samsung', wat: 'voordeligste Samsung', test: function (x) { return /samsung/i.test(x.k.device); } },
        { id: 'pixel', label: 'Google Pixel', wat: 'voordeligste Pixel', test: function (x) { return /pixel/i.test(x.k.device); } },
        { id: 'nul', label: 'Geen bijbetaling', wat: 'laagste kosten zonder bijbetaling', test: function (x) { return !(parseFloat(x.k.downPayment) > 0); } }
      ],
      laad: function () {
        return json(WORKER + '/api/cards/telefoon?limit=60').then(function (j) {
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.device; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k) || 24, een = parseFloat(k.downPayment) || 0;
            var totaal = parseFloat(k.totalPrice) || (p * m + een);
            var toestel = parseFloat(k.deviceTotal) || 0, abbo = parseFloat(k.bundleMonthly) || 0;
            var d = k.unlimited ? 'onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
            var onder = toestel > 0 && abbo > 0
              ? 'Toestel ' + euro(toestel) + (een > 0 ? ', waarvan ' + euro(een) + ' vooraf' : '') + ' · abonnement ' + euro(abbo) + ' per maand'
              : euro(totaal) + ' over ' + m + ' maanden';
            return { k: k, naam: k.device, sub: [k.provider, d, k.minutes, duur(k)].filter(Boolean).join(' · '),
              prijs: p, per: een > 0 ? 'per maand + ' + euro(een) + ' vooraf' : 'per maand',
              rang: totaal / m, onder: onder + ' · samen ' + euro(totaal) + ' over ' + m + ' maanden',
              tags: (toestel > 0 && abbo > 0 ? ['Toestel ' + euro(toestel), 'Abonnement ' + euro(abbo) + ' p/m'] : [])
                .concat(['Samen ' + euro(totaal) + ' over ' + m + ' maanden']),
              url: ga(k, 'telefoon'), knop: k.provider, beeld: foto(k.image) || merkLogo(k.provider), aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste totale kosten per maand over de hele looptijd, dus toestel, abonnement en bijbetaling samen.' + VERGOEDING,
      alle: ['Alle telefoons met abonnement', '/pages/telefoonabonnement'], sein: true
    },

    internet: {
      vraag: 'Wat is voor jou belangrijk?',
      chips: [
        { id: 'alles', label: 'Laagste prijs', wat: 'laagste maandprijs', test: function () { return true; } },
        { id: 'snel', label: '1 Gbit of sneller', wat: 'laagste maandprijs vanaf 1 Gbit', test: function (x) { return x.k.speedMbit >= 1000; } },
        { id: 'tv', label: 'Met tv', wat: 'laagste maandprijs met tv', test: function (x) { return !!x.k.tv; } },
        { id: 'jaar', label: '1 jaar contract', wat: 'laagste maandprijs met een contract van 1 jaar', test: function (x) { return mnd(x.k) === 12; } }
      ],
      laad: function () {
        return json(WORKER + '/api/cards/internet?limit=60').then(function (j) {
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k);
            return { k: k, naam: k.provider, sub: [k.speed, k.tv ? 'met tv' : 'alleen internet', duur(k)].filter(Boolean).join(' · '),
              prijs: p, per: 'per maand', rang2: -(k.speedMbit || 0),
              kort: [k.speed, k.tv ? 'met tv' : 'alleen internet'].filter(Boolean).join(' · '),
              tags: [duur(k)].concat(m ? [euro(p * m) + ' over ' + m + ' maanden'] : []),
              onder: m ? euro(p * m) + ' over ' + m + ' maanden' : '', url: ga(k, 'internet'), knop: k.provider, beeld: merkLogo(k.provider), aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste maandprijs binnen jouw keuze, bij een gelijke prijs de hoogste snelheid. Controleer bij de aanbieder of dit op jouw adres kan.' + VERGOEDING,
      alle: ['Alle internetabonnementen', '/pages/internet-tv'], sein: true
    },

    energie: {
      vraag: 'Met hoeveel woon je?',
      start: 'samen',
      chips: ['alleen:Alleen', 'samen:Samen', 'gezin:Gezin', 'groot:Groot gezin'].map(function (s) {
        var d = s.split(':');
        return { id: d[0], label: d[1], wat: 'laagste jaarrekening', test: function (x) { return x.hh === d[0]; } };
      }),
      uniek: true,
      laad: function (tab) {
        return json(ENERGIE).then(function (j) {
          var uit = [];
          tab.voet = {};
          (j.huishoudens || []).forEach(function (h) {
            tab.voet[h.id] = 'Stroom en gas, ' + h.verbruik + ', zonder postcode gerekend. Tarieven laatst nagekeken op ' + datum(j.bijgehouden) + '.';
            (h.items || []).forEach(function (i) {
              uit.push({ hh: h.id, naam: i.naam, sub: i.soort, prijs: i.maand, per: 'per maand', rang: i.jaar,
                onder: euro(i.jaar) + ' per jaar, de hele rekening: levering, belasting en netbeheer',
                tags: [euro(i.jaar) + ' per jaar', 'incl. belasting en netbeheer'],
                let: i.korting ? 'Inclusief ' + i.korting + '. Die geldt alleen in het eerste jaar.' : '',
                url: i.url, knop: i.naam, beeld: logo(i.dom), aff: !!i.aff });
            });
          });
          return uit;
        });
      },
      regel: 'Zo kiezen wij: de laagste jaarrekening voor dit verbruik, een contract per leverancier. Dynamische contracten doen niet mee, want dat is een schatting. Leveranciers betalen niet voor een plek. Bij een deel van de leveranciers krijgen wij een vergoeding als je afsluit; jij betaalt daardoor niets extra.',
      alle: ['Reken met je eigen verbruik en postcode', '/pages/energie']
    },

    zorg: {
      vraag: 'Wat is voor jou belangrijk?',
      chips: [
        { id: 'alles', label: 'Laagste premie', wat: 'laagste premie', test: function () { return true; } },
        { id: 'er', label: 'Eigen risico €385', wat: 'laagste premie met het gewone eigen risico', test: function (x) { return x.er <= 385; } },
        { id: 'vrij', label: 'Vrije zorgkeuze', wat: 'laagste premie met vrije zorgkeuze', test: function (x) { return x.polis !== 'natura'; } }
      ],
      laad: function () {
        return fetch(ZORG).then(function (r) { return r.text(); }).then(function (html) {
          var a = html.indexOf('var RUW = ['), uit = [];
          if (a < 0) throw new Error('geen polissen');
          var blok = html.slice(a, html.indexOf('];', a));
          var re = /naam:\s*("(?:[^"\\]|\\.)*"),\s*verz:\s*("(?:[^"\\]|\\.)*"),\s*premie:\s*Number\("([\d.]+)"\),\s*er:\s*Number\("(\d+)"\),\s*polis:\s*("(?:[^"\\]|\\.)*"),\s*kenmerken:\s*("(?:[^"\\]|\\.)*"),\s*partner:\s*("(?:[^"\\]|\\.)*"),\s*url:\s*("(?:[^"\\]|\\.)*")/g, m;
          while ((m = re.exec(blok))) {
            try {
              var premie = parseFloat(m[3]), er = parseInt(m[4], 10), polis = JSON.parse(m[5]), partner = JSON.parse(m[7]), url = JSON.parse(m[8]);
              if (!(premie > 0) || !url) continue;
              uit.push({ er: er, polis: polis, naam: JSON.parse(m[1]),
                sub: [JSON.parse(m[2]), polis === 'natura' ? 'naturapolis' : polis + 'polis', 'eigen risico ' + euro(er)].join(' · '),
                prijs: premie, per: 'per maand', onder: euro(premie * 12) + ' per jaar',
                let: er > 385 ? 'Let op: eigen risico ' + euro(er) + ' in plaats van €385. Je betaalt minder premie, maar meer als je zorg nodig hebt.' : '',
                url: url, knop: partner, beeld: '', aff: true });
            } catch (e) {}
          }
          if (!uit.length) throw new Error('geen polissen');
          return uit;
        });
      },
      regel: 'Zo kiezen wij: de laagste premie binnen jouw keuze, uit een selectie van basisverzekeringen. Wij vragen geen leeftijd of gezondheidsgegevens. Controleer het bedrag bij de verzekeraar voordat je afsluit.' + VERGOEDING,
      alle: ['Alle premies en uitleg', ZORG]
    }
  };

  function tekenAanbod(naam) {
    var tab = AANBOD[naam], st = staat[naam];
    var chip = tab.chips.filter(function (c) { return c.id === st.keuze; })[0] || tab.chips[0];
    var lijst = st.items.filter(chip.test).sort(function (a, b) {
      return ((a.rang != null ? a.rang : a.prijs) - (b.rang != null ? b.rang : b.prijs)) || ((a.rang2 || 0) - (b.rang2 || 0));
    });
    if (tab.uniek) { var gehad = {}; lijst = lijst.filter(function (x) { if (gehad[x.naam]) return false; gehad[x.naam] = 1; return true; }); }
    var uit = paneel.querySelector('.dhk-uit');
    if (!uit) return;
    if (!lijst.length) { uit.innerHTML = '<p class="dhk-leeg">Hiervoor hebben wij nu geen aanbod. Kies een andere optie.</p>'; return; }
    function rel(x) { return x.aff ? 'nofollow sponsored noopener' : 'nofollow noopener'; }
    var b = lijst[0];
    var h = '<div class="dhk-best">' +
      '<span class="dhk-lab">' + VINK + 'Beste keuze · ' + esc(chip.wat) + '</span>' +
      '<div class="dhk-best-rij">' + (b.beeld || '') +
        '<div class="dhk-best-naam"><b>' + esc(b.naam) + '</b><span>' + esc(b.tags && b.kort ? b.kort : b.sub) + '</span></div>' +
        '<div class="dhk-prijs">' + euro(b.prijs) + '<small>' + esc(b.per) + '</small></div>' +
      '</div>' +
      '<p class="dhk-tags">' + (b.tags || (b.onder ? [b.onder] : [])).map(function (t) { return '<span>' + esc(t) + '</span>'; }).join('') + '</p>' +
      (b.let ? '<p class="dhk-let">' + esc(b.let) + '</p>' : '') +
      '<a class="dhk-knop" rel="' + rel(b) + '" target="_blank" href="' + esc(b.url) + '" data-pos="1" data-naam="' + esc(b.knop) + '">Bekijk bij ' + esc(b.knop) + ' ›</a>' +
      '</div>';
    var rest = lijst.slice(1, 3);
    if (rest.length) {
      h += '<div class="dhk-alt">' + rest.map(function (x, n) {
        return '<a class="dhk-alt-rij" rel="' + rel(x) + '" target="_blank" href="' + esc(x.url) + '" data-pos="' + (n + 2) + '" data-naam="' + esc(x.knop) + '">' +
          (x.beeld || '') +
          '<span class="dhk-alt-naam"><b>' + esc(x.naam) + '</b><span>' + esc(x.sub) + '</span></span>' +
          '<span class="dhk-prijs">' + euro(x.prijs) + '<small>' + esc(x.per).replace(' + ', '<br>+ ') + '</small></span>' +
          '<span class="dhk-ga">Bekijk ›</span></a>';
      }).join('') + '</div>';
    }
    uit.innerHTML = h;
    var voet = paneel.querySelector('.dhk-voet');
    if (voet) voet.textContent = tab.voet ? (tab.voet[chip.id] || '') + ' ' : '';
  }

  /* =====================================================================
     Tabbladen met producten: per product de winkels op prijs.
     Elk product: naam, sub, im, rijen [{winkel, prijs, klein, url, aff, intern}], meer.
     ===================================================================== */
  function goed(x) {
    // Zelfde rem als in de productrijen: een winkel die meer dan 40% onder de
    // volgende zit, heeft bijna altijd een fout in de feed.
    if (!x || !x.o || !x.o.length || !(x.p > 0)) return false;
    var o = x.o.slice().sort(function (a, b) { return a.p - b.p; });
    if (o.length > 1 && o[0].p < o[1].p * 0.6) return false;
    return true;
  }
  function shopKaart(x) {
    var link = SHOP + '/api/shop/go?i=' + encodeURIComponent(x.i) + '&cat=' + encodeURIComponent(x.c);
    var o = x.o.slice().sort(function (a, b) { return a.p - b.p; });
    return { naam: x.n, im: x.im,
      rijen: o.slice(0, 3).map(function (w) {
        return { winkel: w.w === 'bol.com partner' ? 'bol.com (partner)' : w.w, ruw: w.w, prijs: euro(w.p), url: link + '&w=' + encodeURIComponent(w.w), aff: true };
      }),
      meer: o.length > 3 ? ['+ ' + (o.length - 3) + (o.length - 3 === 1 ? ' winkel' : ' winkels'), '/pages/vergelijken?cat=' + encodeURIComponent(x.c) + '&q=' + encodeURIComponent(x.n)] : null };
  }
  var shopCache = {};
  function shopProduct(id, cat) {
    var s = id + '|' + cat;
    if (!shopCache[s]) shopCache[s] = json(SHOP + '/api/shop/product?i=' + encodeURIComponent(id) + '&cat=' + encodeURIComponent(cat))
      .then(function (j) { return j.product || null; }).catch(function () { return null; });
    return shopCache[s];
  }
  // Bron van een snelkeuze: "id:cat,id:cat" of "lijst:cat:type:minprijs".
  function shopBron(bron) {
    if (shopCache[bron]) return shopCache[bron];
    var p;
    if (bron.indexOf('lijst:') === 0) {
      var d = bron.split(':'), q = new URLSearchParams({ cat: d[1], multi: '1', n: '30', sort: 'prijs' });
      if (d[2]) q.set('type', d[2]);
      if (d[3]) q.set('min', d[3]);
      p = json(SHOP + '/api/shop/lijst?' + q.toString()).then(function (j) {
        var gehad = {}, uit = [];
        (j.items || []).filter(goed).forEach(function (x) {
          var fam = String(x.n).toLowerCase().split(/\s+/).slice(0, 2).join(' ');
          if (gehad[fam] || uit.length >= 3) return;
          gehad[fam] = 1; uit.push(x);
        });
        return uit;
      });
    } else {
      p = Promise.all(bron.split(',').map(function (s) { var d = s.trim().split(':'); return d.length === 2 ? shopProduct(d[0], d[1]) : null; }))
        .then(function (r) { return r.filter(goed); });
    }
    shopCache[bron] = p.then(function (r) { return r.map(shopKaart); });
    return shopCache[bron];
  }
  function groepen(tekst) {
    return String(tekst || '').split(/\n/).map(function (r) { return r.trim().split('|'); })
      .filter(function (d) { return d.length >= 3 && d[0]; })
      .map(function (d, n) { return { id: 'g' + n, label: d[0].trim(), meer: d[1].trim(), bron: d[2].trim() }; });
  }

  var PROD = {
    prod: {
      zoek: true, chips: groepen(A('prod')),
      laad: function (chip) { return shopBron(chip.bron); },
      alle: function (chip) { return chip.meer ? ['Alle ' + chip.label.toLowerCase() + ' vergelijken', '/pages/vergelijken?cat=' + encodeURIComponent(chip.meer)] : ['Alle producten vergelijken', '/pages/vergelijken']; },
      regel: 'Per product staan de winkels op prijs, de laagste bovenaan. Winkels betalen niet voor een plek. Wij krijgen een vergoeding als je via ons koopt; jij betaalt daardoor niets extra.'
    },
    gaming: {
      chips: groepen(A('gaming')),
      laad: function (chip) { return shopBron(chip.bron); },
      alle: function () { return ['Alle gaming-aanbiedingen', '/pages/gaming']; },
      regel: 'Per product staan de winkels op prijs, de laagste bovenaan. Winkels betalen niet voor een plek. Wij krijgen een vergoeding als je via ons koopt; jij betaalt daardoor niets extra.'
    },
    boodschappen: {
      chips: [{ id: 'top', label: 'Meeste winkels' }],
      voor: function (tab) {
        // Een keer alles ophalen; de snelkeuzes zijn de categorieen waarin deze
        // week genoeg te vergelijken valt.
        return json(BOOD + '/sm/api/deals').then(function (j) {
          var P = (j.producten || []).map(function (p) {
            var d = (p.deals || []).filter(function (x) { return x.perEenheid > 0 && x.winkelNaam && !x.mechaniekOnzeker; })
              .sort(function (a, b) { return a.perEenheid - b.perEenheid; });
            var gehad = {}; d = d.filter(function (x) { if (gehad[x.winkel]) return false; gehad[x.winkel] = 1; return true; });
            return { p: p, d: d };
          }).filter(function (x) {
            // Zit de laagste meer dan 40% onder de volgende, dan is het meestal een
            // andere verpakking of een leesfout in de folder. Dan liever niet tonen.
            return x.p.vergelijkbaar && x.d.length >= 2 && x.d[0].perEenheid >= x.d[1].perEenheid * 0.6;
          })
            .sort(function (a, b) { return b.d.length - a.d.length; });
          tab.P = P;
          var tel = {};
          P.forEach(function (x) { tel[x.p.categorie] = (tel[x.p.categorie] || 0) + 1; });
          Object.keys(tel).filter(function (c) { return tel[c] >= 2; }).sort(function (a, b) { return tel[b] - tel[a]; }).slice(0, 5)
            .forEach(function (c, n) { tab.chips.push({ id: 'c' + n, label: c, cat: c }); });
        });
      },
      laad: function (chip, tab) {
        var P = (tab.P || []).filter(function (x) { return !chip.cat || x.p.categorie === chip.cat; }).slice(0, 3);
        return Promise.resolve(P.map(function (x) {
          var e = x.p.eenheid || 'stuk', pagina = '/pages/boodschappen?zoek=' + encodeURIComponent(x.p.merk || x.p.naam);
          return { naam: x.p.naam, sub: 'Aanbiedingen van deze week, prijs per ' + e, im: x.p.afbeelding,
            rijen: x.d.slice(0, 3).map(function (w) {
              return { winkel: w.winkelNaam, ruw: w.winkelNaam, prijs: euro(w.perEenheid), klein: 'per ' + e,
                url: w.bestelUrl || pagina, aff: !!w.bestelUrl, intern: !w.bestelUrl };
            }),
            meer: x.d.length > 3 ? ['+ ' + (x.d.length - 3) + (x.d.length - 3 === 1 ? ' winkel' : ' winkels'), pagina] : null };
        }));
      },
      alle: function () { return ['Alle aanbiedingen van deze week', '/pages/boodschappen']; },
      regel: 'Per product staan de winkels op prijs per liter, kilo of stuk, de laagste bovenaan. De prijzen komen uit de folders en sites van de supermarkten. Bij een winkel waar je online kunt bestellen krijgen wij een vergoeding als je via ons bestelt.'
    }
  };

  function tekenProd(naam) {
    var tab = PROD[naam], st = staat[naam];
    var chip = tab.chips.filter(function (c) { return c.id === st.keuze; })[0] || tab.chips[0];
    var uit = paneel.querySelector('.dhk-uit');
    if (!uit || !chip) return;
    uit.innerHTML = LAAD;
    var alle = paneel.querySelector('.dhk-alle'), a = tab.alle(chip);
    if (alle) { alle.href = a[1]; alle.textContent = a[0] + ' ›'; }
    var mijn = ++st.vraag;
    tab.laad(chip, tab).then(function (items) {
      if (mijn !== st.vraag || actief !== naam) return;
      if (!items.length) { uit.innerHTML = '<p class="dhk-leeg">Hier valt nu niets te vergelijken. Kies een andere optie.</p>'; return; }
      uit.innerHTML = items.map(function (x, pn) {
        var rijen = x.rijen.map(function (w, n) {
          return '<a class="dhk-w' + (n === 0 ? ' eerste' : '') + '"' + (w.intern ? '' : ' rel="' + (w.aff ? 'nofollow sponsored noopener' : 'nofollow noopener') + '" target="_blank"') +
            ' href="' + esc(w.url) + '" data-pos="' + (pn + 1) + '.' + (n + 1) + '" data-naam="' + esc(w.ruw) + '">' +
            '<span>' + (n === 0 ? 'Bekijk bij ' : '') + esc(w.winkel) + (n === 0 && x.rijen.length > 1 ? '<i>laagste</i>' : '') + '</span>' +
            '<b>' + w.prijs + (w.klein ? '<small>' + esc(w.klein) + '</small>' : '') + '</b></a>';
        }).join('');
        return '<div class="dhk-prod">' +
          '<div class="dhk-prod-im">' + (x.im ? '<img src="' + esc(x.im) + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">' : '') + '</div>' +
          '<p class="dhk-prod-n">' + esc(x.naam) + (x.sub ? '<span class="dhk-prod-s">' + esc(x.sub) + '</span>' : '') + '</p>' +
          '<div class="dhk-prod-w">' + rijen + (x.meer ? '<a class="dhk-meer" href="' + esc(x.meer[1]) + '">' + esc(x.meer[0]) + ' ›</a>' : '') + '</div></div>';
      }).join('');
    }).catch(function () { fout(naam); });
  }

  /* =====================================================================
     Tabbladen
     ===================================================================== */
  var staat = {}, actief = '';
  var PAGINA = { sim: '/pages/sim-only', telefoon: '/pages/telefoonabonnement', internet: '/pages/internet-tv', energie: '/pages/energie',
    zorg: ZORG, prod: '/pages/vergelijken', gaming: '/pages/gaming', boodschappen: '/pages/boodschappen' };

  function fout(naam) {
    if (actief !== naam) return;
    var uit = paneel.querySelector('.dhk-uit') || paneel;
    uit.innerHTML = '<p class="dhk-leeg">De prijzen laden nu niet. De volledige vergelijker werkt wel.</p>';
  }
  function chipsHtml(chips, keuze) {
    return '<div class="dhk-chips">' + chips.map(function (c) {
      var aan = c.id === keuze;
      return '<button type="button" class="dhk-chip' + (aan ? ' aan' : '') + '" data-chip="' + esc(c.id) + '" aria-pressed="' + (aan ? 'true' : 'false') + '">' + esc(c.label) + '</button>';
    }).join('') + '</div>';
  }
  function sein() {
    if (!SEIN) return '';
    return '<a class="dhk-sein" href="' + esc(SEIN) + '">' +
      '<span class="dhk-sein-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7 2.5 7h-17S6 15 6 9Z"/><path d="M10 20a2.2 2.2 0 0 0 4 0"/></svg></span>' +
      '<span><b>Zit je nog vast aan je contract?</b><br>Krijg een mail op de dag dat je kunt overstappen.</span>' +
      '<span class="dhk-pijl" aria-hidden="true">›</span></a>';
  }
  // "Hoe is deze lijst bepaald?" staat nu voor de uitleg. De aanhef "Zo kiezen
  // wij:" zou dan dubbel zijn en valt weg; de rest van de tekst is ongewijzigd.
  var HOE = '<b class="dhk-hoe">Hoe is deze lijst bepaald?</b> ';
  function uitleg(t) { t = String(t || '').replace(/^Zo kiezen wij:\s*/, ''); return esc(t.charAt(0).toUpperCase() + t.slice(1)); }
  function bouw(naam) {
    var st = staat[naam];
    if (AANBOD[naam]) {
      var t = AANBOD[naam];
      var chips = t.chips.filter(function (c) { return st.items.some(c.test); });
      paneel.innerHTML = '<p class="dhk-vraag">' + esc(t.vraag) + '</p>' + chipsHtml(chips, st.keuze) +
        '<div class="dhk-uit" aria-live="polite"></div>' +
        '<p class="dhk-regel">' + HOE + '<span class="dhk-voet"></span>' + uitleg(t.regel) + '</p>' +
        '<a class="dhk-alle" href="' + esc(t.alle[1]) + '">' + esc(t.alle[0]) + ' ›</a>' + (t.sein ? sein() : '');
      tekenAanbod(naam);
    } else {
      var p = PROD[naam];
      paneel.innerHTML = (p.zoek ? '<form class="dhk-zoek" action="/pages/vergelijken" method="get" role="search">' +
          '<label for="dhk-q" class="dhk-verborgen">Zoek een product</label>' +
          '<input id="dhk-q" name="q" type="search" autocomplete="off" placeholder="Zoek op merk of model" enterkeyhint="search">' +
          '<button type="submit">Zoek</button></form>' : '') +
        chipsHtml(p.chips, st.keuze) + '<div class="dhk-uit" aria-live="polite"></div>' +
        '<p class="dhk-regel">' + HOE + uitleg(p.regel) + '</p><a class="dhk-alle" href="' + esc(PAGINA[naam]) + '"></a>';
      tekenProd(naam);
    }
  }
  function open(naam) {
    actief = naam;
    paneel.setAttribute('aria-labelledby', 'dhk-t-' + naam);
    var st = staat[naam];
    if (st && st.klaar) return bouw(naam);
    paneel.innerHTML = LAAD;
    if (st) return; // wordt al opgehaald
    st = staat[naam] = { vraag: 0 };
    var t = AANBOD[naam], p = PROD[naam];
    var klaar = t
      ? t.laad(t).then(function (items) { if (!items.length) throw new Error('leeg'); st.items = items; st.keuze = t.start || t.chips[0].id; })
      : (p.voor ? p.voor(p) : Promise.resolve()).then(function () { if (!p.chips.length) throw new Error('leeg'); st.keuze = p.chips[0].id; });
    klaar.then(function () { st.klaar = true; if (actief === naam) bouw(naam); })
      .catch(function () { delete staat[naam]; if (actief === naam) paneel.innerHTML = '<p class="dhk-leeg">De prijzen laden nu niet. De volledige vergelijker werkt wel.</p>' +
        '<a class="dhk-alle" href="' + esc(PAGINA[naam]) + '">Naar de vergelijker ›</a>'; });
  }

  var tabs = [].slice.call(wortel.querySelectorAll('button.dhk-tab'));
  function kiesTab(naam, focus) {
    tabs.forEach(function (t) {
      var aan = t.getAttribute('data-tab') === naam;
      t.classList.toggle('aan', aan);
      t.setAttribute('aria-selected', aan ? 'true' : 'false');
      t.tabIndex = aan ? 0 : -1;
      if (aan && focus) t.focus();
      if (aan && t.scrollIntoView && t.parentNode.scrollWidth > t.parentNode.clientWidth) {
        t.parentNode.scrollLeft = Math.max(0, t.offsetLeft - t.parentNode.offsetLeft - 40);
      }
    });
    open(naam);
    try { sessionStorage.setItem('dhk-tab', naam); } catch (e) {}
  }
  tabs.forEach(function (t, n) {
    t.addEventListener('click', function () { kiesTab(t.getAttribute('data-tab')); meet('dhk_tab', { tab: t.getAttribute('data-tab') }); });
    t.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      kiesTab(tabs[(n + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length].getAttribute('data-tab'), true);
    });
  });

  paneel.addEventListener('click', function (e) {
    var c = e.target.closest ? e.target.closest('.dhk-chip') : null;
    if (c) {
      staat[actief].keuze = c.getAttribute('data-chip');
      [].forEach.call(paneel.querySelectorAll('.dhk-chip'), function (x) { var a = x === c; x.classList.toggle('aan', a); x.setAttribute('aria-pressed', a ? 'true' : 'false'); });
      if (AANBOD[actief]) tekenAanbod(actief); else tekenProd(actief);
      meet('dhk_keuze', { tab: actief, keuze: c.textContent.trim() });
      return;
    }
    var a = e.target.closest ? e.target.closest('a[data-pos]') : null;
    if (a) meet('dhk_klik', { tab: actief, keuze: (staat[actief] || {}).keuze || '', positie: a.getAttribute('data-pos'), aanbieder: a.getAttribute('data-naam') });
  });

  var begin = 'sim';
  try { var b = sessionStorage.getItem('dhk-tab'); if (b && (AANBOD[b] || PROD[b])) begin = b; } catch (e) {}
  kiesTab(begin);
})();
</script>

