{%- comment -%}
  Hero: wat het vandaag kost.

  Nu staan de prijzen voorop. Dat is het enige wat wij kunnen tonen en de rest
  niet: echte bedragen uit de feeds, vanochtend gemeten.

  Onder elk bedrag staat wat het over de hele looptijd kost. Bij zorg staat er
  het eigen risico bij, want de goedkoopste polis heeft er een van 885 euro.

  De bedragen komen live uit de worker. Valt die uit, dan blijven de waarden
  staan die hieronder als instelling zijn ingevuld.

  20 sep:
  - "Bekijk alle prijzen" ging naar de telefoonvergelijker, terwijl de hero vijf
    categorieën toont. Nu naar /pages/alle-prijzen, met per categorie de
    laagste deals en affiliate-knoppen. De link staat in een NIEUWE instelling
    (knop_url_2): de oude waarde staat vast in index.json, en dat bestand is via
    de API niet te schrijven. Een nieuwe id krijgt gewoon zijn standaardwaarde.
  - "Of zoek zelf" ging naar sim only. Nu een zoekbalk: die opent de Zoekhulp
    (dpv-ai-zoek) met de vraag al ingevuld, zodat je in gewone taal kunt zoeken
    in alle categorieën. Is de Zoekhulp er niet, dan valt hij terug op de
    zoekpagina van de winkel.

  5 okt, huisstijl "2-rond" (STIJLGIDS.md): licht in plaats van donkerblauw.
  In de compacte stand heet het blok "Alle vergelijkers" en heeft elke tegel
  een naam met een regel eronder. Bij sim only, telefoon en internet staat er
  "vanaf" voor het bedrag, want dat is de laagste prijs uit de feed.
{%- endcomment -%}

<script>if(!document.getElementById('dpv-mont')){var l=document.createElement('link');l.id='dpv-mont';l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap';document.head.appendChild(l);}</script>

{%- assign peil = section.settings.peildatum -%}

{%- comment -%} 5 okt: compact. Staat de kiezer erboven, dan toont dit blok alleen nog de
   tegels, met een kleine kop in plaats van de grote kop, knop en zoekbalk. {%- endcomment -%}
<section class="dhr{% if section.settings.compact %} dhr-compact{% endif %}" data-worker="{{ section.settings.worker_url }}">
  <div class="dhr-in">

    {%- if section.settings.compact -%}
    <h2 class="dhr-ckop">{{ section.settings.compact_kop }}</h2>
    {%- else -%}
    <div class="dhr-links">
      <p class="dhr-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.kop }}</h1>
      <p class="dhr-sub">{{ section.settings.sub }}</p>

      <div class="dhr-knoppen">
        <a class="dhr-knop" href="{{ section.settings.knop_url_2 }}">{{ section.settings.knop_tekst }}</a>
      </div>

      <form class="dhr-zoek" id="dhr-zoek" action="/search" method="get" role="search">
        <label for="dhr-zoek-in" class="dhr-verborgen">Zoek zelf</label>
        <svg class="dhr-zoek-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="dhr-zoek-in" name="q" type="search" autocomplete="off" placeholder="{{ section.settings.zoek_placeholder }}">
        <button type="submit">Zoek</button>
      </form>

      {%- if section.settings.merken != blank -%}
      <div class="dhr-merken">
        <p class="dhr-merken-kop">{{ section.settings.merken_kop }}</p>
        <div class="dhr-logos">
          {%- assign merken = section.settings.merken | split: ',' -%}
          {%- for m in merken -%}
            {%- assign d = m | strip -%}
            {%- if d != blank -%}
              <img src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=64&amp;url=https://{{ d }}"
                   alt="{{ d | split: '.' | first | capitalize }}" loading="lazy" width="22" height="22"
                   onerror="this.style.display='none'">
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.merken_rest != blank -%}
            <span class="dhr-rest">{{ section.settings.merken_rest }}</span>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="dhr-rechts" id="dhr-rijen">
      {%- assign rijen = section.settings.rijen | newline_to_br | split: '<br />' -%}
      {%- for r in rijen -%}
        {%- assign d = r | strip | split: '|' -%}
        {%- if d.size >= 4 -%}
          {%- assign cat = d[0] | strip -%}
          <a class="dhr-rij" href="{{ d[4] | default: '#' | strip }}" data-cat="{{ cat }}">
            <span class="dhr-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {%- case cat -%}
                {%- when 'simonly' -%}<path d="M6 3.5h8l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z"/><rect x="8.5" y="11" width="7" height="7" rx="1.2"/>
                {%- when 'telefoon' -%}<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>
                {%- when 'internet' -%}<path d="M2.5 8.5a16 16 0 0 1 19 0M5.5 12a11 11 0 0 1 13 0M8.5 15.5a6 6 0 0 1 7 0"/><path d="M12 19h.01"/>
                {%- when 'energie' -%}<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>
                {%- when 'zorg' -%}<path d="M12 2.5l8 3v6c0 5-3.5 8.3-8 10-4.5-1.7-8-5-8-10v-6z"/><path d="M12 8v7M8.5 11.5h7"/>
                {%- when 'boodschappen' -%}<path d="M3 9h18l-2 10.5H5L3 9zM8 9l3-5M16 9l-3-5"/>
                {%- when 'producten' -%}<rect x="3" y="4.5" width="18" height="12" rx="1.8"/><path d="M8 20h8M12 16.5V20"/>
                {%- when 'gaming' -%}<path d="M7.5 7.5h9a5 5 0 0 1 4.9 4l.9 4.6a2.4 2.4 0 0 1-4.2 2l-1.9-2.1H7.8l-1.9 2.1a2.4 2.4 0 0 1-4.2-2l.9-4.6a5 5 0 0 1 4.9-4Z"/><path d="M7.2 10.6v3M5.7 12.1h3"/>
                {%- else -%}<path d="M12 4v16M5 7h14M5 7l-2.5 6a2.8 2.8 0 0 0 5 0L5 7ZM19 7l-2.5 6a2.8 2.8 0 0 0 5 0L19 7ZM8.5 20h7"/>
              {%- endcase -%}
            </svg></span>
            <span class="dhr-naam">{{ d[1] | strip }}{%- if d[5] != blank %} <i class="dhr-nw">{{ d[5] | strip }}</i>{% endif -%}</span>
            <span class="dhr-onder" data-veld="onder">{{ d[3] | strip }}</span>
            <span class="dhr-regel">{%- if cat == 'simonly' or cat == 'telefoon' or cat == 'internet' -%}vanaf {% endif -%}<span class="dhr-prijs" data-veld="prijs">{{ d[2] | strip }}</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
  <p class="dhr-fijn">{{ section.settings.fijn | replace: '[peil]', peil }}</p>
</section>

<style>
/* 5 okt, huisstijl "2-rond": dit blok was donkerblauw en is nu licht. Op de
   homepage staat het in de compacte stand: een raster met acht tegels onder de
   kiezer, afwisselend blauw en groen getint. De gewone stand (grote kop, knop
   en zoekbalk) wordt niet meer gebruikt en is alleen leesbaar licht gemaakt. */
.dhr{background:#fff;color:#0D1B2A;font-family:'Montserrat',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
.dhr *{box-sizing:border-box}
.dhr-in{max-width:1180px;margin:0 auto;padding:30px 16px 10px;display:grid;gap:24px;grid-template-columns:minmax(0,1fr)}
@media(min-width:900px){.dhr-in{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:44px;padding:44px 20px 16px;align-items:start}}

.dhr-eyebrow{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:#5B6B80;font-weight:800;margin:0 0 9px}
.dhr h1{font-family:'Montserrat',system-ui,sans-serif;font-size:28px;line-height:1.05;letter-spacing:-.03em;font-weight:800;margin:0 0 10px;color:#0D1B2A}
@media(min-width:900px){.dhr h1{font-size:46px}}
.dhr-sub{font-size:15px;line-height:1.55;color:#4A5A70;font-weight:500;margin:0 0 20px;max-width:46ch}

/* de knop gaat naar een eigen pagina en niet naar een aanbieder: blauw */
.dhr-knoppen{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 12px}
.dhr a.dhr-knop,.dhr a.dhr-knop:visited{display:flex;align-items:center;justify-content:center;min-height:50px;padding:0 24px;
  background:#2456D6;color:#fff !important;border-radius:12px;font-size:15px;font-weight:800;text-decoration:none !important}
.dhr a.dhr-knop:hover{background:#1B45B4}
@media(max-width:560px){.dhr a.dhr-knop{width:100%}}

.dhr-zoek{position:relative;display:flex;align-items:center;gap:0;margin:0 0 22px;max-width:520px;
  background:#fff;border:1.5px solid #D9E1EC;border-radius:12px;padding:4px 4px 4px 0}
.dhr-zoek:focus-within{border-color:#2456D6}
.dhr-zoek-ic{flex:0 0 auto;margin:0 8px 0 14px;color:#5B6B80}
.dhr-zoek input{flex:1;min-width:0;height:42px;border:0;background:transparent;color:#0D1B2A;font-size:15px;font-family:inherit;outline:none;box-shadow:none}
.dhr-zoek input::placeholder{color:#5B6B80}
.dhr-zoek input::-webkit-search-cancel-button{display:none}
.dhr-zoek button{flex:0 0 auto;height:42px;border:0;border-radius:10px;padding:0 18px;background:#2456D6;color:#fff;font-weight:800;font-size:14.5px;cursor:pointer;font-family:inherit}
.dhr-zoek button:hover{background:#1B45B4}
.dhr-verborgen{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.dhr-merken{padding-top:16px;border-top:1px solid #E6EBF2}
.dhr-merken-kop{font-size:11.5px;font-weight:700;color:#5B6B80;margin:0 0 9px}
.dhr-logos{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.dhr-logos img{width:22px;height:22px;border-radius:5px;object-fit:contain}
.dhr-rest{font-size:11.5px;font-weight:600;color:#5B6B80}

/* 5 okt: tegels in twee kolommen met een pictogram, in plaats van een lijst.
   Korter op een telefoon, en producten, gaming en boodschappen passen erbij.
   Nieuwe stijl: geen rand, om en om blauw en groen getint. */
.dhr-rechts{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:9px;align-content:start}
.dhr a.dhr-rij,.dhr a.dhr-rij:visited{display:flex;flex-direction:column;background:#EAF1FF;border:0;
  border-radius:16px;padding:15px;text-decoration:none !important;color:#0D1B2A !important;transition:background .14s;min-width:0}
.dhr a.dhr-rij:nth-child(even){background:#E3F4EB}
.dhr a.dhr-rij:hover{background:#DDE8FF}
.dhr a.dhr-rij:nth-child(even):hover{background:#D5EEE1}
.dhr-ic{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;color:#2456D6;background:#fff}
.dhr-ic svg{width:22px;height:22px}
.dhr-naam{font-family:'Montserrat',system-ui,sans-serif;font-size:16px;font-weight:800;line-height:1.2;letter-spacing:-.01em}
.dhr-nw{font-style:normal;font-family:'Montserrat',system-ui,sans-serif;font-size:9.5px;font-weight:800;letter-spacing:.04em;background:#2456D6;color:#fff;border-radius:999px;padding:2px 7px;vertical-align:middle;white-space:nowrap}
.dhr-onder{display:block;font-size:12px;font-weight:600;color:#4A5A70;margin:3px 0 8px;line-height:1.35}
.dhr-regel{margin-top:auto;font-size:12.5px;line-height:1.4;font-weight:700;color:#4A5A70;font-variant-numeric:tabular-nums}
.dhr-prijs{font-weight:700}
@media(min-width:900px){.dhr-rechts{gap:12px}.dhr-naam{font-size:17px}}

/* compact: naam met een regel eronder. De lange onderregel (totaal over de
   looptijd) staat al in de kiezer erboven en blijft hier weg. */
.dhr-compact .dhr-in{display:block;padding:26px 16px 10px}
@media(min-width:900px){.dhr-compact .dhr-in{padding:34px 20px 14px}.dhr-compact .dhr-rechts{grid-template-columns:repeat(4,minmax(0,1fr))}}
.dhr-compact .dhr-onder{display:none}
.dhr-compact .dhr-regel{margin-top:3px}
.dhr-ckop{font-family:'Montserrat',system-ui,sans-serif;font-size:21px;line-height:1.2;font-weight:800;letter-spacing:-.025em;color:#0D1B2A;margin:0 0 11px}
@media(min-width:900px){.dhr-ckop{font-size:26px;margin-bottom:14px}}
.dhr-fijn{max-width:1180px;margin:0 auto;padding:0 16px 22px;font-size:11.5px;font-weight:500;color:#5B6B80;line-height:1.5}
@media(min-width:900px){.dhr-fijn{padding:0 20px 26px}}
.dhr :focus-visible{outline:3px solid #2456D6;outline-offset:2px}
</style>

<script>
(function () {
  var wortel = document.querySelector('.dhr');
  if (!wortel) return;

  // Zoekbalk: naar de Zoekhulp met de vraag al ingevuld. De Zoekhulp zet zijn
  // veld in een paneel dat pas bestaat na het openen, dus eerst openen via de
  // zwevende knop, dan het veld vullen en op zoeken drukken.
  var form = document.getElementById('dhr-zoek');
  if (form) {
    form.addEventListener('submit', function (e) {
      var v = (document.getElementById('dhr-zoek-in').value || '').trim();
      if (!v) { e.preventDefault(); document.getElementById('dhr-zoek-in').focus(); return; }
      var fab = document.querySelector('.dpvai-fab');
      if (!fab) return; // geen Zoekhulp: gewone zoekpagina
      e.preventDefault();
      fab.click();
      var pogingen = 0;
      (function vul() {
        var pan = document.getElementById('dpvai-paneel');
        var inp = pan && pan.querySelector('#dpvai-in');
        var go = pan && pan.querySelector('#dpvai-go');
        if (inp && go) { inp.value = v; go.click(); return; }
        if (++pogingen < 20) setTimeout(vul, 60); else location.href = '/search?q=' + encodeURIComponent(v);
      })();
    });
  }

  var WORKER = wortel.getAttribute('data-worker') || '';
  if (!WORKER) return;

  var BRON = {
    simonly:  '/api/cards/simonly',
    telefoon: '/api/cards/telefoon',
    internet: '/api/cards/internet'
  };

  function euro(v) {
    var r = Math.round(v * 100) / 100;
    return '\u20ac' + (r % 1 === 0 ? r.toFixed(0) : r.toFixed(2).replace('.', ','));
  }

  function vul(cat, kaart) {
    var rij = wortel.querySelector('.dhr-rij[data-cat="' + cat + '"]');
    if (!rij || !kaart) return;
    var p = parseFloat(kaart.price || kaart.monthly || 0);
    if (!p) return;
    var mnd = parseInt(kaart.contractMonths || (kaart.contract || '').replace(/\D/g, ''), 10) || 24;
    var een = parseFloat(kaart.downPayment || kaart.initialCost || 0) || 0;
    var totaal = p * mnd + een;

    var pv = rij.querySelector('[data-veld="prijs"]');
    var ov = rij.querySelector('[data-veld="onder"]');
    if (pv) pv.textContent = euro(p) + ' p/m';

    var naam = (kaart.device || kaart.name || '').trim();
    var staart = euro(totaal) + ' over ' + mnd + ' maanden';
    // 5 okt: bij telefoon met abonnement zei de regel alleen het totaal over de
    // looptijd. Nu wat het toestel kost en wat het abonnement kost, los van
    // elkaar, want dat is wat mensen willen weten. Geeft de feed die twee niet
    // apart, dan blijft de oude regel staan.
    if (cat === 'telefoon' && naam) {
      var toestel = parseFloat(kaart.deviceTotal || 0), abbo = parseFloat(kaart.bundleMonthly || 0);
      if (toestel > 0 && abbo > 0) {
        staart = naam + ' \u00b7 toestel ' + euro(toestel) + (een > 0 ? ' (waarvan ' + euro(een) + ' vooraf)' : '') +
          ' + ' + (kaart.provider ? kaart.provider + '-abonnement ' : 'abonnement ') + euro(abbo) + ' p/m';
      } else staart = naam + ' \u00b7 ' + staart;
    }
    if (ov) ov.textContent = staart;
  }

  Object.keys(BRON).forEach(function (cat) {
    fetch(WORKER + BRON[cat] + '?limit=60')
      .then(function (r) { return r.json(); })
      .then(function (j) {
        var kaarten = (j && j.cards) || [];
        if (!kaarten.length) return;
        // 5 okt: de tegel keek alleen naar de eerste acht kaarten en naar het kale
        // maandbedrag, en toonde bij telefoon daardoor een ander toestel dan de
        // kiezer erboven. Nu dezelfde rangschikking: bij telefoon de totale
        // kosten per maand (toestel, abonnement en bijbetaling samen).
        function rang(k) {
          var p = parseFloat(k.price || k.monthly || 0);
          if (!p) return 0;
          if (cat !== 'telefoon') return p;
          var m = parseInt(String(k.contract || '').replace(/\D/g, ''), 10) || 24;
          var t = parseFloat(k.totalPrice || 0) || (p * m + (parseFloat(k.downPayment || 0) || 0));
          return t / m;
        }
        var beste = null;
        kaarten.forEach(function (k) {
          var r = rang(k);
          if (!r) return;
          if (!beste || r < rang(beste)) beste = k;
        });
        vul(cat, beste);
      })
      .catch(function () {});
  });
})();
</script>

{% schema %}
{
  "name": "Hero prijzen",
  "settings": [
    { "type": "text", "id": "worker_url", "label": "Worker", "default": "https://awin.business-347.workers.dev" },
    { "type": "checkbox", "id": "compact", "label": "Alleen de tegels tonen", "info": "Voor als de Hero kiezer erboven staat.", "default": false },
    { "type": "text", "id": "compact_kop", "label": "Kop boven de tegels", "default": "Alle vergelijkers" },
    { "type": "text", "id": "peildatum", "label": "Peildatum", "default": "19 september 2026" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Onafhankelijk \u00b7 vanochtend gemeten" },
    { "type": "text", "id": "kop", "label": "Kop", "default": "Wat het vandaag kost" },
    { "type": "textarea", "id": "sub", "label": "Ondertitel", "default": "De laagste prijs per categorie bij 200 aanbieders, met erbij wat je over de hele looptijd betaalt. Want een laag maandbedrag zegt niets." },

    { "type": "header", "content": "Knop en zoekbalk" },
    { "type": "text", "id": "knop_tekst", "label": "Knop", "default": "Bekijk alle prijzen" },
    { "type": "text", "id": "knop_url_2", "label": "Link", "default": "/pages/alle-prijzen" },
    { "type": "text", "id": "zoek_placeholder", "label": "Tekst in zoekbalk", "default": "Of zoek zelf in gewone taal" },

    { "type": "header", "content": "Prijsregels" },
    { "type": "textarea", "id": "rijen", "label": "Regels", "info": "categorie|naam|prijs|onderregel|link|label (label is optioneel, bijvoorbeeld NIEUW). In de compacte stand staat alleen naam en prijs op de tegel; bij producten, gaming en boodschappen zet je in het prijsveld een korte omschrijving.", "default": "simonly|Sim only|\u20ac3,00 p/m|\u20ac72 over 24 maanden|/pages/sim-only\ntelefoon|Telefoon met abonnement|\u20ac8,00 p/m|\u20ac96 over 12 maanden|/pages/telefoonabonnement\ninternet|Internet & TV|\u20ac9,50 p/m|\u20ac228 over 24 maanden|/pages/internet-tv\nenergie|Energie|\u20ac1.412 p/j|hele rekening, incl. belastingteruggave|/pages/energie\nzorg|Zorgpremie 2026|\u20ac122,89 p/m|let op: \u20ac885 eigen risico|/pages/zorgverzekering" },

    { "type": "header", "content": "Merken" },
    { "type": "text", "id": "merken_kop", "label": "Kopje", "default": "Wij vergelijken onder andere" },
    { "type": "text", "id": "merken", "label": "Domeinen", "default": "kpn.com, odido.nl, vodafone.nl, ziggo.nl, simyo.nl, ben.nl, youfone.nl" },
    { "type": "text", "id": "merken_rest", "label": "Slot", "default": "+194 andere" },

    { "type": "textarea", "id": "fijn", "label": "Kleine letters", "default": "Prijzen van telecom komen uit de feeds van de aanbieders en worden elke ochtend bijgewerkt; energie en zorg houden wij handmatig bij, laatst gecontroleerd op [peil]. Wij sorteren op prijs; wat je kiest bepaal je zelf." }
  ],
  "presets": [ { "name": "Hero prijzen" } ]
}
{% endschema %}
