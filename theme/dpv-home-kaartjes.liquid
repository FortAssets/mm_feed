<script>
(function () {
  var wortel = document.getElementById('dhd');
  if (!wortel || !window.fetch) return;
  var WORKER = wortel.getAttribute('data-worker'), SHOP = wortel.getAttribute('data-shop'), MAIL = wortel.getAttribute('data-mail');
  var MAANDEN = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];

  function euro(v) {
    var r = Math.round(v * 100) / 100;
    var s = r % 1 === 0 ? String(r) : r.toFixed(2).replace('.', ',');
    return '€' + s.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }
  // Zelfde meting als de kiezer die hier eerst stond (dpv-hero-kies): gebeurtenis "dhk_klik".
  function meet(naam, extra) {
    try {
      var d = extra || {};
      if (typeof window.gtag === 'function') window.gtag('event', naam, d);
      else if (window.dataLayer && window.dataLayer.push) { d.event = naam; window.dataLayer.push(d); }
    } catch (e) {}
  }
  function json(url) { return fetch(url).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); }
  function mnd(k) { return parseInt(String(k.contract || '').replace(/\D/g, ''), 10) || 0; }
  function duur(k, lang) { var m = mnd(k); return m ? m + (lang ? ' maanden' : ' mnd') : 'maandelijks opzegbaar'; }
  function ga(k, cat) { return WORKER + '/api/go?u=' + encodeURIComponent(k.url) + '&cat=' + cat + '&p=' + encodeURIComponent(k.provider || ''); }
  function q(el, f) { return el.querySelector('[data-f="' + f + '"]'); }
  function zet(el, f, tekst) { var x = q(el, f); if (x) x.textContent = tekst; }
  function doorklik(a, url, pos, naam, tab) {
    a.href = url; a.target = '_blank'; a.rel = 'nofollow sponsored noopener';
    a.setAttribute('data-pos', pos); a.setAttribute('data-naam', naam); a.setAttribute('data-tab', tab);
  }
  function delen(lijst) { return lijst.filter(Boolean).join(' · '); }

  // ---- Hero: drie prijskaartjes per tabblad --------------------------------
  // De rangschikking is die van dpv-hero-kies: sim only en internet op maandprijs
  // (bij gelijke prijs de grootste bundel of hoogste snelheid), telefoon op de
  // totale kosten per maand over de looptijd, dus met toestel en bijbetaling.
  var TABS = {
    sim: { pad: 'simonly', wat: 'laagste maandprijs', maak: function (j) {
      return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
        var d = k.unlimited ? 'Onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
        return { naam: k.provider, knop: k.provider, rang: parseFloat(k.price), rang2: -(k.unlimited ? 9999 : k.dataGB || 0),
          lang: delen([d, k.minutes, duur(k, true)]), kort: delen([d, k.minutes, duur(k, false)]), url: ga(k, 'simonly') };
      });
    } },
    telefoon: { pad: 'telefoon', wat: 'laagste kosten per maand', maak: function (j) {
      return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.device; }).map(function (k) {
        var p = parseFloat(k.price), m = mnd(k) || 24, een = parseFloat(k.downPayment) || 0;
        var totaal = parseFloat(k.totalPrice) || (p * m + een);
        var d = k.unlimited ? 'onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
        return { naam: k.device, knop: k.provider, rang: totaal / m, rang2: 0,
          lang: delen([k.provider, d, k.minutes, duur(k, true), 'toestel en abonnement samen']),
          kort: delen([k.provider, d, duur(k, false)]), url: ga(k, 'telefoon') };
      });
    } },
    internet: { pad: 'internet', wat: 'laagste maandprijs', maak: function (j) {
      return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
        var soort = k.tv ? 'met tv' : 'alleen internet';
        return { naam: k.provider, knop: k.provider, rang: parseFloat(k.price), rang2: -(k.speedMbit || 0),
          lang: delen([k.speed, soort, duur(k, true)]), kort: delen([k.speed, soort, duur(k, false)]), url: ga(k, 'internet') };
      });
    } }
  };
  var geladen = {};
  function laad(tab) {
    if (!geladen[tab]) {
      geladen[tab] = json(WORKER + '/api/cards/' + TABS[tab].pad + '?limit=60').then(function (j) {
        var lijst = TABS[tab].maak(j).sort(function (a, b) { return a.rang - b.rang || a.rang2 - b.rang2; });
        if (!lijst.length) throw new Error('leeg');
        return { lijst: lijst, bij: j.updatedAt || '' };
      });
      geladen[tab].catch(function () { delete geladen[tab]; });
    }
    return geladen[tab];
  }
  var actief = 'sim';
  function toon(tab, lijst) {
    for (var n = 1; n <= 3; n++) {
      var el = wortel.querySelector('[data-h="' + n + '"]'), x = lijst[n - 1];
      if (!el) continue;
      el.hidden = !x;
      if (!x) continue;
      var prijs = euro(x.rang), p = q(el, 'prijs');
      zet(el, 'aanb', x.naam); zet(el, 'bundel', n === 1 ? x.lang : x.kort);
      if (n === 1) { zet(el, 'wat', TABS[tab].wat); p.classList.toggle('lang', prijs.length > 5); }
      p.textContent = prijs;
      var a = q(el, 'knop');
      a.textContent = 'Bekijk bij ' + x.knop;
      doorklik(a, x.url, n, x.knop, tab);
    }
  }
  function kies(tab) {
    actief = tab;
    var li = wortel.querySelectorAll('.chips li');
    for (var i = 0; i < li.length; i++) {
      var a = li[i].querySelector('a'), aan = a.getAttribute('data-tab') === tab;
      li[i].classList.toggle('actief', aan);
      if (a.hasAttribute('data-tab')) a.setAttribute('aria-pressed', aan ? 'true' : 'false');
    }
    return laad(tab).then(function (d) { if (actief === tab) toon(tab, d.lijst); return d; });
  }
  var chips = wortel.querySelectorAll('.chips a[data-tab]');
  for (var c = 0; c < chips.length; c++) {
    chips[c].setAttribute('role', 'button');
    chips[c].addEventListener('click', function (e) {
      var tab = this.getAttribute('data-tab'), link = this.href;
      e.preventDefault();
      meet('dhk_tab', { tab: tab });
      // Lukt het ophalen niet, dan doet de knop wat hij zonder script ook doet: naar de vergelijker.
      kies(tab).catch(function () { window.location.href = link; });
    });
  }

  // ---- Datumregel en "vanaf"-prijzen ---------------------------------------
  function meting(iso) {
    var d = new Date(iso);
    if (!iso || isNaN(d)) return;
    var dag, tijd;
    try {
      var o = {}; new Intl.DateTimeFormat('nl-NL', { timeZone: 'Europe/Amsterdam', day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })
        .formatToParts(d).forEach(function (x) { o[x.type] = x.value; });
      dag = parseInt(o.day, 10) + ' ' + MAANDEN[parseInt(o.month, 10) - 1]; tijd = o.hour + ':' + o.minute;
      var el = wortel.querySelectorAll('[data-meting]');
      for (var i = 0; i < el.length; i++) {
        el[i].textContent = el[i].getAttribute('data-meting') === 'lang'
          ? 'Prijzen gemeten op ' + dag + ' ' + o.year + ', ' + tijd
          : ', laatste meting ' + dag + ' ' + tijd;
      }
    } catch (e) {}
  }
  function vanaf(tab, d) {
    var el = wortel.querySelector('[data-van="' + tab + '"]');
    if (el) el.textContent = euro(d.lijst[0].rang);
  }
  kies('sim').then(function (d) { vanaf('sim', d); meting(d.bij); }).catch(function () {});
  laad('telefoon').then(function (d) { vanaf('telefoon', d); }).catch(function () {});
  laad('internet').then(function (d) { vanaf('internet', d); }).catch(function () {});

  // ---- Producten en gaming: prijs per winkel -------------------------------
  function shopgo(id, cat, w) { return SHOP + '/api/shop/go?i=' + encodeURIComponent(id) + '&cat=' + encodeURIComponent(cat) + '&w=' + encodeURIComponent(w); }
  function winkels(n) { return n === 1 ? '1 winkel' : n + ' winkels'; }
  // "scheelt" alleen als het verschil onder 30% van de hoogste prijs blijft; daarboven is het
  // meestal een andere uitvoering of een fout in de feed.
  function scheelt(o) {
    if (o.length < 2) return 0;
    var v = o[o.length - 1].p - o[0].p;
    return v > 0 && v < 0.3 * o[o.length - 1].p ? v : 0;
  }
  function span(klasse, tekst) { var s = document.createElement('span'); if (klasse) s.className = klasse; s.textContent = tekst; return s; }
  var gezien = {};
  function vulProduct(el) {
    var id = el.getAttribute('data-pp'), cat = el.getAttribute('data-cat'), naam = el.getAttribute('data-naam') || '';
    var blok = (el.closest('[data-blok]') || wortel).getAttribute('data-blok') || 'producten';
    return json(SHOP + '/api/shop/product?i=' + encodeURIComponent(id) + '&cat=' + encodeURIComponent(cat)).then(function (j) {
      var o = ((j.product || {}).o || []).filter(function (x) { return parseFloat(x.p) > 0 && x.w; })
        .map(function (x) { return { w: x.w, p: parseFloat(x.p) }; }).sort(function (a, b) { return a.p - b.p; });
      if (!o.length) return;
      zet(el, 'prijs', euro(o[0].p)); zet(el, 'winkel', 'bij ' + o[0].w);
      var m = q(el, 'meta');
      if (m) {
        m.textContent = '';
        m.appendChild(span('', winkels(o.length)));
        var v = scheelt(o);
        if (v) m.appendChild(span(el.classList.contains('lig') ? 'sticker kl' : 'sticker', 'scheelt ' + euro(v)));
      }
      var a = q(el, 'knop');
      if (a) { a.textContent = 'Bekijk bij ' + o[0].w; doorklik(a, shopgo(id, cat, o[0].w), 1, o[0].w, blok); a.setAttribute('data-product', naam); }
      var rijen = q(el, 'rijen');
      if (rijen) {
        rijen.textContent = '';
        o.slice(0, 3).forEach(function (x, n) {
          var li = document.createElement('li'), k = document.createElement('a');
          if (n === 0) li.className = 'eerste';
          li.appendChild(span(n === 0 ? 'nr' : 'nr open', String(n + 1)));
          li.appendChild(span('w', x.w));
          if (n === 0) li.appendChild(span('waarom', 'laagste prijs'));
          li.appendChild(span('p', euro(x.p)));
          k.className = n === 0 ? 'knop' : 'knop klein';
          if (n === 0) k.textContent = 'Bekijk bij ' + x.w;
          else { k.textContent = 'Bekijk'; k.appendChild(span('bij', ' bij ' + x.w)); }
          doorklik(k, shopgo(id, cat, x.w), n + 1, x.w, blok); k.setAttribute('data-product', naam);
          li.appendChild(k); rijen.appendChild(li);
        });
      }
      // Laatste dag waarop de winkels voor dit product zijn nagelopen.
      var log = j.logboek || {}, laatst = '';
      Object.keys(log).forEach(function (w) { (log[w] || []).forEach(function (r) { if (r.gezien && r.gezien > laatst) laatst = r.gezien; }); });
      if (laatst && (!gezien[blok] || laatst > gezien[blok])) {
        gezien[blok] = laatst;
        var dm = /^(\d{4})-(\d{2})-(\d{2})/.exec(laatst), regel = wortel.querySelector('[data-gezien="' + blok + '"]');
        if (dm && regel) regel.textContent = 'Prijzen gemeten op ' + parseInt(dm[3], 10) + ' ' + MAANDEN[parseInt(dm[2], 10) - 1] + ' ' + dm[1];
      }
    }).catch(function () {});
  }
  var prods = wortel.querySelectorAll('[data-prod]');
  for (var i = 0; i < prods.length; i++) vulProduct(prods[i]);

  // ---- Kliks meten ----------------------------------------------------------
  wortel.addEventListener('click', function (e) {
    var a = e.target.closest ? e.target.closest('a[data-pos]') : null;
    if (a) meet('dhk_klik', { tab: a.getAttribute('data-tab'), keuze: a.getAttribute('data-product') || '', positie: a.getAttribute('data-pos'), aanbieder: a.getAttribute('data-naam') });
  });

  // ---- Zorg 2027: aanmelden -------------------------------------------------
  var form = document.getElementById('dhd-zmail');
  if (form) {
    var veld = form.querySelector('input[type="email"]'), knop = form.querySelector('button'), fout = form.querySelector('.fout');
    var zeg = function (t) { fout.textContent = t; fout.hidden = !t; };
    veld.addEventListener('input', function () { zeg(''); });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var adres = (veld.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(adres)) { zeg('Vul een geldig e-mailadres in.'); veld.focus(); return; }
      var val = form.querySelector('input[name="website"]'), oud = knop.textContent;
      knop.disabled = true; knop.textContent = 'Bezig…';
      fetch(MAIL + '/sm/api/aanmelden', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: adres, bron: form.getAttribute('data-bron'), website: val ? val.value : '', onderwerpen: ['zorg'] })
      }).then(function (r) { return r.json(); }).then(function (res) {
        if (res && res.ok) {
          var al = res.status === 'al-actief', p = document.createElement('p'), b = document.createElement('b');
          p.className = 'ok'; p.setAttribute('role', 'status');
          b.textContent = al ? 'Je stond er al bij' : 'Kijk even in je mail';
          p.appendChild(b);
          p.appendChild(document.createTextNode(al ? 'Dit adres krijgt het seintje al. Je hoeft niets te doen.' : 'Wij hebben je een bericht gestuurd met één link erin. Klik erop en je krijgt het seintje.'));
          form.textContent = ''; form.appendChild(p);
          meet('dhd_aanmelding', { bron: 'zorgpremies-2027' });
        } else {
          zeg((res && res.fout) || 'Er ging iets mis. Probeer het later nog eens.');
          knop.disabled = false; knop.textContent = oud;
        }
      }).catch(function () {
        zeg('Er ging iets mis. Probeer het later nog eens.');
        knop.disabled = false; knop.textContent = oud;
      });
    });
  }
})();
</script>

