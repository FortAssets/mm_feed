<div class="dhd" id="dhd" data-worker="{{ worker }}" data-shop="{{ shopw }}" data-mail="{{ mailw }}">

<!-- HERO -->
<section class="hero" aria-labelledby="dhd-h1">
  <div class="wrap">
    <div class="hero-tekst">
      <h1 id="dhd-h1">{{ s.kop }}<span class="sr"> {{ s.kop_sr }}</span></h1>
      <p class="sub">{{ s.sub }}</p>
      <ul class="chips" aria-label="Kies een categorie">
        <li class="actief"><a href="/pages/sim-only" data-tab="sim">Sim only</a></li>
        <li><a href="/pages/telefoonabonnement" data-tab="telefoon">Telefoon</a></li>
        <li><a href="/pages/internet-tv" data-tab="internet">Internet &amp; TV</a></li>
        <li><a href="/pages/energie">Energie</a></li>
        <li><a href="/pages/zorgverzekering">Zorg</a></li>
        <li><a href="/pages/vergelijken">Producten</a></li>
      </ul>
    </div>

    <div class="cluster" aria-live="polite">
      <svg class="touw" viewBox="0 0 24 88" aria-hidden="true"><circle cx="12" cy="3" r="2.600" fill="#0D1B2A"/><path d="M12 5.5 C 12 30, 11 50, 12 82" fill="none" stroke="#0D1B2A" stroke-width="1.8" stroke-linecap="round"/></svg>
      <article class="hang kaartje groot" data-h="1">
        <div class="vlak" aria-hidden="true"></div>
        <div class="label">
          <span class="gat" aria-hidden="true"></span>
          <p class="winnaar"><span class="nr">1</span><span class="aanb" data-f="aanb">Lebara</span><span data-f="wat">laagste maandprijs</span></p>
          <p class="prijsrij"><span class="prijs" data-f="prijs">€3,30</span><span class="pm">per maand</span></p>
          <p class="bundel" data-f="bundel">39 GB · 250 min · 24 maanden</p>
          <a class="knop" data-f="knop" href="/pages/sim-only">Bekijk bij Lebara</a>
        </div>
      </article>
      <div class="minis">
        <article class="mini kaartje" style="--vlak:#CDEFE0" data-h="2">
          <div class="vlak" aria-hidden="true"></div>
          <div class="label">
            <p class="top"><span class="nr open">2</span><span class="aanb" data-f="aanb">Youfone</span></p>
            <p class="prijs"><span data-f="prijs">€3,50</span><small>p/m</small></p>
            <p class="bundel" data-f="bundel">39 GB · 300 min · 24 mnd</p>
            <a class="knop klein" data-f="knop" href="/pages/sim-only">Bekijk bij Youfone</a>
          </div>
        </article>
        <article class="mini kaartje" style="--vlak:#CDEFE0" data-h="3">
          <div class="vlak" aria-hidden="true"></div>
          <div class="label">
            <p class="top"><span class="nr open">3</span><span class="aanb" data-f="aanb">Simpel</span></p>
            <p class="prijs"><span data-f="prijs">€4</span><small>p/m</small></p>
            <p class="bundel" data-f="bundel">29 GB · Onbeperkt bellen · 24 mnd</p>
            <a class="knop klein" data-f="knop" href="/pages/sim-only">Bekijk bij Simpel</a>
          </div>
        </article>
      </div>
    </div>

    <div class="hero-onder">
      {%- assign logos = s.logos | split: ',' -%}
      {%- if logos.size > 0 -%}
      <div class="logorij">
        <p>{{ s.logos_kop }}</p>
        <div class="lg-rij">
          {%- for m in logos -%}
            {%- assign d = m | strip -%}
            {%- if d != blank -%}
              {%- assign nm = d | split: '.' | first | capitalize -%}
              <img src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=128&amp;url=https://{{ d | escape }}" alt="{{ nm | escape }}" title="{{ nm | escape }}" loading="lazy" width="40" height="40" onerror="this.style.display='none'">
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      <a href="/pages/zo-vergelijken-wij#volgorde">Hoe bepalen wij de volgorde?</a>
      <span data-meting="lang">Prijzen elke nacht gemeten</span>
    </div>
  </div>
</section>

<!-- FEITEN -->
<section class="vertrouwen" aria-label="Over de vergelijking">
  <div class="wrap">
    <ul class="feiten">
      {%- if s.feit1 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h7"/></svg>{{ s.feit1 }}</li>{%- endif -%}
      {%- if s.feit2 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.500"/><path d="M12 7.5V12l3 2"/></svg><span>{{ s.feit2 }}<span data-meting="kort"></span></span></li>{%- endif -%}
      {%- if s.feit3 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4.5 4.5L19 7"/></svg>{{ s.feit3 }}</li>{%- endif -%}
    </ul>
  </div>
</section>

