html:not(#x) .dhd a.knop.pw{width:calc(100% - 3px);justify-content:flex-start;min-height:48px;padding:0 14px;margin-bottom:3px}
html:not(#x) .dhd .pk .meer{justify-self:start;font-size:13px;font-weight:600;color:var(--blauw);padding:4px 0}
html:not(#x) .dhd .leeg{border:var(--rand);border-radius:var(--rk);background:var(--wit);padding:18px;font-size:15px;font-weight:500}
html:not(#x) .dhd .leeg a{font-weight:600;text-decoration:underline;text-underline-offset:3px}
html:not(#x) .dhd .pblok .leeg{border:0;border-radius:0}
@media (max-width:900px){html:not(#x) .dhd .tabs,html:not(#x) .dhd .subs{flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;margin-left:-16px;margin-right:-16px;padding:2px 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
html:not(#x) .dhd .tabs::-webkit-scrollbar,html:not(#x) .dhd .subs::-webkit-scrollbar{display:none}
html:not(#x) .dhd .hero .wrap{grid-template-columns:minmax(0,1fr)}
html:not(#x) .dhd .tabs{margin-top:14px;gap:6px}
html:not(#x) .dhd .tabs .tab{min-height:40px;padding:0 13px;font-size:13px}
html:not(#x) .dhd .subs{margin-top:6px;min-height:42px}
html:not(#x) .dhd .groot .info{margin-top:10px}
html:not(#x) .dhd .tags{margin-top:8px}
html:not(#x) .dhd .mini .label{grid-template-areas:"top knop" "prijs knop" "bundel knop" "extra knop"}
html:not(#x) .dhd .mini .extra{grid-area:extra}
html:not(#x) .dhd .mini .knop{max-width:132px;padding-left:8px;padding-right:8px;font-size:13px;overflow-wrap:anywhere}
html:not(#x) .dhd .c-voet{margin:22px 8px 0 0}
html:not(#x) .dhd .cluster.is-prod{padding:0 8px 0 0;margin-top:14px}
html:not(#x) .dhd .pblok{box-shadow:8px 8px 0 var(--groen)}
html:not(#x) .dhd .zoek{padding:10px 12px}
html:not(#x) .dhd .pk{grid-template-columns:64px minmax(0,1fr);gap:10px 12px;align-items:center;padding:12px}
html:not(#x) .dhd .pk-foto{grid-row:auto;width:64px;height:64px}
html:not(#x) .dhd .pk-foto img{max-width:52px;max-height:52px}
html:not(#x) .dhd .pk h3{font-size:15px}
html:not(#x) .dhd .pk-w{grid-column:1 / -1}}
@media (max-width:900px){html:not(#x) .dhd .groot .prijs.lang{font-size:60px}}
@media (max-width:360px){html:not(#x) .dhd .groot .prijs.lang{font-size:52px}}
</style>

<div class="dhd" id="dhd" data-worker="{{ worker }}" data-shop="{{ shopw }}" data-mail="{{ mailw }}"
  data-boodschappen="{{ s.boodschappen_url | default: mailw }}" data-energie="{{ s.energie_data }}" data-zorg="{{ s.zorg_bron | default: '/pages/zorgverzekering' }}"
  data-prod="{{ s.groepen | escape }}" data-gaming="{{ s.gaming_groepen | escape }}">

<!-- HERO -->
<section class="hero" aria-labelledby="dhd-h1">
  <div class="wrap">
    <div class="hero-tekst">
      <h1 id="dhd-h1">{{ s.kop }}<span class="sr"> {{ s.kop_sr }}</span></h1>
      <p class="sub">{{ s.sub }}</p>
      {%- comment -%}
        De kiezer (6 okt): acht hoofdknoppen, daaronder de subkeuzes van de gekozen categorie. De logica komt uit
        dpv-hero-kies. Zonder script zijn de hoofdknoppen gewone links naar de categoriepagina.
      {%- endcomment -%}
      <div class="tabs" role="tablist" aria-label="Wat wil je vergelijken?">
        {%- assign tabs = "sim|Sim only|/pages/sim-only,telefoon|Telefoon|/pages/telefoonabonnement,internet|Internet|/pages/internet-tv,energie|Energie|/pages/energie,zorg|Zorg|/pages/zorgverzekering,prod|Producten|/pages/vergelijken,gaming|Gaming|/pages/gaming,boodschappen|Boodschappen|/pages/boodschappen" | split: ',' -%}
        {%- for t in tabs -%}
          {%- assign d = t | split: '|' -%}
          <a class="tab{% if forloop.first %} aan{% endif %}" role="tab" id="dhd-t-{{ d[0] }}" href="{{ d[2] }}" data-tab="{{ d[0] }}" aria-controls="dhd-paneel" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ d[1] }}</a>
        {%- endfor -%}
      </div>
      <div class="subs" id="dhd-subs" role="group" aria-label="Wat is voor jou belangrijk?">
        <button type="button" class="sk aan" data-chip="alles" aria-pressed="true">Laagste prijs</button>
        <button type="button" class="sk" data-chip="data" aria-pressed="false">Onbeperkt data</button>
        <button type="button" class="sk" data-chip="bellen" aria-pressed="false">Onbeperkt bellen</button>
        <button type="button" class="sk" data-chip="jaar" aria-pressed="false">1 jaar contract</button>
      </div>
    </div>

    <div class="cluster" id="dhd-paneel" role="tabpanel" aria-labelledby="dhd-t-sim" aria-live="polite">
      <div class="c-aanbod">
        <svg class="touw" viewBox="0 0 24 88" aria-hidden="true"><circle cx="12" cy="3" r="2.600" fill="#0D1B2A"/><path d="M12 5.5 C 12 30, 11 50, 12 82" fill="none" stroke="#0D1B2A" stroke-width="1.8" stroke-linecap="round"/></svg>
        <article class="hang kaartje groot" data-h="1">
          <div class="vlak" aria-hidden="true"></div>
          <div class="label">
            <span class="gat" aria-hidden="true"></span>
            <p class="winnaar"><span class="nr">1</span><span class="aanb" data-f="aanb">Lebara</span><span data-f="wat">laagste maandprijs</span></p>
            <p class="prijsrij"><span class="prijs" data-f="prijs">€3,30</span><span class="pm" data-f="per">per maand</span></p>
            <div class="info"><span class="beeld" data-f="beeld" hidden></span><p class="bundel" data-f="bundel">39 GB · 250 min</p></div>
            <ul class="tags" data-f="tags"><li>2 jaar</li><li>€79,20 over 24 maanden</li></ul>
            <p class="let" data-f="let" hidden></p>
            <a class="knop" data-f="knop" href="/pages/sim-only">Bekijk bij Lebara</a>
          </div>
        </article>
        <div class="minis">
          <article class="mini kaartje" style="--vlak:#CDEFE0" data-h="2">
            <div class="vlak" aria-hidden="true"></div>
            <div class="label">
              <p class="top"><span class="nr open">2</span><span class="aanb" data-f="aanb">Youfone</span></p>
              <p class="prijs"><span data-f="prijs">€3,50</span><small data-f="per">p/m</small></p>
              <p class="bundel" data-f="bundel">39 GB · 300 min · 2 jaar</p>
              <p class="extra" data-f="extra">€84 over 24 maanden</p>
              <a class="knop klein" data-f="knop" href="/pages/sim-only">Bekijk bij Youfone</a>
            </div>
          </article>
          <article class="mini kaartje" style="--vlak:#CDEFE0" data-h="3">
            <div class="vlak" aria-hidden="true"></div>
            <div class="label">
              <p class="top"><span class="nr open">3</span><span class="aanb" data-f="aanb">Simpel</span></p>
              <p class="prijs"><span data-f="prijs">€4</span><small data-f="per">p/m</small></p>
              <p class="bundel" data-f="bundel">29 GB · onbeperkt bellen · 2 jaar</p>
              <p class="extra" data-f="extra">€96 over 24 maanden</p>
              <a class="knop klein" data-f="knop" href="/pages/sim-only">Bekijk bij Simpel</a>
            </div>
          </article>
        </div>
      </div>
      <div class="c-prod" hidden>
        <div class="pblok">
          <form class="zoek" action="/pages/vergelijken" method="get" role="search" hidden>
            <label for="dhd-q" class="sr">Zoek een product</label>
            <input id="dhd-q" name="q" type="search" autocomplete="off" placeholder="Zoek op merk of model" enterkeyhint="search">
            <button type="submit" class="knop-inkt">Zoek</button>
          </form>
          <div class="pk-lijst" data-f="lijst"><p class="leeg">Even geduld.</p></div>
        </div>
      </div>
      <div class="c-fout" hidden><p class="leeg">De prijzen laden nu niet.</p></div>
      <div class="c-voet">
        <p class="regel"><b>Hoe is deze lijst bepaald?</b> <span data-f="voet"></span><span data-f="regel">De laagste maandprijs binnen jouw keuze, bij een gelijke prijs de grootste bundel. Aanbieders betalen niet voor een plek. Wij krijgen een vergoeding als je via ons afsluit; jij betaalt daardoor niets extra.</span></p>
        <a class="alle-l" data-f="alle" href="/pages/sim-only">Alle sim only vergelijken</a>
        {%- if s.seintje_url != blank -%}<p class="sein" data-f="sein">Zit je nog vast aan je contract? <a href="{{ s.seintje_url }}">Krijg een mail op de dag dat je kunt overstappen</a></p>{%- endif -%}
      </div>
    </div>

    <div class="hero-onder">
      {%- assign logos = s.logos | split: ',' -%}
      {%- if logos.size > 0 -%}
      <div class="logorij">
        <p>{{ s.logos_kop }}</p>
        <div class="lg-rij">
          {%- for m in logos -%}
            {%- assign d = m | strip -%}
            {%- if d != blank -%}
              {%- assign nm = d | split: '.' | first | capitalize -%}
              <img src="https://t3.gstatic.com/faviconV2?client=SOCIAL&amp;type=FAVICON&amp;fallback_opts=TYPE,SIZE,URL&amp;size=128&amp;url=https://{{ d | escape }}" alt="{{ nm | escape }}" title="{{ nm | escape }}" loading="lazy" width="40" height="40" onerror="this.style.display='none'">
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      <a href="/pages/zo-vergelijken-wij#volgorde">Hoe bepalen wij de volgorde?</a>
      <span data-meting="lang">Prijzen elke nacht gemeten</span>
    </div>
  </div>
</section>

<!-- CATEGORIEEN -->
