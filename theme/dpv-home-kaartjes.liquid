{%- assign arts = blogs[s.blog].articles -%}
{%- if arts.size > 0 -%}
<section class="actueel" aria-labelledby="dhd-act">
  <div class="wrap">
    <div class="kopregel">
      <h2 id="dhd-act">{{ s.act_kop }}</h2>
      <p><a class="alle" href="{{ blogs[s.blog].url }}">Alle artikelen</a></p>
    </div>
    <ul class="blogs">
      {%- comment -%}
        Drie vaste artikelen (handles uit de instellingen), in die volgorde. Bestaat een handle niet,
        dan komt op die plek het nieuwste artikel dat nog niet getoond wordt.
      {%- endcomment -%}
      {%- assign act_ruw = s.act_1 | append: ',' | append: s.act_2 | append: ',' | append: s.act_3 | split: ',' -%}
      {%- assign act_vast = '|' -%}
      {%- for ruw in act_ruw -%}
        {%- assign h = ruw | strip | split: '/' | last -%}
        {%- if h != blank -%}
          {%- assign sleutel = s.blog | append: '/' | append: h -%}
          {%- if articles[sleutel].id -%}{%- assign act_vast = act_vast | append: h | append: '|' -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign act_getoond = '|' -%}
      {%- for i in (0..2) -%}
        {%- assign article = nil -%}
        {%- assign h = act_ruw[i] | strip | split: '/' | last -%}
        {%- if h != blank -%}
          {%- assign sleutel = s.blog | append: '/' | append: h -%}
          {%- assign zoek = '|' | append: h | append: '|' -%}
          {%- unless act_getoond contains zoek -%}
            {%- if articles[sleutel].id -%}{%- assign article = articles[sleutel] -%}{%- endif -%}
          {%- endunless -%}
        {%- endif -%}
        {%- unless article -%}
          {%- for a in arts limit: 12 -%}
            {%- assign zoek = '|' | append: a.handle | append: '|' -%}
            {%- if act_vast contains zoek or act_getoond contains zoek -%}{%- continue -%}{%- endif -%}
            {%- assign article = a -%}
            {%- break -%}
          {%- endfor -%}
        {%- endunless -%}
        {%- unless article -%}{%- continue -%}{%- endunless -%}
        {%- assign act_getoond = act_getoond | append: article.handle | append: '|' -%}
      <li><a href="{{ article.url }}">
        {%- if article.image -%}
          <img src="{{ article.image | image_url: width: 800 }}" alt="" width="800" height="450" loading="lazy">
        {%- endif -%}
        <div class="tekst">{%- if article.tags.size > 0 -%}<p class="rubriek">{{ article.tags | first | capitalize }}</p>{%- endif -%}<h3>{{ article.title }}</h3></div>
      </a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

<!-- UITLEG -->
<section class="uitleg" aria-labelledby="dhd-uitleg">
  <div class="wrap">
    <div>
      <h2 id="dhd-uitleg">Zo werkt het, en zo verdienen wij</h2>
      <div class="model">
        <p>Vergelijken is gratis. Stap je over of koop je via onze site, dan ontvangen wij een vergoeding van de aanbieder of winkel. De volgorde is op prijs en staat los van die vergoeding.</p>
        <a class="tl" href="/pages/zo-vergelijken-wij">Zo vergelijken wij: methode, bronnen en bijwerkfrequentie</a>
      </div>
    </div>
    <div class="tekst">
      <h3>Elke nacht meten</h3>
      <p>Elke nacht halen wij de actuele prijzen op bij 14 telecomaanbieders en 9 winkels. Voor sim only, internet en tv kijken we naar de maandprijs over de looptijd. Bij telefoon met abonnement tellen we de eenmalige kosten mee, zodat je ziet wat het per maand echt kost. Bij producten vergelijken we dezelfde uitvoering bij bol, Coolblue, MediaMarkt en andere winkels. Het tijdstip van de laatste meting staat bij elk blok.</p>
      <h3>Sorteren op prijs</h3>
      <p>De goedkoopste aanbieding staat bovenaan, altijd. Nummer 1 is nummer 1 omdat de prijs het laagst is, niet omdat een aanbieder daarvoor betaalt. Hebben we een prijs die nacht niet kunnen meten, dan staat die aanbieder er die dag niet bij. We vullen niets in.</p>
      <h3>Jij klikt door</h3>
      <p>Bij de aanbieding die je bevalt klik je op "Bekijk bij". Je komt dan rechtstreeks op de site van de aanbieder of winkel. Bestellen of overstappen doe je daar, tegen de prijs die je bij ons zag.</p>
    </div>
  </div>
</section>

</div>

<script>
(function () {
  var wortel = document.getElementById('dhd');
  if (!wortel || !window.fetch) return;
  var WORKER = wortel.getAttribute('data-worker'), SHOP = wortel.getAttribute('data-shop'), MAIL = wortel.getAttribute('data-mail');
  var MAANDEN = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];

  function euro(v) {
    var r = Math.round(v * 100) / 100;
    var s = r % 1 === 0 ? String(r) : r.toFixed(2).replace('.', ',');
    return '€' + s.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }
  // Zelfde meting als de kiezer die hier eerst stond (dpv-hero-kies): gebeurtenis "dhk_klik".
  function meet(naam, extra) {
    try {
      var d = extra || {};
      if (typeof window.gtag === 'function') window.gtag('event', naam, d);
      else if (window.dataLayer && window.dataLayer.push) { d.event = naam; window.dataLayer.push(d); }
    } catch (e) {}
  }
  function json(url) { return fetch(url).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function mnd(k) { return parseInt(String(k.contract || '').replace(/\D/g, ''), 10) || 0; }
  function duur(k) { var m = mnd(k); return m === 12 ? '1 jaar' : m === 24 ? '2 jaar' : m ? m + ' maanden' : 'maandelijks opzegbaar'; }
  function ga(k, cat) { return WORKER + '/api/go?u=' + encodeURIComponent(k.url) + '&cat=' + cat + '&p=' + encodeURIComponent(k.provider || ''); }
  function q(el, f) { return el.querySelector('[data-f="' + f + '"]'); }
  function zet(el, f, tekst) { var x = q(el, f); if (x) x.textContent = tekst; }
  function doorklik(a, url, pos, naam, tab, aff) {
    a.href = url; a.target = '_blank'; a.rel = aff === false ? 'nofollow noopener' : 'nofollow sponsored noopener';
    a.setAttribute('data-pos', pos); a.setAttribute('data-naam', naam); a.setAttribute('data-tab', tab);
  }
  function datum(iso) {
    var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso || '');
    if (!m) return iso || '';
    return parseInt(m[3], 10) + ' ' + MAANDEN[parseInt(m[2], 10) - 1] + ' ' + m[1];
  }

  // ---- Hero: de kiezer -------------------------------------------------------
  // Acht hoofdknoppen, daaronder de subkeuzes van de gekozen categorie. De logica
  // (bronnen, rangschikking, subkeuzes, doorklik en meting) komt uit de kiezer die
  // hier eerst stond, dpv-hero-kies; alleen de opmaak is die van de prijskaartjes.
  // Een categorie haalt haar gegevens pas op als je haar opent. Tot de nieuwe
  // gegevens er zijn blijft de vorige inhoud staan, zodat de pagina niet verspringt.
  var BOOD = wortel.getAttribute('data-boodschappen'), ENERGIE = wortel.getAttribute('data-energie'), ZORG = wortel.getAttribute('data-zorg');
  var cluster = document.getElementById('dhd-paneel'), subs = document.getElementById('dhd-subs');
  var cA = cluster.querySelector('.c-aanbod'), cP = cluster.querySelector('.c-prod'), cF = cluster.querySelector('.c-fout'), cV = cluster.querySelector('.c-voet');
  var pLijst = q(cP, 'lijst'), pZoek = cP.querySelector('.zoek');
  var VERGOEDING = ' Aanbieders betalen niet voor een plek. Wij krijgen een vergoeding als je via ons afsluit; jij betaalt daardoor niets extra.';

  /* Categorieën met een aanbod: nummer 1 groot, 2 en 3 klein.
     Elk item: naam, sub, kort, prijs, per, tags, onder, mini, let, url, knop, foto, aff. */
  var AANBOD = {
    sim: {
      vraag: 'Wat is voor jou belangrijk?',
      chips: [
        { id: 'alles', label: 'Laagste prijs', wat: 'laagste maandprijs', test: function () { return true; } },
        { id: 'data', label: 'Onbeperkt data', wat: 'laagste maandprijs met onbeperkt data', test: function (x) { return x.k.unlimited; } },
        { id: 'bellen', label: 'Onbeperkt bellen', wat: 'laagste maandprijs met onbeperkt bellen', test: function (x) { return /onbeperkt/i.test(x.k.minutes || ''); } },
        { id: 'jaar', label: '1 jaar contract', wat: 'laagste maandprijs met een contract van 1 jaar', test: function (x) { return mnd(x.k) === 12; } }
      ],
      laad: function (tab) {
        return json(WORKER + '/api/cards/simonly?limit=60').then(function (j) {
          tab.bij = j.updatedAt || '';
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k) || 24;
            var d = k.unlimited ? 'Onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
            var b = /onbeperkt/i.test(k.minutes || '') ? 'onbeperkt bellen' : (k.minutes || '');
            var net = k.network && String(k.network).toLowerCase() !== String(k.provider).toLowerCase() ? 'netwerk van ' + k.network : '';
            return { k: k, naam: k.provider, sub: [d, b, duur(k), net].filter(Boolean).join(' · '), prijs: p, per: 'per maand',
              kort: [d, b, net].filter(Boolean).join(' · '), tags: [duur(k), euro(p * m) + ' over ' + m + ' maanden'],
              rang2: -(k.unlimited ? 9999 : k.dataGB || 0),
              onder: euro(p * m) + ' over ' + m + ' maanden', url: ga(k, 'simonly'), knop: k.provider, aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste maandprijs binnen jouw keuze, bij een gelijke prijs de grootste bundel.' + VERGOEDING,
      alle: ['Alle sim only vergelijken', '/pages/sim-only'], sein: true
    },

    telefoon: {
      vraag: 'Welk toestel zoek je?',
      chips: [
        { id: 'alles', label: 'Laagste kosten', wat: 'laagste kosten per maand', test: function () { return true; } },
        { id: 'apple', label: 'iPhone', wat: 'voordeligste iPhone', test: function (x) { return /iphone/i.test(x.k.device); } },
        { id: 'samsung', label: 'Samsung', wat: 'voordeligste Samsung', test: function (x) { return /samsung/i.test(x.k.device); } },
        { id: 'pixel', label: 'Google Pixel', wat: 'voordeligste Pixel', test: function (x) { return /pixel/i.test(x.k.device); } },
        { id: 'nul', label: 'Geen bijbetaling', wat: 'laagste kosten zonder bijbetaling', test: function (x) { return !(parseFloat(x.k.downPayment) > 0); } }
      ],
      laad: function () {
        return json(WORKER + '/api/cards/telefoon?limit=60').then(function (j) {
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.device; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k) || 24, een = parseFloat(k.downPayment) || 0;
            var totaal = parseFloat(k.totalPrice) || (p * m + een);
            var toestel = parseFloat(k.deviceTotal) || 0, abbo = parseFloat(k.bundleMonthly) || 0;
            var d = k.unlimited ? 'onbeperkt data' : (k.dataGB ? k.dataGB + ' GB' : '');
            var onder = toestel > 0 && abbo > 0
              ? 'Toestel ' + euro(toestel) + (een > 0 ? ', waarvan ' + euro(een) + ' vooraf' : '') + ' · abonnement ' + euro(abbo) + ' per maand'
              : euro(totaal) + ' over ' + m + ' maanden';
            return { k: k, naam: k.device, sub: [k.provider, d, k.minutes, duur(k)].filter(Boolean).join(' · '),
              prijs: p, per: een > 0 ? 'per maand + ' + euro(een) + ' vooraf' : 'per maand',
              rang: totaal / m, onder: onder + ' · samen ' + euro(totaal) + ' over ' + m + ' maanden',
              tags: (toestel > 0 && abbo > 0 ? ['Toestel ' + euro(toestel), 'Abonnement ' + euro(abbo) + ' p/m'] : [])
                .concat(['Samen ' + euro(totaal) + ' over ' + m + ' maanden']),
              mini: (een > 0 ? euro(een) + ' vooraf · ' : '') + 'samen ' + euro(totaal),
              url: ga(k, 'telefoon'), knop: k.provider, foto: k.image || '', aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste totale kosten per maand over de hele looptijd, dus toestel, abonnement en bijbetaling samen.' + VERGOEDING,
      alle: ['Alle telefoons met abonnement', '/pages/telefoonabonnement'], sein: true
    },

    internet: {
      vraag: 'Wat is voor jou belangrijk?',
      chips: [
        { id: 'alles', label: 'Laagste prijs', wat: 'laagste maandprijs', test: function () { return true; } },
        { id: 'snel', label: '1 Gbit of sneller', wat: 'laagste maandprijs vanaf 1 Gbit', test: function (x) { return x.k.speedMbit >= 1000; } },
        { id: 'tv', label: 'Met tv', wat: 'laagste maandprijs met tv', test: function (x) { return !!x.k.tv; } },
        { id: 'jaar', label: '1 jaar contract', wat: 'laagste maandprijs met een contract van 1 jaar', test: function (x) { return mnd(x.k) === 12; } }
      ],
      laad: function () {
        return json(WORKER + '/api/cards/internet?limit=60').then(function (j) {
          return (j.cards || []).filter(function (k) { return parseFloat(k.price) > 0 && k.url && k.provider; }).map(function (k) {
            var p = parseFloat(k.price), m = mnd(k);
            return { k: k, naam: k.provider, sub: [k.speed, k.tv ? 'met tv' : 'alleen internet', duur(k)].filter(Boolean).join(' · '),
              prijs: p, per: 'per maand', rang2: -(k.speedMbit || 0),
              kort: [k.speed, k.tv ? 'met tv' : 'alleen internet'].filter(Boolean).join(' · '),
              tags: [duur(k)].concat(m ? [euro(p * m) + ' over ' + m + ' maanden'] : []),
              onder: m ? euro(p * m) + ' over ' + m + ' maanden' : '', url: ga(k, 'internet'), knop: k.provider, aff: true };
          });
        });
      },
      regel: 'Zo kiezen wij: de laagste maandprijs binnen jouw keuze, bij een gelijke prijs de hoogste snelheid. Controleer bij de aanbieder of dit op jouw adres kan.' + VERGOEDING,
      alle: ['Alle internetabonnementen', '/pages/internet-tv'], sein: true
    },

    energie: {
      vraag: 'Met hoeveel woon je?',
      start: 'samen',
      chips: ['alleen:Alleen', 'samen:Samen', 'gezin:Gezin', 'groot:Groot gezin'].map(function (s) {
        var d = s.split(':');
        return { id: d[0], label: d[1], wat: 'laagste jaarrekening', test: function (x) { return x.hh === d[0]; } };
      }),
      uniek: true,
      laad: function (tab) {
        return json(ENERGIE).then(function (j) {
          var uit = [];
          tab.voet = {};
          (j.huishoudens || []).forEach(function (h) {
            tab.voet[h.id] = 'Stroom en gas, ' + h.verbruik + ', zonder postcode gerekend. Tarieven laatst nagekeken op ' + datum(j.bijgehouden) + '.';
            (h.items || []).forEach(function (i) {
              uit.push({ hh: h.id, naam: i.naam, sub: i.soort, prijs: i.maand, per: 'per maand', rang: i.jaar,
                onder: euro(i.jaar) + ' per jaar, de hele rekening: levering, belasting en netbeheer',
                tags: [euro(i.jaar) + ' per jaar', 'incl. belasting en netbeheer'], mini: euro(i.jaar) + ' per jaar',
                let: i.korting ? 'Inclusief ' + i.korting + '. Die geldt alleen in het eerste jaar.' : '',
                url: i.url, knop: i.naam, aff: !!i.aff });
            });
          });
          return uit;
        });
      },
      regel: 'Zo kiezen wij: de laagste jaarrekening voor dit verbruik, een contract per leverancier. Dynamische contracten doen niet mee, want dat is een schatting. Leveranciers betalen niet voor een plek. Bij een deel van de leveranciers krijgen wij een vergoeding als je afsluit; jij betaalt daardoor niets extra.',
      alle: ['Reken met je eigen verbruik en postcode', '/pages/energie']
    },

    zorg: {
