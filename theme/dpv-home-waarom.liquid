{%- comment -%}
  Zo werkt het, en zo verdienen wij.

  Was "Waarom onze prijzen anders zijn": vier kaarten met een groot cijfer en
  een lange tekst (4 okt).

  5 okt, huisstijl "2-rond" (STIJLGIDS.md): drie korte stappen op een
  lichtblauwe band, elk met een blauw rond nummer. De derde stap zegt waar ons
  geld vandaan komt; dat hoort op de homepage te staan (ACM Leidraad 2024) en
  stond eerst weggestopt in de vierde kaart. De teksten zijn instellingen. De
  link onderaan is er nog, maar staat standaard uit: het contract-seintje staat
  al in de kiezer bovenaan.
{%- endcomment -%}

<script>if(!document.getElementById('dpv-mont')){var l=document.createElement('link');l.id='dpv-mont';l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap';document.head.appendChild(l);}</script>

<section class="dwa">
  <div class="dwa-in">
    <h2 class="dwa-kop">{{ section.settings.kop }}</h2>

    <ol class="dwa-grid">
      {%- for n in (1..3) -%}
        {%- assign k = 's' | append: n | append: '_kop' -%}
        {%- assign t = 's' | append: n | append: '_tekst' -%}
        {%- if section.settings[k] != blank -%}
        <li class="dwa-kaart">
          <span class="dwa-nr" aria-hidden="true">{{ n }}</span>
          <b>{{ section.settings[k] }}</b>
          <p>{{ section.settings[t] }}</p>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>

    {%- if section.settings.cta_tekst != blank and section.settings.cta_url != blank -%}
      <a class="dwa-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_tekst }} &rsaquo;</a>
    {%- endif -%}
  </div>
</section>

<style>
.dwa{background:#F4F7FF;padding:26px 0 28px;margin:26px 0 0;font-family:'Montserrat',system-ui,sans-serif;color:#0D1B2A;-webkit-font-smoothing:antialiased}
.dwa *{box-sizing:border-box}
.dwa-in{max-width:1180px;margin:0 auto;padding:0 16px}
.dwa-kop{font-family:'Montserrat',system-ui,sans-serif;font-weight:800;letter-spacing:-.025em;font-size:21px;line-height:1.2;margin:0 0 12px;color:#0D1B2A}
.dwa-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:9px}
.dwa-kaart{background:#fff;border:1px solid #E6EBF2;border-radius:16px;padding:18px;margin:0}
.dwa-nr{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:#2456D6;color:#fff;
  font-weight:800;font-size:15px;line-height:1;margin-bottom:10px}
.dwa-kaart b{display:block;font-weight:800;font-size:17px;line-height:1.25;letter-spacing:-.01em;margin-bottom:5px;color:#0D1B2A}
.dwa-kaart p{margin:0;font-size:13.5px;line-height:1.5;font-weight:500;color:#4A5A70}
.dwa a.dwa-cta,.dwa a.dwa-cta:visited{display:inline-block;margin-top:16px;font-weight:800;font-size:14px;color:#2456D6;text-decoration:none}
.dwa a.dwa-cta:hover{color:#1B45B4;text-decoration:underline}
.dwa :focus-visible{outline:3px solid #2456D6;outline-offset:2px}
@media(min-width:900px){
  .dwa{padding:34px 0 36px;margin-top:30px}
  .dwa-in{padding:0 20px}
  .dwa-kop{font-size:26px;margin-bottom:14px}
  .dwa-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
}
</style>

{% schema %}
{
  "name": "Zo werkt het",
  "settings": [
    { "type": "text", "id": "kop", "label": "Kop", "default": "Zo werkt het, en zo verdienen wij" },
    { "type": "header", "content": "Stap 1" },
    { "type": "text", "id": "s1_kop", "label": "Kop", "default": "Tik je keuze aan" },
    { "type": "textarea", "id": "s1_tekst", "label": "Tekst", "default": "Geen formulier en geen account. Je ziet direct de laagste prijs en de alternatieven." },
    { "type": "header", "content": "Stap 2" },
    { "type": "text", "id": "s2_kop", "label": "Kop", "default": "Vergelijk de hele rekening" },
    { "type": "textarea", "id": "s2_tekst", "label": "Tekst", "default": "Maandprijs, looptijd en wat je in totaal betaalt, per aanbieder en per winkel." },
    { "type": "header", "content": "Stap 3" },
    { "type": "text", "id": "s3_kop", "label": "Kop", "default": "Ga naar de aanbieder" },
    { "type": "textarea", "id": "s3_tekst", "label": "Tekst", "default": "Sluit je daar af, dan krijgen wij een vergoeding. De volgorde blijft op prijs en jij betaalt niets extra." },
    { "type": "header", "content": "Link onderaan (optioneel)" },
    { "type": "text", "id": "cta_tekst", "label": "Linktekst", "info": "Leeg = geen link." },
    { "type": "text", "id": "cta_url", "label": "URL" }
  ],
  "presets": [ { "name": "Zo werkt het" } ]
}
{% endschema %}
