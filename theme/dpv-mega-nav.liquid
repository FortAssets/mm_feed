{%- comment -%}
  DPV uitklapmenu.

  Aparte sectie in plaats van een wijziging in pv-header.liquid. Die header is
  meertalig en dat wil ik niet aanraken voor een navigatiewijziging.

  Waarom in Liquid en niet met JavaScript vanuit de overlay: de zestig links
  in deze panelen zijn de hele reden om dit te bouwen. Ze moeten in de HTML
  staan die Google ophaalt, niet pas na het uitvoeren van een script.

  Alle links zijn nagekeken tegen de sitemap. Er staat niets in wat niet
  bestaat; ontbrekende onderwerpen zijn weggelaten in plaats van gegokt.

  Deze sectie vervangt de linkrij van de oude header (.pvnav-links), die
  hieronder met CSS verborgen wordt. Het logo en de rechterknoppen daar
  blijven staan.

  19 sep: de zakelijke links wijzen nu rechtstreeks naar de eigen zakelijke
  pagina's. Ze gingen naar /pages/sim-only?zakelijk=1, en dat werkte alleen
  doordat de vergelijker zo'n bezoeker doorstuurde. Voor een bezoeker is dat
  een extra paginalading, en Google zag de oude link staan en volgde de
  doorverwijzing niet als een echte verwijzing. Nu staan er drie: sim only,
  internet en met toestel, elk vanuit de bijbehorende categorie.
{%- endcomment -%}

{%- assign p = '/pages/' -%}
{%- assign a = '/blogs/advies/' -%}
{%- assign n = '/blogs/news/' -%}

<style>
/* De oude linkrij verbergen; logo en knoppen blijven. */
.pvnav-links{display:none !important}

/* De 9,2-badge uit de header. Vertrouwen hoort waar iemand twijfelt — in de
   hero en naast de dealkaarten — niet in de rij waarmee hij navigeert. De
   score staat bovendien al twee keer elders op de pagina. */
.pvnav-rating{display:none !important}

.dmn{background:#fff;border-bottom:1px solid #e8edf5;position:relative;z-index:60;font-family:'Inter',system-ui,sans-serif}

.dmn-zak{
  margin-left:auto;display:inline-flex;align-items:center;gap:7px;
  font-size:12.5px;font-weight:700;color:#0D1B2A;text-decoration:none;
  border:1px solid #e8edf5;border-radius:10px;padding:9px 14px;background:#fff;
  white-space:nowrap;transition:border-color .12s,color .12s
}
.dmn-zak:hover{border-color:#059669;color:#047857}
.dmn-zak svg{opacity:.65;flex:0 0 auto}
.dmn-zak:hover svg{opacity:1}

/* Samengevoegde rij: logo en menu naast elkaar. De panelen hangen dan aan de
   headerrij zelf, zodat ze over de volle breedte uitlijnen. */
.pvnav-inner.dmn-inline{position:relative;display:flex;align-items:center;gap:2px;flex-wrap:nowrap}
.pvnav-inner.dmn-inline .pvnav-logo{margin-right:20px;flex:0 0 auto}
.pvnav-inner.dmn-inline .dmn-i > a{padding:20px 12px;font-size:13.5px}
.pvnav-inner.dmn-inline .dmn-i.plat > a{font-size:13.5px}
.pvnav-inner.dmn-inline .dmn-zak{margin-left:auto}
.pvnav-inner.dmn-inline .pvnav-right{flex:0 0 auto;margin-left:9px}
.pvnav-inner.dmn-inline .dmn-p{width:auto}
@media(max-width:1240px){
  .pvnav-inner.dmn-inline .dmn-i > a{padding:20px 9px;font-size:13px}
  .pvnav-inner.dmn-inline .pvnav-logo{margin-right:12px}
}
.dmn-in{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;gap:2px}

/* Het paneel lijnt uit op de BALK, niet op het losse menu-item. Stond het op
   het item, dan schoof een breed paneel bij een item rechts in de balk het
   scherm uit aan de linkerkant -- bij eSIM viel de eerste kolom weg.
   Daarvoor moet .dmn-i zelf ongepositioneerd zijn, zodat het paneel zich aan
   .dmn-in richt. */
.dmn-in{position:relative}
.dmn-i{position:static}
.dmn-i > a{
  display:flex;align-items:center;gap:6px;padding:14px 13px;
  font-size:14px;font-weight:800;color:#0D1B2A;text-decoration:none;white-space:nowrap;
  border-bottom:3px solid transparent;transition:color .12s,border-color .12s
}
.dmn-i > a .ch{transition:transform .18s ease;opacity:.5;flex:0 0 auto}
.dmn-i:hover > a,.dmn-i:focus-within > a{color:#047857;border-bottom-color:#059669}
.dmn-i:hover > a .ch,.dmn-i:focus-within > a .ch{transform:rotate(180deg)}
.dmn-i.plat > a{font-weight:600;color:#64748b}
.dmn-i.plat:hover > a{color:#0D1B2A;border-bottom-color:#e8edf5}
/* Geen onzichtbare brug meer. Die was nodig toen het paneel aan het item hing;
   nu sluit het paneel direct op de onderrand van de balk aan (top:100% en geen
   bovenrand), dus er is geen kier om te overbruggen. En met .dmn-i op static
   zou zo'n strook zich over de hele balk uitstrekken en elk item tegelijk
   'aangewezen' maken. */

.dmn-p{
  position:absolute;left:0;right:0;top:100%;width:auto;
  background:#fff;border:1px solid #e8edf5;border-top:none;border-radius:0 0 16px 16px;
  box-shadow:0 26px 56px -24px rgba(13,27,42,.4);
  padding:20px 22px;display:grid;grid-template-columns:1.05fr 1fr 1.15fr .95fr;gap:22px;
  opacity:0;visibility:hidden;transform:translateY(-7px);
  transition:opacity .16s ease,transform .16s ease,visibility .16s;z-index:55
}
.dmn-i:hover .dmn-p,.dmn-i:focus-within .dmn-p{opacity:1;visibility:visible;transform:none}
/* De uitzondering voor de laatste items is niet meer nodig: alle panelen
   staan nu op dezelfde plek, uitgelijnd met de inhoud van de balk. */

.dmn-p h5{font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#94a3b8;margin:0 0 9px}
.dmn-p a.r{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px;color:#0D1B2A;text-decoration:none;padding:6px 8px;margin-left:-8px;border-radius:8px;line-height:1.35}
.dmn-p a.r:hover{background:#f4f8ff;color:#1B3FA0}
.dmn-p a.r small{color:#64748b;font-size:11px;display:block;margin-top:1px;font-weight:400}
.dmn-p a.r .pl{color:#94a3b8;opacity:0;transition:opacity .12s;flex:0 0 auto}
.dmn-p a.r:hover .pl{opacity:1}

.dmn-pro{background:linear-gradient(160deg,#f0fdf4,#fff);border:1px solid #a7f3d0;border-radius:14px;padding:15px;display:flex;flex-direction:column}
.dmn-pro .lb{font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#047857;margin-bottom:7px}
.dmn-pro b{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:14.5px;display:block;line-height:1.25;color:#0D1B2A}
.dmn-pro .sp{font-size:11.5px;color:#64748b;margin-top:3px;line-height:1.45}
.dmn-pro .kn{background:#059669;color:#fff;text-align:center;font-size:12px;font-weight:700;padding:9px;border-radius:9px;margin-top:auto;text-decoration:none}
.dmn-pro .kn:hover{background:#047857}

/* 7 okt: beeld in de panelen. Logo's bij aanbieders en merken, en in het
   blok rechts een rij logo's of de populairste toestellen. De plaatjes laden
   pas als iemand het menu aanraakt, zodat een gewone paginalading niets extra
   ophaalt. */
html:not(#x) .dmn-p a.r.lg{flex-wrap:nowrap !important;justify-content:flex-start !important;gap:10px}
.dmn-p a.r.lg .tx{flex:1 1 auto;min-width:0}
.dmn-lg{width:26px;height:26px;border-radius:7px;border:1px solid #E3E8F0;background:#fff;object-fit:contain;padding:3px;flex:0 0 auto;box-sizing:border-box}
.dmn-vis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:13px 0}
.dmn-vis a{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;border:1px solid #E3E8F0;border-radius:10px;padding:10px 5px 8px;text-decoration:none;color:#0D1B2A;font-size:11.5px;font-weight:600;text-align:center;background:#fff;line-height:1.25;transition:border-color .12s}
.dmn-vis a:hover{border-color:#0D1B2A}
.dmn-vis img{width:34px;height:34px;object-fit:contain;border-radius:7px}
.dmn-vis.twee{grid-template-columns:1fr 1fr}
.dmn-vis.tel a{padding:8px 5px}
.dmn-vis.tel img{width:100%;height:86px;border-radius:0}
.dmn-vis-k{font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:#4A5A70;margin:10px 0 -6px}
.dmn-pro .kn{margin-top:auto}

.dmn-vt{grid-column:1/-1;border-top:1px solid #e8edf5;margin-top:2px;padding-top:12px;display:flex;gap:18px;flex-wrap:wrap;font-size:12px}
.dmn-vt a{color:#1B3FA0;text-decoration:none;font-weight:600}
.dmn-vt a:hover{text-decoration:underline}

/* ============================================================
   MOBIEL MENU — iconen zonder gekleurd vlak (variant C)
   ------------------------------------------------------------
   De vlakjes gebruikten zes kleuren die niets betekenden: Los toestel
   groen, Dagdeals oranje, Veelgestelde vragen paars. Oranje en paars
   komen nergens anders op de site voor, en juist in een menu — het meest
   herhaalde element — valt dat op.

   Nu alleen het lijnicoon in navy. Zonder vlak lopen de regels sneller in
   elkaar over, dus de scheidingslijnen blijven staan en het icoon krijgt
   meer ruimte ernaast; anders wordt het op een telefoon mistikken.
   ============================================================ */
.pvnav-mobile a .pvico{
  background:none !important;color:#0D1B2A !important;
  width:26px !important;height:26px !important;border-radius:0 !important
}
.pvnav-mobile a .pvico svg{width:22px !important;height:22px !important;stroke-width:1.8 !important;opacity:.8}
.pvnav-mobile a{gap:16px !important;padding:15px 0 !important}
.pvnav-mobile a:hover .pvico svg,.pvnav-mobile a:active .pvico svg{opacity:1}
/* De kleuruitzonderingen per item overrulen: die zaten op de vlakjes. */
.pvnav-mobile a.pvm-toestel .pvico,
.pvnav-mobile a.pvm-deal .pvico,
.pvnav-mobile a.pvm-esim .pvico,
.pvnav-mobile a.pvm-faq .pvico,
.pvnav-mobile a.pvm-zak .pvico{background:none !important;color:#0D1B2A !important}

/* Aanwijzen bestaat niet op mobiel/tablet; daar neemt de hamburger van pv-header
   het over. De oude linkrij NIET terugzetten: acht items met white-space:nowrap
   zijn samen ruim 1100px breed en duwen het hele document breder dan het scherm
   (horizontale overflow -- content in een smalle kolom links, witruimte rechts).
   pv-header verbergt .pvnav-links zelf al onder 1100px en toont daar .pvnav-burger
   met het .pvnav-mobile paneel. Zelfde breakpoint aanhouden, zodat er geen
   tussengebied is waar beide menu's tegelijk zichtbaar zijn. */
@media(max-width:1100px){ .dmn{display:none} }
</style>

{%- comment -%}
  Het menu naast het logo in plaats van eronder.

  De balk staat als losse sectie ná de header in de HTML — dat moet, want de
  links moeten server-rendered zijn voor Google. Maar visueel hoort hij op
  dezelfde regel als het logo. Daarom verhuizen we de items met JavaScript naar
  de bestaande headerrij. De links zelf staan gewoon in de broncode; alleen hun
  plek verandert.
{%- endcomment -%}
<script>
(function(){
  function schuif(){
    var bar = document.querySelector('.dmn');
    var rij = document.querySelector('.pvnav-inner');
    if (!bar || !rij || rij.dataset.dmnKlaar) return;
    if (window.innerWidth <= 1100) return;          // daar geldt de hamburger
    var inner = bar.querySelector('.dmn-in');
    if (!inner) return;
    rij.dataset.dmnKlaar = '1';
    var logo = rij.querySelector('.pvnav-logo');
    // Items één voor één achter het logo plaatsen, in dezelfde volgorde.
    var na = logo ? logo.nextSibling : rij.firstChild;
    [].slice.call(inner.children).forEach(function(el){ rij.insertBefore(el, na); });
    bar.remove();
    rij.classList.add('dmn-inline');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schuif);
  else schuif();
  setTimeout(schuif, 400);
})();
</script>

<script>
(function(){
  var gedaan = false;
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function laad(){
    if (gedaan || window.innerWidth <= 1100) return; gedaan = true;
    var im = document.querySelectorAll('img.dmn-lg[data-src],img.dmn-vi[data-src]');
    for (var i = 0; i < im.length; i++) { im[i].src = im[i].getAttribute('data-src'); im[i].removeAttribute('data-src'); }
    var vak = document.getElementById('dmn-tel');
    if (!vak || !window.fetch) return;
    fetch('https://go.deprijsvergelijker.com/api/cards/telefoon?limit=8').then(function(r){return r.json();}).then(function(d){
      var gezien = {}, uit = [];
      (d.cards || []).forEach(function(c){
        var naam = String(c.device || '').replace(/^(Apple|Samsung|Google|OnePlus|Xiaomi|Motorola|OPPO|Oppo|Nothing|Fairphone)\s+/, '');
        if (!naam || !c.image || gezien[naam] || uit.length >= 3) return;
        gezien[naam] = 1;
        uit.push('<a href="/pages/telefoonabonnement?q=' + encodeURIComponent(naam) + '&sorteer=price"><img src="' + esc(c.image) + '" alt="" loading="lazy" width="80" height="86">' + esc(naam) + '</a>');
      });
      if (uit.length === 3) { vak.innerHTML = uit.join(''); vak.hidden = false; }
    }).catch(function(){});
  }
  function haak(){
    var rij = document.querySelector('.pvnav-inner') || document.querySelector('.dmn');
    if (!rij) return;
    ['pointerenter','focusin','touchstart'].forEach(function(e){ rij.addEventListener(e, laad, { passive: true }); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', haak); else haak();
})();
</script>

