      var foto = '<div class="ft">' + (p.im ? '<img src="' + esc(p.im) + '" alt="" loading="lazy" style="max-width:88%;max-height:88%;object-fit:contain">' : '') + '</div>';
      return '<a class="kaart' + (i ? '' : ' top') + '" href="' + url + '">' + foto + '<span class="m">' + esc(p.b) + '</span><h3>' + esc(p.n) + '</h3><div class="p"><b>' + eur(p.p) + '</b><span class="w2">' + n + ' winkels</span></div>' + (i ? '' : '<span class="knop" style="margin-top:14px">Vergelijk prijzen →</span>') + '</a>';
    }).join('');
  }).catch(function () {});
})();
</script>
