  <details><summary>Waarom zijn sommige producten zo snel uitverkocht?</summary><p>Bij populaire sets kopen opkopers grote aantallen op de releasedag en verkopen ze daarna duurder door. Bestel daarom op tijd voor, of zet een seintje voor de volgende voorraad.</p></details><details><summary>Wat is de adviesprijs?</summary><p>De prijs die de uitgever aanraadt. Pokémon publiceert geen Nederlandse adviesprijzen; wij gaan uit van de Duitse adviesprijzen (UVP) van de huidige sets, zoals €4,99 per booster en €54,99 voor een Elite Trainer Box. Bij oudere sets die niet meer gemaakt worden, zeggen we niets over de prijs.</p></details><details><summary>Hoe vaak worden de prijzen bijgewerkt?</summary><p>Twee keer per dag halen wij de prijzen en de voorraad op bij de winkels. Controleer de prijs altijd bij de winkel voordat je koopt.</p></details><details><summary>Japanse of Engelse kaarten?</summary><p>Japanse pakjes zijn vaak goedkoper en anders samengesteld. Voor verzamelen maakt het niet uit, voor toernooien in Europa heb je meestal Engelse kaarten nodig. Bij Japanse producten tonen wij geen adviesprijslabel.</p></details><details><summary>Hoe voorkom ik nepkaarten?</summary><p>Koop dichte producten bij bekende winkels. Wees voorzichtig met losse kaarten of open dozen van onbekende verkopers, en met prijzen die veel te laag lijken.</p></details>
  <p class="fijn">Vergelijken is gratis. Koop je via onze site, dan krijgen wij soms een vergoeding van de winkel. De volgorde staat los van die vergoeding. Pokémon is een merk van Nintendo, Creatures en GAME FREAK. Wij zijn geen onderdeel van The Pokémon Company.</p>
 </div>
</div>
<script>
(function () {
function advies(n){n=String(n||'').toLowerCase();
 if(!/perfect order|chaos rising|pitch black|ascended heroes|phantasmal flames|mega evolution|delta reign|destined rivals|black bolt|white flare|journey together|prismatic evolutions/.test(n))return 0;
 if(/japans|japanese|korea|chinese|\(jp\)|pok[eé]mon center|\btin\b|collection|bundle display|display.*bundle|\bcase\b/.test(n))return 0;
 if(/elite trainer box|top trainer box/.test(n))return 54.99;
 if(/booster bundle|booster bundel/.test(n))return 29.99;
 if(/\bhalf|18 booster|18[- ]pack/.test(n))return 89.82;
 if(/booster (box|display)|36 booster|36[- ]pack/.test(n))return 179.64;
 if(/\b3[- ]?(pack|booster)/.test(n))return 15.99;
 if(/\b2[- ]?(pack|booster)/.test(n))return 12.99;
 if(/\b[4-9] ?booster|\b[4-9][- ]pack/.test(n))return 0;
 if(/\bbooster( pack)?\b/.test(n)&&!/blister|box|deck|kit|display/.test(n))return 4.99;
 return 0}
function oordeel(p,a){if(!a||!p)return null;var r=p/a;
 if(r<0.95)return['groen','Onder adviesprijs'];if(r<=1.05)return['groen','Rond adviesprijs'];if(r<=1.25)return['oranje','Iets boven adviesprijs'];return['rood','Ruim boven adviesprijs']}

(function () {
  var r = document.getElementById('pkm'); if (!r) return;
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var eur = function (n) { return '€' + Number(n).toLocaleString('nl-NL', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }); };
  var lab = function (p, n) { var o = oordeel(p, advies(n)); return o ? '<span class="ap ' + o[0] + '">' + o[1] + '</span>' : ''; };
  var zoek = function (p) { return '/pages/vergelijken?cat=kaarten&type=pokemon&q=' + encodeURIComponent(p.n); };
  var wk = function (p) { return (p.o && p.o[0] && p.o[0].w) || ''; };
  fetch(r.dataset.shop + '/api/shop/lijst?cat=kaarten&type=pokemon&n=200&sort=winkels').then(function (x) { return x.json(); }).then(function (j) {
    var it = ((j && j.items) || []).filter(function (p) { return p.im && p.p > 0; }); if (it.length < 7) return;
    r.querySelector('[data-f=voorraad]').innerHTML = it.slice(0, 7).map(function (p, i) {
      return '<a class="kaart' + (i ? '' : ' top') + '" href="' + zoek(p) + '"><div class="ft"><img src="' + esc(p.im) + '" alt="" loading="lazy" style="max-width:88%;max-height:88%;object-fit:contain"></div><span class="m">' + esc(wk(p)) + (p.o.length > 1 ? ' en ' + (p.o.length - 1) + ' meer' : '') + '</span><h3>' + esc(p.n) + '</h3><div class="p"><b>' + eur(p.p) + '</b><span class="w2">' + p.o.length + (p.o.length === 1 ? ' winkel' : ' winkels') + '</span></div>' + lab(p.p, p.n) + (i ? '' : '<span class="knop" style="margin-top:14px">Vergelijk prijzen →</span>') + '</a>';
    }).join('');
    var g = it.filter(function (p) { return advies(p.n); }).sort(function (a, b) { return a.p / advies(a.n) - b.p / advies(b.n); }).slice(0, 4);
    if (g.length) r.querySelector('[data-f=advies]').innerHTML = g.map(function (p) {
      return '<a class="nw" href="' + zoek(p) + '"><div class="t"><b>' + eur(p.p) + '</b><span>' + esc(wk(p)) + '</span></div><div>' + lab(p.p, p.n) + '<h3>' + esc(p.n) + '</h3><p><b>' + eur(p.p) + '</b> bij ' + esc(wk(p)) + ' · adviesprijs ' + eur(advies(p.n)) + '</p></div><div class="ft" style="background:#F3F5F9"><img src="' + esc(p.im) + '" alt="" loading="lazy" style="max-width:86%;max-height:86%;object-fit:contain;mix-blend-mode:multiply"></div></a>';
    }).join('');
  }).catch(function () {});
  // Seintje: aanmelden op de lijst pokemon-alert, met de gekozen set als voorkeur.
  var f = document.getElementById('pk-sein'); if (!f) return;
  var keuze = document.getElementById('pk-keuze'), mail = document.getElementById('pk-mail'), knop = document.getElementById('pk-knop'), uit = document.getElementById('pk-uit');
  var zeg = function (t, ok) { uit.textContent = t; uit.style.color = ok ? '#7BE0A7' : '#FFB4A6'; uit.hidden = false; };
  Array.prototype.forEach.call(r.querySelectorAll('[data-sein]'), function (b) {
    b.addEventListener('click', function (e) { e.preventDefault(); keuze.value = b.getAttribute('data-sein'); f.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(function () { mail.focus(); }, 400); });
  });
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var adres = (mail.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(adres)) { zeg('Vul een geldig e-mailadres in.', false); mail.focus(); return; }
    knop.disabled = true; var oud = knop.textContent; knop.textContent = 'Bezig…';
    fetch('https://mijn.deprijsvergelijker.com/api/mc/aanmelden', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: adres, lijst: 'pokemon-alert', bron: 'pokemonpagina', voorkeur: keuze.value }) })
      .then(function (x) { return x.json(); })
      .then(function (res) { if (res && res.ok) { zeg('Gelukt. Je krijgt een bevestiging per mail.', true); mail.value = ''; } else zeg((res && res.fout) || 'Er ging iets mis. Probeer het later nog eens.', false); })
      .catch(function () { zeg('Er ging iets mis. Probeer het later nog eens.', false); })
      .then(function () { knop.disabled = false; knop.textContent = oud; });
  });
})();
})();
</script>
{% schema %}
{
  "name": "Pokémon vergelijken",
  "settings": [
    { "type": "text", "id": "kop", "label": "Kop", "default": "Pokémonkaarten vergelijken zonder woekerprijs" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Wij laten zien welke winkel een set op voorraad heeft en wat hij daar kost. Bij de huidige sets zie je meteen of de prijs rond de adviesprijs ligt of ver erboven." },
    { "type": "checkbox", "id": "pj", "label": "Prijsje tonen", "default": true },
    { "type": "text", "id": "shop", "label": "Adres van de vergelijker", "default": "https://shop.deprijsvergelijker.com" }
  ]
}
{% endschema %}
