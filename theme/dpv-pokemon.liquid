    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Wij laten zien welke winkel een set nog op voorraad heeft en wat hij daar kost. Bij elk product zie je de adviesprijs, zodat je een opkopersprijs meteen herkent." },
    { "type": "checkbox", "id": "pj", "label": "Prijsje tonen", "default": true },
