{%- comment -%}
  Meldingsbalk in twee helften: links wat je nu kunt bestellen, rechts wat
  eraan komt.

  Waarom twee: je hebt twee bezoekers met twee verschillende acties. Bij de
  iPhone 18 kan iemand vandaag bestellen, en dat levert nu geld op. Bij de Duo
  kan dat pas op 16 oktober, dus daar wil je alleen een e-mailadres.

  Zodra het pre-ordermoment rechts is gepasseerd, wordt die helft ook licht en
  verandert de knoptekst vanzelf in "Vergelijk". Dat gebeurt in de browser en
  niet in Liquid, want Shopify houdt pagina's in de cache.

  2 okt: de balk staat niet op elke pagina, alleen op de startpagina en de
  telecompagina's (instelling "Alleen tonen op"). Op zorg, boodschappen en
  energie dus niet, en op de zakelijke pagina's ook niet ("Niet tonen op").

  9 okt: terug aan, in de huisstijl van de rebranding: lichtgroen vlak met gele
  knop voor wat nu kan, donker vlak voor wat eraan komt, letters Bricolage
  Grotesque en Instrument Sans. Op de telefoon staan de twee helften naast
  elkaar in een lage balk die niet meeschuift, zodat hij geen halve schermhoogte
  inneemt; op de computer blijft hij bovenaan staan. De prijs links volgt de
  pre-orderpagina (vanaf €1.479).
{%- endcomment -%}

{%- liquid
  assign toon = section.settings.aan
  assign vandaag = 'now' | date: '%Y-%m-%d'
  if section.settings.tot != blank and vandaag > section.settings.tot
    assign toon = false
  endif

  assign mag = false
  if request.page_type == 'index'
    assign mag = true
  endif
  assign witte_lijst = section.settings.toon_op
  if witte_lijst == blank
    assign witte_lijst = 'sim-only,telefoon,iphone,internet,providers,toestellen,zender,abonnement,esim,apple-event,odido-klik-en-klaar,duo-pre-order'
  endif
  assign stukken = witte_lijst | split: ','
  assign pad = request.path | downcase
  for stuk in stukken
    assign schoon = stuk | strip | downcase
    if schoon != blank and pad contains schoon
      assign mag = true
    endif
  endfor
  unless mag
    assign toon = false
  endunless

  if section.settings.verberg_op != blank
    assign paden = section.settings.verberg_op | split: ','
    for pad2 in paden
      assign schoon2 = pad2 | strip
      if schoon2 != blank and request.path contains schoon2
        assign toon = false
      endif
    endfor
  endif
-%}

{%- if toon -%}
<div class="dpb" id="dpb" data-start="{{ section.settings.b_moment }}">
  <div class="dpb-in">

    <a class="dpb-helft dpb-nu" href="{{ section.settings.a_link }}">
      <span class="dpb-links">
        {%- if section.settings.a_img != blank -%}
        <span class="dpb-img"><img src="{{ section.settings.a_img }}" alt="" width="34" height="44" loading="eager" decoding="async"></span>
        {%- endif -%}
        <span class="dpb-tx">
          <span class="dpb-titel">{{ section.settings.a_titel }}</span>
          <span class="dpb-sub">{{ section.settings.a_sub }}</span>
        </span>
      </span>
      <span class="dpb-knop">{{ section.settings.a_knop }}</span>
    </a>

    <a class="dpb-helft dpb-straks" id="dpb-b" href="{{ section.settings.b_link }}">
      <span class="dpb-links">
        <span class="dpb-img dpb-img-breed">
          <img src="{% if section.settings.b_img != blank %}{{ section.settings.b_img }}{% else %}{{ 'dpv-po-duo.webp' | asset_url }}{% endif %}" alt="" width="48" height="42" loading="eager" decoding="async">
        </span>
        <span class="dpb-tx">
          <span class="dpb-titel"><i class="dpb-dot" aria-hidden="true"></i>{{ section.settings.b_titel }} <span class="dpb-cnt" id="dpb-cnt" hidden></span></span>
          <span class="dpb-sub" id="dpb-b-sub">{{ section.settings.b_sub }}</span>
        </span>
      </span>
      <span class="dpb-knop" id="dpb-b-knop">{{ section.settings.b_knop }}</span>
    </a>

    <button type="button" class="dpb-sluit" id="dpb-sluit" aria-label="Melding sluiten">&times;</button>
  </div>
</div>

<style>
/* 12 okt: donkere regel (concept B van de homepage). Eén donkere kleur, tekstlinks in geel,
   bij de Duo een groene stip en "nog X dagen". Op de telefoon alleen het dringendste bericht (rechts). */
#shopify-section-{{ section.id }}{position:-webkit-sticky;position:sticky;top:0;z-index:90}
.dpb{--ink:#0D1B2A;--geel:#F9C31F;--groen:#3FAE7A;position:relative;z-index:1;
  font-family:'Instrument Sans',system-ui,sans-serif;background:var(--ink);color:#fff}
.dpb *{box-sizing:border-box}
.dpb-in{display:flex;align-items:center;justify-content:center;max-width:1240px;margin:0 auto;position:relative;padding:0 48px 0 24px;min-height:44px}
.dpb a.dpb-helft,.dpb a.dpb-helft:visited{flex:0 1 auto;min-width:0;display:flex;align-items:center;gap:14px;padding:8px 0;text-decoration:none;color:#fff !important}
.dpb a.dpb-straks{order:-1}
.dpb a.dpb-nu{border-left:1px solid rgba(255,255,255,.18);padding-left:22px;margin-left:22px}
.dpb-links{display:flex;align-items:center;gap:10px;min-width:0}
.dpb-img{display:none}
.dpb-tx{min-width:0;display:flex;align-items:center;gap:10px;white-space:nowrap;overflow:hidden}
.dpb-titel{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;line-height:1.2;color:#fff}
.dpb-dot{width:8px;height:8px;border-radius:50%;background:var(--groen);box-shadow:0 0 0 4px rgba(63,174,122,.25);flex:none}
.dpb-cnt{background:var(--geel);color:var(--ink);font-weight:800;font-size:12.5px;border-radius:6px;padding:2px 8px;line-height:1.3}
.dpb-sub{font-size:14px;line-height:1.2;color:#C9D4E3;overflow:hidden;text-overflow:ellipsis}
.dpb-knop{flex:0 0 auto;color:var(--geel);font-weight:700;font-size:14px;white-space:nowrap}
.dpb-knop::after{content:" \2192"}
.dpb a.dpb-helft:hover .dpb-knop{text-decoration:underline;text-underline-offset:3px}
.dpb-sluit{position:absolute;top:50%;right:12px;transform:translateY(-50%);width:28px;height:28px;border:0;border-radius:8px;
  background:transparent;color:#9FB0C6;font-size:19px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center}
html:not(#x):not(#y) .dpb .dpb-sluit,html:not(#x):not(#y) .dpb.is-open .dpb-sluit{background:transparent !important;color:#9FB0C6 !important;border:0 !important}
html:not(#x):not(#y) .dpb .dpb-sluit:hover{color:#fff !important}
.dpb-sluit:focus-visible,.dpb a.dpb-helft:focus-visible{outline:2px solid var(--geel);outline-offset:2px}
@media(max-width:820px){
  #shopify-section-{{ section.id }}{position:relative}
  .dpb-in{justify-content:flex-start;padding:0 38px 0 12px;min-height:42px}
  .dpb a.dpb-nu{display:none}
  .dpb a.dpb-helft{flex:1 1 auto;gap:8px;padding:6px 0}
  .dpb-sub{display:none}
  .dpb-titel{font-size:13.5px;gap:7px}
  .dpb-cnt{font-size:12px;padding:2px 7px}
  .dpb-knop{margin-left:auto;font-size:13.5px}
  .dpb-sluit{right:6px}
}
</style>

<script>
(function () {
  var balk = document.getElementById('dpb');
  if (!balk) return;

  var start = Date.parse(balk.getAttribute('data-start') || '');
  var cnt = document.getElementById('dpb-cnt');
  if (cnt && !isNaN(start) && Date.now() < start) {
    var dag = function (t) { var d = new Date(t); return Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5; };
    var n = dag(start) - dag(Date.now());
    cnt.textContent = n <= 0 ? 'vandaag' : n === 1 ? 'morgen' : 'nog ' + n + ' dagen';
    cnt.hidden = false;
  }
  if (!isNaN(start) && Date.now() >= start) {
    balk.classList.add('is-open');
    var b = document.getElementById('dpb-b');
    if (b) b.classList.add('is-open');
    var sub = document.getElementById('dpb-b-sub');
    if (sub) sub.textContent = {{ section.settings.b_sub_na | json }};
    var knop = document.getElementById('dpb-b-knop');
    if (knop) knop.textContent = {{ section.settings.b_knop_na | json }};
  }

  var SL = 'dpb-dicht';
  try {
    var eerder = localStorage.getItem(SL);
    if (eerder && Date.now() - parseInt(eerder, 10) < 7 * 864e5) {
      balk.parentNode.style.display = 'none';
      return;
    }
  } catch (e) {}

  var sluit = document.getElementById('dpb-sluit');
  if (sluit) {
    sluit.addEventListener('click', function () {
      balk.parentNode.style.display = 'none';
      try { localStorage.setItem(SL, String(Date.now())); } catch (e) {}
    });
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Meldingsbalk",
  "settings": [
    { "type": "checkbox", "id": "aan", "label": "Tonen", "default": true },
    { "type": "text", "id": "tot", "label": "Verberg na (JJJJ-MM-DD)", "default": "2026-11-07" },
    { "type": "textarea", "id": "toon_op", "label": "Alleen tonen op", "default": "sim-only,telefoon,iphone,internet,providers,toestellen,zender,abonnement,esim,apple-event,odido-klik-en-klaar,duo-pre-order", "info": "Padgedeelten, gescheiden door komma's. De startpagina telt altijd mee. Laat je dit leeg, dan geldt dezelfde lijst." },
    { "type": "textarea", "id": "verberg_op", "label": "Niet tonen op", "default": "/pages/zakelijk-", "info": "Padgedeelten, gescheiden door komma's. Dit gaat voor op de lijst hierboven." },

    { "type": "header", "content": "Links: wat nu kan" },
    { "type": "text", "id": "a_titel", "label": "Titel", "default": "iPhone 18 Pro" },
    { "type": "text", "id": "a_sub", "label": "Regel eronder", "default": "vanaf €1.479 · nu te bestellen" },
    { "type": "text", "id": "a_knop", "label": "Knop", "default": "Vergelijk" },
    { "type": "text", "id": "a_link", "label": "Link", "default": "/pages/iphone-18-pre-order" },
    { "type": "text", "id": "a_img", "label": "Afbeelding links (URL)", "default": "https://images.ctfassets.net/m5g3wfd9m3nr/1L25vzFmqoR0xr5gDSpKgb/937aff98c55f5e966ea005786b3de9d7/iPhone-18-Pro-Burgundy-1.png?q=90&w=120" },

    { "type": "header", "content": "Rechts: wat eraan komt" },
    { "type": "text", "id": "b_titel", "label": "Titel", "default": "iPhone Duo" },
    { "type": "text", "id": "b_sub", "label": "Regel eronder", "default": "16 okt, 14:00 uur · vanaf €2.339" },
    { "type": "text", "id": "b_knop", "label": "Knop", "default": "Seintje" },
    { "type": "text", "id": "b_link", "label": "Link", "default": "/pages/iphone-duo-pre-order" },
    { "type": "text", "id": "b_img", "label": "Afbeelding rechts (URL, leeg = Duo-foto uit het thema)" },
    { "type": "text", "id": "b_moment", "label": "Pre-ordermoment (ISO)", "default": "2026-10-16T14:00:00+02:00" },
    { "type": "text", "id": "b_sub_na", "label": "Regel eronder na dat moment", "default": "vanaf €2.339 · nu te bestellen" },
    { "type": "text", "id": "b_knop_na", "label": "Knop na dat moment", "default": "Vergelijk" }
  ],
  "presets": [ { "name": "Meldingsbalk" } ]
}
{% endschema %}
