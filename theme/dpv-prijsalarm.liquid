.pa-ow-in{margin:10px 0 0}
.pa-ow .pa-cats{margin:0}
.pa-ow-snel{display:flex;gap:14px;margin:10px 0 0}
.pa-ow-fijn{font-size:12px;line-height:1.5;color:var(--soft);margin:8px 0 0}
.pa-vorm-balk .pa-ow{display:none}
.pa-cat{background:#fff;border:1.5px solid #BFE6D4;border-radius:99px;padding:8px 14px;font-family:inherit;
  font-size:14px;font-weight:700;color:var(--ink);cursor:pointer}
.pa-cat[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
@media(max-width:560px){
  .pa-f{flex-direction:column}
  .pa-knop{width:100%}
}
</style>

{% render 'dpv-mailcheck' %}
<script>
(function () {
  var wortel = document.getElementById('pa-{{ section.id }}');
  if (!wortel) return;
  var API = wortel.getAttribute('data-api');
  var BRON = wortel.getAttribute('data-bron') || '';

  function deel(rol) { return wortel.querySelector('[data-rol="' + rol + '"]'); }
  function toon(rol) {
    ['formulier', 'gelukt', 'voorkeur'].forEach(function (r) {
      var el = deel(r); if (el) el.hidden = r !== rol;
    });
  }
  function zeg(el, tekst, goed) {
    el.textContent = tekst;
    el.style.color = goed ? '#047857' : '#B42318';
    el.hidden = false;
  }

  var sleutel = new URLSearchParams(location.search).get('s') || '';
  var pad = location.pathname;

  // De drie servicepagina's horen niet in Google: ze hebben geen inhoud
  // zonder sleutel en een gedeelde link zou een vreemde op iemands
  // voorkeuren kunnen zetten. Google voert dit script uit en houdt zich
  // aan een robots-meta die er zo in komt.
  if (/bevestig|afmeld|mijn-aanbiedingen/.test(pad)) {
    var mt = document.querySelector('meta[name="robots"]');
    if (!mt) { mt = document.createElement('meta'); mt.setAttribute('name', 'robots'); document.head.appendChild(mt); }
    mt.setAttribute('content', 'noindex,follow');
  }

  // ---- Onderwerpchips ----------------------------------------------------
  //
  // De lijst staat hier en niet alleen in de worker, zodat de chips er staan
  // voordat er een verzoek uit is. De worker gooit alles weg wat hij niet
  // kent, dus een verouderde lijst hier kan geen rommel in de database zetten.
  var ONDERWERPEN = [
    ['black-friday', 'Black Friday'],
    ['gaming', 'Gaming en consoles'],
    ['telefoons', 'Telefoons en tablets'],
    ['laptops', 'Laptops en computers'],
    ['tv-beeld', "Tv's en beeld"],
    ['audio', 'Audio'],
    ['huishoudelijk', 'Huishoudelijk'],
    ['keuken', 'Koffie en keuken'],
    ['boodschappen', 'Boodschappen'],
    ['telecom', 'Sim only en abonnementen'],
    ['energie', 'Energie'],
    ['zorg', 'Zorgverzekering']
  ];

  var owVak = deel('ow');
  if (owVak) {
    // Voorselectie: leeg betekent alles aan. Zet je er iets in, dan staan
    // alleen die aan, en de rest uit maar wel zichtbaar.
    var voor = String(wortel.getAttribute('data-voor') || '').split(',')
      .map(function (x) { return x.trim(); }).filter(Boolean);
    owVak.innerHTML = ONDERWERPEN.map(function (o) {
      var aan = voor.length ? voor.indexOf(o[0]) > -1 : true;
      return '<button type="button" class="pa-cat" aria-pressed="' + (aan ? 'true' : 'false') +
        '" data-o="' + o[0] + '">' + o[1] + '</button>';
    }).join('');
    owVak.addEventListener('click', function (e) {
      var k = e.target.closest('.pa-cat');
      if (!k) return;
      k.setAttribute('aria-pressed', k.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      owTelBij();
    });

    // De knop zegt hoeveel er aanstaan en welke, zodat je niet hoeft open te
    // klappen om te zien wat er gebeurt als je niets doet.
    var owKnop = deel('ow-knop'), owIn = deel('ow-in'), owTel = deel('ow-tel');
    function owTelBij() {
      var aan = gekozenOnderwerpen();
      if (owTel) owTel.textContent = aan.length === ONDERWERPEN.length ? 'alles' : String(aan.length);
      var tekst = deel('ow-aan');
      if (!tekst) return;
      if (aan.length === ONDERWERPEN.length) tekst.textContent = 'onderwerpen staan aan';
      else if (!aan.length) tekst.textContent = 'niets gekozen, je krijgt alles';
      else {
        var namen = ONDERWERPEN.filter(function (o) { return aan.indexOf(o[0]) > -1; }).map(function (o) { return o[1]; });
        tekst.textContent = namen.slice(0, 2).join(', ') + (namen.length > 2 ? ' en ' + (namen.length - 2) + ' meer' : '');
      }
    }
    if (owKnop && owIn) {
      owKnop.addEventListener('click', function () {
        var open = owIn.hidden;
        owIn.hidden = !open;
        owKnop.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    var alles = deel('ow-alles'), niets = deel('ow-niets');
    function zetAlle(aan) {
      [].slice.call(owVak.querySelectorAll('.pa-cat')).forEach(function (k) {
        k.setAttribute('aria-pressed', aan ? 'true' : 'false');
      });
      owTelBij();
    }
    if (alles) alles.addEventListener('click', function () { zetAlle(true); });
    if (niets) niets.addEventListener('click', function () { zetAlle(false); });
    owTelBij();
  }
  function gekozenOnderwerpen() {
    if (!owVak) return [];
    return [].slice.call(owVak.querySelectorAll('.pa-cat[aria-pressed="true"]'))
      .map(function (k) { return k.getAttribute('data-o'); });
  }

  // ---- Aanmelden ---------------------------------------------------------
  var form = wortel.querySelector('.pa-f');
  if (form) {
    var veld = wortel.querySelector('.pa-mail');
    var knop = wortel.querySelector('.pa-knop');
    var melding = deel('melding');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var adres = (veld.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(adres)) { zeg(melding, 'Vul een geldig e-mailadres in.', false); veld.focus(); return; }
      // 9 okt: tikfout in het domein (.con, gmial.com)? Eerst vragen. Wie
      // hetzelfde adres nog eens verstuurt, laten we door; de worker kijkt dan
      // zelf of het domein mail aanneemt.
      var voorstel = window.dpvMail ? window.dpvMail.tip(adres) : '';
      if (voorstel && form.getAttribute('data-tip') !== adres) {
        form.setAttribute('data-tip', adres);
        zeg(melding, '', false); window.dpvMail.toon(melding, 'Bedoel je ' + voorstel + '?', voorstel, veld);
        return;
      }
      var val = form.querySelector('input[name="website"]');
      knop.disabled = true; var oud = knop.textContent; knop.textContent = 'Bezig…';
      fetch(API + '/sm/api/aanmelden', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: adres, bron: BRON, website: val ? val.value : '', onderwerpen: gekozenOnderwerpen() })
      }).then(function (r) { return r.json(); }).then(function (res) {
        if (res && res.ok) {
          if (res.status === 'al-actief') {
            deel('gelukt-kop').textContent = 'Je stond er al bij';
            deel('gelukt-tekst').textContent = 'Dit adres ontvangt onze mail al. We hebben je onderwerpen bijgewerkt en een bevestiging gestuurd naar ' + adres + '.';
          } else if (res.status !== 'bevestig') {
            // 6 okt: de worker meldt sinds v1.76 direct aan, zonder bevestigingsmail.
            deel('gelukt-kop').textContent = 'Je bent aangemeld';
            deel('gelukt-tekst').textContent = 'We hebben een bevestiging gestuurd naar ' + adres + '. Niets binnen binnen een paar minuten? Kijk even in je spam. Afmelden kan altijd met een klik.';
          }
          toon('gelukt');
        } else {
          zeg(melding, '', false);
          if (window.dpvMail) window.dpvMail.toon(melding, (res && res.fout) || 'Er ging iets mis. Probeer het later nog eens.', res && res.suggestie, veld);
          else zeg(melding, (res && res.fout) || 'Er ging iets mis. Probeer het later nog eens.', false);
          veld.focus();
        }
      }).catch(function () {
        zeg(melding, 'Er ging iets mis. Probeer het later nog eens.', false);
      }).then(function () { knop.disabled = false; knop.textContent = oud; });
    });
    veld.addEventListener('input', function () { melding.hidden = true; });
  }

  // ---- Bevestigen, afmelden en voorkeuren --------------------------------
  // Deze drie pagina's hebben alleen een sleutel in de URL nodig. De worker
  // doet het werk; wij tonen hier het antwoord.
  // /sm/bevestig en /sm/afmelden geven een hele HTML-pagina terug, bedoeld
  // voor wie die link rechtstreeks opent. Zo'n antwoord heeft geen
  // CORS-koppen, dus de browser laat ons het hier niet lezen; dat gaf een
  // "Failed to fetch" terwijl de bevestiging aan de andere kant wel gelukt
  // was. Daarom sturen wij het verzoek met mode no-cors, dat komt wel aan,
  // en lezen wij daarna bij /sm/api/mijn terug wat er echt is gebeurd. Zo
  // volgt de melding de database in plaats van een aanname.
  function doeEnControleer(pad, verwacht, kop, tekst, alsHtml) {
    fetch(API + pad + '?s=' + encodeURIComponent(sleutel), { mode: 'no-cors' })
      .catch(function () {})
      .then(function () { return fetch(API + '/sm/api/mijn?s=' + encodeURIComponent(sleutel)); })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (!res || !res.ok) {
          deel('gelukt-kop').textContent = 'Deze link werkt niet meer';
          deel('gelukt-tekst').textContent = 'Hij is mogelijk al gebruikt of verlopen. Meld je hieronder opnieuw aan, dan sturen wij een nieuwe bevestiging.';
        } else if (res.status !== verwacht) {
          deel('gelukt-kop').textContent = 'Er ging iets mis';
          deel('gelukt-tekst').textContent = 'Probeer het over een minuut nog eens, of meld je hieronder opnieuw aan.';
        } else {
          deel('gelukt-kop').textContent = kop;
          if (alsHtml) deel('gelukt-tekst').innerHTML = tekst;
          else deel('gelukt-tekst').textContent = tekst;
        }
        toon('gelukt');
      })
      .catch(function () {
        deel('gelukt-kop').textContent = 'Er ging iets mis';
        deel('gelukt-tekst').textContent = 'Probeer het over een minuut nog eens.';
        toon('gelukt');
      });
  }
  function bevestig() {
    doeEnControleer('/sm/bevestig', 'actief', 'Je aanmelding is bevestigd',
      'Vanaf volgende week krijg je \u00e9\u00e9n mail met de aanbiedingen waarbij het verschil het grootst is, omgerekend naar de prijs per liter en per kilo. ' +
      '<a href="/pages/mijn-aanbiedingen?s=' + encodeURIComponent(sleutel) + '">Kies welke producten je volgt</a>.', true);
  }
  function afmelden() {
    doeEnControleer('/sm/afmelden', 'afgemeld', 'Je bent afgemeld',
      'Wij sturen je geen mail meer. Je adres blijft alleen bewaard om te onthouden dat je geen mail meer wilt.', false);
  }
  function voorkeuren() {
    fetch(API + '/sm/api/mijn?s=' + encodeURIComponent(sleutel))
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (!res || !res.ok) {
          deel('gelukt-kop').textContent = 'Deze link werkt niet meer';
          deel('gelukt-tekst').textContent = 'Hij is mogelijk verlopen. Meld je hieronder opnieuw aan, dan sturen wij een nieuwe bevestiging.';
          toon('gelukt');
          return;
        }
        deel('voorkeur-tekst').textContent = 'Je ontvangt de mail op ' + res.email + '. Vink aan wat je wilt volgen.';

        // Onderwerpen. De worker stuurt de lijst mee; kan hij dat niet (oude
        // versie nog niet uitgerold), dan vallen we terug op de lijst hierboven.
        var lijst = (res.onderwerpen && res.onderwerpen.length)
          ? res.onderwerpen.map(function (o) { return [o.id, o.naam]; })
          : ONDERWERPEN;
        var ow = res.gekozenOnderwerpen || [];
        var vkOw = deel('vk-ow');
        if (vkOw) {
          vkOw.innerHTML = lijst.map(function (o) {
            return '<button type="button" class="pa-cat" aria-pressed="' +
              (ow.indexOf(o[0]) > -1 ? 'true' : 'false') + '" data-o="' + o[0] + '">' + o[1] + '</button>';
          }).join('');
        }

        // De boodschappenschappen zijn een laag dieper en hebben alleen zin als
        // boodschappen aanstaat. Anders staat er een rij Zuivel en Vlees onder
        // een aanmelding die over consoles ging.
        var gekozen = res.gekozen || [];
        deel('cats').innerHTML = (res.categorieen || []).map(function (c) {
          return '<button type="button" class="pa-cat" aria-pressed="' + (gekozen.indexOf(c) > -1 ? 'true' : 'false') + '" data-c="' + c.replace(/"/g, '&quot;') + '">' + c + '</button>';
        }).join('');
        function schappenBij() {
          var vak = deel('vk-cats-vak');
          if (!vak) return;
          var aan = !!(vkOw && vkOw.querySelector('.pa-cat[data-o="boodschappen"][aria-pressed="true"]'));
          vak.hidden = !(aan && (res.categorieen || []).length);
        }
        schappenBij();
        if (vkOw) vkOw.addEventListener('click', function (e) {
          var k = e.target.closest('.pa-cat');
          if (!k) return;
          k.setAttribute('aria-pressed', k.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
          schappenBij();
        });

        toon('voorkeur');
      });
  }
  deel('cats') && deel('cats').addEventListener('click', function (e) {
    var k = e.target.closest('.pa-cat');
    if (!k) return;
    k.setAttribute('aria-pressed', k.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
  });
  deel('bewaar') && deel('bewaar').addEventListener('click', function () {
    // Alleen binnen het eigen vak zoeken. Eerst stond hier een query over de
    // hele sectie, en die pakte ook de chips van het aanmeldformulier mee.
    var catsVak = deel('cats');
    var owVak2 = deel('vk-ow');
    var cats = catsVak ? [].slice.call(catsVak.querySelectorAll('.pa-cat[aria-pressed="true"]')).map(function (k) { return k.getAttribute('data-c'); }) : [];
    var ow = owVak2 ? [].slice.call(owVak2.querySelectorAll('.pa-cat[aria-pressed="true"]')).map(function (k) { return k.getAttribute('data-o'); }) : [];
    var m = deel('voorkeur-melding');
    this.disabled = true;
    fetch(API + '/sm/api/voorkeur', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ s: sleutel, cats: cats, onderwerpen: ow })
    }).then(function (r) { return r.json(); }).then(function (res) {
      zeg(m, res && res.ok ? 'Bewaard. Zo ziet je mail er vanaf nu uit.' : 'Opslaan lukte niet. Probeer het nog eens.', !!(res && res.ok));
    }).catch(function () { zeg(m, 'Opslaan lukte niet. Probeer het nog eens.', false); })
      .then(function () { deel('bewaar').disabled = false; });
  });
  deel('afmelden') && deel('afmelden').addEventListener('click', afmelden);

  if (sleutel) {
    if (pad.indexOf('bevestig') > -1) bevestig();
    else if (pad.indexOf('afmeld') > -1) afmelden();
    else if (pad.indexOf('mijn-aanbiedingen') > -1) voorkeuren();
  }
})();
</script>

{%- endif -%}

