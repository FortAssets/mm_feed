{%- comment -%}
  dpv-shop-rij — een rij producten uit de shop-feed, om ergens tussen te zetten.

  Dit is met opzet een los blokje en geen onderdeel van de vergelijkpagina, want
  je wilt hem op meer plekken: een gamingrij op de homepage, een Black
  Friday-rij, een rij onder een artikel. Alle instellingen staan in het thema,
  dus je kunt hem neerzetten zonder dat ik eraan te pas kom.

  Hij haalt niets op als er geen producten zijn en verdwijnt dan helemaal. Dat is
  belangrijk: een lege rij met een kop erboven ziet eruit als een storing.

  Met "Alleen bij artikelen met tag" zet je hem in het artikeltemplate en komt
  hij alleen onder artikelen met die tag. Zo kan een artikel over GTA VI een
  prijsvergelijking tonen zonder dat elk artikel dat krijgt. Dezelfde aanpak als
  bij dpv-zorgpremie-2027.

  Let op: dit thema verbergt lege divs (div:empty). Lege plekken krijgen daarom
  &nbsp; in plaats van niets.

  5 okt, huisstijl "2-rond" (STIJLGIDS.md): nieuwe kaart. Foto in een
  lichtblauw vlak, groen label "scheelt €X" (het verschil tussen de laagste en
  de hoogste getoonde winkel), de overige winkels als regels en onderaan de
  gele knop naar de goedkoopste winkel. De donkere band is donkerblauw in
  plaats van paars. Staat "Black Friday" in de kop of het label, dan krijgt die
  band het verschoven gele vlak. De bronnen, de keuze van producten (mix,
  geloofwaardig) en het lui laden zijn niet aangeraakt.
{%- endcomment -%}

{%- assign toon = true -%}
{%- assign tag = section.settings.alleen_tag | strip -%}
{%- if tag != blank -%}
  {%- assign toon = false -%}
  {%- if article and article.tags contains tag -%}{%- assign toon = true -%}{%- endif -%}
{%- endif -%}
{%- comment -%}
  En het omgekeerde: niet tonen bij een tag. Een artikel over GTA 6 draagt ook
  de tag gaming, en dan stonden de GTA-rij en de algemene gamingrij allebei
  onder hetzelfde artikel.
{%- endcomment -%}
{%- assign niet = section.settings.niet_tag | strip -%}
{%- if niet != blank and article and article.tags contains niet -%}{%- assign toon = false -%}{%- endif -%}

{%- if toon -%}
{%- assign rid = 'dsr-' | append: section.id -%}
{%- assign bf_tekst = section.settings.kop | append: ' ' | append: section.settings.label | downcase -%}
{%- assign bf_rij = false -%}
{%- if bf_tekst contains 'black friday' -%}{%- assign bf_rij = true -%}{%- endif -%}

{%- if section.settings.anker != blank -%}<span id="{{ section.settings.anker | handleize }}" style="display:block;position:relative;top:-80px;visibility:hidden"></span>{%- endif -%}
<script>if(!document.getElementById('dpv-mont')){var l=document.createElement('link');l.id='dpv-mont';l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&display=swap';document.head.appendChild(l);}</script>
<section class="dsr dsr-{{ section.settings.vlak }}{% if bf_rij %} dsr-bf{% endif %}" id="{{ rid }}"
         data-api="{{ section.settings.api }}"
         data-bron="{{ section.settings.bron }}"
         data-cat="{{ section.settings.cat }}"
         data-sort="{{ section.settings.sort }}"
         data-n="{{ section.settings.aantal }}"
         data-echt="{% if section.settings.alleen_echt %}1{% endif %}"
         data-deal="{% if section.settings.alleen_deal %}1{% endif %}"
         data-multi="{% if section.settings.alleen_multi %}1{% endif %}"
         data-type="{{ section.settings.types }}"
         data-min="{{ section.settings.min }}"
         data-max="{{ section.settings.max }}"
         data-uitgelicht="{{ section.settings.uitgelicht | strip_newlines | escape }}"
         data-bf="{% if section.settings.bf_knop %}1{% endif %}"
         hidden>

  <div class="dsr-kop">
    <div>
      {%- if section.settings.label != blank -%}
        <p class="dsr-eyebrow">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2>{{ section.settings.kop }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="dsr-sub">{{ section.settings.sub }}</p>
      {%- endif -%}
      {%- if section.settings.gids_url != blank -%}
        <a class="dsr-gids" href="{{ section.settings.gids_url }}">{{ section.settings.gids_tekst | default: 'Lees de koopgids' }} &rsaquo;</a>
      {%- endif -%}
    </div>
    {%- if section.settings.link_url != blank -%}
      <a class="dsr-alles" href="{{ section.settings.link_url }}">{{ section.settings.link_tekst }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
    <div class="dsr-pijlen" data-pijlen hidden>
      <button type="button" data-pijl="-1" aria-label="Vorige producten"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button type="button" data-pijl="1" aria-label="Volgende producten"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>

  <div class="dsr-spoor" data-spoor></div>

  <p class="dsr-fijn" data-fijn>&nbsp;</p>
</section>

{%- if section.settings.bf_knop -%}{%- render 'dpv-bf-knop', api: section.settings.bf_api, tot: section.settings.bf_tot -%}{%- endif -%}

<style>
/* 5 okt, huisstijl "2-rond" (STIJLGIDS.md): geen paars en geen fel groen meer.
   Kaarten met de foto in een lichtblauw vlak, een groen label "scheelt",
   de winkels als regels en onderaan de gele knop naar de goedkoopste winkel. */
#{{ rid }}{--bl:#2456D6;--bl2:#1B45B4;--tint:#EAF1FF;--licht:#F4F7FF;--rd:#E6EBF2;--rd2:#D9E1EC;--gr:#3FAE7A;--geel:#F9C31F;--ink:#0D1B2A;--mut:#4A5A70;--mut2:#5B6B80;
 max-width:1180px;margin:0 auto;padding:22px 0 8px;font-family:'Montserrat',system-ui,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
/* Een band eromheen. Op de homepage staan er meerdere blokken met kaarten
   onder elkaar en dan loopt alles in elkaar over. Met een eigen vlak is het
   een blok in plaats van nog een rij. De lichte band loopt over de volle
   breedte, de inhoud blijft in het midden. */
#{{ rid }}.dsr-vlak{max-width:none;padding:26px 0 18px;margin:22px 0;background:var(--licht)}
#{{ rid }}.dsr-vlak .dsr-kop,#{{ rid }}.dsr-vlak .dsr-spoor,#{{ rid }}.dsr-vlak .dsr-fijn{max-width:1180px;margin-left:auto;margin-right:auto}
/* De donkere band was paars en liep over de volle breedte. Nu donkerblauw met
   ronde hoeken, even breed als de rest van de pagina. Een Black Friday-rij
   krijgt het verschoven gele vlak; dat past in de marge naast de band. */
#{{ rid }}.dsr-donker{width:calc(100% - 32px);max-width:1140px;margin:24px auto;padding:22px 0 16px;background:#0D1B2A;border:0;border-radius:18px}
#{{ rid }}.dsr-donker.dsr-bf{box-shadow:8px 8px 0 var(--geel);margin-bottom:32px}
@media(min-width:900px){#{{ rid }}.dsr-donker{width:calc(100% - 40px);margin:30px auto;padding:26px 0 18px}
  #{{ rid }}.dsr-donker.dsr-bf{box-shadow:10px 10px 0 var(--geel);margin-bottom:40px}}
#{{ rid }}.dsr-donker h2{color:#fff}
#{{ rid }}.dsr-donker .dsr-eyebrow{color:#B9C7DB}
#{{ rid }}.dsr-donker .dsr-sub{color:#D5DEEA}
#{{ rid }}.dsr-donker .dsr-alles,#{{ rid }}.dsr-donker .dsr-alles:visited,
#{{ rid }}.dsr-donker .dsr-gids,#{{ rid }}.dsr-donker .dsr-gids:visited{color:#fff}
#{{ rid }}.dsr-donker .dsr-fijn{color:#B9C7DB}
#{{ rid }} *{box-sizing:border-box}
#{{ rid }} .dsr-kop{display:flex;align-items:flex-end;flex-wrap:wrap;gap:8px 12px;padding:0 16px;margin:0 0 12px}
#{{ rid }} .dsr-kop>div{flex:1 1 240px;min-width:0}
#{{ rid }} .dsr-eyebrow{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut2);font-weight:800;margin:0 0 5px}
#{{ rid }} h2{font-family:'Montserrat',system-ui,sans-serif;font-size:21px;line-height:1.2;letter-spacing:-.025em;font-weight:800;margin:0;color:var(--ink)}
#{{ rid }} .dsr-sub{font-size:13.5px;line-height:1.55;font-weight:500;color:var(--mut);margin:5px 0 0;max-width:60ch}
#{{ rid }} .dsr-alles,#{{ rid }} .dsr-alles:visited{flex:0 0 auto;display:inline-flex;align-items:center;gap:5px;
 font-size:14px;font-weight:800;color:var(--bl);text-decoration:none;white-space:nowrap}
#{{ rid }} .dsr-gids,#{{ rid }} .dsr-gids:visited{display:inline-block;margin-top:7px;font-size:13.5px;font-weight:700;color:var(--bl);text-decoration:underline;text-underline-offset:3px}
#{{ rid }} .dsr-alles svg{width:15px;height:15px}
#{{ rid }} .dsr-alles:hover{text-decoration:underline}
@media(min-width:900px){#{{ rid }} h2{font-size:26px}#{{ rid }} .dsr-kop{padding:0 20px;margin-bottom:14px}}

#{{ rid }} .dsr-spoor{display:flex;gap:10px;overflow-x:auto;padding:4px 16px 14px;scroll-snap-type:x mandatory;scroll-padding-left:16px;
 scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;scroll-behavior:smooth}
@media(min-width:900px){#{{ rid }} .dsr-spoor{gap:14px;padding:4px 20px 14px;scroll-padding-left:20px}}
/* De schuifbalk van de browser stond als een grijze streep onder de kaarten.
   Schuiven kan nog steeds, met de vinger, het muiswiel of de pijlen in de kop. */
#{{ rid }} .dsr-spoor::-webkit-scrollbar{display:none}
#{{ rid }} .dsr-kop>.dsr-pijlen{flex:0 0 auto;display:flex;gap:6px;margin-left:6px}
#{{ rid }} .dsr-kop>.dsr-pijlen[hidden]{display:none}
#{{ rid }} .dsr-pijlen button{width:36px;height:36px;border-radius:50%;border:1px solid var(--rd2);background:#fff;color:var(--bl);
 display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0}
#{{ rid }} .dsr-pijlen button:hover{border-color:var(--bl)}
#{{ rid }} .dsr-pijlen button svg{width:16px;height:16px}
#{{ rid }} .dsr-pijlen button:disabled{opacity:.35;cursor:default}
#{{ rid }}.dsr-donker .dsr-pijlen button{background:transparent;border-color:rgba(255,255,255,.35);color:#fff}
@media(max-width:640px){#{{ rid }} .dsr-kop>.dsr-pijlen{display:none}}

/* de kaart: op een telefoon anderhalve kaart in beeld, breed vier naast elkaar */
#{{ rid }} .dsr-k{flex:0 0 238px;min-width:0;scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;color:var(--ink);
 border:1px solid var(--rd);border-radius:16px;padding:12px;position:relative;transition:border-color .14s}
@media(min-width:620px){#{{ rid }} .dsr-k{flex-basis:252px}}
@media(min-width:1000px){#{{ rid }} .dsr-k{flex-basis:calc((100% - 42px) / 4)}}
#{{ rid }} .dsr-k:hover{border-color:#C9D6EA}
#{{ rid }}.dsr-donker .dsr-k{border-color:#fff}
/* Vaste hoogte voor het plaatje. Een staande hoes (een game) trok de kaart
   anders langer dan een liggende foto (een console) en dan stond de prijs bij
   elke kaart op een andere hoogte. */
#{{ rid }} .dsr-afb{flex:0 0 auto;height:140px;position:relative;background:var(--licht);border-radius:12px;overflow:hidden;margin-bottom:11px}
@media(min-width:900px){#{{ rid }} .dsr-afb{height:170px}}
#{{ rid }} .dsr-afb img{position:absolute;inset:16px;width:calc(100% - 32px);height:calc(100% - 32px);object-fit:contain;mix-blend-mode:multiply}
#{{ rid }} .dsr-in{display:flex;flex-direction:column;flex:1;min-width:0}
#{{ rid }} .dsr-merk{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--mut2);font-weight:800;margin-bottom:2px}
#{{ rid }} .dsr-naam{font-size:16px;line-height:1.2;font-weight:800;letter-spacing:-.01em;margin:0;color:var(--ink);display:-webkit-box;
 -webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
@media(min-width:900px){#{{ rid }} .dsr-naam{font-size:17px}}
#{{ rid }} .dsr-van{font-size:12.5px;line-height:1.3;color:var(--mut);font-weight:700;margin:3px 0 8px}
#{{ rid }} .dsr-van b{font-size:20px;font-weight:800;color:var(--ink);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
#{{ rid }} .dsr-van s{font-size:12px;color:var(--mut2);font-weight:600}
#{{ rid }} .dsr-kt{display:inline-block;font-size:11px;font-weight:800;color:var(--ink);background:#E3F4EB;border-radius:999px;padding:2px 7px;vertical-align:2px}
/* de overige winkels: naam links, prijs rechts, elk een link naar die winkel */
#{{ rid }} .dsr-wl .dpvmb,#{{ rid }} .dsr-wl > :not(.dsr-wr){display:none !important}
#{{ rid }} .dsr-wr,#{{ rid }} .dsr-wr:visited{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:34px;padding:6px 0;border-top:1px solid var(--rd);
 font-size:13px;font-weight:700;color:var(--mut);text-decoration:none}
#{{ rid }} .dsr-wr:hover .dsr-wn{color:var(--bl);text-decoration:underline}
#{{ rid }} .dsr-wn{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#{{ rid }} .dsr-wr b{flex:0 0 auto;font-weight:800;color:var(--ink);white-space:nowrap;font-variant-numeric:tabular-nums}
/* knop, link en seintje staan onderaan, zodat ze in een rij op een lijn staan */
#{{ rid }} .dsr-voet{margin-top:auto;padding-top:2px}
#{{ rid }} .dsr-knop,#{{ rid }} .dsr-knop:visited{display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 10px;
 background:var(--geel);color:var(--ink) !important;border-radius:12px;font-size:13.5px;line-height:1.25;font-weight:800;text-align:center;
 text-decoration:none !important}
#{{ rid }} .dsr-knop:hover{background:#EDB50C}
/* De productpagina's met prijsverloop bestaan nog niet; tot die tijd gaat deze
   link naar de vergelijker met het product al ingevuld. */
#{{ rid }} .dsr-meer,#{{ rid }} .dsr-meer:visited{display:block;text-align:center;font-size:12.5px;font-weight:800;color:var(--bl);text-decoration:none;margin-top:5px;padding:5px 0}
#{{ rid }} .dsr-meer:hover{color:var(--bl2);text-decoration:underline}
#{{ rid }} .dsr-b{position:absolute;top:9px;left:9px;font-size:11px;font-weight:800;border-radius:999px;padding:4px 9px;line-height:1.2;z-index:2}
/* wit op dit groen leest slecht: donkere tekst */
#{{ rid }} .dsr-b.scheelt{background:var(--gr);color:var(--ink)}
#{{ rid }} .dsr-b.laag{background:var(--bl);color:#fff}
#{{ rid }} .dsr-fijn{padding:0 16px;margin:0;font-size:11.5px;font-weight:500;color:var(--mut2);line-height:1.5}
@media(min-width:900px){#{{ rid }} .dsr-fijn{padding:0 20px}}
#{{ rid }} .dsr-sk{flex:0 0 238px;border:1px solid var(--rd);border-radius:16px;overflow:hidden;background:#fff;padding:12px}
#{{ rid }} .dsr-sk i{display:block;height:140px;border-radius:12px;background:linear-gradient(90deg,#EAF1FF,#F4F7FF,#EAF1FF);
 background-size:200% 100%;animation:dsr-golf 1.2s linear infinite}
#{{ rid }} .dsr-sk u{display:block;height:10px;margin:10px 0 0;border-radius:5px;background:#EAF1FF}
@keyframes dsr-golf{0%{background-position:100% 0}100%{background-position:-100% 0}}
@media(prefers-reduced-motion:reduce){#{{ rid }} .dsr-sk i{animation:none}}
#{{ rid }} :focus-visible{outline:3px solid var(--bl);outline-offset:2px}
#{{ rid }}.dsr-donker :focus-visible{outline-color:var(--geel)}
</style>

<script>
(function () {
  var w = document.getElementById('{{ rid }}');
  if (!w) return;
  var API = (w.getAttribute('data-api') || '').replace(/\/+$/, '');
  if (!API) return;
  var BF = w.getAttribute('data-bf') === '1';
  var spoor = w.querySelector('[data-spoor]');
  var fijn = w.querySelector('[data-fijn]');

  function eur(n) {
    if (n == null || isNaN(n)) return '';
    var v = Math.round(n * 100) / 100;
    // 5 okt: punt bij duizendtallen (€1.349), zoals in de kiezer bovenaan.
    return '€' + (v % 1 === 0 ? String(v) : v.toFixed(2).replace('.', ',')).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }
  function winkel(w) { return w === 'bol.com partner' ? 'bol.com (partner)' : w; }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // Drie bronnen. "categorie" is de gewone lijst-route; "deals" en "vergelijk"
  // gaan over alle categorieen heen en zijn voor een Black Friday-pagina, waar
  // je bovenaan alles wilt zien wat is afgeprijsd zonder eerst een categorie te
  // kiezen. Daar is cat een filter in plaats van een keuze.
  var bron = w.getAttribute('data-bron') || 'categorie';
  var route = bron === 'deals' ? '/api/shop/deals'
    : bron === 'vergelijk' ? '/api/shop/vergelijk'
    : '/api/shop/lijst';
  var cat = w.getAttribute('data-cat') || '';
  var p = new URLSearchParams();
  if (bron === 'categorie') p.set('cat', cat || 'gaming');
  else if (cat) p.set('cat', cat);
  p.set('sort', w.getAttribute('data-sort') || 'prijs');
  p.set('n', String(Math.min(30, Math.max(3, parseInt(w.getAttribute('data-n'), 10) || 10))));
  if (w.getAttribute('data-echt')) p.set('echt', '1');
  if (w.getAttribute('data-deal')) p.set('deal', '1');
  if (w.getAttribute('data-multi')) p.set('multi', '1');
  if (w.getAttribute('data-type')) p.set('type', w.getAttribute('data-type'));
  if (w.getAttribute('data-min')) p.set('min', w.getAttribute('data-min'));
  if (w.getAttribute('data-max')) p.set('max', w.getAttribute('data-max'));

  // Pas ophalen als de rij bijna in beeld komt. Op de homepage staan er straks
  // meerdere van deze blokjes en die hoeven niet allemaal direct te laden.
  function teken(items, gemaakt) {
    if (!items.length) { w.hidden = true; return; }
    spoor.innerHTML = items.map(function (x) {
      var korting = (x.v > x.p) ? Math.round((1 - x.p / x.v) * 100) : 0;
      if (korting > 70) korting = 0;
      // Winkels op prijs, de laagste eerst. Op de kaart staan er hooguit drie:
      // de goedkoopste op de gele knop, de twee volgende als regel erboven.
      var o = x.o.slice().sort(function (a, b) { return a.p - b.p; });
      var multi = o.length > 1, top = o.slice(0, 3);
      // "scheelt": laagste tegenover de hoogste getoonde winkel, hele euro's.
      // Onder de euro zeggen wij niets; dat is geen verschil om voor te klikken.
      var scheelt = multi ? Math.round(top[top.length - 1].p - top[0].p) : 0;
      // 5 okt: bij een tv stond "scheelt €4.675". Ligt de laagste meer dan 40%
      // onder de hoogste, dan is het bijna altijd een fout in een feed of een
      // ander product onder dezelfde naam. Dan tonen wij het verschil niet.
      if (multi && top[0].p < top[top.length - 1].p * 0.6) scheelt = 0;
      var laagsteOoit = (typeof x.lp === 'number' && x.mt >= 2 && x.p <= x.lp + 0.005);
      var badge = scheelt >= 1 ? '<span class="dsr-b scheelt">scheelt ' + eur(scheelt) + '</span>'
        : (laagsteOoit ? '<span class="dsr-b laag">Laagste tot nu</span>' : '');
      var ga = API + '/api/shop/go?i=' + encodeURIComponent(x.i) + '&cat=' + encodeURIComponent(x.c);
      // Voor elke pijl staat een vaste spatie (\u00a0): anders kwam de pijl op
      // een smalle kaart alleen op een nieuwe regel.
      // Het merk alleen tonen als het niet al vooraan in de naam staat.
      var merk = x.b && String(x.n || '').toLowerCase().indexOf(String(x.b).toLowerCase()) !== 0 ? '<span class="dsr-merk">' + esc(x.b) + '</span>' : '';
      return '<article class="dsr-k">' +
        '<div class="dsr-afb">' + badge + (x.im ? '<img src="' + esc(x.im) + '" alt="' + esc(x.n) + '" loading="lazy" decoding="async">' : '&nbsp;') + '</div>' +
        '<div class="dsr-in">' + merk +
        '<p class="dsr-naam">' + esc(x.n) + '</p>' +
        (multi
          // Meer dan een winkel: elke winkel is te bereiken. Eerst was alleen de
          // goedkoopste te bereiken; de andere stonden er als "tot X elders"
          // zonder link.
          ? '<p class="dsr-van">vanaf <b>' + eur(top[0].p) + '</b> · ' + o.length + ' winkels</p>' +
            '<div class="dsr-wl">' + top.slice(1).map(function (w) {
              return '<a class="dsr-wr" href="' + ga + '&w=' + encodeURIComponent(w.w) +
                '" target="_blank" rel="sponsored noopener"><span class="dsr-wn">' + esc(winkel(w.w)) + '</span><b>' + eur(w.p) + '</b></a>';
            }).join('') + '</div>' +
            '<div class="dsr-voet">' +
            '<a class="dsr-knop" href="' + ga + '&w=' + encodeURIComponent(top[0].w) + '" target="_blank" rel="sponsored noopener">Bekijk bij ' + esc(winkel(top[0].w)) + ' · ' + eur(top[0].p) + '\u00a0›</a>' +
            '<a class="dsr-meer" href="/pages/vergelijken?cat=' + encodeURIComponent(x.c) + '&q=' + encodeURIComponent(x.n) + '">Prijsverloop en alle winkels\u00a0›</a>'
          : '<p class="dsr-van"><b>' + eur(x.p) + '</b>' +
            (korting ? ' <s>' + eur(x.v) + '</s> <span class="dsr-kt">-' + korting + '%</span>' : '') + '</p>' +
            '<div class="dsr-voet">' +
            '<a class="dsr-knop" href="' + ga + '" target="_blank" rel="sponsored noopener">Bekijk bij ' + esc(winkel(o[0].w)) + ' · ' + eur(x.p) + '\u00a0›</a>') +
        (BF && window.dpvBf && window.dpvBf.aan ? window.dpvBf.knop(x) : '') +
        '</div></div></article>';
    }).join('');

    var dag = gemaakt ? String(gemaakt).slice(0, 10).split('-').reverse().join('-') : '';
    fijn.innerHTML = (dag ? 'Prijzen bijgewerkt op ' + esc(dag) + '. ' : '') +
      'Wij ontvangen een vergoeding als je iets koopt; jij betaalt hetzelfde.';
    pijlenAan();
  }

  // Pijlen in de kop, in plaats van de schuifbalk van de browser.
  function pijlenAan() {
    var vak = w.querySelector('[data-pijlen]');
    if (!vak) return;
    var knoppen = vak.querySelectorAll('button');
    function stand() {
      var max = spoor.scrollWidth - spoor.clientWidth;
      vak.hidden = max < 8;
      knoppen[0].disabled = spoor.scrollLeft < 8;
      knoppen[1].disabled = spoor.scrollLeft > max - 8;
    }
    for (var i = 0; i < knoppen.length; i++) {
      knoppen[i].addEventListener('click', function () {
        spoor.scrollBy({ left: (+this.getAttribute('data-pijl')) * Math.max(240, spoor.clientWidth * 0.8), behavior: 'smooth' });
      });
    }
    spoor.addEventListener('scroll', stand, { passive: true });
    window.addEventListener('resize', stand);
    stand();
  }

  // Variatie. Gesorteerd op prijsverschil krijg je anders twaalf keer dezelfde
  // telefoon in een andere kleur, en bijna altijd dezelfde winkel als
  // goedkoopste. Daarom halen we ruim op en kiezen daaruit: een product per
  // familie, een paar per categorie en per winkel. Een prijs onder de 60% van
  // de eerstvolgende winkel slaan we over: dat is vaker een fout in een feed
  // dan een aanbieding.
  function familie(x) {
    return String((x.b || '') + ' ' + (x.n || '')).toLowerCase().replace(/[^a-z0-9 ]+/g, ' ')
      .replace(/\b\d+ ?(gb|tb|inch|cm|mm)\b/g, ' ').split(/\s+/).filter(Boolean).slice(0, 4).join(' ');
  }
  function geloofwaardig(x) {
    if (!x.o || !x.o.length || !(x.p > 0)) return false;
    if (x.o.length > 1 && x.o[0].p < x.o[1].p * 0.6) return false;
    // Meer dan 70% korting volgens de winkel zelf: zo goed als altijd een fout
    // van-prijs, of een maandbedrag dat als prijs in de feed staat.
    if (x.v > x.p && x.p < x.v * 0.3) return false;
    return true;
  }
  function band(x) { return x.p < 100 ? 'a' : x.p < 300 ? 'b' : x.p < 800 ? 'c' : 'd'; }
  function mix(items, n) {
    var goed = items.filter(geloofwaardig), uit = [], gehad = {};
    var perBand = Math.ceil(n / 3);
    // [per winkel, per categorie, per type, per prijsklasse]; elke ronde ruimer.
    [[2, 3, 3, perBand, 2], [3, 5, 4, perBand + 2, 3], [99, 99, 99, 99, 3], [99, 99, 99, 99, 99]].forEach(function (g) {
      var fam = {}, per = {}, ct = {}, ty = {}, bd = {}, mk = {};
      function merk(x) { return String(x.b || String(x.n || '').split(' ')[0]).toLowerCase(); }
      function tel(x) {
        fam[familie(x)] = 1; per[x.o[0].w] = (per[x.o[0].w] || 0) + 1; ct[x.c] = (ct[x.c] || 0) + 1;
        if (x.t) ty[x.t] = (ty[x.t] || 0) + 1;
        bd[band(x)] = (bd[band(x)] || 0) + 1;
        mk[merk(x)] = (mk[merk(x)] || 0) + 1;
      }
      uit.forEach(tel);
      goed.forEach(function (x) {
        if (uit.length >= n || gehad[x.i]) return;
        if (fam[familie(x)] || (per[x.o[0].w] || 0) >= g[0] || (!cat && (ct[x.c] || 0) >= g[1]) ||
            (x.t && (ty[x.t] || 0) >= g[2]) || (bd[band(x)] || 0) >= g[3] || (mk[merk(x)] || 0) >= g[4]) return;
        tel(x); gehad[x.i] = 1; uit.push(x);
      });
    });
    // Om en om per winkel, zodat de eerste kaarten al verschillen.
    var bak = {}, volg = [], r = [];
    uit.forEach(function (x) { var k = x.o[0].w; if (!bak[k]) { bak[k] = []; volg.push(k); } bak[k].push(x); });
    while (r.length < uit.length) volg.forEach(function (k) { if (bak[k].length) r.push(bak[k].shift()); });
    return r;
  }

  function lijst() {
    var n = parseInt(p.get('n'), 10) || 10;
    if (bron === 'categorie' && p.get('sort') === 'prijs') {
      return fetch(API + route + '?' + p.toString())
        .then(function (r) { return r.json(); })
        .then(function (d) { teken(((d && d.items) || []).filter(geloofwaardig), d && d.gemaakt); })
        .catch(function () { w.hidden = true; });
    }
    p.set('n', '60');
    Promise.all([1, 2, 3, 4].map(function (pg) {
      var q = new URLSearchParams(p.toString()); q.set('p', String(pg));
      return fetch(API + route + '?' + q.toString()).then(function (r) { return r.json(); }).catch(function () { return null; });
    })).then(function (ds) {
      var alles = [], gemaakt = '';
      ds.forEach(function (d) { if (d && d.items) { alles = alles.concat(d.items); gemaakt = gemaakt || d.gemaakt; } });
      teken(mix(alles, n), gemaakt);
    }).catch(function () { w.hidden = true; });
  }

  // Uitgelicht: een vaste keuze van producten, in jouw volgorde. De gewone
  // lijst sorteert op prijs of prijsverschil en dan komen er vooral
  // accessoires bovenaan, want daar zijn er het meeste van. Voor de homepage
  // wil je de dingen waar mensen voor komen. Lukt het ophalen van minder dan
  // drie, dan valt de rij terug op de gewone lijst.
  function start() {
    var ids = (w.getAttribute('data-uitgelicht') || '').split(/[\s,;]+/).filter(Boolean);
    if (!ids.length) return lijst();
    Promise.all(ids.map(function (id) {
      return fetch(API + '/api/shop/product?i=' + encodeURIComponent(id) + '&cat=' + encodeURIComponent(cat || 'gaming'))
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { return d && d.product && d.product.o && d.product.o.length ? d.product : null; })
        .catch(function () { return null; });
    })).then(function (ps) {
      var items = ps.filter(Boolean);
      if (items.length < 3) return lijst();
      teken(items, new Date().toISOString());
    });
  }

  // De sectie staat in de HTML op hidden, zodat er nooit een lege kop in beeld
  // komt als de worker niet antwoordt. Hier zetten we hem aan met skeletten
  // erin; komt er niets terug, dan gaat hij weer op hidden.
  w.hidden = false;
  spoor.innerHTML = '<div class="dsr-sk"><i></i><u></u><u></u></div>' +
    '<div class="dsr-sk"><i></i><u></u><u></u></div>' +
    '<div class="dsr-sk"><i></i><u></u><u></u></div>' +
    '<div class="dsr-sk"><i></i><u></u><u></u></div>';

  if ('IntersectionObserver' in window) {
    var ob = new IntersectionObserver(function (rijen) {
      if (rijen.some(function (r) { return r.isIntersecting; })) { ob.disconnect(); start(); }
    }, { rootMargin: '400px' });
    ob.observe(w);
  } else start();
})();
</script>

{%- endif -%}

