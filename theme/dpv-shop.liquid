  </div>
</div>

<div class="ds ds-ovl" id="ds-ovl" hidden role="dialog" aria-modal="true" aria-labelledby="ds-ovl-kop">
  <div class="ds-ovl-vak">
    <div class="ds-ovl-kop">
      <h3 id="ds-ovl-kop">Vergelijken</h3>
      <button type="button" class="ds-ovl-sluit" id="ds-ovl-sluit" aria-label="Sluiten">&times;</button>
    </div>
    <div class="ds-ovl-body" id="ds-ovl-body"></div>
  </div>
</div>

<script>
(function () {
  var wortel = document.getElementById('ds');
  if (!wortel) return;
  var API = (wortel.getAttribute('data-api') || '').replace(/\/+$/, '');
  if (!API) return;
  /* Het partnerlabel van Amazon. Leeg betekent: geen Amazon op de pagina. */
  var AMZ = (wortel.getAttribute('data-amazon') || '').trim();
  var BF = wortel.getAttribute('data-bf') === '1';
  /* Deals (12 okt): gezakt.json uit de GitHub Action. Daarin alleen producten
     die bij dezelfde winkel echt lager staan dan de laagste prijs uit de 30
     dagen voor de daling. Leeg betekent: geen deals-knop. */
  var DEALS = (wortel.getAttribute('data-deals') || '').trim();

  /* Een EAN is de nauwkeurigste zoekopdracht die Amazon aanneemt; staat er
     geen EAN bij, dan het merk met de productnaam. Een vast ASIN heeft
     voorrang, want dat wijst naar precies het juiste product. */
  /* Een bij Amazon afgelezen prijs, met de dag waarop. Niet gemeten zoals
     de rest: iemand heeft hem gezien en genoteerd. Daarom staat de dag er
     altijd bij, en verdwijnt hij vanzelf na een week (dat regelt de build). */
  function amzDag(p) {
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(p.azd || '');
    if (!m) return '';
    var mnd = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
    return (+m[3]) + ' ' + mnd[+m[2] - 1];
  }
  /* Staat Amazon al tussen de winkels, dan hoeft het losse blok niet. */
  function amzIsWinkel(p) {
    return (p.o || []).some(function (o) { return /^Amazon/.test(o.w); });
  }
  function amzGoedkoper(p) { return p.azp > 0 && p.o && p.o.length && p.azp < p.o[0].p; }

  function amzLink(p) {
    var asin = (p.az || '').trim();
    if (asin) return 'https://www.amazon.nl/dp/' + encodeURIComponent(asin) + '?tag=' + encodeURIComponent(AMZ);
    var q = (p.e || ((p.b ? p.b + ' ' : '') + p.n)).trim();
    return 'https://www.amazon.nl/s?k=' + encodeURIComponent(q) + '&tag=' + encodeURIComponent(AMZ);
  }

  // ---------------------------------------------------------------- toestand
  var st = {
    cat: '',
    q: '',
    merk: [],
    type: [],
    filters: {},
    min: '',
    max: '',
    sort: 'populair',
    deals: false,
    pagina: 1,
    perPagina: 24
  };
  var index = null;
  var heeftAlles = false;
  var items = [];
  var gekozen = [];          // product-id's voor de vergelijking
  var gekozenData = {};
  var MAX_VGL = 4;
  var bezig = null;          // AbortController van het lopende verzoek

  var el = {
    cats: document.getElementById('ds-cats'),
    filters: document.getElementById('ds-filters'),
    merken: document.getElementById('ds-merken'),
    types: document.getElementById('ds-types'),
    raster: document.getElementById('ds-raster'),
    laden: document.getElementById('ds-laden'),
    leeg: document.getElementById('ds-leeg'),
    meer: document.getElementById('ds-meer'),
    meerKnop: document.getElementById('ds-meer-knop'),
    telling: document.getElementById('ds-telling'),
    q: document.getElementById('ds-q'),
    wis: document.getElementById('ds-wis'),
    min: document.getElementById('ds-min'),
    max: document.getElementById('ds-max'),
    sort: document.getElementById('ds-sort'),
    dok: document.getElementById('ds-dok'),
    dokT: document.getElementById('ds-dok-t'),
    ovl: document.getElementById('ds-ovl'),
    ovlKop: document.getElementById('ds-ovl-kop'),
    ovlBody: document.getElementById('ds-ovl-body')
  };

  // ---------------------------------------------------------------- hulpjes
  function eur(n) {
    if (n == null || isNaN(n)) return '';
    var v = Math.round(n * 100) / 100;
    return '€' + (v % 1 === 0 ? String(v) : v.toFixed(2).replace('.', ','));
  }
  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function hoofd(s) {
    s = String(s || '');
    return s ? s.charAt(0).toUpperCase() + s.slice(1) : s;
  }
  function dagen(d) {
    if (!d) return 0;
    return Math.max(0, Math.round((Date.now() - Date.parse(d)) / 864e5));
  }

  // ---------------------------------------------------------------- url
  // De filters in de url, zodat een gefilterde lijst te delen en te bookmarken
  // is en de terugknop van de browser doet wat je verwacht.
  function naarUrl(push) {
    var p = new URLSearchParams();
    if (st.cat) p.set('cat', st.cat);
    if (st.q) p.set('q', st.q);
    if (st.merk.length) p.set('merk', st.merk.join(','));
    if (st.type.length) p.set('type', st.type.join(','));
    Object.keys(st.filters).forEach(function (k) { if (st.filters[k]) p.set(k, '1'); });
    if (st.min !== '') p.set('min', st.min);
    if (st.max !== '') p.set('max', st.max);
    if (st.sort !== 'populair' && st.sort !== 'beste') p.set('sort', st.sort);
    if (st.deals) p.set('deals', 'black-friday');
    var s = p.toString();
    var nieuw = location.pathname + (s ? '?' + s : '');
    try {
      if (push) history.pushState(null, '', nieuw);
      else history.replaceState(null, '', nieuw);
    } catch (e) {}
  }

  function uitUrl() {
    var p = new URLSearchParams(location.search);
    st.cat = p.get('cat') || '';
    st.q = p.get('q') || '';
    st.merk = (p.get('merk') || '').split(',').filter(Boolean);
    st.type = (p.get('type') || '').split(',').filter(Boolean);
    st.filters = {};
    ['echt', 'deal', 'multi', 'voorraad', 'refurbished'].forEach(function (k) {
      if (p.get(k) === '1') st.filters[k] = true;
    });
    st.min = p.get('min') || '';
    st.max = p.get('max') || '';
    st.deals = !!DEALS && !!p.get('deals');
    st.sort = p.get('sort') || (st.deals ? 'beste' : 'populair');
    if (st.deals) st.filters = {};
    st.pagina = 1;
  }

  // ---------------------------------------------------------------- index
  function haalIndex() {
    return fetch(API + '/api/shop/index')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        // "alles" is de lijst met populaire producten achter de chip Alles; geen eigen chip.
        heeftAlles = !!(d && d.categorieen || []).some(function (c) { return c.slug === 'alles'; });
        if (d && d.categorieen) d.categorieen = d.categorieen.filter(function (c) { return c.slug !== 'alles'; });
        index = d; return d;
      });
  }

  function tekenCats() {
    if (!index) return;
    var cats = index.categorieen || [];
    var kop = cats.filter(function (c) { return c.kop; });
    var rest = cats.filter(function (c) { return !c.kop; });
    var dc = (st.deals && gz) ? dealPerCat() : null;
    if (dc) {
      kop = kop.filter(function (c) { return dc[c.slug] || c.slug === st.cat; });
      rest = rest.filter(function (c) { return dc[c.slug] || c.slug === st.cat; });
    }
    var h = '<button class="ds-chip" type="button" data-cat="" aria-pressed="' +
      (st.cat ? 'false' : 'true') + '"><b>Alles</b> <span class="n">' +
      (dc ? gz.p.length : (index.totaal || '')) + '</span></button>';
    function chip(c) {
      return '<button class="ds-chip" type="button" data-cat="' + esc(c.slug) + '" aria-pressed="' +
        (st.cat === c.slug ? 'true' : 'false') + '"><b>' + esc(c.naam) +
        '</b> <span class="n">' + (dc ? (dc[c.slug] || 0) : c.aantal) + '</span></button>';
    }
    kop.forEach(function (c) { h += chip(c); });
    // de kleinere categorieen pas na een klik op "meer", anders is de rij te lang
    if (rest.length) {
      var open = rest.some(function (c) { return c.slug === st.cat; });
      if (open) rest.forEach(function (c) { h += chip(c); });
      else h += '<button class="ds-chip" type="button" data-meer="1"><b>Meer</b> <span class="n">+' + rest.length + '</span></button>';
    }
    el.cats.innerHTML = h;
  }

  // ---------------------------------------------------------------- lijst
  function vraag() {
    var p = new URLSearchParams();
    p.set('cat', st.cat || (heeftAlles ? 'alles' : 'gaming'));
    if (st.q) p.set('q', st.q);
    if (st.merk.length) p.set('merk', st.merk.join(','));
    if (st.type.length) p.set('type', st.type.join(','));
    if (st.filters.echt) p.set('echt', '1');
    if (st.filters.deal) p.set('deal', '1');
    if (st.filters.multi) p.set('multi', '1');
    if (st.filters.voorraad) p.set('voorraad', '1');
    if (st.filters.refurbished) p.set('staat', 'refurbished');
    if (st.min !== '') p.set('min', st.min);
    if (st.max !== '') p.set('max', st.max);
    p.set('sort', st.sort);
    p.set('p', String(st.pagina));
    p.set('n', String(st.perPagina));
    return API + '/api/shop/lijst?' + p.toString();
  }

  function laad(bijvoegen) {
    if (st.deals) return laadDeals(bijvoegen);
    if (bezig) { try { bezig.abort(); } catch (e) {} }
    bezig = new AbortController();

    if (!bijvoegen) {
      el.laden.hidden = false;
      el.raster.hidden = true;
      el.leeg.hidden = true;
      el.meer.hidden = true;
    } else {
      el.meerKnop.disabled = true;
      el.meerKnop.textContent = 'Laden…';
    }

    // Zonder categorie zoeken gaat via de zoekindex; die gaat over alle
    // categorieen heen en is dus de enige manier om breed te zoeken.
    var url = (!st.cat && st.q) ? API + '/api/shop/zoek?q=' + encodeURIComponent(st.q) + '&n=48' : vraag();

    return fetch(url, { signal: bezig.signal })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        bezig = null;
        if (d.fout) throw new Error(d.fout);
        if (!st.cat && st.q) return breedResultaat(d);
        if (bijvoegen) items = items.concat(d.items || []);
        else items = d.items || [];
        tekenFacetten(d.facetten || {});
        tekenLijst(d);
      })
      .catch(function (e) {
        if (e && e.name === 'AbortError') return;
        el.laden.hidden = true;
        el.raster.hidden = true;
        el.leeg.hidden = false;
        el.leeg.querySelector('b').textContent = 'Even niet beschikbaar';
        el.leeg.querySelector('p').textContent = 'De prijzen konden niet geladen worden. Probeer het straks nog eens.';
      });
  }


  // ---------------------------------------------------------------- deals
  var gz = null, gzP = null;
  function haalDeals() {
    if (!DEALS) return Promise.reject(new Error('geen deals'));
    if (!gzP) {
      gzP = fetch(DEALS).then(function (r) { if (!r.ok) throw new Error('deals ' + r.status); return r.json(); })
        .then(function (d) {
          if (!d || !d.p) throw new Error('deals leeg');
          gz = d;
          var n = document.getElementById('ds-deals-n');
          if (n) { n.textContent = d.p.length.toLocaleString('nl-NL'); n.hidden = false; }
          return d;
        });
      gzP.catch(function () { gzP = null; });
    }
    return gzP;
  }
  function dealPerCat() {
    var m = {};
    gz.p.forEach(function (x) { m[x.c] = (m[x.c] || 0) + 1; });
    return m;
  }
  var MND = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
  function kortDatum(d) {
    var m = /^(\d{4})-(\d\d)-(\d\d)/.exec(d || '');
    return m ? (+m[3]) + ' ' + MND[+m[2] - 1] : '';
  }
  function zetDealKnop() {
    var k = document.getElementById('ds-deals');
    if (k) k.setAttribute('aria-pressed', st.deals ? 'true' : 'false');
    var u = document.getElementById('ds-dealuitleg');
    if (u) { u.hidden = !st.deals; if (st.deals && !u.dataset.gezet) { u.dataset.gezet = '1'; u.open = window.innerWidth > 640; } }
    zetSortOpties();
    // de andere aanbiedingsfilters gaan over de feed, niet over gezakt.json
    el.filters.querySelectorAll('[data-f]').forEach(function (b) {
      if (st.deals) { b.disabled = true; b.setAttribute('aria-pressed', 'false'); }
      else b.disabled = false;
    });
  }
  // Beste deal: korting in procenten maal de wortel van het bedrag. Zo komt een
  // koptelefoon die 178 euro zakte boven een pak wasmiddel dat 60 euro zakte.
  function beste(x) { return x.k * Math.sqrt(Math.min(x.d, 600)); }
  function zetSortOpties() {
    var o = el.sort.querySelector('option[value="beste"]');
    if (st.deals && !o) {
      o = document.createElement('option'); o.value = 'beste'; o.textContent = 'Beste deals';
      el.sort.insertBefore(o, el.sort.firstChild);
    } else if (!st.deals && o) o.parentNode.removeChild(o);
    el.sort.value = st.sort;
  }
  function dealSelectie() {
    var woorden = st.q.toLowerCase().split(/\s+/).filter(Boolean);
    var mn = st.min === '' ? null : +st.min, mx = st.max === '' ? null : +st.max;
    var basis = gz.p.filter(function (x) {
      if (st.cat && x.c !== st.cat) return false;
      if (mn != null && x.p < mn) return false;
      if (mx != null && x.p > mx) return false;
      if (woorden.length) {
        var t = (x.n + ' ' + (x.b || '')).toLowerCase();
        for (var i = 0; i < woorden.length; i++) if (t.indexOf(woorden[i]) === -1) return false;
      }
      return true;
    });
    function telling(veld) {
      var m = {};
      basis.forEach(function (x) { if (x[veld]) m[x[veld]] = (m[x[veld]] || 0) + 1; });
      return Object.keys(m).map(function (k) { return [k, m[k]]; }).sort(function (a, b) { return b[1] - a[1]; });
    }
    var lijst = basis.filter(function (x) {
      if (st.merk.length && st.merk.indexOf(x.b) === -1) return false;
      if (st.type.length && st.type.indexOf(x.t) === -1) return false;
      return true;
    });
    var srt = {
      'prijs': function (a, b) { return a.p - b.p; },
      'prijs-af': function (a, b) { return b.p - a.p; },
      'naam': function (a, b) { return a.n.localeCompare(b.n, 'nl'); },
      'verschil': function (a, b) { return b.d - a.d || b.k - a.k; },
      'korting': function (a, b) { return b.k - a.k || b.d - a.d; }
    }[st.sort] || function (a, b) { return beste(b) - beste(a); };
    lijst.sort(srt);
    return { lijst: lijst, facetten: { merken: telling('b'), types: telling('t') } };
  }
  function dealKaart(x) {
    var h = '<article class="ds-kaart" data-i="' + esc(x.i) + '">';
    h += '<div class="ds-badges"><span class="ds-badge daal">&minus;' + eur(x.d) + ' gezakt</span>' +
      (x.nw > 1 ? '<span class="ds-badge multi">' + x.nw + ' winkels</span>' : '') + '</div>';
    h += '<div class="ds-afb">' + (x.im
      ? '<img src="' + esc(x.im) + '" alt="' + esc(x.n) + '" loading="lazy" decoding="async">'
      : '<span class="ds-geen">geen<br>afbeelding</span>') + '</div>';
    h += '<div class="ds-kaartin">';
    h += '<span class="ds-merk">' + (x.b ? esc(x.b) : '&nbsp;') + '</span>';
    h += '<p class="ds-naam"><a href="#" data-open="' + esc(x.i) + '">' + esc(x.n) + '</a></p>';
    h += '<div class="ds-prijsrij"><span class="ds-prijs">' + eur(x.p) + '</span>' +
      '<span class="ds-van">' + eur(x.was) + '</span><span class="ds-korting">-' + x.k + '%</span></div>';
    h += '<div class="ds-winkelrij"><b>' + esc(x.w) + '</b> <span class="ds-was">&middot; was ' + eur(x.was) +
      (x.wd ? ' op ' + kortDatum(x.wd) : '') + '</span></div>';
    h += '<div class="ds-kaartknop">';
    h += '<a href="' + API + '/api/shop/go?i=' + encodeURIComponent(x.i) + '&cat=' + encodeURIComponent(x.c) +
      '&w=' + encodeURIComponent(x.w) + '&ref=deals&log=1" target="_blank" rel="sponsored noopener">Naar ' + esc(x.w) + '</a>';
    h += '<button type="button" data-open="' + esc(x.i) + '" aria-label="Alle winkels en prijsverloop">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19V10M10 19V5M16 19v-6M22 19H2"/></svg></button>';
    h += '</div>';
    if (BF && window.dpvBf && window.dpvBf.aan) h += window.dpvBf.knop({ i: x.i, c: x.c, n: x.n });
    h += '</div></article>';
    return h;
  }
  function laadDeals(bijvoegen) {
    if (bezig) { try { bezig.abort(); } catch (e) {} bezig = null; }
    if (!gz) {
      el.laden.hidden = false; el.raster.hidden = true; el.leeg.hidden = true; el.meer.hidden = true;
      return haalDeals().then(function () { tekenCats(); return laadDeals(bijvoegen); }).catch(function () {
        el.laden.hidden = true;
        el.leeg.hidden = false;
        el.leeg.querySelector('b').textContent = 'Even niet beschikbaar';
        el.leeg.querySelector('p').textContent = 'De deals konden niet geladen worden. Probeer het straks nog eens.';
      });
    }
    var r = dealSelectie();
    tekenFacetten(r.facetten);
    zetDealKnop();
    if (tipEl) tipEl.hidden = true;
    el.laden.hidden = true;
    el.meerKnop.disabled = false;
    el.meerKnop.textContent = 'Meer laden';
    var tot = r.lijst.length;
    var zicht = r.lijst.slice(0, st.pagina * st.perPagina);
    if (!tot) {
      el.raster.hidden = true;
      el.leeg.hidden = false;
      el.leeg.querySelector('b').textContent = 'Hier is nu niets echt gezakt';
      el.leeg.querySelector('p').textContent = 'Kies een andere categorie, of zet de deals uit om alles te zien.';
      el.meer.hidden = true;
      el.telling.innerHTML = '<b>0</b> gezakte prijzen';
      return Promise.resolve();
    }
    el.leeg.hidden = true;
    el.raster.hidden = false;
    el.raster.innerHTML = zicht.map(dealKaart).join('');
    zicht.forEach(function (x) { gekozenData[x.i] = gekozenData[x.i] || { i: x.i, n: x.n, c: x.c }; });
    var naam = '';
    (index && index.categorieen || []).forEach(function (c) { if (c.slug === st.cat) naam = c.naam; });
    el.telling.innerHTML = '<b>' + tot.toLocaleString('nl-NL') + '</b> ' + (tot === 1 ? 'echt gezakte prijs' : 'echt gezakte prijzen') +
      (naam ? ' in ' + esc(naam.toLowerCase()) : '');
    el.meer.hidden = zicht.length >= tot;
    return Promise.resolve();
  }

  // Breed zoeken geeft alleen naam, prijs en categorie terug. Dat is genoeg om
  // iemand naar de juiste chip te sturen; daar staat de volledige kaart.
  function breedResultaat(d) {
    el.laden.hidden = true;
    el.merken.hidden = true;
    el.types.hidden = true;
    el.meer.hidden = true;
    var perCat = d.perCat || {};
    var namen = {};
    (index && index.categorieen || []).forEach(function (c) { namen[c.slug] = c.naam; });
    var rijtjes = Object.keys(perCat).sort(function (a, b) { return perCat[b] - perCat[a]; });

    if (!d.aantal) {
      el.raster.hidden = true;
      el.leeg.hidden = false;
      el.leeg.querySelector('b').textContent = 'Niets gevonden voor “' + d.q + '”';
      el.leeg.querySelector('p').textContent = 'Probeer een kortere zoekterm, bijvoorbeeld alleen het merk of het model.';
      el.telling.textContent = ' ';
      return;
    }

    el.leeg.hidden = true;
    el.raster.hidden = false;
    el.telling.innerHTML = '<b>' + d.aantal + '</b> resultaten voor “' + esc(d.q) + '”';

    var h = '';
    rijtjes.forEach(function (slug) {
      h += '<button class="ds-chip" type="button" data-cat="' + esc(slug) + '" style="margin:0 6px 6px 0"><b>' +
        esc(namen[slug] || slug) + '</b> <span class="n">' + perCat[slug] + '</span></button>';
    });
    var kaarten = (d.items || []).map(function (r) {
      return '<div class="ds-kaart"><div class="ds-kaartin" style="padding-top:11px">' +
        '<p class="ds-naam">' + esc(r.n) + '</p>' +
        '<div class="ds-prijsrij"><span class="ds-prijs">' + eur(r.p) + '</span></div>' +
        '<div class="ds-winkelrij">' + (r.w > 1 ? '<b>' + r.w + ' winkels</b>' : esc(namen[r.c] || r.c)) + '</div>' +
        '<div class="ds-kaartknop"><a href="#" data-naar="' + esc(r.c) + '" data-zoek="' + esc(r.n) + '">Bekijk</a></div>' +
        '</div></div>';
    }).join('');
    el.raster.innerHTML = '<div style="grid-column:1/-1">' +
      '<p style="font-size:13.5px;font-weight:700;color:#5B6B80;margin:0 0 8px">Kies een categorie om te filteren en vergelijken:</p>' +
      h + '</div>' + kaarten;
  }

  function tekenFacetten(f) {
    // merken
    var m = f.merken || [];
    if (m.length > 1) {
      el.merken.hidden = false;
      el.merken.innerHTML = m.slice(0, 22).map(function (r) {
        var aan = st.merk.indexOf(r[0]) !== -1;
        return '<button class="ds-chip" type="button" data-merk="' + esc(r[0]) + '" aria-pressed="' +
          (aan ? 'true' : 'false') + '"><b>' + esc(r[0]) + '</b> <span class="n">' + r[1] + '</span></button>';
      }).join('');
    } else el.merken.hidden = true;

    // soorten binnen de categorie (product_type uit de feed)
    var t = f.types || [];
    if (t.length > 1) {
      el.types.hidden = false;
      el.types.innerHTML = t.slice(0, 20).map(function (r) {
        var aan = st.type.indexOf(r[0]) !== -1;
        return '<button class="ds-chip" type="button" data-type="' + esc(r[0]) + '" aria-pressed="' +
          (aan ? 'true' : 'false') + '"><b>' + esc(hoofd(r[0])) + '</b> <span class="n">' + r[1] + '</span></button>';
      }).join('');
    } else el.types.hidden = true;

    // aantallen op de filterchips
    ['echt', 'deal', 'multi', 'refurbished'].forEach(function (k) {
      var sp = el.filters.querySelector('[data-n="' + k + '"]');
      if (!sp) return;
      var n = f[k];
      sp.textContent = (n == null) ? '' : String(n);
      var knop = sp.closest('.ds-chip');
      if (knop) knop.disabled = (n === 0 && !st.filters[k]);
    });
  }

  function kaart(p) {
    var korting = (p.v > p.p) ? Math.round((1 - p.p / p.v) * 100) : 0;
    var multi = p.o && p.o.length > 1;
    var hoogste = multi ? p.o[p.o.length - 1].p : 0;
    var aan = gekozen.indexOf(p.i) !== -1;
    // "laagste ooit" mag alleen als we hem vaker dan eens gemeten hebben
    var laagsteOoit = (typeof p.lp === 'number' && p.mt >= 2 && p.p <= p.lp + 0.005);

    var badges = '';
    if (laagsteOoit) badges += '<span class="ds-badge laag">Laagste tot nu</span>';
    if (multi) badges += '<span class="ds-badge multi">' + p.o.length + ' winkels</span>';
    if (p.s === 'r') badges += '<span class="ds-badge ref">' + (p.g ? 'Tweedehands' : 'Refurbished') + '</span>';

    var h = '<article class="ds-kaart' + (aan ? ' gekozen' : '') + '" data-i="' + esc(p.i) + '">';
    h += '<div class="ds-badges">' + (badges || '&nbsp;') + '</div>';
    h += '<button class="ds-vink" type="button" data-vink="' + esc(p.i) + '" aria-pressed="' + (aan ? 'true' : 'false') +
      '" aria-label="Zet in de vergelijking"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7"/></svg></button>';
    h += '<div class="ds-afb">' + (p.im
      ? '<img src="' + esc(p.im) + '" alt="' + esc(p.n) + '" loading="lazy" decoding="async">'
      : '<span class="ds-geen">geen<br>afbeelding</span>') + '</div>';
    h += '<div class="ds-kaartin">';
    h += '<span class="ds-merk">' + (p.b ? esc(p.b) : '&nbsp;') + '</span>';
    h += '<p class="ds-naam"><a href="#" data-open="' + esc(p.i) + '">' + esc(p.n) + '</a></p>';
    h += '<div class="ds-prijsrij"><span class="ds-prijs">' + eur(p.p) + '</span>';
    if (korting) h += '<span class="ds-van">' + eur(p.v) + '</span><span class="ds-korting">-' + korting + '%</span>';
    h += '</div>';
    h += '<div class="ds-winkelrij">' + (multi
      ? '<b>' + esc(p.o[0].w) + '</b> &middot; tot ' + eur(hoogste) + ' elders'
      : '<b>' + esc(p.o[0].w) + '</b>' + (p.dg > 6 ? ' &middot; deze prijs al ' + p.dg + ' dagen' : '')) + '</div>';
    /* Alleen bij een product waarvan het Amazon-ASIN bekend is, dus een
       directe link naar precies dit product. Zonder prijs; zie de uitleg bij
       het blok in het overzicht. */
    if (AMZ && p.az && !amzIsWinkel(p)) {
      h += '<a class="ds-amzlink' + (amzGoedkoper(p) ? ' lager' : '') + '" href="' + esc(amzLink(p)) + '" target="_blank" rel="sponsored nofollow noopener">' +
        (p.azp > 0
          ? (amzGoedkoper(p) ? 'Goedkoper bij Amazon: ' : 'Bij Amazon ') + eur(p.azp) + ' <small>gezien ' + esc(amzDag(p)) + '</small>'
          : 'Ook bij Amazon') + ' &rsaquo;</a>';
    }
    h += '<div class="ds-kaartknop">';
    h += '<a href="' + API + '/api/shop/go?i=' + encodeURIComponent(p.i) + '&cat=' + encodeURIComponent(p.c) +
      '" target="_blank" rel="sponsored noopener">Naar ' + esc(p.o[0].w) + '</a>';
    h += '<button type="button" data-open="' + esc(p.i) + '" aria-label="Alle winkels en prijsverloop">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19V10M10 19V5M16 19v-6M22 19H2"/></svg></button>';
    h += '</div>';
    if (BF && window.dpvBf && window.dpvBf.aan) h += window.dpvBf.knop(p);
    h += '</div></article>';
    return h;
  }

  // Tip met Prijsje (12 okt): pas na de eerste lijst, niet in de deals (daar kun
  // je niet aanvinken), en weg voor altijd zodra iemand op Begrepen klikt.
  var tipEl = document.getElementById('ds-tip');
  function tipWeg() { try { return localStorage.getItem('dpv-tip-vink') === '1'; } catch (e) { return false; } }
  function zetTip() { if (tipEl) tipEl.hidden = st.deals || tipWeg() || !items.length; }
  if (tipEl) tipEl.addEventListener('click', function (e) {
    if (!e.target.closest('[data-tip-weg]')) return;
    tipEl.hidden = true;
    try { localStorage.setItem('dpv-tip-vink', '1'); } catch (er) {}
  });
  function tekenLijst(d) {
    setTimeout(zetTip, 0);
    el.laden.hidden = true;
    el.meerKnop.disabled = false;
    el.meerKnop.textContent = 'Meer laden';

    if (!items.length) {
      el.raster.hidden = true;
      el.leeg.hidden = false;
      el.leeg.querySelector('b').textContent = 'Niets gevonden';
      el.leeg.querySelector('p').textContent = 'Er is geen product dat aan alle filters voldoet.';
      el.meer.hidden = true;
      el.telling.innerHTML = '<b>0</b> producten';
      return;
    }

    el.leeg.hidden = true;
    el.raster.hidden = false;
    el.raster.innerHTML = items.map(kaart).join('');

    var mix = !st.cat && heeftAlles;
    var naam = mix ? '' : (d.naam || '');
    el.telling.innerHTML = '<b>' + d.aantal + '</b> ' + (d.aantal === 1 ? 'product' : (mix ? 'populaire producten uit alle categorie\u00ebn' : 'producten')) +
      (naam ? ' in ' + esc(naam.toLowerCase()) : '') +
      (d.facetten && d.facetten.multi ? ' &middot; ' + d.facetten.multi + ' bij meer dan een winkel' : '');

    el.meer.hidden = !(d.paginas && st.pagina < d.paginas);
    items.forEach(function (p) { gekozenData[p.i] = p; });
  }

  // ---------------------------------------------------------------- vergelijken
  function dokBij() {
    if (!gekozen.length) { el.dok.hidden = true; document.body.style.paddingBottom = ''; return; }
    el.dok.hidden = false;
    el.dokT.innerHTML = '<b>' + gekozen.length + '</b> van ' + MAX_VGL + ' gekozen';
    wijkVoorCookiebalk();
    document.body.style.paddingBottom = (el.dok.offsetHeight + 8) + 'px';
    document.documentElement.style.setProperty('--dsdok', (el.dok.offsetHeight + (parseInt(el.dok.style.bottom, 10) || 0)) + 'px');
  }

  // De cookiebalk van Avada staat onderaan en dekt deze balk af op mobiel.
  // Dus meten hoe hoog die staat en daarboven gaan zitten.
  function wijkVoorCookiebalk() {
    var ck = document.querySelector('#Avada-CookiesBar, #shopify-pc__banner, .cookie-banner');
    var h = 0;
    if (ck) {
      var s = getComputedStyle(ck);
      if (s.display !== 'none' && s.visibility !== 'hidden' && ck.offsetHeight > 0) {
        var r = ck.getBoundingClientRect();
        if (r.bottom > window.innerHeight - 4) h = ck.offsetHeight;
      }
    }
    el.dok.style.bottom = h ? h + 'px' : '';
  }

  function zetVink(id, aan) {
    var i = gekozen.indexOf(id);
    if (aan && i === -1) {
      if (gekozen.length >= MAX_VGL) {
        el.dokT.innerHTML = '<b>Hoogstens ' + MAX_VGL + '</b> producten tegelijk';
        return;
      }
      gekozen.push(id);
    } else if (!aan && i !== -1) gekozen.splice(i, 1);

    var knop = el.raster.querySelector('[data-vink="' + id.replace(/"/g, '\\"') + '"]');
    if (knop) {
      knop.setAttribute('aria-pressed', aan ? 'true' : 'false');
      var k = knop.closest('.ds-kaart');
      if (k) k.classList.toggle('gekozen', aan);
    }
    dokBij();
  }

  function vergelijkTabel() {
    var ps = gekozen.map(function (i) { return gekozenData[i]; }).filter(Boolean);
    if (ps.length < 2) {
      el.ovlBody.innerHTML = '<p style="font-size:14px;color:#5B6B80;margin:0">Kies er minstens twee om te vergelijken.</p>';
      return;
    }
    var kol = 'grid-template-columns:118px repeat(' + ps.length + ',minmax(118px,1fr))';

    // Lege cellen krijgen &nbsp;. Dit thema verbergt lege divs (div:empty) en
    // dan schuift de hele kolom een plek op; dat kostte eerder veel zoekwerk.
    function rij(label, waarden, besteIdx) {
      var h = '<div class="ds-vt-r" style="' + kol + '"><div>' + esc(label) + '</div>';
      waarden.forEach(function (v, i) {
        var leeg = (v === '' || v == null);
        h += '<div' + (i === besteIdx ? ' class="ds-vt-best"' : '') + '>' + (leeg ? '&nbsp;' : v) + '</div>';
      });
      return h + '</div>';
    }

    function goedkoopsteIdx(getallen) {
      var b = -1; var w = Infinity;
      getallen.forEach(function (g, i) { if (typeof g === 'number' && g < w) { w = g; b = i; } });
      return b;
    }

    var h = '<div class="ds-vt">';
    h += '<div class="ds-vt-h" style="' + kol + '"><div>Product</div>';
    ps.forEach(function (p) {
      h += '<div>' + (p.im ? '<img class="ds-vt-afb" src="' + esc(p.im) + '" alt="" loading="lazy">' : '') +
        esc(p.n) + '</div>';
    });
    h += '</div>';

    h += rij('Merk', ps.map(function (p) { return esc(p.b || ''); }), -1);
    h += rij('Laagste prijs', ps.map(function (p) { return eur(p.p); }), goedkoopsteIdx(ps.map(function (p) { return p.p; })));
    h += rij('Bij', ps.map(function (p) { return esc(p.o[0].w); }), -1);
    h += rij('Verzendkosten', ps.map(function (p) {
      var v = p.o[0].vz;
      return v > 0 ? eur(v) : 'gratis';
    }), -1);
    h += rij('Aantal winkels', ps.map(function (p) { return String(p.o.length); }), -1);
    h += rij('Duurste winkel', ps.map(function (p) {
      return p.o.length > 1 ? eur(p.o[p.o.length - 1].p) + ' (' + esc(p.o[p.o.length - 1].w) + ')' : '';
    }), -1);
    h += rij('Van-prijs winkel', ps.map(function (p) { return p.v > p.p ? eur(p.v) : ''; }), -1);
    h += rij('Laagst gemeten', ps.map(function (p) {
      return (typeof p.lp === 'number' && p.mt >= 2) ? eur(p.lp) : '';
    }), -1);
    h += rij('Deze prijs sinds', ps.map(function (p) {
      if (!p.sinds || !p.mt || p.mt < 2) return '';
      var d = dagen(p.sinds);
      return d === 0 ? 'vandaag' : d + (d === 1 ? ' dag' : ' dagen');
    }), -1);
    h += rij('Soort', ps.map(function (p) { return esc(hoofd(p.t || '')); }), -1);
    h += rij('Staat', ps.map(function (p) { return p.s === 'r' ? (p.g ? 'tweedehands' : 'refurbished') : 'nieuw'; }), -1);
    h += '</div>';

    h += '<div class="ds-vt-knop" style="' + kol + '"><div>&nbsp;</div>';
    ps.forEach(function (p) {
      h += '<div><a href="' + API + '/api/shop/go?i=' + encodeURIComponent(p.i) + '&cat=' + encodeURIComponent(p.c) +
        '" target="_blank" rel="sponsored noopener">Naar ' + esc(p.o[0].w) + '</a></div>';
    });
    h += '</div>';

    el.ovlBody.innerHTML = h;
  }

  // ---------------------------------------------------------------- productvak
  function prijsGraf(reeks) {
    if (!reeks || reeks.length < 2) return '';
    var pr = reeks.map(function (e) { return e.prijs; });
    var min = Math.min.apply(null, pr);
    var max = Math.max.apply(null, pr);
    if (max - min < 0.01) return '';
    var t0 = Date.parse(reeks[0].dag);
    var t1 = Math.max(Date.now(), Date.parse(reeks[reeks.length - 1].gezien || reeks[reeks.length - 1].dag));
    if (!(t1 > t0)) return '';
    var B = 100; var H = 72;
    function x(t) { return ((Date.parse(t) - t0) / (t1 - t0)) * B; }
    function y(p) { return H - ((p - min) / (max - min)) * (H - 10) - 5; }

    // trapfunctie: een prijs geldt tot de volgende wijziging
    var d = '';
    reeks.forEach(function (e, i) {
      var xa = x(e.dag);
      var xb = (i + 1 < reeks.length) ? x(reeks[i + 1].dag) : B;
      if (i === 0) d += 'M' + xa.toFixed(2) + ' ' + y(e.prijs).toFixed(2);
      else d += ' L' + xa.toFixed(2) + ' ' + y(e.prijs).toFixed(2);
      d += ' L' + xb.toFixed(2) + ' ' + y(e.prijs).toFixed(2);
    });

    var nu = reeks[reeks.length - 1];
    return '<div class="ds-graf"><svg viewBox="0 0 100 ' + H + '" preserveAspectRatio="none" aria-hidden="true">' +
      '<path d="' + d + '" fill="none" stroke="#5b3b8c" stroke-width="1.6" vector-effect="non-scaling-stroke" stroke-linejoin="round"/>' +
      '<circle cx="' + x(nu.dag).toFixed(2) + '" cy="' + y(nu.prijs).toFixed(2) + '" r="2.4" fill="#5b3b8c"/>' +
      '</svg><div class="ds-graf-vt"><span>' + esc(reeks[0].dag) + ' &middot; ' + eur(max) + ' hoogste</span>' +
      '<span>nu ' + eur(nu.prijs) + '</span></div></div>';
  }

  function oordeelTekst(o, beste) {
    if (!o || o.metingen < 2) {
      return '<p>Wij volgen deze prijs sinds kort. Zodra er meer metingen zijn, staat hier of de huidige prijs echt laag is.</p>';
    }
    var h = '';
    if (o.isLaagsteOoit) {
      h += '<p><span class="ja">Dit is de laagste prijs</span> die wij voor dit product hebben gemeten, ' +
        'in ' + o.metingen + ' metingen sinds ' + esc(o.eersteMeting) + '.</p>';
    } else {
      h += '<p>Wij hebben dit product goedkoper gezien: <b>' + eur(o.laagsteOoit) + '</b> op ' +
        esc(o.laagsteOp) + '. Nu staat hij op ' + eur(beste.prijs) + '.</p>';
    }
    if (beste.v > 0) {
      if (o.vanPrijsGemeten === true) {
        h += '<p>De winkel noemt ' + eur(beste.v) + ' als eerdere prijs, en <span class="ja">die hebben wij ook gemeten</span>. ' +
          'De korting is dus echt.</p>';
      } else if (o.vanPrijsGemeten === false) {
        h += '<p>De winkel noemt ' + eur(beste.v) + ' als eerdere prijs, maar <span class="nee">zo hoog hebben wij hem nooit gezien</span>. ' +
          'Het hoogste dat wij meten is ' + eur(o.hoogsteOoit) + '.</p>';
      }
    }
    var d = o.dagenOpDezePrijs;
    if (d >= 14) h += '<p>Deze prijs staat er al ' + d + ' dagen, dus dit is geen tijdelijke actie.</p>';
    else if (d <= 2 && d >= 0) h += '<p>De prijs is ' + (d === 0 ? 'vandaag' : d === 1 ? 'gisteren' : d + ' dagen terug') + ' veranderd.</p>';
    return h;
  }

  function openProduct(id) {
    var p = gekozenData[id];
    el.ovlKop.textContent = p ? p.n : 'Product';
    el.ovlBody.innerHTML = '<p style="font-size:14px;color:#5B6B80;margin:0">Prijzen en prijsverloop ophalen…</p>';
    el.ovl.hidden = false;
    document.body.style.overflow = 'hidden';
    el.dok.hidden = true;

    fetch(API + '/api/shop/product?i=' + encodeURIComponent(id) + (p && p.c ? '&cat=' + encodeURIComponent(p.c) : ''))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d.fout) throw new Error(d.fout);
        var pr = d.product;
        el.ovlKop.textContent = pr.n;
        var h = '<div class="ds-pv">';
        h += '<div><div class="ds-pv-afb">' + (pr.im ? '<img src="' + esc(pr.im) + '" alt="' + esc(pr.n) + '">' : '') + '</div></div>';
        h += '<div>';
        h += '<div class="ds-pv-w">';
        pr.o.forEach(function (o, i) {
          var hist = (d.logboek || {})[o.w] || [];
          h += '<div class="ds-pv-w-r' + (i === 0 ? ' beste' : '') + '">';
          h += '<div class="ds-pv-w-n">' + esc(o.w);
          var sub = [];
          /* Bij bol kan het aanbod van een marktplaatsverkoper komen. Die
             staat dan als "bol.com partner", en hier staat wie het is. Zonder
             die naam lijkt het de prijs van bol zelf, en dat is het niet. */
          if (o.vk) sub.push('verkocht door ' + esc(o.vk));
          if (o.vz > 0) sub.push(eur(o.vz) + ' verzending'); else sub.push('gratis verzending');
          if (!o.vr) sub.push('voorraad onbekend');
          if (hist.length >= 2) sub.push('sinds ' + esc(hist[hist.length - 1].dag));
          h += '<small>' + sub.join(' · ') + '</small></div>';
          h += '<span class="ds-pv-w-p">' + eur(o.p) + (o.v > o.p ? ' <small style="font-weight:600;color:#5B6B80;text-decoration:line-through;font-size:12px">' + eur(o.v) + '</small>' : '') + '</span>';
          h += '<a class="ds-pv-w-k" href="' + API + '/api/shop/go?i=' + encodeURIComponent(pr.i) +
            '&w=' + encodeURIComponent(o.w) + '&cat=' + encodeURIComponent(d.cat) +
            '" target="_blank" rel="sponsored noopener">Bekijk</a>';
          h += '</div>';
        });
        h += '</div>';

        /* Amazon. Hun prijs komt niet uit een feed of koppeling: die krijg je
           pas bij tien verkopen in dertig dagen. Wat hier kan staan is een
           prijs die met de hand is afgelezen, met de dag erbij. Die doet niet
           mee in de winkellijst hierboven en gaat niet het prijslogboek in,
           want hij is gezien en niet gemeten. Is hij lager dan de laagste
           winkel, dan staat dat erbij. */
        if (AMZ && !amzIsWinkel(pr)) {
          var direct = !!(pr.az || '').trim();
          var tekst;
          if (pr.azp > 0) {
            tekst = '<b>' + (amzGoedkoper(pr) ? 'Goedkoper bij Amazon: ' : 'Bij Amazon: ') + eur(pr.azp) + '</b>' +
              '<small>Deze prijs hebben wij op ' + esc(amzDag(pr)) + ' bij Amazon gezien. Hij wordt niet elke nacht nagemeten zoals de rest, dus kijk daar of hij nog klopt.</small>';
          } else {
            tekst = '<b>Ook bij Amazon</b><small>' + (direct
              ? 'Dit product staat ook bij Amazon. Wij meten hun prijs niet, dus kijk zelf wat het daar kost.'
              : 'Wij meten de prijs van Amazon niet. Deze knop zoekt het product bij hen op.') + '</small>';
          }
          h += '<div class="ds-amz' + (amzGoedkoper(pr) ? ' lager' : '') + '"><div>' + tekst +
            '</div><a href="' + esc(amzLink(pr)) + '" target="_blank" rel="sponsored nofollow noopener">' +
            (direct ? 'Bekijk bij Amazon' : 'Zoek bij Amazon') + '</a></div>';
        }

        var besteW = pr.o[0].w;
        var reeks = (d.logboek || {})[besteW] || [];
        h += '<div class="ds-oordeel"><b>Wat wij van deze prijs weten</b>' +
          oordeelTekst(d.oordeel, { prijs: pr.o[0].p, v: pr.o[0].v }) + '</div>';
        h += prijsGraf(reeks);
        h += '</div></div>';
        el.ovlBody.innerHTML = h;
      })
      .catch(function () {
        el.ovlBody.innerHTML = '<p style="font-size:14px;color:#5B6B80;margin:0">Dit product kon niet geladen worden.</p>';
      });
  }

  function sluitOvl() {
    el.ovl.hidden = true;
    document.body.style.overflow = '';
    dokBij();
  }

  // ---------------------------------------------------------------- gebeurtenissen
  var dempTimer = null;
  function vernieuw(push) {
    st.pagina = 1;
    naarUrl(push);
    tekenCats();
    laad(false);
  }

  el.cats.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    if (b.hasAttribute('data-meer')) {
      // alle categorieen uitklappen
      var cats = (index && index.categorieen) || [];
      el.cats.innerHTML = '<button class="ds-chip" type="button" data-cat="" aria-pressed="' + (st.cat ? 'false' : 'true') +
        '"><b>Alles</b> <span class="n">' + (index.totaal || '') + '</span></button>' +
        cats.map(function (c) {
          return '<button class="ds-chip" type="button" data-cat="' + esc(c.slug) + '" aria-pressed="' +
            (st.cat === c.slug ? 'true' : 'false') + '"><b>' + esc(c.naam) + '</b> <span class="n">' + c.aantal + '</span></button>';
        }).join('');
      return;
    }
    if (!b.hasAttribute('data-cat')) return;
    var nieuw = b.getAttribute('data-cat');
    if (nieuw === st.cat) return;
    st.cat = nieuw;
    st.merk = [];
    st.type = [];
    vernieuw(true);
  });

  var dealKnop = document.getElementById('ds-deals');
  if (dealKnop && DEALS) dealKnop.addEventListener('click', function () {
    st.deals = !st.deals;
    if (st.deals) {
      st.filters = {};
      if (st.sort === 'populair') st.sort = 'beste';
    } else if (st.sort === 'beste') st.sort = 'populair';
    st.merk = []; st.type = [];
    zetDealKnop();
    vernieuw(true);
  });
  else if (dealKnop) dealKnop.parentNode.hidden = true;

  el.filters.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-f]');
    if (!b || b.disabled) return;
    var k = b.getAttribute('data-f');
    st.filters[k] = !st.filters[k];
    if (!st.filters[k]) delete st.filters[k];
    b.setAttribute('aria-pressed', st.filters[k] ? 'true' : 'false');
    vernieuw(false);
  });

  el.merken.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-merk]');
    if (!b) return;
    var m = b.getAttribute('data-merk');
    var i = st.merk.indexOf(m);
    if (i === -1) st.merk.push(m); else st.merk.splice(i, 1);
    vernieuw(false);
  });

  el.types.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-type]');
    if (!b) return;
    var t = b.getAttribute('data-type');
    var i = st.type.indexOf(t);
    if (i === -1) st.type.push(t); else st.type.splice(i, 1);
    vernieuw(false);
  });

  el.raster.addEventListener('click', function (e) {
    var v = e.target.closest('button[data-vink]');
    if (v) {
      e.preventDefault();
      var id = v.getAttribute('data-vink');
      zetVink(id, v.getAttribute('aria-pressed') !== 'true');
      return;
    }
    var o = e.target.closest('[data-open]');
    if (o) { e.preventDefault(); openProduct(o.getAttribute('data-open')); return; }
    var n = e.target.closest('[data-naar]');
    if (n) {
      e.preventDefault();
      st.cat = n.getAttribute('data-naar');
      st.q = n.getAttribute('data-zoek') || st.q;
      el.q.value = st.q;
      vernieuw(true);
      return;
    }
    var c = e.target.closest('button[data-cat]');
    if (c) { st.cat = c.getAttribute('data-cat'); vernieuw(true); }
  });

  el.meerKnop.addEventListener('click', function () {
    st.pagina++;
    laad(true);
  });

  el.q.addEventListener('input', function () {
    el.wis.hidden = !el.q.value;
    clearTimeout(dempTimer);
    dempTimer = setTimeout(function () {
      st.q = el.q.value.trim();
      vernieuw(false);
    }, 320);
  });
  el.wis.addEventListener('click', function () {
    el.q.value = '';
    el.wis.hidden = true;
    st.q = '';
    vernieuw(false);
    el.q.focus();
  });

  function prijsBij() {
    clearTimeout(dempTimer);
    dempTimer = setTimeout(function () {
      st.min = el.min.value === '' ? '' : String(Math.max(0, parseInt(el.min.value, 10) || 0));
      st.max = el.max.value === '' ? '' : String(Math.max(0, parseInt(el.max.value, 10) || 0));
      vernieuw(false);
    }, 450);
  }
  el.min.addEventListener('input', prijsBij);
  el.max.addEventListener('input', prijsBij);

  el.sort.addEventListener('change', function () {
    st.sort = el.sort.value;
    vernieuw(false);
  });

  function wisFilters(ookZoek) {
    if (ookZoek) { st.q = ''; el.q.value = ''; el.wis.hidden = true; }
    st.merk = []; st.type = []; st.filters = {}; st.min = ''; st.max = '';
    el.min.value = ''; el.max.value = '';
    el.filters.querySelectorAll('[aria-pressed]').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
    zetDealKnop();
    vernieuw(true);
  }
  document.getElementById('ds-leeg-reset').addEventListener('click', function () { wisFilters(true); });

  // ---------- zijbalk: filterknop op mobiel, telling, lange lijsten inklappen ----------
  (function () {
    var zij = document.getElementById('ds-zij'), knop = document.getElementById('ds-fknop'),
      n = document.getElementById('ds-fknop-n'), toon = document.getElementById('ds-zij-toon');
    if (!zij || !knop) return;
    function open(aan) {
      zij.classList.toggle('open', aan);
      knop.setAttribute('aria-expanded', aan ? 'true' : 'false');
      document.body.style.overflow = aan ? 'hidden' : '';
      if (aan) { var s = document.getElementById('ds-zij-sluit'); if (s) s.focus(); } else knop.focus();
    }
    knop.addEventListener('click', function () { open(true); });
    document.getElementById('ds-zij-sluit').addEventListener('click', function () { open(false); });
    toon.addEventListener('click', function () { open(false); el.telling.scrollIntoView({ block: 'start' }); });
    document.getElementById('ds-zij-wis').addEventListener('click', function () { wisFilters(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && zij.classList.contains('open')) open(false); });
    window.addEventListener('resize', function () { if (window.innerWidth >= 900 && zij.classList.contains('open')) open(false); });
    zij.addEventListener('click', function (e) {
      var m = e.target.closest('.ds-zij-meer'); if (!m) return;
      var lijst = m.previousElementSibling, uit = lijst.classList.toggle('open');
      m.textContent = m.getAttribute(uit ? 'data-minder' : 'data-meer');
    });
    // Alleen schrijven als er iets verandert: de waarnemer hieronder ziet ook onze eigen wijzigingen.
    function zetVerborgen(e, v) { if (e && e.hidden !== v) e.hidden = v; }
    function zetTekst(e, t) { if (e && e.textContent !== t) e.textContent = t; }
    function bij() {
      // Kop en "alle"-knop alleen tonen als de lijst er is en lang genoeg is.
      [].forEach.call(zij.querySelectorAll('.ds-zg'), function (g) {
        var lijst = g.querySelector('#ds-types,#ds-merken'); if (!lijst) return;
        zetVerborgen(g, lijst.hidden);
        zetVerborgen(g.querySelector('.ds-zij-meer'), lijst.children.length <= 7);
      });
      var aan = zij.querySelectorAll('.ds-chip[aria-pressed="true"]').length + (el.min.value ? 1 : 0) + (el.max.value ? 1 : 0);
      zetVerborgen(n, !aan); zetTekst(n, aan ? String(aan) : '');
      var b = el.telling.querySelector('b');
      zetTekst(toon, b ? 'Toon ' + b.textContent + ' producten' : 'Toon resultaten');
    }
    if (window.MutationObserver) {
      var mo = new MutationObserver(bij);
      mo.observe(zij, { subtree: true, childList: true, attributes: true, attributeFilter: ['aria-pressed', 'hidden'] });
      mo.observe(el.telling, { childList: true, subtree: true, characterData: true });
    }
    el.min.addEventListener('input', bij); el.max.addEventListener('input', bij);
    bij();
  })();

  document.getElementById('ds-dok-vgl').addEventListener('click', function () {
    el.ovlKop.textContent = 'Vergelijken';
    vergelijkTabel();
    el.ovl.hidden = false;
    document.body.style.overflow = 'hidden';
    el.dok.hidden = true;
  });
  document.getElementById('ds-dok-leeg').addEventListener('click', function () {
    gekozen.slice().forEach(function (id) { zetVink(id, false); });
  });
  document.getElementById('ds-ovl-sluit').addEventListener('click', sluitOvl);
  el.ovl.addEventListener('click', function (e) { if (e.target === el.ovl) sluitOvl(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !el.ovl.hidden) sluitOvl(); });

  window.addEventListener('popstate', function () {
    uitUrl();
    el.q.value = st.q;
    el.wis.hidden = !st.q;
    el.min.value = st.min;
    el.max.value = st.max;
    el.sort.value = st.sort;
    el.filters.querySelectorAll('[data-f]').forEach(function (b) {
      b.setAttribute('aria-pressed', st.filters[b.getAttribute('data-f')] ? 'true' : 'false');
    });
    zetDealKnop();
    tekenCats();
    laad(false);
  });

  window.addEventListener('resize', wijkVoorCookiebalk);
  window.addEventListener('scroll', wijkVoorCookiebalk, { passive: true });

  // ---------------------------------------------------------------- start
  uitUrl();
  el.q.value = st.q;
  el.wis.hidden = !st.q;
  el.min.value = st.min;
  el.max.value = st.max;
  el.sort.value = st.sort;
  el.filters.querySelectorAll('[data-f]').forEach(function (b) {
    b.setAttribute('aria-pressed', st.filters[b.getAttribute('data-f')] ? 'true' : 'false');
  });

  zetDealKnop();
  haalIndex().then(function () {
    // het aantal deals op de knop, zonder de pagina op te houden
    if (DEALS && !st.deals) setTimeout(function () { haalDeals().then(function () {}, function () {}); }, 1500);
    if (!st.cat && !st.q && !st.deals) {
      var sc = '{{ section.settings.start_cat | default: "alles" }}';
      if (sc && sc !== 'alles') st.cat = sc;
    }
    tekenCats();
    return laad(false);
  }).catch(function () {
    el.laden.hidden = true;
    el.leeg.hidden = false;
    el.leeg.querySelector('b').textContent = 'Even niet beschikbaar';
    el.leeg.querySelector('p').textContent = 'De prijzen konden niet geladen worden. Probeer het straks nog eens.';
  });
})();
</script>

