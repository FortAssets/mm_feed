{%- comment -%}
  dpv-shop — vergelijkpagina voor alles wat geen telefoonabonnement is.

  Haalt zijn gegevens bij de worker dpv-shop, die op zijn beurt de bestanden
  leest die de GitHub Action FortAssets/mm_feed elke nacht wegzet. Daar zitten
  de brede Awin-feed (Coolblue, Xiaomi, Mobiel.nl, Action, Bazta en meer) en
  veertien MediaMarkt-feeds in, gekoppeld op EAN.

  Opzet: categoriechips bovenaan, daaronder filterchips, dan een raster met
  kaarten. Dus hoe een webwinkel het doet, want dat kennen mensen al. Vergelijken
  gaat zoals op de losse-toestellen pagina: aanvinken, balk onderaan, overlay.

  Let op twee dingen die in dit thema eerder misgingen:
   - het thema verbergt lege divs (div:empty), waardoor kolommen in een
     vergelijktabel verschuiven. Daarom staat er &nbsp; in de lege cellen.
   - de cookiebalk van Avada staat onderaan over de zwevende balk heen op
     mobiel. De balk meet die hoogte en schuift omhoog.

  De van-prijs komt uit de feed en die is bij Coolblue nooit gevuld; bij
  MediaMarkt in ongeveer een vijfde van de gevallen. Daarom staat er een tweede
  filter "echt lager": die kijkt in ons eigen prijslogboek of de prijs nu
  werkelijk lager staat dan alles wat we eerder gemeten hebben. Dat is het enige
  harde bewijs dat er is, en in november is dat het verschil tussen onze pagina
  en de rest.
{%- endcomment -%}

<style>
.ds{--pa:#5b3b8c;--pa2:#F6F4FB;--rd:#E2DCF2;--gr:#10b981;--rood:#e11d48;--ink:#0D1B2A;--mut:#5B6B80;
 max-width:1180px;margin:0 auto;padding:10px 16px 40px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink)}
.ds *{box-sizing:border-box}
.ds[hidden],.ds [hidden]{display:none !important}

/* ---------------------------------------------------------------- kop */
.ds-kop{margin:0 0 14px}
.ds-eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--pa);font-weight:800;margin:0 0 6px}
.ds h1{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:27px;line-height:1.15;
 letter-spacing:-.03em;font-weight:800;margin:0 0 8px}
.ds-sub{font-size:15px;line-height:1.6;color:var(--mut);margin:0;max-width:66ch}

/* ---------------------------------------------------------------- zoeken */
.ds-zoekrij{display:flex;gap:8px;margin:14px 0 12px}
.ds-zoek{position:relative;flex:1;min-width:0}
.ds-zoek input{width:100%;height:46px;border:1.5px solid var(--rd);border-radius:12px;padding:0 38px 0 40px;
 font-size:15px;font-family:inherit;background:#fff;color:var(--ink)}
.ds-zoek input:focus{outline:none;border-color:var(--pa);box-shadow:0 0 0 3px rgba(91,59,140,.12)}
.ds-zoek svg{position:absolute;left:13px;top:14px;width:18px;height:18px;color:var(--mut);pointer-events:none}
.ds-wis{position:absolute;right:6px;top:7px;width:32px;height:32px;border:0;background:none;color:var(--mut);
 font-size:20px;line-height:1;cursor:pointer;border-radius:8px}
.ds-wis:hover{background:var(--pa2)}

/* ---------------------------------------------------------------- chips */
.ds-chips{display:flex;gap:7px;overflow-x:auto;padding:2px 0 8px;margin:0 -16px;padding-left:16px;padding-right:16px;
 scrollbar-width:none;-ms-overflow-style:none}
.ds-chips::-webkit-scrollbar{display:none}
.ds-chip{flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 14px;border-radius:999px;
 border:1.5px solid var(--rd);background:#fff;font-size:13.5px;font-weight:700;color:var(--ink);cursor:pointer;
 font-family:inherit;white-space:nowrap;transition:background .12s,border-color .12s}
.ds-chip:hover{border-color:var(--pa)}
.ds-chip b{font-weight:800}
.ds-chip span.n{font-weight:600;color:var(--mut);font-size:12px}
.ds-chip[aria-pressed="true"]{background:var(--pa);border-color:var(--pa);color:#fff}
.ds-chip[aria-pressed="true"] span.n{color:rgba(255,255,255,.75)}
.ds-chip.groen[aria-pressed="true"]{background:var(--gr);border-color:var(--gr)}
.ds-chip.rood[aria-pressed="true"]{background:var(--rood);border-color:var(--rood)}
.ds-chip:disabled{opacity:.4;cursor:default}
.ds-chiprij2{border-top:1px solid var(--rd);padding-top:9px;margin-top:2px}

/* ---------------------------------------------------------------- balk met sortering */
.ds-balk{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 0 14px}
.ds-telling{font-size:13.5px;color:var(--mut);font-weight:600}
.ds-telling b{color:var(--ink);font-weight:800}
.ds-rechts{margin-left:auto;display:flex;gap:8px;align-items:center}
.ds-sel{height:38px;border:1.5px solid var(--rd);border-radius:10px;background:#fff;font-family:inherit;
 font-size:13.5px;font-weight:700;color:var(--ink);padding:0 30px 0 11px;cursor:pointer;
 appearance:none;background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235B6B80' stroke-width='2.5'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E");
 background-repeat:no-repeat;background-position:right 8px center;background-size:15px}
.ds-sel:focus{outline:none;border-color:var(--pa)}

/* ---------------------------------------------------------------- prijsvak */
.ds-prijsvak{display:flex;align-items:center;gap:6px}
.ds-prijsvak input{width:74px;height:38px;border:1.5px solid var(--rd);border-radius:10px;padding:0 9px;
 font-family:inherit;font-size:13.5px;font-weight:700;color:var(--ink);background:#fff}
.ds-prijsvak input:focus{outline:none;border-color:var(--pa)}
.ds-prijsvak span{font-size:13px;color:var(--mut);font-weight:700}

/* ---------------------------------------------------------------- raster */
.ds-raster{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:620px){.ds-raster{grid-template-columns:repeat(3,1fr);gap:12px}}
@media(min-width:900px){.ds-raster{grid-template-columns:repeat(4,1fr)}}

.ds-kaart{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid var(--rd);
 border-radius:14px;overflow:hidden;transition:box-shadow .14s,border-color .14s}
.ds-kaart:hover{border-color:#cdc2e8;box-shadow:0 6px 18px rgba(13,27,42,.07)}
.ds-kaart.gekozen{border-color:var(--pa);box-shadow:0 0 0 2px rgba(91,59,140,.18)}
.ds-afb{position:relative;aspect-ratio:1/1;background:#fff;display:flex;align-items:center;justify-content:center;padding:10px}
/* 6 okt: foto's hadden elk een eigen hoogte, omdat max-height in procenten niets doet in een vak zonder vaste hoogte. Nu vult elke foto hetzelfde vierkant. */
.ds-afb{overflow:hidden}
.ds-afb img{position:absolute;left:10px;top:10px;width:calc(100% - 20px);height:calc(100% - 20px);max-width:none;max-height:none;object-fit:contain;mix-blend-mode:normal}
.ds-afb .ds-geen{font-size:11px;color:var(--mut);text-align:center;line-height:1.4}
.ds-kaartin{padding:0 11px 11px;display:flex;flex-direction:column;flex:1;gap:5px}
.ds-merk{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--mut);font-weight:800}
.ds-naam{font-size:13px;line-height:1.35;font-weight:700;margin:0;display:-webkit-box;-webkit-line-clamp:3;
 -webkit-box-orient:vertical;overflow:hidden}
.ds-naam a,.ds-naam a:visited{color:var(--ink);text-decoration:none}
.ds-prijsrij{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;margin-top:auto;padding-top:4px}
.ds-prijs{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:19px;font-weight:800;
 letter-spacing:-.02em;color:var(--ink)}
.ds-van{font-size:12.5px;color:var(--mut);text-decoration:line-through}
.ds-korting{font-size:11px;font-weight:800;color:#fff;background:var(--rood);border-radius:6px;padding:2px 5px}
.ds-winkelrij{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--mut);font-weight:600;min-height:17px}
.ds-amz{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px;padding:11px 13px;border:1px solid var(--lijn);border-radius:10px;background:var(--vlak)}
.ds-amz b{display:block;font-size:13px;color:var(--ink)}
.ds-amz small{display:block;font-size:11.5px;color:var(--mut);margin-top:2px;line-height:1.35}
.ds-amz a{flex:0 0 auto;font-size:13px;font-weight:700;color:var(--ink);border:1px solid var(--lijn);border-radius:8px;padding:7px 12px;text-decoration:none;background:#fff}
.ds-amz a:hover{border-color:var(--ink)}
.ds-amzlink{display:inline-block;font-size:11.5px;font-weight:700;color:var(--mut);text-decoration:none;margin:2px 0 4px}
.ds-amzlink:hover{color:var(--ink)}
.ds-amzlink small{font-weight:600;opacity:.8}
.ds-amzlink.lager{color:#0A7A3D}
.ds-amz.lager{border-color:#0A7A3D}
.ds-amz.lager b{color:#0A7A3D}
.ds-winkelrij b{color:var(--ink);font-weight:800}
.ds-badges{position:absolute;top:8px;left:8px;display:flex;flex-direction:column;gap:4px;align-items:flex-start;z-index:2}
.ds-badge{font-size:10px;font-weight:800;border-radius:6px;padding:3px 6px;line-height:1.2;letter-spacing:.01em}
.ds-badge.laag{background:var(--gr);color:#fff}
.ds-badge.multi{background:var(--pa);color:#fff}
.ds-badge.ref{background:#fff;color:var(--mut);border:1px solid var(--rd)}
.ds-vink{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:8px;border:1.5px solid var(--rd);
 background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2;padding:0}
.ds-vink svg{width:15px;height:15px;color:transparent}
.ds-vink[aria-pressed="true"]{background:var(--pa);border-color:var(--pa)}
.ds-vink[aria-pressed="true"] svg{color:#fff}
.ds-kaartknop{display:flex;gap:6px;margin-top:6px}
.ds-kaartknop a,.ds-kaartknop a:visited{flex:1;display:flex;align-items:center;justify-content:center;min-height:38px;
 background:var(--gr);color:#fff !important;border-radius:9px;font-size:13px;font-weight:800;text-decoration:none !important}
.ds-kaartknop a:hover{background:#0fa876}
.ds-kaartknop button{width:38px;min-height:38px;border:1.5px solid var(--rd);background:#fff;border-radius:9px;
 cursor:pointer;color:var(--mut);display:flex;align-items:center;justify-content:center;padding:0}
.ds-kaartknop button:hover{border-color:var(--pa);color:var(--pa)}
.ds-kaartknop button svg{width:17px;height:17px}

/* ---------------------------------------------------------------- laden / leeg */
.ds-laden{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:620px){.ds-laden{grid-template-columns:repeat(3,1fr);gap:12px}}
@media(min-width:900px){.ds-laden{grid-template-columns:repeat(4,1fr)}}
.ds-skel{border:1px solid var(--rd);border-radius:14px;overflow:hidden;background:#fff}
.ds-skel i{display:block;aspect-ratio:1/1;background:linear-gradient(90deg,#f4f1fa,#faf9fd,#f4f1fa);
 background-size:200% 100%;animation:ds-golf 1.2s linear infinite}
.ds-skel u{display:block;height:11px;margin:10px 11px;border-radius:5px;background:#f0ecf8}
.ds-skel u:last-child{width:55%;margin-bottom:14px}
@keyframes ds-golf{0%{background-position:100% 0}100%{background-position:-100% 0}}
.ds-leeg{text-align:center;padding:38px 16px;border:1px dashed var(--rd);border-radius:14px;background:var(--pa2)}
.ds-leeg b{display:block;font-size:16px;font-weight:800;margin-bottom:5px}
.ds-leeg p{margin:0 0 12px;font-size:14px;color:var(--mut)}
.ds-leeg button{height:40px;padding:0 16px;border-radius:10px;border:0;background:var(--pa);color:#fff;
 font-family:inherit;font-size:14px;font-weight:800;cursor:pointer}

/* ---------------------------------------------------------------- meer laden */
.ds-meer{display:flex;justify-content:center;margin:18px 0 0}
.ds-meer button{height:46px;padding:0 24px;border-radius:12px;border:1.5px solid var(--rd);background:#fff;
 font-family:inherit;font-size:14.5px;font-weight:800;color:var(--ink);cursor:pointer}
.ds-meer button:hover{border-color:var(--pa);background:var(--pa2)}
.ds-meer button:disabled{opacity:.5;cursor:default}

/* ---------------------------------------------------------------- zwevende balk */
.ds-dok{position:fixed;left:0;right:0;bottom:0;z-index:60;padding:9px 12px;background:rgba(255,255,255,.97);
 border-top:1px solid var(--rd);box-shadow:0 -4px 18px rgba(13,27,42,.1);backdrop-filter:blur(6px)}
.ds-dok-in{max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:10px}
.ds-dok-t{font-size:13px;font-weight:700;color:var(--mut);flex:1;min-width:0}
.ds-dok-t b{color:var(--ink);font-weight:800}
.ds-dok button{height:42px;padding:0 16px;border-radius:10px;border:0;font-family:inherit;font-size:14px;
 font-weight:800;cursor:pointer;white-space:nowrap}
.ds-dok .ds-dok-vgl{background:var(--pa);color:#fff}
.ds-dok .ds-dok-leeg{background:#fff;border:1.5px solid var(--rd);color:var(--mut);padding:0 12px}
/* 14 okt: de zwevende knop Zoekhulp lag op mobiel over Wissen en Vergelijk. Staat de balk er, dan schuift hij erboven. */
body:has(#ds-dok:not([hidden])) .dpvai-fab{bottom:calc(var(--dsdok,62px) + 12px)}

/* ---------------------------------------------------------------- overlay */
.ds-ovl{position:fixed;inset:0;z-index:80;background:rgba(13,27,42,.55);display:flex;align-items:flex-end;
 justify-content:center;padding:0}
@media(min-width:760px){.ds-ovl{align-items:center;padding:22px}}
.ds-ovl-vak{background:#fff;width:100%;max-width:980px;max-height:92vh;border-radius:18px 18px 0 0;
 display:flex;flex-direction:column;overflow:hidden}
@media(min-width:760px){.ds-ovl-vak{border-radius:18px;max-height:88vh}}
.ds-ovl-kop{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--rd);flex:0 0 auto}
.ds-ovl-kop h3{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:17px;font-weight:800;
 margin:0;letter-spacing:-.02em;flex:1;min-width:0}
.ds-ovl-sluit{width:34px;height:34px;border-radius:9px;border:1.5px solid var(--rd);background:#fff;cursor:pointer;
 color:var(--mut);font-size:20px;line-height:1;flex:0 0 auto;padding:0}
.ds-ovl-sluit:hover{background:var(--pa2)}
.ds-ovl-body{overflow:auto;padding:16px;-webkit-overflow-scrolling:touch}

/* vergelijktabel. de lege cellen hebben &nbsp; nodig: het thema verbergt
   lege divs met div:empty, en dan schuiven de kolommen een plek op. */
.ds-vt{display:block;overflow-x:auto}
.ds-vt-h,.ds-vt-r{display:grid;gap:0;min-width:520px}
.ds-vt-h{position:sticky;top:0;background:#fff;z-index:2;border-bottom:2px solid var(--rd)}
.ds-vt-h>div{padding:9px 8px;font-size:12px;font-weight:800;line-height:1.3}
.ds-vt-h>div:first-child{color:var(--mut);font-size:11px;text-transform:uppercase;letter-spacing:.07em}
.ds-vt-r{border-bottom:1px solid #f0ecf8}
.ds-vt-r>div{padding:9px 8px;font-size:13px;line-height:1.4}
.ds-vt-r>div:first-child{font-weight:700;color:var(--mut);font-size:12px}
.ds-vt-r:nth-child(even){background:#fbfafe}
.ds-vt-best{color:var(--gr);font-weight:800}
.ds-vt-afb{width:100%;max-width:74px;aspect-ratio:1/1;object-fit:contain;display:block;margin:0 auto 5px}
.ds-vt-knop{display:grid;gap:0;min-width:520px;padding-top:10px}
.ds-vt-knop>div{padding:0 8px}
.ds-vt-knop a,.ds-vt-knop a:visited{display:flex;align-items:center;justify-content:center;min-height:42px;
 background:var(--gr);color:#fff !important;border-radius:10px;font-size:13.5px;font-weight:800;text-decoration:none !important}

/* ---------------------------------------------------------------- productvak */
.ds-pv{display:grid;gap:16px}
@media(min-width:680px){.ds-pv{grid-template-columns:230px 1fr}}
.ds-pv-afb{background:#fff;border:1px solid var(--rd);border-radius:12px;aspect-ratio:1/1;display:flex;
 align-items:center;justify-content:center;padding:14px}
.ds-pv-afb img{max-width:100%;max-height:100%;object-fit:contain}
.ds-pv-w{border:1px solid var(--rd);border-radius:12px;overflow:hidden}
.ds-pv-w-r{display:flex;align-items:center;gap:10px;padding:11px 12px;border-bottom:1px solid #f0ecf8}
.ds-pv-w-r:last-child{border-bottom:0}
.ds-pv-w-r.beste{background:#f0fdf7}
.ds-pv-w-n{flex:1;min-width:0;font-size:13.5px;font-weight:800}
.ds-pv-w-n small{display:block;font-weight:600;color:var(--mut);font-size:11.5px;margin-top:1px}
.ds-pv-w-p{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-size:17px;font-weight:800;
 letter-spacing:-.02em;white-space:nowrap}
.ds-pv-w-k,.ds-pv-w-k:visited{display:flex;align-items:center;justify-content:center;min-height:36px;padding:0 13px;
 background:var(--gr);color:#fff !important;border-radius:9px;font-size:13px;font-weight:800;text-decoration:none !important;
 white-space:nowrap}
.ds-oordeel{margin-top:14px;background:var(--pa2);border:1px solid var(--rd);border-radius:12px;padding:13px}
.ds-oordeel b{display:block;font-size:13.5px;font-weight:800;margin-bottom:5px}
.ds-oordeel p{margin:0 0 7px;font-size:13.5px;line-height:1.55;color:var(--ink)}
.ds-oordeel p:last-child{margin:0}
.ds-oordeel .ja{color:var(--gr);font-weight:800}
.ds-oordeel .nee{color:var(--rood);font-weight:800}
.ds-graf{margin-top:11px;background:#fff;border:1px solid var(--rd);border-radius:10px;padding:9px 10px 5px}
.ds-graf svg{width:100%;height:84px;display:block;overflow:visible}
.ds-graf-vt{display:flex;justify-content:space-between;font-size:10.5px;color:var(--mut);font-weight:700;margin-top:3px}

/* ---------------------------------------------------------------- kleine letters */
.ds-fijn{margin-top:26px;padding-top:16px;border-top:1px solid var(--rd);font-size:12px;line-height:1.65;color:var(--mut)}
.ds-fijn p{margin:0 0 7px}
.ds-fijn p:last-child{margin:0}

/* ---------------------------------------------------------------- zijbalk met filters (7 okt) */
.ds{max-width:1240px}
.ds-zij h4{font-size:11.5px;letter-spacing:.07em;text-transform:uppercase;color:#4A5A70;font-weight:800;margin:0 0 6px}
.ds-zg{margin:0 0 20px}
.ds-zij .ds-chips{display:flex;flex-direction:column;gap:0;overflow:visible;margin:0;padding:0;border:0}
html:not(#x):not(#y) .ds-zij .ds-chip{width:100%;height:auto;min-height:36px;padding:6px 0;border:0 !important;border-radius:6px;background:none !important;
 color:#0D1B2A !important;font-size:14px;font-weight:500;justify-content:flex-start;gap:10px;white-space:normal;text-align:left;line-height:1.25}
.ds-zij .ds-chip::before{content:"";flex:0 0 auto;width:18px;height:18px;border:1.5px solid #CBD3DF;border-radius:5px;background:#fff}
.ds-zij .ds-chip:hover::before{border-color:#0D1B2A}
.ds-zij .ds-chip[aria-pressed="true"]::before{border-color:#0D1B2A;background:#0D1B2A url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23fff' stroke-width='3.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M5 12.5l4.5 4.5L19 7.5'/%3E%3C/svg%3E") center/13px no-repeat}
.ds-zij .ds-chip b{font-weight:500}
.ds-zij .ds-chip[aria-pressed="true"] b{font-weight:700}
html:not(#x):not(#y) .ds-zij .ds-chip span.n{margin-left:auto;color:#4A5A70 !important;font-size:12.5px;font-weight:500}
.ds-zij .ds-chips:not(.open) .ds-chip:nth-child(n+8){display:none}
.ds-zij-meer{border:0;background:none;padding:6px 0;font-family:inherit;font-size:13px;font-weight:700;color:#2456D6;cursor:pointer}
.ds-zij-meer:hover{text-decoration:underline}
.ds-zij .ds-prijsvak input{flex:1;width:auto;min-width:0;height:42px}
.ds-zij-kop,.ds-zij-voet,.ds-fknop{display:none}
.ds-fknop{align-items:center;gap:8px;height:42px;padding:0 15px;border-radius:10px;border:1.5px solid #0D1B2A;background:#0D1B2A;color:#fff;
 font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}
.ds-fknop svg{width:16px;height:16px}
.ds-fknop em{font-style:normal;background:#3FAE7A;color:#0D1B2A;border-radius:99px;font-size:11.5px;font-weight:800;padding:1px 7px}
@media(min-width:900px){
 .ds-twee{display:grid;grid-template-columns:228px minmax(0,1fr);gap:28px;align-items:start;margin-top:8px}
 .ds-zij{position:sticky;top:12px;max-height:calc(100vh - 24px);overflow-y:auto;padding-right:6px;scrollbar-width:thin}
 .ds-hoofd .ds-balk{margin-top:0;flex-wrap:nowrap}
 html:not(#x):not(#y) .ds-hoofd .ds-rechts{width:auto !important;flex:0 0 auto;margin-left:auto}
 html:not(#x):not(#y) .ds-hoofd .ds-rechts .ds-sel{flex:0 0 auto !important;width:auto !important;min-width:200px !important}
 .ds-hoofd .ds-telling{flex:1 1 auto;min-width:0}
 .ds-hoofd .ds-raster,.ds-hoofd .ds-laden{grid-template-columns:repeat(3,1fr)}
}
@media(min-width:1180px){.ds-twee{grid-template-columns:240px minmax(0,1fr);gap:34px}}
@media(max-width:899px){
 .ds-fknop{display:inline-flex}
 .ds-hoofd .ds-balk{flex-wrap:wrap;gap:8px}
 .ds-hoofd .ds-telling{order:3;flex:0 0 100%}
 html:not(#x):not(#y) .ds-hoofd .ds-rechts{width:auto !important;flex:1 1 0;min-width:0;margin-left:0}
 html:not(#x):not(#y) .ds-hoofd .ds-rechts .ds-sel{width:100% !important;height:42px}
 .ds-zij{display:none;position:fixed;inset:0;z-index:100000;background:#fff;flex-direction:column}
 .ds-zij.open{display:flex}
 .ds-zij-kop{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #E3E8F0;flex:0 0 auto}
 .ds-zij-kop b{font-family:'Bricolage Grotesque','Instrument Sans',sans-serif;font-size:20px;font-weight:800;letter-spacing:-.03em}
 .ds-zij-kop button{width:40px;height:40px;border:1px solid #CBD3DF;border-radius:10px;background:#fff;font-size:22px;line-height:1;color:#0D1B2A;cursor:pointer;padding:0}
 .ds-zij-in{flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px 16px 8px}
 html:not(#x):not(#y) .ds-zij .ds-chip{min-height:44px;font-size:15px}
 .ds-zij .ds-chip::before{width:20px;height:20px}
 .ds-zij-voet{display:flex;gap:8px;padding:10px 16px calc(10px + env(safe-area-inset-bottom));border-top:1px solid #E3E8F0;flex:0 0 auto;background:#fff}
 .ds-zij-voet button{height:48px;border-radius:10px;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer}
 .ds-zij-wis{flex:0 0 auto;padding:0 16px;border:1.5px solid #CBD3DF;background:#fff;color:#0D1B2A}
 .ds-zij-toon{flex:1;border:1.5px solid #0D1B2A;background:#0D1B2A;color:#fff}
}

/* ---------------------------------------------------------------- toetsenbord */
.ds :focus-visible{outline:2px solid var(--pa);outline-offset:2px}
.ds-vz{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ---------------------------------------------------------------- deals (12 okt) */
.ds-dealrij{display:flex;align-items:center;gap:10px;margin:0 0 10px;flex-wrap:wrap}
html:not(#x):not(#y) .ds .ds-dealchip{height:42px;padding:0 16px;border:1.5px solid #0D1B2A;background:#fff;color:#0D1B2A;border-radius:999px}
html:not(#x):not(#y) .ds .ds-dealchip b{font-weight:800}
html:not(#x):not(#y) .ds .ds-dealchip .n{color:#4A5A70;font-weight:700;font-size:12.5px}
html:not(#x):not(#y) .ds .ds-dealchip[aria-pressed="true"]{background:#0D1B2A;color:#fff}
html:not(#x):not(#y) .ds .ds-dealchip[aria-pressed="true"] .n{background:#FFD84D;color:#0D1B2A;border-radius:99px;padding:2px 8px}
.ds-dealchip .ds-dot{width:8px;height:8px;border-radius:50%;background:#10b981;flex:0 0 auto}
.ds-dealtip{font-size:12.5px;color:#4A5A70;font-weight:600}
.ds-dealuitleg{border:1px solid #D5DCE6;border-radius:12px;background:#fff;box-shadow:0 10px 28px rgba(13,27,42,.06);padding:12px 14px;margin:0 0 12px;font-size:13.5px;line-height:1.55;color:#33445A}
.ds-dealuitleg b{color:#0D1B2A}
.ds-dealuitleg summary{cursor:pointer;font-weight:800;color:#0D1B2A;list-style:none}
.ds-dealuitleg summary::-webkit-details-marker{display:none}
.ds-dealuitleg summary::after{content:" +";color:#4A5A70}
.ds-dealuitleg[open] summary::after{content:" \2212"}
.ds-dealuitleg p{margin:6px 0 0}
.ds-dealuitleg:not([open]){padding:10px 14px}
.ds-badge.daal{background:#0D1B2A;color:#FFD84D}
.ds-winkelrij .ds-was{white-space:nowrap}
@media (max-width:640px){.ds-dealtip{display:none}}

/* ---------------------------------------------------------------- uitleg met Prijsje (12 okt) */
.ds-tip{display:flex;align-items:center;gap:12px;background:#F4F6FA;border:1px solid #D5DCE6;border-radius:14px;padding:10px 12px 10px 10px;margin:0 0 12px;font-size:14px;line-height:1.45;color:#26384F}
.ds-tip .pj{flex:none;width:56px;line-height:0}.ds-tip .pj svg,.ds-leeg .pj svg{display:block;width:100%;height:auto}
.ds-tip p{flex:1;margin:0}.ds-tip b{color:#0D1B2A;margin-right:4px}
html:not(#x):not(#y) .ds .ds-tip-ok{flex:none;height:36px;padding:0 13px;border-radius:10px;border:1.5px solid #0D1B2A;background:#fff;color:#0D1B2A;font:inherit;font-weight:800;font-size:13px;cursor:pointer}
html:not(#x):not(#y) .ds .ds-tip-x{flex:none;width:30px;height:30px;border:0;background:none;color:#8A97A8;font-size:20px;line-height:1;cursor:pointer;border-radius:8px}
.ds-leeg .pj{display:block;width:92px;margin:0 auto 6px}
@media (max-width:640px){.ds-tip{font-size:13.5px;flex-wrap:wrap}.ds-tip .pj{width:46px}.ds-tip p{flex:1 1 60%}html:not(#x):not(#y) .ds .ds-tip-ok{margin-left:58px}}
</style>

{%- if section.settings.bf_knop -%}{%- render 'dpv-bf-knop', api: section.settings.bf_api, tot: section.settings.bf_tot -%}{%- endif -%}
<section class="ds" id="ds" data-api="{{ section.settings.api }}" data-amazon="{{ section.settings.amazon_tag }}" data-bf="{% if section.settings.bf_knop %}1{% endif %}" data-deals="{% if section.settings.deals_aan %}{{ section.settings.deals_url }}{% endif %}">

  <div class="ds-kop">
    {%- if section.settings.label != blank -%}
      <p class="ds-eyebrow">{{ section.settings.label }}</p>
    {%- endif -%}
    <h1>{{ section.settings.kop }}</h1>
    {%- if section.settings.sub != blank -%}
      <p class="ds-sub">{{ section.settings.sub }}</p>
    {%- endif -%}
  </div>

  <div class="ds-zoekrij">
    <div class="ds-zoek">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
      <label class="ds-vz" for="ds-q">Zoek een product</label>
      <input id="ds-q" type="search" inputmode="search" autocomplete="off"
             placeholder="{{ section.settings.zoek_plaatshouder }}">
      <button class="ds-wis" type="button" id="ds-wis" aria-label="Zoekveld leegmaken" hidden>&times;</button>
    </div>
  </div>

  {%- if section.settings.deals_aan -%}
  <div class="ds-dealrij">
    <button class="ds-chip ds-dealchip" type="button" id="ds-deals" aria-pressed="false">
      <span class="ds-dot" aria-hidden="true"></span><b>{{ section.settings.deals_label | default: "Black Friday-deals" }}</b> <span class="n" id="ds-deals-n" hidden></span>
    </button>
    {%- if section.settings.deals_tip != blank -%}<span class="ds-dealtip">{{ section.settings.deals_tip }}</span>{%- endif -%}
  </div>
  {%- endif -%}

  <nav class="ds-chips" id="ds-cats" aria-label="Categorieen">
    <button class="ds-chip" type="button" data-cat="" aria-pressed="true"><b>Alles</b></button>
  </nav>

  {%- comment -%}
    7 okt: filters in een zijbalk (desktop) en achter een filterknop (mobiel).
    De knoppen zelf zijn dezelfde als voorheen, met dezelfde id's en data-attributen,
    zodat het script eronder niets anders hoeft te doen. Alleen de plek en de
    vorm (een aanvinklijst) zijn anders.
  {%- endcomment -%}
  <div class="ds-twee">
    <aside class="ds-zij" id="ds-zij" aria-label="Filters">
      <div class="ds-zij-kop"><b>Filters</b><button type="button" id="ds-zij-sluit" aria-label="Filters sluiten">&times;</button></div>
      <div class="ds-zij-in">
        <div class="ds-zg">
          <h4>Aanbieding</h4>
  <div class="ds-chips ds-chiprij2" id="ds-filters" aria-label="Filters">
    <button class="ds-chip groen" type="button" data-f="echt" aria-pressed="false">
      <b>Echt lager</b> <span class="n" data-n="echt"></span>
    </button>
    <button class="ds-chip rood" type="button" data-f="deal" aria-pressed="false">
      <b>Afgeprijsd</b> <span class="n" data-n="deal"></span>
    </button>
    <button class="ds-chip" type="button" data-f="multi" aria-pressed="false">
      <b>Bij meer winkels</b> <span class="n" data-n="multi"></span>
    </button>
    <button class="ds-chip" type="button" data-f="voorraad" aria-pressed="false"><b>Op voorraad</b></button>
    <button class="ds-chip" type="button" data-f="refurbished" aria-pressed="false">
      <b>Refurbished</b> <span class="n" data-n="refurbished"></span>
    </button>
  </div>
        </div>
        <div class="ds-zg" hidden>
          <h4>Soort</h4>
          <div class="ds-chips" id="ds-types" aria-label="Soorten" hidden></div>
          <button type="button" class="ds-zij-meer" data-meer="Alle soorten" data-minder="Minder soorten" hidden>Alle soorten</button>
        </div>
        <div class="ds-zg" hidden>
          <h4>Merk</h4>
          <div class="ds-chips" id="ds-merken" aria-label="Merken" hidden></div>
          <button type="button" class="ds-zij-meer" data-meer="Alle merken" data-minder="Minder merken" hidden>Alle merken</button>
        </div>
        <div class="ds-zg">
          <h4>Prijs</h4>
      <div class="ds-prijsvak">
        <label class="ds-vz" for="ds-min">Minimumprijs</label>
        <input id="ds-min" type="number" min="0" step="1" placeholder="van">
        <span>&ndash;</span>
        <label class="ds-vz" for="ds-max">Maximumprijs</label>
        <input id="ds-max" type="number" min="0" step="1" placeholder="tot">
      </div>
        </div>
      </div>
      <div class="ds-zij-voet">
        <button type="button" class="ds-zij-wis" id="ds-zij-wis">Wissen</button>
        <button type="button" class="ds-zij-toon" id="ds-zij-toon">Toon resultaten</button>
      </div>
    </aside>

    <div class="ds-hoofd">
      {%- if section.settings.deals_aan and section.settings.deals_uitleg != blank -%}
      <details class="ds-dealuitleg" id="ds-dealuitleg" hidden><summary>Hoe meten wij dit?</summary>{{ section.settings.deals_uitleg }}</details>
      {%- endif -%}
      <div class="ds-balk">
        <button type="button" class="ds-fknop" id="ds-fknop" aria-controls="ds-zij" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
          Filters <em id="ds-fknop-n" hidden></em>
        </button>
        <span class="ds-telling" id="ds-telling" aria-live="polite">&nbsp;</span>
        <div class="ds-rechts">
      <label class="ds-vz" for="ds-sort">Sorteren</label>
      <select class="ds-sel" id="ds-sort">
        <option value="populair">Populair</option>
        <option value="prijs">Prijs laag &rarr; hoog</option>
        <option value="prijs-af">Prijs hoog &rarr; laag</option>
        <option value="korting">Hoogste korting</option>
        <option value="verschil">Grootste prijsverschil</option>
        <option value="winkels">Meeste winkels</option>
        <option value="naam">Naam</option>
      </select>
        </div>
      </div>

      <div class="ds-laden" id="ds-laden">
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
        <div class="ds-skel"><i></i><u></u><u></u></div>
      </div>

