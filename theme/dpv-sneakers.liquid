<script>
(function () {
  var r = document.getElementById('snk'); if (!r) return;
  // Zodra er sneakers in de vergelijker staan, vervangen we de voorbeeldkaarten.
  fetch(r.dataset.shop + '/api/shop/lijst?cat=sneakers&n=10&sort=winkels').then(function (x) { return x.json(); }).then(function (j) {
    var it = (j && j.items) || []; if (it.length < 5) return;
    var esc = function (s) { return String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var eur = function (n) { return '€' + Number(n).toLocaleString('nl-NL', { minimumFractionDigits: n % 1 ? 2 : 0 }); };
    r.querySelector('[data-f=populair]').innerHTML = it.map(function (p) {
      return '<a class="kaart" href="/pages/vergelijken?cat=sneakers&q=' + encodeURIComponent(p.n) + '"><div class="foto">' + (p.im ? '<img src="' + esc(p.im) + '" alt="" loading="lazy">' : '') + '</div><span class="merk">' + esc(p.b) + '</span><span class="model">' + esc(p.n) + '</span><div class="prijs"><small>vanaf</small><b>' + eur(p.p) + '</b></div><span class="winkels">' + ((p.o || []).length || 1) + ' winkels</span></a>';
    }).join('');
    var d = r.querySelector('[data-f=demo]'); if (d) d.hidden = true;
  }).catch(function () {});
})();
</script>
