<script>
(function () {
  var r = document.getElementById('snk'); if (!r) return;
  fetch(r.dataset.shop + '/api/shop/lijst?cat=sneakers&n=9&sort=winkels').then(function (x) { return x.json(); }).then(function (j) {
    var it = (j && j.items) || []; if (it.length < 5) return;
    var esc = function (s) { return String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var eur = function (n) { return '€' + Number(n).toLocaleString('nl-NL', { minimumFractionDigits: n % 1 ? 2 : 0 }); };
    var kaart = function (p, top) {
      var n = (p.o || []).length || 1, url = '/pages/vergelijken?cat=sneakers&q=' + encodeURIComponent(p.n);
      var foto = '<div class="ft">' + (p.im ? '<img src="' + esc(p.im) + '" alt="" loading="lazy" style="max-width:88%;max-height:88%;object-fit:contain">' : '') + '</div>';
      return top
        ? '<a class="kaart top" href="' + url + '">' + foto + '<span class="m">' + esc(p.b) + '</span><h3>' + esc(p.n) + '</h3><p class="vanaf">vanaf ' + eur(p.p) + ' bij ' + n + ' winkels</p><span class="knop">Vergelijk prijzen →</span></a>'
        : '<a class="kaart" href="' + url + '">' + foto + '<span class="m">' + esc(p.b) + '</span><h3>' + esc(p.n) + '</h3><div class="p"><b>' + eur(p.p) + '</b><span class="w2">' + n + ' winkels</span></div></a>';
    };
    r.querySelector('[data-f=populair]').innerHTML = it.map(function (p, i) { return kaart(p, i === 0); }).join('');
  }).catch(function () {});
})();
</script>
