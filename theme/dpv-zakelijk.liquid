  var LINK = {
    'Ziggo Zakelijk':    {{ section.settings.link_ziggo | json }},
    'KPN Zakelijk':      {{ section.settings.link_kpn | json }},
    'Vodafone Zakelijk': {{ section.settings.link_vodafone | json }}
  };

  var EIND = { internet: '/api/feed/internet', simonly: '/api/feed/simonly', toestel: '/api/feed/telefoon' };
  var ALLES = [], TOON = TAB === 'toestel' ? 12 : 15, FILTER = '', MERKF = '', MODELF = '', DATAF = 0, MNDF = 0, TEAM = 1, TIERF = '';
  try { TEAM = Math.max(1, Math.min(50, parseInt(localStorage.getItem('zkvTeam'), 10) || 1)); } catch (e) {}

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function euro(v) {
    if (!v && v !== 0) return '';
    var r = Math.round(v * 100) / 100;
    return '€' + (r % 1 === 0 ? r.toFixed(0) : r.toFixed(2).replace('.', ','));
  }
  function gbTekst(g) { return g >= 999 ? 'Onbeperkt' : g + ' GB'; }
  function isZakelijk(d) {
    if (d.isZakelijk === true) return true;
    var h = ((d.merchantName || '') + ' ' + (d.name || '')).toLowerCase();
    return h.indexOf('zakelijk') > -1 || h.indexOf('business') > -1 || h.indexOf('b2b') > -1;
  }
  var GEEN_TELEFOON = /tablet|\btab\b|\bpad\b|ipad|watch|smartwatch|hotspot|mifi|wi-?fi|router|modem|data ?sim|\bbook\b|laptop|dongle/;

  var MERKEN = [['Apple', /iphone|apple/], ['Samsung', /samsung|galaxy/], ['Google', /pixel/], ['OnePlus', /oneplus|one plus/],
    ['Xiaomi', /xiaomi|redmi|poco/], ['Motorola', /motorola|moto /], ['Nokia', /nokia/], ['Fairphone', /fairphone/], ['Honor', /honor/], ['OPPO', /oppo/]];
  function merkVan(naam) {
    var n = (naam || '').toLowerCase();
    for (var i = 0; i < MERKEN.length; i++) if (MERKEN[i][1].test(n)) return MERKEN[i][0];
    return '';
  }
  function heeftToestel(d) {
    var n = (d.name || '').toLowerCase();
    if (/sim only|sim-only/.test(n) || GEEN_TELEFOON.test(n)) return false;
    if (!merkVan(n)) return false;
    return parseFloat(d.deviceTotalPrice) > 0 || parseFloat(d.deviceMonthlyCost) > 0 || /iphone|galaxy|pixel|xiaomi|redmi|oppo|oneplus|motorola|nokia|fairphone|honor/.test(n);
  }
  // Model zonder bundel en kleur, met opslag: "iPhone 17 256 GB".
  function modelVan(d) {
    var n = String(d.model || d.name || '');
    n = n.replace(/\b(zwart|wit|blauw|groen|grijs|zilver|goud|paars|roze|rood|oranje|titanium|black|white|blue|green|grey|gray|silver|gold|purple|pink|red)\b/ig, '');
    var op = /(\d{1,4})\s?(GB|TB)\b/i.exec(n) || /(\d{1,4})\s?(GB|TB)\b/i.exec(String(d.name || ''));
    var kern = n.replace(/\b\d{2,4}\s?(GB|TB)\b.*$/i, '').replace(/\s{2,}/g, ' ').trim();
    return { kern: kern, opslag: op ? op[1] + ' ' + op[2].toUpperCase() : (d.storage || '') };
  }

  // Odido Zakelijk levert elke toesteldeal in drie varianten (termijnen, deels
  // vooruit, toestel ineens). Bij "toestel ineens" zet de feed de aanbetaling op
  // 0 terwijl je de hele toestelprijs vooraf betaalt. De toestelbedragen in de
  // feed zijn inclusief btw, de maandprijzen exclusief; wij tonen alles excl. btw.
  function eenmaligExBtw(d, prijs) {
    var btw = (parseFloat(d.deviceTotalPrice) > 0 && parseFloat(d.deviceTotalExBtw) > 0) ? parseFloat(d.deviceTotalPrice) / parseFloat(d.deviceTotalExBtw) : 1.21;
    if (!(btw > 1 && btw < 1.3)) btw = 1.21;
    var vooruit = parseFloat(d.deviceDownPayment) || parseFloat(d.initialCost) || 0;
    var toestel = parseFloat(d.deviceTotalPrice) || 0;
    var perMaand = parseFloat(d.deviceMonthlyCost) || 0;
    var basis = parseFloat(d.baseMonthlyCost);
    if (ZAK && toestel > 0 && basis === 0 && prijs < perMaand) vooruit = toestel;
    if (!ZAK) return vooruit > 0 ? Math.round(vooruit * 100) / 100 : 0;
    return vooruit > 0 ? Math.round(vooruit / btw * 100) / 100 : 0;
  }

  function planVan(naam, prov) {
    var p = String(naam || '');
    var merk = String(prov || '').replace(/\s*Zakelijk$/i, '');
    p = p.replace(new RegExp('^' + merk + '\\s+', 'i'), '').replace(/sim[ -]?only/ig, '').replace(/@work basic/i, '')
      .replace(/\b\d+(,\d+)?\s*GB\b.*$/i, '').replace(/\s{2,}/g, ' ').trim();
    return p || 'Zakelijk';
  }

  function uitFeed(d) {
    var naam = (d.name || '').trim();
    var mnd = d.contractMonths || 24;
    var prijs = parseFloat(d.price) || 0;
    var los = d.source === 'kpn-zakelijk';
    if (los && ZAK && parseFloat(d.priceExclBtw) > 0) prijs = parseFloat(d.priceExclBtw);
    var eenmalig = TAB === 'toestel' && !los ? eenmaligExBtw(d, prijs) : 0;
    var totaal = eenmalig + prijs * mnd;
    var mv = modelVan(d);
    return {
      naam: naam, prov: (d.merchantName || '').trim(), plan: planVan(naam, d.merchantName), prijs: prijs, eenmalig: eenmalig,
      totaal: totaal, gemiddeld: totaal / mnd, maanden: mnd, m: d.contractMonths || (TAB === 'toestel' ? 24 : 0),
      gb: d.dataGB || 0, mbit: d.speedMbit || 0, min: d.minutesLabel || '', net: d.network || '',
      abo: parseFloat(d.baseMonthlyCost) || 0, tm: parseFloat(d.deviceMonthlyCost) || 0,
      img: d.image || '', merknaam: merkVan(naam), model: mv.kern, opslag: mv.opslag,
      merk: [], url: d.affiliateUrl, live: true, los: los
    };
  }
  function uitHand(h) {
    return {
      naam: h.naam, prov: h.prov, plan: planVan(h.naam, h.prov), prijs: h.prijs, eenmalig: 0, totaal: 0, gemiddeld: h.prijs,
      maanden: h.m || 24, m: h.m || 0, gb: h.gb || 0, mbit: h.mbit || 0, min: h.min || h.detail || '', net: h.net || '',
      merk: h.merk || [], notitie: h.notitie || '', aanvraag: !!h.aanvraag, url: LINK[h.prov] || '#', live: false
    };
  }

  var DOMEIN = { 'KPN Zakelijk': 'kpn.com', 'Odido Zakelijk': 'odido.nl', 'Vodafone Zakelijk': 'vodafone.nl', 'Ziggo Zakelijk': 'ziggo.nl' };
  function logo(prov) {
    var dom = DOMEIN[prov], p = String(prov || '').toLowerCase();
    if (!dom) dom = p.indexOf('kpn') > -1 ? 'kpn.com' : p.indexOf('odido') > -1 ? 'odido.nl' : p.indexOf('vodafone') > -1 ? 'vodafone.nl' : p.indexOf('ziggo') > -1 ? 'ziggo.nl' :
      p.indexOf('mobiel.nl') > -1 ? 'mobiel.nl' : p.indexOf('simyo') > -1 ? 'simyo.nl' : p.indexOf('hollandsnieuwe') > -1 ? 'hollandsnieuwe.nl' : p.indexOf('youfone') > -1 ? 'youfone.nl' :
      p.indexOf('simpel') > -1 ? 'simpel.nl' : p.indexOf('50plus') > -1 ? '50plusmobiel.nl' : p.indexOf('mediamarkt') > -1 ? 'mediamarkt.nl' : /^ben\b/.test(p) ? 'ben.nl' : '';
    if (!dom) return '<span class="zkv-logo zkv-logo-tekst">' + esc(String(prov || '?').charAt(0)) + '</span>';
    var g = 'https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&size=64&url=https://' + dom;
    var d = 'https://icons.duckduckgo.com/ip3/' + dom + '.ico';
    return '<img class="zkv-logo" src="' + g + '" alt="" loading="lazy" onerror="if(this.dataset.fb){this.style.visibility=\'hidden\'}else{this.dataset.fb=1;this.src=\'' + d + '\'}">';
  }
  function go(r, tekst) {
    return '<a class="zkv-go" href="' + esc(r.url) + '" target="_blank" rel="nofollow sponsored noopener">' + (tekst || 'Bekijk') + '</a>';
  }

  // ---------------------------------------------------------------- filters
  function chip(tekst, aan, klik, html) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'zkv-chip' + (aan ? ' aan' : '');
    b.innerHTML = (html || '') + '<span>' + esc(tekst) + '</span>';
    b.onclick = klik;
    return b;
  }
  function rij(label) {
    var r = document.createElement('div'); r.className = 'zkv-filterrij';
    if (label) { var l = document.createElement('span'); l.className = 'zkv-fl'; l.textContent = label; r.appendChild(l); }
    return r;
  }
  function tekenFilters() {
    var vak = document.getElementById('zkv-filters');
    if (!vak) return;
    vak.innerHTML = '';
    var prov = {}; ALLES.forEach(function (r) { prov[r.prov] = 1; });
    var r1 = rij('');
    [''].concat(Object.keys(prov).sort()).forEach(function (p) {
      r1.appendChild(chip(p || 'Alle aanbieders', FILTER === p, function () { FILTER = p; reset(); }, p ? logo(p).replace('zkv-logo', 'zkv-logo zkv-logo-chip') : ''));
    });
    vak.appendChild(r1);

    if (TAB === 'simonly') {
      var r2 = rij('Data');
      [[0, 'Alles'], [5, '5 GB+'], [10, '10 GB+'], [20, '20 GB+'], [999, 'Onbeperkt']].forEach(function (x) {
        r2.appendChild(chip(x[1], DATAF === x[0], function () { DATAF = x[0]; reset(); }));
      });
      var mnden = {}; ALLES.forEach(function (r) { if (r.m) mnden[r.m] = 1; });
      var lijst = Object.keys(mnden).map(Number).sort(function (a, b) { return a - b; });
      if (lijst.length > 1) {
        var l = document.createElement('span'); l.className = 'zkv-fl'; l.style.marginLeft = '10px'; l.textContent = 'Looptijd'; r2.appendChild(l);
        [0].concat(lijst).forEach(function (m) {
          r2.appendChild(chip(m ? (m === 1 ? '1 maand' : m === 12 ? '1 jaar' : m === 24 ? '2 jaar' : m === 36 ? '3 jaar' : m + ' mnd') : 'Alle', MNDF === m, function () { MNDF = m; reset(); }));
        });
      }
      vak.appendChild(r2);
    }

    if (TAB === 'toestel') {
      var aanw = {}; ALLES.forEach(function (r) { aanw[tierVan(r)] = 1; });
      var r5 = rij('Bundel');
      [['', 'Alle bundels']].concat(TIERS.filter(function (k) { return aanw[k[0]]; })).forEach(function (k) { r5.appendChild(chip(k[1], TIERF === k[0], function () { TIERF = k[0]; reset(); })); });
      vak.appendChild(r5);
      var tm = {}; ALLES.forEach(function (r) { if (r.m) tm[r.m] = 1; });
      var tl = Object.keys(tm).map(Number).sort(function (a, b) { return a - b; });
      if (tl.length > 1) {
        var r4 = rij('Looptijd');
        [0].concat(tl).forEach(function (m) { r4.appendChild(chip(m ? m + ' maanden' : 'Alle', MNDF === m, function () { MNDF = m; reset(); })); });
        vak.appendChild(r4);
      }
      var merken = {}; ALLES.forEach(function (r) { if (r.merknaam && (!FILTER || r.prov === FILTER)) merken[r.merknaam] = 1; });
      var m = Object.keys(merken).sort();
      if (m.length) {
        var r3 = rij('');
        [''].concat(m).forEach(function (x) { r3.appendChild(chip(x || 'Alle merken', MERKF === x, function () { MERKF = x; MODELF = ''; reset(); })); });
        vak.appendChild(r3);
      }
    }
  }
  function reset() { TOON = TAB === 'toestel' ? 12 : 15; teken(); }

  function opPrijs(a, b) {
    if (a.aanvraag !== b.aanvraag) return a.aanvraag ? 1 : -1;
    return (a.gemiddeld || a.prijs) - (b.gemiddeld || b.prijs);
  }
  function gefilterd() {
    return ALLES.filter(function (r) {
      if (FILTER && r.prov !== FILTER) return false;
      if (MERKF && r.merknaam !== MERKF) return false;
      if (MODELF && r.model !== MODELF) return false;
      if (DATAF && !(r.gb >= DATAF)) return false;
      if (MNDF && r.m !== MNDF && !r.los) return false;
      return true;
    });
  }

  // ------------------------------------------------- sim only en internet
  function teamRegel(prijs) { return TEAM > 1 ? '<div class="zkv-teamp">' + euro(prijs * TEAM) + ' per maand voor ' + TEAM + ' simkaarten</div>' : ''; }
  function keuzes(rijen) {
    var echt = rijen.filter(function (r) { return !r.aanvraag && r.prijs > 0; });
    if (echt.length < 3) return '';
    var lijst = [], gezien = [];
    function zet(tag, r, hl) { if (r && gezien.indexOf(r) < 0) { gezien.push(r); lijst.push([tag, r, hl]); } }
    zet('Goedkoopst', echt[0]);
    if (TAB === 'simonly') {
      var perGb = echt.filter(function (r) { return r.gb >= 10 && r.gb < 999; }).sort(function (a, b) { return a.gemiddeld / a.gb - b.gemiddeld / b.gb; });
      zet('Meeste data voor je geld', perGb[0], true);
      zet('Onbeperkt data', echt.filter(function (r) { return r.gb >= 999; })[0]);
    } else {
      var perMbit = echt.filter(function (r) { return r.mbit >= 400; }).sort(function (a, b) { return a.gemiddeld / a.mbit - b.gemiddeld / b.mbit; });
      zet('Snelheid voor je geld', perMbit[0], true);
      zet('Met vast IP-adres', echt.filter(function (r) { return r.merk.indexOf('Vast IP') > -1; })[0]);
    }
    if (lijst.length < 2) return '';
    return '<div class="zkv-drie">' + lijst.map(function (k) {
      var r = k[1], groen = k[0] === 'Goedkoopst';
      var groot = TAB === 'simonly' ? gbTekst(r.gb) + (r.gb < 999 ? ' <small>data</small>' : '') : (r.mbit ? r.mbit + ' <small>Mbit/s</small>' : esc(r.plan));
      var eig = [];
      if (r.min) eig.push(r.min);
      if (r.m) eig.push(r.m + (r.m === 1 ? ' maand' : ' maanden'));
      if (r.net) eig.push('netwerk ' + r.net);
      r.merk.forEach(function (x) { if (eig.indexOf(x) < 0) eig.push(x); });
      return '<div class="zkv-k' + (k[2] ? ' hl' : '') + '"><span class="zkv-tag' + (groen ? ' groen' : '') + '">' + k[0] + '</span>' +
        '<div class="zkv-kkop">' + logo(r.prov) + '<div><b>' + esc(r.prov) + '</b><small>' + esc(r.plan) + '</small></div></div>' +
        '<div class="zkv-groot">' + groot + '</div>' +
        '<div class="zkv-eig">' + eig.map(function (x) { return '<span>' + esc(x) + '</span>'; }).join('') + '</div>' +
        '<div class="zkv-kprijs"><div><b>' + euro(r.prijs) + '</b><small>per maand' + (TAB === 'simonly' ? ' per sim' : '') + ', ' + BTWT + '</small>' +
        (r.eenmalig ? '<small class="zkv-eenmalig">+ ' + euro(r.eenmalig) + ' eenmalig</small>' : '') + (TAB === 'simonly' ? teamRegel(r.prijs) : '') + '</div>' + go(r) + '</div></div>';
    }).join('') + '</div>';
  }
  // Zonder gekozen looptijd staat dezelfde bundel er anders vier keer (1, 12, 24
  // en 36 maanden). Dan een regel: de goedkoopste, met de andere looptijden erbij.
  function samen(rijen) {
    if (MNDF) return rijen;
    var g = {}, uit = [];
    rijen.forEach(function (r) {
      var k = r.prov + '|' + r.plan + '|' + r.gb + '|' + r.mbit + '|' + r.min;
      if (!g[k]) { g[k] = r; r.ook = []; uit.push(r); }
      else if (r.m && g[k].ook.indexOf(r.m) < 0 && r.m !== g[k].m) g[k].ook.push(r.m);
    });
    uit.forEach(function (r) { r.ook.sort(function (a, b) { return a - b; }); });
    return uit;
  }
  function tabel(rijen) {
    rijen = samen(rijen);
    var kop = TAB === 'simonly'
      ? '<tr><th>Aanbieder en bundel</th><th>Data</th><th>Bellen</th><th>Looptijd</th><th style="text-align:right">Per maand</th><th></th></tr>'
      : '<tr><th>Aanbieder en pakket</th><th>Snelheid</th><th>Extra</th><th>Looptijd</th><th style="text-align:right">Per maand</th><th></th></tr>';
    var laagste = rijen.filter(function (r) { return !r.aanvraag; })[0];
    var body = rijen.slice(0, TOON).map(function (r) {
      var top = r === laagste;
      var sub = esc(r.plan) + (r.net ? ' · netwerk ' + esc(r.net) : '') + (r.live ? '' : ' · handmatig, tarief van ' + esc(PEIL)) + (r.notitie ? '<br>' + esc(r.notitie) : '');
      var c2 = TAB === 'simonly' ? '<span class="zkv-gb">' + (r.gb ? gbTekst(r.gb) : '—') + '</span>' : '<span class="zkv-gb">' + (r.mbit ? r.mbit + ' Mbit/s' : '—') + '</span>';
      var c3 = TAB === 'simonly' ? esc(r.min || '—') : esc(r.merk.join(', ') || (r.min && !r.mbit ? r.min : '') || '—');
      var prijs = r.aanvraag ? '<b style="font-size:15px">Op aanvraag</b>'
        : '<b>' + euro(r.prijs) + '</b><small>' + BTWT + '</small>' + (r.eenmalig ? '<small class="zkv-eenmalig">+ ' + euro(r.eenmalig) + ' eenmalig</small>' : '') + (TAB === 'simonly' ? teamRegel(r.prijs) : '');
      return '<tr class="' + (top ? 'top' : '') + '">' +
        '<td class="zkv-c1"><div class="zkv-aanb">' + logo(r.prov) + '<div><b>' + esc(r.prov) + (top ? '<span class="zkv-lab">Goedkoopst</span>' : '') + '</b><small>' + sub + '</small></div></div></td>' +
        '<td class="zkv-cgb">' + c2 + '</td><td class="zkv-cmin">' + c3 + '</td>' +
        '<td class="zkv-cm">' + (r.m ? r.m + ' mnd' : '') + (r.ook && r.ook.length ? '<small class="zkv-ook">ook ' + r.ook.join(', ') + ' mnd</small>' : '') + '</td>' +
        '<td class="zkv-pr zkv-cpr">' + prijs + '</td><td class="zkv-cgo">' + go(r) + '</td></tr>';
    }).join('');
    return '<table class="zkv-tabel"><thead>' + kop + '</thead><tbody>' + body + '</tbody></table>';
  }

  // ------------------------------------------------------------- met toestel
  // 20 okt: per toestel alle aanbieders onder elkaar, per soort abonnement (databundel). Je kiest bovenin de
  // kaart de bundel; daaronder per aanbieder de goedkoopste aanbieding met die bundel, op totaalprijs.
  var TIERS = [['5', 'Tot 7 GB'], ['10', '8 tot 19 GB'], ['20', '20 tot 49 GB'], ['50', '50 GB of meer'], ['onb', 'Onbeperkt']];
  function tierVan(r) { if (r.los) return 'los'; var g = r.gb; return g >= 999 ? 'onb' : g >= 50 ? '50' : g >= 20 ? '20' : g >= 8 ? '10' : '5'; }
  function tierNaam(k) { for (var i = 0; i < TIERS.length; i++) if (TIERS[i][0] === k) return TIERS[i][1]; return k; }
  var MERKWOORD = /\b(apple|samsung|google|motorola|xiaomi|oppo|oneplus|nokia|fairphone|honor)\b/g;
  function toestelSleutel(r) { return (r.merknaam + '|' + String(r.model).toLowerCase().replace(MERKWOORD, '').replace(/\b5g\b/g, '').replace(/[^a-z0-9+]/g, '') + '|' + String(r.opslag).toLowerCase().replace(/\s/g, '')); }
  function provNaam(p) { return String(p || '').replace(/\s+NL$/, ''); }
  function toestelGroepen(rijen) {
    var g = {}, volg = [];
    rijen.forEach(function (r) {
      var k = toestelSleutel(r);
      if (!g[k]) { g[k] = { model: r.model, opslag: r.opslag, img: r.img, merk: r.merknaam, rijen: [] }; volg.push(g[k]); }
      if (!g[k].img && r.img) g[k].img = r.img;
      if (String(r.model).length < String(g[k].model).length) g[k].model = r.model;
      g[k].rijen.push(r);
    });
    volg.forEach(function (x) {
      // per bundelsoort en aanbieder de goedkoopste over de looptijd
      var per = {}, provs = {};
      x.los = [];
      x.rijen.forEach(function (r) {
        provs[r.prov] = 1;
        if (r.los) { var o = x.los.filter(function (y) { return y.prov === r.prov; })[0]; if (!o) x.los.push(r); else if (r.prijs < o.prijs) x.los[x.los.indexOf(o)] = r; return; }
        var t = tierVan(r), k = t + '|' + r.prov;
        if (!per[k] || (r.los ? r.prijs < per[k].prijs : r.totaal < per[k].totaal)) per[k] = r;
      });
      x.tiers = {};
      Object.keys(per).forEach(function (k) { var t = k.split('|')[0]; (x.tiers[t] = x.tiers[t] || []).push(per[k]); });
      Object.keys(x.tiers).forEach(function (t) { x.tiers[t].sort(function (a, b) { return a.los ? a.prijs - b.prijs : a.totaal - b.totaal; }); });
      x.aanbieders = Object.keys(provs).length;
      var echt = x.rijen.filter(function (r) { return !r.los; }).sort(function (a, b) { return a.totaal - b.totaal; });
      x.beste = echt[0] || x.rijen[0];
      // Standaard de bundel met de meeste aanbieders (bij gelijk: de goedkoopste); "naar keuze" alleen als er niets anders is.
      var keuzes = Object.keys(x.tiers);
      keuzes.sort(function (a, b) { return (x.tiers[b].length - x.tiers[a].length) || (x.tiers[a][0].totaal - x.tiers[b][0].totaal); });
      x.keuze = TIERF && x.tiers[TIERF] ? TIERF : keuzes[0] || '';
    });
    return volg.filter(function (x) { return x.beste && (!TIERF || x.tiers[TIERF] || (x.los.length && !Object.keys(x.tiers).length)); }).sort(function (a, b) { return (a.beste.los - b.beste.los) || (a.beste.totaal - b.beste.totaal); });
  }
  function aanbodRij(r, top) {
    var sub = [r.gb ? gbTekst(r.gb) : '', r.net && provNaam(r.prov).toLowerCase().indexOf(r.net.toLowerCase()) < 0 ? 'netwerk ' + r.net : '', r.m ? r.m + ' mnd' : ''].filter(Boolean).join(' · ');
    if (r.los) sub = 'Toestel op afbetaling, het abonnement kies je bij ' + esc(provNaam(r.prov).replace(/\s*Zakelijk$/i, ''));
    var prijs = r.los ? '<b>' + euro(r.prijs) + '</b><small>p/m voor het toestel</small>'
      : '<b>' + euro(r.totaal) + '</b><small>totaal ' + r.maanden + ' mnd</small><small>' + euro(r.prijs) + ' p/m' + (r.eenmalig ? ' + ' + euro(r.eenmalig) + ' eenmalig' : '') + '</small>';
    return '<li class="zkv-ar' + (top ? ' top' : '') + '">' + logo(r.prov) + '<div class="zkv-an"><b>' + esc(provNaam(r.prov)) + (top ? '<span class="zkv-lab">Goedkoopst</span>' : '') + '</b><small>' + sub + '</small></div><div class="zkv-ap">' + prijs + '</div>' + go(r) + '</li>';
  }
  function toestelKaart(x, i, goedkoopst) {
    var t = x.keuze, lijst = x.tiers[t] || [], open = !!x.open, max = 5;
    var knoppen = TIERS.filter(function (k) { return x.tiers[k[0]]; }).map(function (k) {
      return '<button type="button" data-t="' + k[0] + '" aria-pressed="' + (k[0] === t) + '"><b>' + esc(k[1]) + '</b><small>' + x.tiers[k[0]].length + ' ' + (x.tiers[k[0]].length === 1 ? 'aanbieder' : 'aanbieders') + '</small></button>';
    }).join('');
    var r0 = lijst[0];
    return '<article class="zkv-tk zkv-tk2' + (goedkoopst ? ' hl' : '') + '" data-i="' + i + '">' + (goedkoopst ? '<span class="zkv-tag groen">Goedkoopst</span>' : '') +
      '<div class="zkv-tkop"><div class="zkv-tim">' + (x.img ? '<img src="' + esc(x.img) + '" alt="' + esc(x.model) + '" loading="lazy">' : '') + '</div>' +
      '<div><h3>' + esc(x.model) + '</h3><div class="zkv-tsub">' + esc(x.opslag) + (x.opslag ? ' · ' : '') + x.aanbieders + (x.aanbieders === 1 ? ' aanbieder' : ' aanbieders') + '</div>' +
      (x.beste && !x.beste.los ? '<div class="zkv-vanaf"><small>vanaf</small> <b>' + euro(x.beste.totaal) + '</b> <small>totaal ' + x.beste.maanden + ' mnd, ' + BTWT + '</small></div>' : '') + '</div></div>' +
      '<div class="zkv-bun2" role="group" aria-label="Kies een bundel">' + knoppen + '</div>' +
      (lijst.length ? '<ul class="zkv-al">' + lijst.slice(0, open ? 99 : max).map(function (r, j) { return aanbodRij(r, j === 0 && lijst.length > 1); }).join('') + '</ul>' : '') +
      (x.los.length ? '<p class="zkv-ookl">' + (lijst.length ? 'Ook te koop, abonnement naar keuze' : 'Abonnement naar keuze') + '</p><ul class="zkv-al">' + x.los.map(function (r) { return aanbodRij(r, false); }).join('') + '</ul>' : '') +
      (lijst.length > max ? '<button type="button" class="zkv-alle" data-open="' + (open ? 0 : 1) + '">' + (open ? 'Minder tonen' : 'Alle ' + lijst.length + ' aanbieders met ' + esc(tierNaam(t).toLowerCase())) + '</button>' : '') +
      (r0 && !r0.los && (r0.tm || r0.abo) && !r0.eenmalig ? '<p class="zkv-split">Bij ' + esc(provNaam(r0.prov)) + ': ' + euro(r0.tm) + ' per maand voor het toestel en ' + euro(r0.abo) + ' voor het abonnement.</p>' : '') +
      '</article>';
  }

  var GROEPEN = [];
  function teken() {
    var rijen = gefilterd().sort(opPrijs);
    var lijst = document.getElementById('zkv-lijst'), kz = document.getElementById('zkv-keuzes');
    tekenFilters();
    if (!rijen.length) {
      kz.innerHTML = '';
      lijst.innerHTML = '<div class="zkv-leeg">Geen aanbiedingen gevonden met deze keuze.</div>';
      document.getElementById('zkv-meer').hidden = true;
      document.getElementById('zkv-telling').innerHTML = '<b>0</b> ' + (ZAK ? 'zakelijke ' : '') + 'aanbiedingen';
      return;
    }
    if (TAB === 'toestel') {
      GROEPEN = toestelGroepen(rijen);
      var pv = {}; rijen.forEach(function (r) { pv[r.prov] = 1; });
      document.getElementById('zkv-telling').innerHTML = '<b>' + GROEPEN.length + '</b> toestellen, <b>' + rijen.length + '</b> aanbiedingen van <b>' + Object.keys(pv).length + '</b> aanbieders';
      kz.innerHTML = '';
      lijst.innerHTML = '<div class="zkv-toe">' + GROEPEN.slice(0, TOON).map(function (x, i) { return toestelKaart(x, i, i === 0); }).join('') + '</div>';
      document.getElementById('zkv-meer').hidden = GROEPEN.length <= TOON;
      return;
    }
    document.getElementById('zkv-telling').innerHTML = '<b>' + rijen.length + '</b> ' + (ZAK ? 'zakelijke ' : '') + 'aanbiedingen';
    kz.innerHTML = keuzes(rijen);
    lijst.innerHTML = tabel(rijen);
    document.getElementById('zkv-meer').hidden = rijen.length <= TOON;
  }

  document.getElementById('zkv-lijst').addEventListener('click', function (e) {
    var b = e.target.closest('.zkv-bun2 button, .zkv-alle'); if (!b) return;
    var k = b.closest('.zkv-tk'), i = +k.getAttribute('data-i'), x = GROEPEN[i]; if (!x) return;
    if (b.classList.contains('zkv-alle')) x.open = b.getAttribute('data-open') === '1';
    else { x.keuze = b.getAttribute('data-t'); x.open = false; }
    var tmp = document.createElement('div'); tmp.innerHTML = toestelKaart(x, i, i === 0);
    k.parentNode.replaceChild(tmp.firstChild, k);
  });
  document.getElementById('zkv-meer-knop').addEventListener('click', function () { TOON += TAB === 'toestel' ? 12 : 15; teken(); });
  function zetTeam(n) {
    TEAM = Math.max(1, Math.min(50, n));
    var el = document.getElementById('zkv-n'); if (el) el.textContent = TEAM;
    try { localStorage.setItem('zkvTeam', String(TEAM)); } catch (e) {}
    teken();
  }
  var mn = document.getElementById('zkv-min'), pl = document.getElementById('zkv-plus');
  if (mn) mn.addEventListener('click', function () { zetTeam(TEAM - 1); });
  if (pl) pl.addEventListener('click', function () { zetTeam(TEAM + 1); });
  if (document.getElementById('zkv-n')) document.getElementById('zkv-n').textContent = TEAM;

  // Handmatige regels staan er meteen; de feed komt erbij zodra hij binnen is.
  ALLES = ((ZAK && HAND[TAB]) || []).map(uitHand);
  teken();

  fetch(WORKER + EIND[TAB])
    .then(function (r) { return r.json(); })
    .then(function (j) {
      var d = (j && j.data) || [];
      var uit = [], gezien = {};
      d.forEach(function (x) {
        if (ZAK ? !isZakelijk(x) : isZakelijk(x)) return;
        var naam = (x.name || '').toLowerCase();
        if (TAB === 'toestel' && !heeftToestel(x)) return;
        // sim only: geen regels met een toestel erbij (tabletabonnementen van Odido)
        if (TAB === 'simonly' && (parseFloat(x.deviceTotalPrice) > 0 || parseFloat(x.deviceMonthlyCost) > 0 || GEEN_TELEFOON.test(naam))) return;
        // toestel: een abonnementsdeel onder de 8 euro klopt niet met de sim-onlyprijzen
        var basis = parseFloat(x.baseMonthlyCost) || 0;
        if (ZAK && TAB === 'toestel' && basis > 0 && basis < 8) return;
        var p = parseFloat(x.price) || 0;
        if (!p) return;
        var r = uitFeed(x);
        // bundels waarvan de feed de data niet kent (0 GB) laten we bij sim only weg
        // KPN Zakelijk (uit onze eigen meting) kent alleen het toestel per maand: die tonen we apart.
        if ((TAB === 'simonly' || TAB === 'toestel') && !(r.gb > 0) && !r.los) return;
        if (r.los) { r.m = 24; r.maanden = 24; r.totaal = r.prijs * 24; r.gemiddeld = r.prijs; }
        var sleutel = (x.merchantName || '') + '|' + (x.name || '') + '|' + (x.dataGB || 0) + '|' + (x.contractMonths || 0);
        if (gezien[sleutel] && gezien[sleutel].gemiddeld <= r.gemiddeld) return;
        if (gezien[sleutel]) uit.splice(uit.indexOf(gezien[sleutel]), 1);
        gezien[sleutel] = r;
        uit.push(r);
      });
      ALLES = ((ZAK && HAND[TAB]) || []).map(uitHand).concat(uit);
      // Met toestel vergelijk je alleen eerlijk bij dezelfde looptijd: een totaal
      // over 12 maanden is altijd lager dan over 24. Standaard dus 24 maanden.
      if (TAB === 'toestel' && !MNDF && uit.some(function (r) { return r.m === 24; })) MNDF = 24;
      teken();
    })
    .catch(function () { teken(); });
})();
</script>

