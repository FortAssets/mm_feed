{%- assign ig = section.settings.instagram -%}
<style>
html:not(#x):not(#y):not(#z) footer.dpf{background:#0D1B2A !important;background-image:none !important;border-top:0 !important;color:#C9D3E0 !important;font-family:'Instrument Sans',system-ui,sans-serif !important;padding:0 !important;margin:0}
footer.dpf *{box-sizing:border-box}
footer.dpf .dpf-w{max-width:1180px;margin:0 auto;padding:0 28px}
footer.dpf a{color:inherit;text-decoration:none}
footer.dpf a:focus-visible,footer.dpf summary:focus-visible{outline:2px solid #3FAE7A;outline-offset:3px;border-radius:4px}
/* bovenste rij: merk en volg ons */
