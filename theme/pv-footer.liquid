  footer.dpf .dpf-snel{display:flex;flex-wrap:wrap;gap:8px;padding:20px 0 6px}
  footer.dpf .dpf-snel a{background:#F9C31F;color:#0D1B2A !important;font-weight:700;font-size:14px;border:2px solid #0D1B2A;box-shadow:3px 3px 0 #000;border-radius:12px;padding:10px 14px}
  footer.dpf .dpf-grid{grid-template-columns:1fr;gap:0;padding:12px 0 18px}
  footer.dpf details{border-bottom:1px solid rgba(255,255,255,.12)}
  footer.dpf summary{pointer-events:auto;cursor:pointer;margin:0;padding:16px 0;display:flex;justify-content:space-between;align-items:center}
  footer.dpf summary::after{content:"+";font-family:'Instrument Sans',sans-serif;font-weight:500;font-size:24px;line-height:1;color:#F9C31F}
  footer.dpf details[open] summary::after{content:"\2212"}
  footer.dpf .dpf-k ul{padding-bottom:12px}
  footer.dpf .dpf-k li a{padding:9px 0;font-size:15px}
  footer.dpf .dpf-onder{flex-direction:column;align-items:flex-start;padding-bottom:96px}
}
