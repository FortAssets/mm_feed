.pvf-logo{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-weight:800;font-size:26px;text-decoration:none;letter-spacing:-.01em;display:inline-block;margin-bottom:14px;line-height:1;background:linear-gradient(135deg,#fff,#bfd2ff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:#fff}
.pvf-logo .g{-webkit-background-clip:initial;background-clip:initial;-webkit-text-fill-color:#10b981;color:#10b981}
.pvf-brand p{font-size:14px;line-height:1.65;color:#9fb0d4;max-width:262px;margin-bottom:20px}
.pvf-badges{display:flex;gap:10px;flex-wrap:wrap}
.pvf-badge{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:9px;padding:8px 14px;font-size:12px;font-weight:600;color:#cdd7ee;display:flex;align-items:center;gap:6px}
.pvf-col h5{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;color:#fff;margin-bottom:16px;letter-spacing:.04em;text-transform:uppercase}
.pvf-col ul{list-style:none;display:flex;flex-direction:column;gap:9px;margin:0;padding:0}
.pvf-col ul a{font-size:13px;color:#9fb0d4;text-decoration:none;transition:color .15s;overflow-wrap:break-word;word-break:break-word}
.pvf-col ul a:hover{color:#fff}
.pvf-col ul a:focus-visible{outline:2px solid #10b981;outline-offset:3px;border-radius:3px}
.pvf-col ul a.pvf-uit{color:#cdd7ee;font-weight:700}
.pvf-bottom{border-top:1px solid rgba(255,255,255,.12);padding:20px 0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.pvf-bottom p{font-size:12px;color:#8295bb}
.pvf-bottom-links{display:flex;gap:20px;flex-wrap:wrap}
.pvf-bottom-links a{font-size:12px;color:#8295bb;text-decoration:none}
.pvf-bottom-links a:hover{color:#cdd7ee}
.pvf-trustpilot{display:inline-flex;align-items:center;gap:8px;width:fit-content;max-width:100%;box-sizing:border-box;flex-wrap:wrap;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 14px;margin-top:20px}
.pvf-trustpilot .stars{color:#10b981;font-size:15px;letter-spacing:.5px;white-space:nowrap}
.pvf-trustpilot span{font-size:12px;color:#9fb0d4}
.pvf-trustpilot strong{color:#fff;font-size:14px}
@media(max-width:1024px){.pvf-grid{grid-template-columns:1fr 1fr 1fr;gap:30px 24px}.pvf-brand{grid-column:1/-1}.pvf-brand p{max-width:520px}}
@media(max-width:640px){.pvf{padding:44px 0 0}.pvf-wrap{padding:0 20px}.pvf-grid{grid-template-columns:1fr 1fr;gap:28px 20px}.pvf-brand{grid-column:1/-1}.pvf-bottom{flex-direction:column;text-align:center;align-items:center}}
@media(max-width:380px){.pvf-grid{grid-template-columns:1fr}}
</style>

