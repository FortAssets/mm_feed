footer.dpf .dpf-soc a:hover{transform:translateY(-2px)}
footer.dpf .dpf-soc a[aria-label="Facebook"]{background:#1877F2;border-color:#1877F2}
footer.dpf .dpf-soc a[aria-label="Instagram"]{background:linear-gradient(45deg,#F9A825 0%,#E53935 45%,#C2185B 70%,#7B1FA2 100%);border-color:transparent}
footer.dpf .dpf-soc svg{width:20px;height:20px;fill:#fff}
/* snelknoppen, alleen mobiel */
footer.dpf .dpf-snel{display:none}
/* kolommen */
footer.dpf .dpf-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:28px;padding:34px 0 38px}
footer.dpf details{min-width:0}
footer.dpf summary{list-style:none;cursor:default;font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:17px;letter-spacing:-.02em;color:#fff;margin-bottom:12px;pointer-events:none}
footer.dpf summary::-webkit-details-marker{display:none}
footer.dpf .dpf-k ul{list-style:none;margin:0;padding:0}
footer.dpf .dpf-k li a{display:block;padding:5px 0;font-size:14px;line-height:1.35;color:#C9D3E0}
footer.dpf .dpf-k li a:hover{color:#3FAE7A}
footer.dpf .dpf-k li a.dpf-uit{color:#fff;font-weight:700}
footer.dpf .dpf-k .dpf-sub{margin-top:18px}
/* onderbalk */
footer.dpf .dpf-onder{border-top:1px solid rgba(255,255,255,.12);padding:18px 0 22px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px 20px;font-size:13px;color:#93A3B8}
footer.dpf .dpf-onder nav{display:flex;flex-wrap:wrap;gap:6px 18px}
footer.dpf .dpf-onder a{color:#93A3B8}
footer.dpf .dpf-onder a:hover{color:#fff}
/* de losse social-balk van dpv-social staat nu in de footer zelf */
html:not(#x):not(#y) .pvs{display:none !important}
@media(max-width:900px){
  footer.dpf .dpf-w{padding:0 16px}
