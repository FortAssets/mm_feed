{{ 'pv-global.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
.pvnav{background:#fff;border-bottom:1px solid #e7ebf3;position:sticky;top:0;z-index:100;font-family:'Plus Jakarta Sans',system-ui,sans-serif}
.pvnav-inner{display:flex;align-items:center;height:70px;max-width:1200px;margin:0 auto;padding:0 20px}
.pvnav-logo{display:inline-flex;align-items:center;gap:11px;flex-shrink:0;text-decoration:none;line-height:1}
.pvnav-merk{width:46px;height:46px;flex-shrink:0;display:block;margin:-4px -2px -4px -4px}
.pvnav-woord{font-family:'Bricolage Grotesque','Plus Jakarta Sans',sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em;background:linear-gradient(135deg,#1D3A6B,#0D1B2A);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:#1e3a8a}
.pvnav-woord .g{-webkit-background-clip:initial;background-clip:initial;-webkit-text-fill-color:#3FAE7A;color:#3FAE7A}
/* Tussen 1101 en 1320 staat het volledige menu nog naast het logo, maar past
   het net niet: de knop rechts viel eraf. Daar tonen we alleen het merkteken.
   Dat is nog steeds volledig herkenbaar en scheelt ongeveer 210 pixels. */
@media(min-width:1101px) and (max-width:1420px){
  .pvnav-woord{display:none}
  .pvnav-logo{gap:0}
  .pvnav-links{gap:4px}
  .pvnav-links a{font-size:12.5px;padding:8px 8px}
}
/* Vangnet: laat het middenmenu krimpen in plaats van de rest wegduwen. */
.pvnav-links{min-width:0}
@media(max-width:520px){.pvnav-woord{font-size:19px}.pvnav-merk{width:41px;height:41px}.pvnav-logo{gap:9px}}
.pvnav-links{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;list-style:none;margin:0;padding:0}
.pvnav-links a{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#475569;text-decoration:none;padding:8px 11px;border-radius:9px;transition:all .15s;white-space:nowrap}
.pvnav-links a:hover,.pvnav-links a.active{color:#2563eb;background:#eef2fb}
.pvnav-links a svg{width:16px;height:16px;flex-shrink:0;stroke-width:2}
.pvnav-links a.pvnav-zak{border:1.5px solid #e7ebf3;color:#1e293b;font-weight:700}
.pvnav-links a.pvnav-zak:hover{border-color:#2563eb;background:#fff;color:#2563eb}
.pvnav-right{display:flex;align-items:center;gap:12px;flex-shrink:0}
.pvnav-rating{display:flex;align-items:center;gap:5px;font-size:13px;color:#64748b;padding:7px 11px;background:#f8fafc;border-radius:9px;font-weight:600;white-space:nowrap}
.pvnav-rating svg{width:15px;height:15px;flex-shrink:0}
.pvnav-rating strong{color:#1e293b;font-weight:800}
.pvnav-rating span{color:#94a3b8}
.pvnav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;margin-left:auto}
.pvnav-burger span{width:22px;height:2px;background:#2563eb;border-radius:2px;transition:all .2s}
.pvnav-mobile{display:none;flex-direction:column;background:#fff;border-top:1px solid #e7ebf3;padding:16px 28px 24px}
.pvnav-mobile a{display:flex;align-items:center;gap:13px;font-size:15px;font-weight:600;color:#1e293b;text-decoration:none;padding:13px 0;border-bottom:1px solid #f1f5f9}
.pvnav-mobile a:last-child{border:none}
.pvnav-mobile a .pvico{flex-shrink:0;width:38px;height:38px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:#eef2fb;color:#2563eb}
.pvnav-mobile a .pvico svg{width:20px;height:20px;stroke-width:2}
.pvnav-mobile a.pvm-toestel .pvico{background:#ecfdf5;color:#059669}
.pvnav-mobile a.pvm-deal .pvico{background:#fff1ec;color:#ea580c}
.pvnav-mobile a.pvm-advies .pvico{background:#eff6ff;color:#2563eb}
.pvnav-mobile a.pvm-zak .pvico{background:#f1f5f9;color:#1e293b}
.pvnav-mobile a.pvm-game .pvico{background:#f5f3ff;color:#6d28d9}
.pvnav-mobile a.pvm-verg .pvico{background:#ecfdf5;color:#059669}
.pvnav-mobile a.pvm-faq .pvico{background:#f5f3ff;color:#7c3aed}
.pvnav-mobile a.pvm-buitenland .pvico{background:#ecfeff;color:#0891b2}
@media(max-width:1100px){.pvnav-links,.pvnav-right{display:none}.pvnav-burger{display:flex}}
@media(min-width:1101px){.pvnav-mobile{display:none!important}}
