var tvInfo='';if(isInternet&&d.hasTV){var _ti=tvInfoFor(d);if(_ti){var _pk=tvKeyFor(d);tvInfo='<div class="pvx-tvinfo"><span class="ic">&#128250;</span><span><button type="button" class="pvx-tvlink" onclick="pvxTvModal(\''+_pk+'\')"><b>'+_ti.count+' '+T.tvChannels+'</b> &#9432;</button> \u00b7 '+_ti.note+'</span></div>';}}
var een=getEenmalig(d),dm=getDevMaand(d),sub=getSub(d),dtot=getDevTotal(d),dexb=getDevExBtw(d);var cm=d.contractMonths||0;
var bigP,bigL;if(isTelefoon&&toon==='toestel'&&dtot>0){bigP=fmtEur(dtot);bigL=T.devicePriceLbl+(zak?' '+T.inclBtw:'');}else{bigP=d.displayPrice;bigL=(isTelefoon?T.cardTotal:T.cardMonth)+(zak?' *':'');}
