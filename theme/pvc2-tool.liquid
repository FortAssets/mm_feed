function gv(id){var e=document.getElementById(id);return e?e.value:'';}
function getFiltered(){var q=document.getElementById('pvx-q').value.trim();var minData=0,ctr=gv('f-ctr'),stor=gv('f-stor'),kleur=gv('f-kleur'),net=gv('f-net');var maxMaand=parseFloat((document.getElementById('s-maand')||{}).value||9999),maxBij=parseFloat((document.getElementById('s-bij')||{}).value||999999);return ALL.filter(function(d){if(!segBase(d))return false;if(activeMerk&&!matchMerk(d,activeMerk))return false;if(activeProv&&pkey(provSrc(d))!==activeProv)return false;if(activeReseller==='direct'&&resellerOf(d))return false;if(activeReseller&&activeReseller!=='direct'&&resellerOf(d)!==activeReseller)return false;if(q&&!matchQ(hay(d),q))return false;/* Zoek je op Pro, dan hoort de Pro Max er niet bij: "iPhone 18 Pro Max" bevat immers "iPhone 18 Pro". Zoek je op iPhone 18, dan zie je nog gewoon de hele serie. */if(q&&/\bpro\b/.test(q.toLowerCase())&&!/\bmax\b/.test(q.toLowerCase())&&/pro max/.test((d.name||'').toLowerCase()))return false;if(activeData){var _p=activeData.split('-');var _lo=parseFloat(_p[0])||0;var _hi=(_p.length>1&&_p[1]!=='')?parseFloat(_p[1]):Infinity;if(isInternet){var _s=d.speedMbit||0;if(activeData==='1000-'){if(_s<1000)return false;}else{if(_s<_lo||_s>=_hi)return false;}}else{var _g=d.dataGB||0;if(activeData==='999-'){if(_g<999)return false;}else{if(_g>=999)return false;if(_g<=_lo&&_lo>0)return false;if(_g>_hi)return false;}}}if(activeTv==='with'&&!d.hasTV)return false;if(activeTv==='without'&&d.hasTV)return false;var c=gv('f-ctr');if(c==='0'&&(d.contractMonths||0)>1)return false;if(c==='12'&&d.contractMonths!==12)return false;if(c==='24'&&d.contractMonths!==24)return false;if(stor&&getStorage(d)!==stor)return false;var mdl=gv('f-model');if(mdl&&modelNaam(d)!==mdl)return false;if(kleur&&hoofdKleur(d)!==kleur)return false;if(net){var nh=fix(d.network||'').toLowerCase()+' '+provName(d.merchantName||'').toLowerCase();if(!nh.includes(net))return false;}if(activeCalls&&!isInternet){var _ml=(d.minutesLabel||'').toLowerCase();if(activeCalls==='unli