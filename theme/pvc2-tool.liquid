function prijsMatch(d){var p=d.price||0;switch(activeMaand){case 9999:return true;case 15:return p<15;case 25:return p>=15&&p<25;case 40:return p>=25&&p<40;case 60:return p>=40&&p<60;case 999:return p>=60;}return true;}
function bijMatch(d){if(!isTelefoon)return true;var e=getEenmalig(d)||0;switch(activeBij){case 999999:return true;case 0:return e<=0&&getDevMaand(d)>0;case 100:return e>0&&e<100;case 300:return e>=100&&e<300;case 600:return e>=300&&e<600;case 9999:return e>=600;}return true;}

function card(gi){var g=GROUPS[gi],d=g.items[g.sel]||g.items[0];var rsl=resellerOf(d);var provDisp=provSrc(d);var nm=fix(d.name||''),me=provName(provDisp),zak=isZak(d);if(!me&&rsl){me=(d.brand||'').trim()||rsl;}var toonEl=document.getElementById('f-toon');var toon=toonEl?toonEl.value:'maand';
var gifts=giftHtml(d);
