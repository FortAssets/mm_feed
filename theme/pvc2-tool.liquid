function pvxRender(){
 var items=getFiltered();
 items.sort(function(a,b){/* 6 okt: gespreid betalen is de norm. Aanbiedingen waarbij je het hele toestel ineens betaalt staan bij de standaardsortering en bij sorteren op maandprijs onderaan. */if(SORT==='pop'||SORT==='price'){var ra=ineens(a),rb=ineens(b);if(ra!==rb)return ra-rb;}if(SORT==='pop'){var pa=popScore(a),pb=popScore(b);if(pa!==pb)return pb-pa;/* 17 sep: binnen hetzelfde toestel op TOTAALPRIJS sorteren, niet op maandbedrag. Een aanbieding van 1 euro per maand met 3.128 euro vooruit stond bovenaan als goedkoopste, terwijl dat juist de duurste van de lijst was. */var ta=getEenmalig(a)+a.price*(a.contractMonths||24),tb=getEenmalig(b)+b.price*(b.contractMonths||24);if(ta!==tb)return ta-tb;return a.price-b.price;}if(SORT==='price')return a.price-b.price;if(SORT==='devasc')return getDevMaand(a)-getDevMaand(b);if(SORT==='down')return getEenmalig(a)-getEenmalig(b);if(SORT==='data')return(b.dataGB||0)-(a.dataGB||0);return fix(a.name||'').localeCompare(fix(b.name||''));});
