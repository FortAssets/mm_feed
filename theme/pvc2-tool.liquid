var dots='';if(isTelefoon&&g.items.length>1){var seen={},dh='',cnt=0;g.items.forEach(function(v,vi){var kl=getKleur(v)||('V'+(vi+1));if(seen[kl])return;seen[kl]=1;cnt++;if(cnt>5)return;dh+='<button class="pvx-cdot'+(vi===g.sel?' sel':'')+'" style="background:'+colorCss(kl)+'" title="'+kl+'" onclick="pvxVar('+gi+','+vi+')"></button>';});if(cnt>5)dh+='<span class="pvx-cmore">+'+(cnt-5)+'</span>';if(cnt>1)dots='<div class="pvx-colors">'+dh+'</div>';}
