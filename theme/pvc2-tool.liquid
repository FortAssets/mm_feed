 var grid=document.getElementById('pvx-grid'),more=document.getElementById('pvx-more');
 if(!total){grid.innerHTML='<div class="pvx-empty"><p style="font-size:2rem;margin:0 0 10px">'+(SEG==='zakelijk'?'&#128188;':'&#128270;')+'</p><p style="font-weight:700;margin:0">'+T.noResults+'</p>'+(SEG==='zakelijk'?'<p style="font-size:13px;margin-top:6px">'+T.noResultsZak+'</p>':'')+'<p style="font-size:13px;margin-top:6px"><button onclick="pvxReset()" style="color:#1B3FA0;font-weight:700;background:none;border:none;cursor:pointer;font-family:inherit;font-size:inherit">'+T.reset+'</button></p></div>';more.style.display='none';return;}
