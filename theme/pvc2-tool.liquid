    function gbVal(s){return s.indexOf('TB')>=0?parseInt(s)*1024:parseInt(s);}
    var stor={};ALL.forEach(function(d){if(!segBase(d))return;var s=getStorage(d);if(s&&gbVal(s)>=64)stor[s]=1;});
