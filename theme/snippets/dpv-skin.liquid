{%- comment -%}
  Huisstijl "Prijskaartjes" voor de hele site (6 okt; daarvoor "2-rond").

  De site bestaat uit ruim honderd secties die elk hun eigen opmaak
  meebrengen. In plaats van die allemaal te herschrijven ligt hier een laag
  overheen: assets/dpv-skin.css zet per bestaande regel de kleur, de letter en
  de vorm om naar de huisstijl (inkt, wit en lichtgrijs, Bricolage Grotesque
  voor koppen en prijzen, Instrument Sans voor de rest, kaarten met inktrand).
  Dat bestand wordt gemaakt door skin/bouw.sh in de repo (skin.cjs, kaart.cjs
  en de handgeschreven delen hand-k.css en kaartjes.css), uit de opmaak die de
  pagina's echt gebruiken.

  De homepage (dpv-home-kaartjes) en de secties met eigen opmaak in deze stijl
  (productrijen, productpagina, het seintje) slaat die laag over.

  Het script zet de gele kleur op knoppen die naar een aanbieder of winkel
  gaan. Geel is in deze huisstijl alleen voor die doorklik; alle andere
  knoppen zijn inkt of wit met inktrand. Welke knop naar een aanbieder gaat
  staat niet in de opmaak maar in de link, daarom doet een script dit.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
{{ 'dpv-skin.css' | asset_url | stylesheet_tag }}
<script>
(function () {
  // De kleur van de browserbalk op een telefoon staat in layout/theme.liquid; die volgt hier de nieuwe huisstijl.
  try { var tc = document.querySelector('meta[name="theme-color"]'); if (tc) tc.setAttribute('content', '#FFFFFF'); } catch (e) {}
  var UIT = /\/api\/go\b|\/go\/deal|\/api\/shop\/go|\/sm\/go|awin1\.com|tradedoubler\.com|partner\.bol\.com|lt45\.net|daisycon|tradetracker|prf\.hn|tp\.media|tp\.st|emrldtp/i;
  function tint(kleur) {
    var m = (kleur || '').match(/[\d.]+/g);
    if (!m || m.length < 3) return null;
    if (m.length > 3 && +m[3] < 0.5) return null;
    var r = +m[0], g = +m[1], b = +m[2], mx = Math.max(r, g, b), mn = Math.min(r, g, b);
    var l = (mx + mn) / 510, s = mx === mn ? 0 : (mx - mn) / (l > 0.5 ? 510 - mx - mn : mx + mn);
    return { l: l, s: s };
  }
  function loop() {
    var a = document.querySelectorAll('a[href]:not(.dpv-geel)');
    for (var i = 0; i < a.length; i++) {
      var el = a[i];
      if (!UIT.test(el.getAttribute('href'))) continue;
      if (el.offsetHeight > 96 || el.offsetHeight === 0) continue;
      var cs = getComputedStyle(el), t = tint(cs.backgroundColor);
      if (!t && cs.backgroundImage && cs.backgroundImage !== 'none') t = tint((cs.backgroundImage.match(/rgba?\([^)]*\)/) || [])[0]);
      // Alleen een gekleurde knop wordt geel. Een tekstlink of een witte kaart die als geheel klikbaar is niet.
      if (!t || t.l > 0.72 || t.s < 0.25) continue;
      el.classList.add('dpv-geel');
    }
  }
  var wacht = 0;
  function plan() { if (wacht) return; wacht = setTimeout(function () { wacht = 0; loop(); }, 120); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loop); else loop();
  window.addEventListener('load', loop);
  if (window.MutationObserver) {
    document.addEventListener('DOMContentLoaded', function () {
      new MutationObserver(plan).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
    });
  }
})();
</script>
{%- comment -%}
  Productpagina's (/pages/product/<handle>). Een productkaart die een eigen
  pagina heeft, krijgt een link op de foto en de naam, en de tekstregel onder
  de winkels gaat erheen. Welke producten een pagina hebben staat in
  data/productpaginas.json in de repo. Een kaart doet mee met data-pp="<id>",
  en daarbinnen data-pp-foto, data-pp-naam en eventueel data-pp-link.
  De knoppen naar de winkel blijven rechtstreeks naar de winkel gaan.
{%- endcomment -%}
<style>a.dpv-pp-a{color:inherit;text-decoration:none}a.dpv-pp-a:hover{text-decoration:underline}a.dpv-pp-a i{font-style:normal;color:#2456D6;white-space:nowrap}</style>
<script>
(function () {
  var URL_ = 'https://raw.githubusercontent.com/FortAssets/mm_feed/main/data/productpaginas.json', kaart = null, bezig = false;
  function haal(klaar) {
    if (kaart) return klaar();
    try { var c = JSON.parse(sessionStorage.getItem('dpvPP') || 'null'); if (c && Date.now() - c.t < 36e5) { kaart = c.k; return klaar(); } } catch (e) {}
    if (bezig) return; bezig = true;
    fetch(URL_).then(function (r) { return r.json(); }).then(function (k) {
      kaart = k || {}; try { sessionStorage.setItem('dpvPP', JSON.stringify({ t: Date.now(), k: kaart })); } catch (e) {}
      klaar();
    }).catch(function () { kaart = {}; });
  }
  function koppel() {
    var k = document.querySelectorAll('[data-pp]:not([data-pp-ok])');
    if (!k.length) return;
    haal(function () {
      for (var i = 0; i < k.length; i++) {
        var el = k[i]; el.setAttribute('data-pp-ok', '1');
        var h = kaart[el.getAttribute('data-pp')]; if (!h) continue;
        var href = '/pages/product/' + h;
        var img = el.querySelector('[data-pp-foto] img');
        if (img && !img.closest('a')) { var a = document.createElement('a'); a.href = href; a.className = 'dpv-pp-a'; a.setAttribute('aria-hidden', 'true'); a.tabIndex = -1; img.parentNode.insertBefore(a, img); a.appendChild(img); }
        var n = el.querySelector('[data-pp-naam]');
        if (n && !n.querySelector('a')) { var b = document.createElement('a'); b.href = href; b.className = 'dpv-pp-a'; while (n.firstChild) b.appendChild(n.firstChild); var p = document.createElement('i'); p.textContent = '\u00a0›'; b.appendChild(p); n.appendChild(b); }
        var l = el.querySelector('[data-pp-link]');
        if (l) { l.href = href; l.textContent = 'Prijsverloop en prijsalarm\u00a0›'; l.hidden = false; l.removeAttribute('target'); }
      }
    });
  }
  var w = 0; function plan() { if (w) return; w = setTimeout(function () { w = 0; koppel(); }, 200); }
  document.addEventListener('DOMContentLoaded', function () {
    koppel();
    if (window.MutationObserver) new MutationObserver(plan).observe(document.body, { childList: true, subtree: true });
  });
})();
</script>
